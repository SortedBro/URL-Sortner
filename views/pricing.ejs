<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pricing — SnapLink</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/pages/home.css">
  <link rel="stylesheet" href="/css/pages/generated/pricing.inline.css" />
</head>

<body>

  <!-- ═══ NAVBAR ═══ -->
  <nav class="navbar">
    <a href="/" class="nav-logo">
      <span class="logo-dot"></span>
      Snap<em>Link</em>
    </a>
    <div class="nav-center">
      <a href="/" class="nav-link">Home</a>
      <a href="/features" class="nav-link">Features</a>
      <a href="/pricing" class="nav-link" style="color:var(--accent)">Pricing</a>
      <a href="/about" class="nav-link">About</a>
    </div>
    <div class="nav-right">
      <button class="theme-btn" id="themeBtn" onclick="toggleTheme()">🌙</button>
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="nav-user">
          <div class="nav-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
          <span class="nav-username"><%= user.name %></span>
        </div>
        <a href="/dashboard" class="nav-link">Dashboard</a>
        <a href="/logout" class="nav-btn-outline">Logout</a>
      <% } else { %>
        <a href="/login" class="nav-link">Login</a>
        <a href="/signup" class="nav-btn-solid">Get Started</a>
      <% } %>
    </div>
  </nav>

  <main>

    <!-- ═══ HERO ═══ -->
    <section class="pricing-hero">
      <div class="pricing-badge">💰 Simple Pricing</div>
      <h1 class="pricing-title">Sahi plan <span>choose karo</span></h1>
      <p class="pricing-sub">Free mein shuru karo — jab scale karna ho tab upgrade karo. Koi hidden charges nahi.</p>

      <!-- Billing toggle -->
      <div class="billing-toggle">
        <span id="monthlyLabel" style="color:var(--text)">Monthly</span>
        <button class="toggle-switch" id="billingToggle" onclick="toggleBilling()">
          <div class="toggle-knob"></div>
        </button>
        <span id="yearlyLabel">Yearly</span>
        <span class="save-badge">2 months free</span>
      </div>
    </section>

    <!-- ═══ PLANS ═══ -->
    <div class="plans-section">
      <div class="plans-grid">

        <!-- FREE -->
        <div class="plan-card">
          <div class="plan-name">Free</div>
          <div class="plan-price">
            <span class="price-currency">₹</span>
            <span class="price-amount">0</span>
            <span class="price-period">/month</span>
          </div>
          <p class="plan-desc">Shuru karne ke liye — bilkul free, hamesha.</p>
          <hr class="plan-divider">
          <ul class="features-list">
            <li class="feature-li"><span class="feature-check">✓</span> 10 URLs per month</li>
            <li class="feature-li"><span class="feature-check">✓</span> Basic click analytics</li>
            <li class="feature-li"><span class="feature-check">✓</span> 30 day link history</li>
            <li class="feature-li"><span class="feature-check">✓</span> QR Code generate</li>
            <li class="feature-li disabled"><span class="feature-check cross">✕</span> Custom alias</li>
            <li class="feature-li disabled"><span class="feature-check cross">✕</span> Password protected links</li>
            <li class="feature-li disabled"><span class="feature-check cross">✕</span> Link expiry date</li>
            <li class="feature-li disabled"><span class="feature-check cross">✕</span> Bulk shortener</li>
            <li class="feature-li disabled"><span class="feature-check cross">✕</span> API access</li>
          </ul>
          <% if (typeof user !== 'undefined' && user) { %>
            <span class="plan-btn current">Current Plan</span>
          <% } else { %>
            <a href="/signup" class="plan-btn free">Get Started Free</a>
          <% } %>
        </div>

        <!-- PRO -->
        <div class="plan-card popular">
          <div class="popular-badge">★ MOST POPULAR</div>
          <div class="plan-name">Pro</div>
          <div class="plan-price">
            <span class="price-currency">₹</span>
            <span class="price-amount accent" id="proPrice">99</span>
            <span class="price-period" id="proPeriod">/month</span>
          </div>
          <p class="plan-desc">Serious creators aur marketers ke liye.</p>
          <hr class="plan-divider">
          <ul class="features-list">
            <li class="feature-li"><span class="feature-check">✓</span> <strong>Unlimited</strong> URLs</li>
            <li class="feature-li"><span class="feature-check">✓</span> Full click analytics</li>
            <li class="feature-li"><span class="feature-check">✓</span> <strong>Lifetime</strong> link history</li>
            <li class="feature-li"><span class="feature-check">✓</span> Custom alias</li>
            <li class="feature-li"><span class="feature-check">✓</span> QR Code + Download</li>
            <li class="feature-li"><span class="feature-check">✓</span> Password protected links</li>
            <li class="feature-li"><span class="feature-check">✓</span> Link expiry date</li>
            <li class="feature-li"><span class="feature-check">✓</span> Bulk shortener</li>
            <li class="feature-li"><span class="feature-check">✓</span> Analytics export CSV</li>
            <li class="feature-li"><span class="feature-check">✓</span> API access</li>
          </ul>
          <a href="/upgrade?plan=pro" class="plan-btn pro">Upgrade to Pro →</a>
        </div>

        <!-- BUSINESS -->
        <div class="plan-card">
          <div class="plan-name">Business</div>
          <div class="plan-price">
            <span class="price-currency">₹</span>
            <span class="price-amount" id="bizPrice">299</span>
            <span class="price-period" id="bizPeriod">/month</span>
          </div>
          <p class="plan-desc">Teams aur agencies ke liye — sab kuch unlimited.</p>
          <hr class="plan-divider">
          <ul class="features-list">
            <li class="feature-li"><span class="feature-check">✓</span> Sab Pro features</li>
            <li class="feature-li"><span class="feature-check">✓</span> 5 team members</li>
            <li class="feature-li"><span class="feature-check">✓</span> Custom domain</li>
            <li class="feature-li"><span class="feature-check">✓</span> White label</li>
            <li class="feature-li"><span class="feature-check">✓</span> Weekly email reports</li>
            <li class="feature-li"><span class="feature-check">✓</span> UTM tracking</li>
            <li class="feature-li"><span class="feature-check">✓</span> Webhook support</li>
            <li class="feature-li"><span class="feature-check">✓</span> Priority support</li>
            <li class="feature-li"><span class="feature-check">✓</span> SLA guarantee</li>
          </ul>
          <a href="/upgrade?plan=business" class="plan-btn business">Upgrade to Business →</a>
        </div>

      </div>
    </div>

    <!-- ═══ COMPARISON TABLE ═══ -->
    <div class="compare-section">
      <h2 class="compare-title">Plans <span>compare karo</span></h2>
      <div class="compare-table-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Free</th>
              <th class="highlight">Pro</th>
              <th>Business</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>URLs per month</td>
              <td>10</td>
              <td class="highlight-col">Unlimited</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Click analytics</td>
              <td>Basic</td>
              <td class="highlight-col">Full</td>
              <td>Full + Export</td>
            </tr>
            <tr>
              <td>Custom alias</td>
              <td><span class="cross">✕</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>QR Code</td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>Password protection</td>
              <td><span class="cross">✕</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>Link expiry</td>
              <td><span class="cross">✕</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>API access</td>
              <td><span class="cross">✕</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>Team members</td>
              <td><span class="cross">✕</span></td>
              <td><span class="cross">✕</span></td>
              <td>5 seats</td>
            </tr>
            <tr>
              <td>Custom domain</td>
              <td><span class="cross">✕</span></td>
              <td><span class="cross">✕</span></td>
              <td><span class="check">✓</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ═══ FAQ ═══ -->
    <div class="faq-section">
      <h2 class="faq-title">Sawaal <span>Jawaab</span></h2>

      <div class="faq-item">
        <div class="faq-q" onclick="toggleFaq(this)">
          Free plan mein card details chahiye?
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-a">Nahi! Free plan ke liye koi payment ya card ki zaroorat nahi. Seedha signup karo aur use karo.</div>
      </div>

      <div class="faq-item">
        <div class="faq-q" onclick="toggleFaq(this)">
          Subscription kaise cancel karein?
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-a">Kabhi bhi cancel kar sakte ho — Dashboard → Settings → Cancel Subscription. Billing period khatam hone tak Pro features milte rahenge.</div>
      </div>

      <div class="faq-item">
        <div class="faq-q" onclick="toggleFaq(this)">
          Pro se Free pe wapas aaye toh kya hoga?
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-a">Tumhare saare links kaam karte rahenge lekin naye links banane ki limit 10/month ho jaayegi. Purana data safe rahega.</div>
      </div>

      <div class="faq-item">
        <div class="faq-q" onclick="toggleFaq(this)">
          Payment methods kaunse hain?
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-a">UPI, Credit/Debit Card, Net Banking, aur Wallets — Razorpay ke through sab accept karte hain.</div>
      </div>

      <div class="faq-item">
        <div class="faq-q" onclick="toggleFaq(this)">
          Yearly plan mein kitni savings hogi?
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-a">Yearly plan mein 2 mahine free milte hain — Pro pe ₹198 bachoge aur Business pe ₹598 bachoge har saal!</div>
      </div>

    </div>

  </main>

  <%- include('partials/footer') %>

  <script src="/js/shared/theme.js"></script>
  <script>
    // ── Theme ──

    // ── Billing toggle ──
    let isYearly = false;
    function toggleBilling() {
      isYearly = !isYearly;
      const btn = document.getElementById('billingToggle');
      btn.classList.toggle('active', isYearly);

      document.getElementById('monthlyLabel').style.color = isYearly ? 'var(--muted)' : 'var(--text)';
      document.getElementById('yearlyLabel').style.color  = isYearly ? 'var(--text)' : 'var(--muted)';

      // Pro price
      document.getElementById('proPrice').textContent  = isYearly ? '990' : '99';
      document.getElementById('proPeriod').textContent = isYearly ? '/year' : '/month';

      // Business price
      document.getElementById('bizPrice').textContent  = isYearly ? '2990' : '299';
      document.getElementById('bizPeriod').textContent = isYearly ? '/year' : '/month';
    }

    // ── FAQ ──
    function toggleFaq(el) {
      const item = el.parentElement;
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    }
  </script>

</body>
</html>




