<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pricing — SnapLink</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/home.css">
  <style>

    .pricing-hero {
      text-align: center;
      padding: 5rem 2rem 3rem;
      position: relative;
      overflow: hidden;
    }
    .pricing-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(var(--border) 1px, transparent 1px),
        linear-gradient(90deg, var(--border) 1px, transparent 1px);
      background-size: 50px 50px;
      opacity: 0.2;
      pointer-events: none;
    }

    .pricing-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--card);
      border: 0.5px solid var(--border);
      border-radius: 99px;
      padding: 5px 14px;
      font-size: 12px;
      color: var(--accent);
      font-family: 'DM Mono', monospace;
      margin-bottom: 1.2rem;
      animation: fadeUp 0.5s ease both;
    }

    .pricing-title {
      font-family: 'Syne', sans-serif;
      font-size: clamp(2.2rem, 6vw, 4rem);
      font-weight: 800;
      letter-spacing: -2px;
      line-height: 1.1;
      margin-bottom: 1rem;
      animation: fadeUp 0.5s 0.1s ease both;
    }
    .pricing-title span { color: var(--accent); }

    .pricing-sub {
      font-size: 1rem;
      color: var(--text2);
      max-width: 460px;
      margin: 0 auto 2rem;
      line-height: 1.7;
      animation: fadeUp 0.5s 0.2s ease both;
    }

    /* Toggle */
    .billing-toggle {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: var(--card);
      border: 0.5px solid var(--border);
      border-radius: 99px;
      padding: 6px 16px;
      font-size: 13px;
      color: var(--text2);
      margin-bottom: 3rem;
      animation: fadeUp 0.5s 0.3s ease both;
      font-family: 'DM Sans', sans-serif;
    }
    .toggle-switch {
      position: relative;
      width: 40px; height: 22px;
      background: var(--border);
      border-radius: 99px;
      cursor: pointer;
      transition: background 0.3s;
      border: none;
      outline: none;
    }
    .toggle-switch.active { background: var(--accent); }
    .toggle-knob {
      position: absolute;
      top: 3px; left: 3px;
      width: 16px; height: 16px;
      background: white;
      border-radius: 50%;
      transition: transform 0.3s;
    }
    .toggle-switch.active .toggle-knob { transform: translateX(18px); }
    .save-badge {
      background: var(--green);
      color: #0a0a09;
      font-size: 10px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 99px;
      font-family: 'DM Mono', monospace;
    }

    /* Plans grid */
    .plans-section {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 2rem 5rem;
    }
    .plans-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 16px;
      animation: fadeUp 0.6s 0.4s ease both;
    }
    @media(max-width: 768px) {
      .plans-grid { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto; }
    }

    /* Plan card */
    .plan-card {
      background: var(--card);
      border: 0.5px solid var(--border);
      border-radius: 16px;
      padding: 2rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0;
      position: relative;
      transition: border-color 0.2s, transform 0.2s;
    }
    .plan-card:hover { transform: translateY(-4px); }
    .plan-card.popular {
      border-color: var(--accent);
      border-width: 1.5px;
    }

    .popular-badge {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--accent);
      color: #1a1a18;
      font-size: 10px;
      font-weight: 700;
      font-family: 'DM Mono', monospace;
      padding: 4px 14px;
      border-radius: 99px;
      white-space: nowrap;
      letter-spacing: 0.5px;
    }

    .plan-name {
      font-family: 'Syne', sans-serif;
      font-size: 14px;
      font-weight: 700;
      color: var(--text2);
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }

    .plan-price {
      display: flex;
      align-items: baseline;
      gap: 4px;
      margin-bottom: 6px;
    }
    .price-currency {
      font-family: 'Syne', sans-serif;
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--text2);
    }
    .price-amount {
      font-family: 'Syne', sans-serif;
      font-size: 3rem;
      font-weight: 800;
      letter-spacing: -2px;
      line-height: 1;
      color: var(--text);
    }
    .price-amount.accent { color: var(--accent); }
    .price-period {
      font-size: 13px;
      color: var(--muted);
      font-family: 'DM Mono', monospace;
    }

    .plan-desc {
      font-size: 13px;
      color: var(--text2);
      margin-bottom: 1.5rem;
      line-height: 1.5;
    }

    .plan-divider {
      border: none;
      border-top: 0.5px solid var(--border);
      margin-bottom: 1.5rem;
    }

    /* Features list */
    .features-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 2rem;
      flex: 1;
    }
    .feature-li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 13px;
      color: var(--text2);
      font-family: 'DM Sans', sans-serif;
    }
    .feature-li.disabled { color: var(--muted); }
    .feature-check {
      width: 16px; height: 16px;
      border-radius: 50%;
      background: var(--green);
      color: #0a0a09;
      font-size: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
      font-weight: 700;
    }
    .feature-check.cross {
      background: var(--border);
      color: var(--muted);
    }

    /* CTA button */
    .plan-btn {
      width: 100%;
      padding: 12px;
      font-size: 13px;
      font-weight: 700;
      font-family: 'Syne', sans-serif;
      border-radius: 10px;
      cursor: pointer;
      text-align: center;
      text-decoration: none;
      display: block;
      transition: all 0.2s;
    }
    .plan-btn.free {
      background: transparent;
      border: 0.5px solid var(--border);
      color: var(--text2);
    }
    .plan-btn.free:hover { border-color: var(--border2); color: var(--text); }

    .plan-btn.pro {
      background: var(--accent);
      border: none;
      color: #1a1a18;
    }
    .plan-btn.pro:hover { background: var(--accent-dark); transform: translateY(-1px); }

    .plan-btn.business {
      background: var(--surface);
      border: 0.5px solid var(--border);
      color: var(--text);
    }
    .plan-btn.business:hover { border-color: var(--accent); color: var(--accent); }

    .plan-btn.current {
      background: var(--surface);
      border: 0.5px solid var(--green);
      color: var(--green);
      cursor: default;
    }

    /* FAQ */
    .faq-section {
      max-width: 700px;
      margin: 0 auto;
      padding: 2rem 2rem 5rem;
    }
    .faq-title {
      font-family: 'Syne', sans-serif;
      font-size: 1.6rem;
      font-weight: 800;
      text-align: center;
      margin-bottom: 2rem;
      letter-spacing: -1px;
    }
    .faq-title span { color: var(--accent); }

    .faq-item {
      border-bottom: 0.5px solid var(--border);
      padding: 1rem 0;
    }
    .faq-q {
      font-size: 14px;
      font-weight: 600;
      font-family: 'Syne', sans-serif;
      color: var(--text);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .faq-icon {
      font-size: 18px;
      color: var(--accent);
      transition: transform 0.3s;
      flex-shrink: 0;
    }
    .faq-item.open .faq-icon { transform: rotate(45deg); }
    .faq-a {
      font-size: 13px;
      color: var(--text2);
      line-height: 1.7;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease, padding 0.3s;
    }
    .faq-item.open .faq-a {
      max-height: 200px;
      padding-top: 10px;
    }

    /* Comparison table */
    .compare-section {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 2rem 5rem;
    }
    .compare-title {
      font-family: 'Syne', sans-serif;
      font-size: 1.6rem;
      font-weight: 800;
      text-align: center;
      margin-bottom: 2rem;
      letter-spacing: -1px;
    }
    .compare-title span { color: var(--accent); }

    .compare-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    .compare-table-wrap {
      overflow-x: auto;
      border: 0.5px solid var(--border);
      border-radius: 12px;
    }
    .compare-table th {
      font-family: 'Syne', sans-serif;
      font-size: 13px;
      font-weight: 700;
      padding: 12px 16px;
      text-align: center;
      border-bottom: 0.5px solid var(--border);
      color: var(--text2);
    }
    .compare-table th:first-child { text-align: left; color: var(--text); }
    .compare-table th.highlight { color: var(--accent); }

    .compare-table td {
      padding: 12px 16px;
      border-bottom: 0.5px solid var(--border);
      text-align: center;
      color: var(--text2);
      font-family: 'DM Sans', sans-serif;
    }
    .compare-table td:first-child { text-align: left; color: var(--text); }
    .compare-table tr:hover td { background: var(--surface); }
    .compare-table .check { color: var(--green); font-size: 16px; }
    .compare-table .cross { color: var(--muted); font-size: 16px; }
    .compare-table .highlight-col { color: var(--accent); font-weight: 600; }

    @media (max-width: 640px) {
      .pricing-hero {
        padding: 3.5rem 1rem 2rem;
      }

      .plans-section,
      .compare-section,
      .faq-section {
        padding-left: 1rem;
        padding-right: 1rem;
      }

      .billing-toggle {
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
      }

      .compare-table th,
      .compare-table td {
        padding: 10px 12px;
        white-space: nowrap;
      }
    }

  </style>
</head>

<body>

  <!-- ═══ NAVBAR ═══ -->
  <nav class="navbar">
    <a href="/" class="nav-logo">
      <span class="logo-dot"></span>
      Snap<em>Link</em>
    </a>
    <div class="nav-center">
      <a href="/" class="nav-link">Home</a>
      <a href="/features" class="nav-link">Features</a>
      <a href="/pricing" class="nav-link" style="color:var(--accent)">Pricing</a>
      <a href="/about" class="nav-link">About</a>
    </div>
    <div class="nav-right">
      <button class="theme-btn" id="themeBtn" onclick="toggleTheme()">🌙</button>
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="nav-user">
          <div class="nav-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
          <span class="nav-username"><%= user.name %></span>
        </div>
        <a href="/dashboard" class="nav-link">Dashboard</a>
        <a href="/logout" class="nav-btn-outline">Logout</a>
      <% } else { %>
        <a href="/login" class="nav-link">Login</a>
        <a href="/signup" class="nav-btn-solid">Get Started</a>
      <% } %>
    </div>
  </nav>

  <main>

    <!-- ═══ HERO ═══ -->
    <section class="pricing-hero">
      <div class="pricing-badge">💰 Simple Pricing</div>
      <h1 class="pricing-title">Sahi plan <span>choose karo</span></h1>
      <p class="pricing-sub">Free mein shuru karo — jab scale karna ho tab upgrade karo. Koi hidden charges nahi.</p>

      <!-- Billing toggle -->
      <div class="billing-toggle">
        <span id="monthlyLabel" style="color:var(--text)">Monthly</span>
        <button class="toggle-switch" id="billingToggle" onclick="toggleBilling()">
          <div class="toggle-knob"></div>
        </button>
        <span id="yearlyLabel">Yearly</span>
        <span class="save-badge">2 months free</span>
      </div>
    </section>

    <!-- ═══ PLANS ═══ -->
    <div class="plans-section">
      <div class="plans-grid">

        <!-- FREE -->
        <div class="plan-card">
          <div class="plan-name">Free</div>
          <div class="plan-price">
            <span class="price-currency">₹</span>
            <span class="price-amount">0</span>
            <span class="price-period">/month</span>
          </div>
          <p class="plan-desc">Shuru karne ke liye — bilkul free, hamesha.</p>
          <hr class="plan-divider">
          <ul class="features-list">
            <li class="feature-li"><span class="feature-check">✓</span> 10 URLs per month</li>
            <li class="feature-li"><span class="feature-check">✓</span> Basic click analytics</li>
            <li class="feature-li"><span class="feature-check">✓</span> 30 day link history</li>
            <li class="feature-li"><span class="feature-check">✓</span> QR Code generate</li>
            <li class="feature-li disabled"><span class="feature-check cross">✕</span> Custom alias</li>
            <li class="feature-li disabled"><span class="feature-check cross">✕</span> Password protected links</li>
            <li class="feature-li disabled"><span class="feature-check cross">✕</span> Link expiry date</li>
            <li class="feature-li disabled"><span class="feature-check cross">✕</span> Bulk shortener</li>
            <li class="feature-li disabled"><span class="feature-check cross">✕</span> API access</li>
          </ul>
          <% if (typeof user !== 'undefined' && user) { %>
            <span class="plan-btn current">Current Plan</span>
          <% } else { %>
            <a href="/signup" class="plan-btn free">Get Started Free</a>
          <% } %>
        </div>

        <!-- PRO -->
        <div class="plan-card popular">
          <div class="popular-badge">★ MOST POPULAR</div>
          <div class="plan-name">Pro</div>
          <div class="plan-price">
            <span class="price-currency">₹</span>
            <span class="price-amount accent" id="proPrice">99</span>
            <span class="price-period" id="proPeriod">/month</span>
          </div>
          <p class="plan-desc">Serious creators aur marketers ke liye.</p>
          <hr class="plan-divider">
          <ul class="features-list">
            <li class="feature-li"><span class="feature-check">✓</span> <strong>Unlimited</strong> URLs</li>
            <li class="feature-li"><span class="feature-check">✓</span> Full click analytics</li>
            <li class="feature-li"><span class="feature-check">✓</span> <strong>Lifetime</strong> link history</li>
            <li class="feature-li"><span class="feature-check">✓</span> Custom alias</li>
            <li class="feature-li"><span class="feature-check">✓</span> QR Code + Download</li>
            <li class="feature-li"><span class="feature-check">✓</span> Password protected links</li>
            <li class="feature-li"><span class="feature-check">✓</span> Link expiry date</li>
            <li class="feature-li"><span class="feature-check">✓</span> Bulk shortener</li>
            <li class="feature-li"><span class="feature-check">✓</span> Analytics export CSV</li>
            <li class="feature-li"><span class="feature-check">✓</span> API access</li>
          </ul>
          <a href="/upgrade?plan=pro" class="plan-btn pro">Upgrade to Pro →</a>
        </div>

        <!-- BUSINESS -->
        <div class="plan-card">
          <div class="plan-name">Business</div>
          <div class="plan-price">
            <span class="price-currency">₹</span>
            <span class="price-amount" id="bizPrice">299</span>
            <span class="price-period" id="bizPeriod">/month</span>
          </div>
          <p class="plan-desc">Teams aur agencies ke liye — sab kuch unlimited.</p>
          <hr class="plan-divider">
          <ul class="features-list">
            <li class="feature-li"><span class="feature-check">✓</span> Sab Pro features</li>
            <li class="feature-li"><span class="feature-check">✓</span> 5 team members</li>
            <li class="feature-li"><span class="feature-check">✓</span> Custom domain</li>
            <li class="feature-li"><span class="feature-check">✓</span> White label</li>
            <li class="feature-li"><span class="feature-check">✓</span> Weekly email reports</li>
            <li class="feature-li"><span class="feature-check">✓</span> UTM tracking</li>
            <li class="feature-li"><span class="feature-check">✓</span> Webhook support</li>
            <li class="feature-li"><span class="feature-check">✓</span> Priority support</li>
            <li class="feature-li"><span class="feature-check">✓</span> SLA guarantee</li>
          </ul>
          <a href="/upgrade?plan=business" class="plan-btn business">Upgrade to Business →</a>
        </div>

      </div>
    </div>

    <!-- ═══ COMPARISON TABLE ═══ -->
    <div class="compare-section">
      <h2 class="compare-title">Plans <span>compare karo</span></h2>
      <div class="compare-table-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Free</th>
              <th class="highlight">Pro</th>
              <th>Business</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>URLs per month</td>
              <td>10</td>
              <td class="highlight-col">Unlimited</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Click analytics</td>
              <td>Basic</td>
              <td class="highlight-col">Full</td>
              <td>Full + Export</td>
            </tr>
            <tr>
              <td>Custom alias</td>
              <td><span class="cross">✕</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>QR Code</td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>Password protection</td>
              <td><span class="cross">✕</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>Link expiry</td>
              <td><span class="cross">✕</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>API access</td>
              <td><span class="cross">✕</span></td>
              <td><span class="check">✓</span></td>
              <td><span class="check">✓</span></td>
            </tr>
            <tr>
              <td>Team members</td>
              <td><span class="cross">✕</span></td>
              <td><span class="cross">✕</span></td>
              <td>5 seats</td>
            </tr>
            <tr>
              <td>Custom domain</td>
              <td><span class="cross">✕</span></td>
              <td><span class="cross">✕</span></td>
              <td><span class="check">✓</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ═══ FAQ ═══ -->
    <div class="faq-section">
      <h2 class="faq-title">Sawaal <span>Jawaab</span></h2>

      <div class="faq-item">
        <div class="faq-q" onclick="toggleFaq(this)">
          Free plan mein card details chahiye?
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-a">Nahi! Free plan ke liye koi payment ya card ki zaroorat nahi. Seedha signup karo aur use karo.</div>
      </div>

      <div class="faq-item">
        <div class="faq-q" onclick="toggleFaq(this)">
          Subscription kaise cancel karein?
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-a">Kabhi bhi cancel kar sakte ho — Dashboard → Settings → Cancel Subscription. Billing period khatam hone tak Pro features milte rahenge.</div>
      </div>

      <div class="faq-item">
        <div class="faq-q" onclick="toggleFaq(this)">
          Pro se Free pe wapas aaye toh kya hoga?
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-a">Tumhare saare links kaam karte rahenge lekin naye links banane ki limit 10/month ho jaayegi. Purana data safe rahega.</div>
      </div>

      <div class="faq-item">
        <div class="faq-q" onclick="toggleFaq(this)">
          Payment methods kaunse hain?
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-a">UPI, Credit/Debit Card, Net Banking, aur Wallets — Razorpay ke through sab accept karte hain.</div>
      </div>

      <div class="faq-item">
        <div class="faq-q" onclick="toggleFaq(this)">
          Yearly plan mein kitni savings hogi?
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-a">Yearly plan mein 2 mahine free milte hain — Pro pe ₹198 bachoge aur Business pe ₹598 bachoge har saal!</div>
      </div>

    </div>

  </main>

  <%- include('partials/footer') %>

  <script>
    // ── Theme ──
    const saved = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', saved);
    document.getElementById('themeBtn').textContent = saved === 'dark' ? '🌙' : '☀️';
    function toggleTheme() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const next = isDark ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      document.getElementById('themeBtn').textContent = next === 'dark' ? '🌙' : '☀️';
    }

    // ── Billing toggle ──
    let isYearly = false;
    function toggleBilling() {
      isYearly = !isYearly;
      const btn = document.getElementById('billingToggle');
      btn.classList.toggle('active', isYearly);

      document.getElementById('monthlyLabel').style.color = isYearly ? 'var(--muted)' : 'var(--text)';
      document.getElementById('yearlyLabel').style.color  = isYearly ? 'var(--text)' : 'var(--muted)';

      // Pro price
      document.getElementById('proPrice').textContent  = isYearly ? '990' : '99';
      document.getElementById('proPeriod').textContent = isYearly ? '/year' : '/month';

      // Business price
      document.getElementById('bizPrice').textContent  = isYearly ? '2990' : '299';
      document.getElementById('bizPeriod').textContent = isYearly ? '/year' : '/month';
    }

    // ── FAQ ──
    function toggleFaq(el) {
      const item = el.parentElement;
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    }
  </script>

</body>
</html>
