<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const activePlan = user ? String(user.plan || 'free') : 'free';
    const faqItems = [
      { q: 'Do I need a card for the free plan?', a: 'No. The free plan starts without payment details, so you can begin shortening links right away.' },
      { q: 'What happens if I downgrade from Pro?', a: 'Existing links keep working. Your account simply returns to the free creation limit and feature access.' },
      { q: 'Which payment methods are supported?', a: 'Razorpay checkout supports UPI, cards, net banking, and wallet-based payment methods.' },
      { q: 'What does Business include beyond Pro?', a: 'Business adds white label controls, team seats, weekly reports, webhook support, and business operations settings.' },
      { q: 'Can I switch between monthly and yearly billing?', a: 'Yes. Choose the cadence that fits your usage. Yearly billing keeps the same feature set with better effective pricing.' }
    ];
    const seo = {
      title: 'SnapLink Pricing | Free, Pro, and Business Plans',
      description: 'Compare SnapLink pricing for free, Pro, and Business plans. Start free, unlock analytics and API access, and scale into white-label workflows.',
      keywords: 'snaplink pricing, url shortener pricing, branded link pricing, white label link plans, analytics pricing',
      path: '/pricing',
      stylesheets: ['/css/pages/site-shell.css', '/css/pages/marketing-pages.css'],
      jsonLd: {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a }
        }))
      }
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
</head>
<body class="site-page pricing-page">
  <%- include('partials/site-navbar', { currentPage: 'pricing' }) %>

  <main class="page-shell page-stack">
    <section class="page-hero">
      <div class="hero-grid">
        <div>
          <div class="eyebrow">Pricing</div>
          <h1 class="hero-title">Start free. Upgrade only when the workflow needs <span>more power</span>.</h1>
          <p class="hero-text">
            SnapLink pricing stays simple: a free starting point for early use, Pro for advanced operators,
            and Business for teams that need white-label delivery and automation.
          </p>
          <div class="hero-actions">
            <button type="button" class="btn-secondary" id="billingToggle">Monthly billing</button>
            <span class="form-note">Toggle to yearly pricing for the same features and better effective spend.</span>
          </div>
        </div>

        <aside class="hero-panel">
          <h3>Why the pricing is structured this way</h3>
          <p>It should be easy to try the product, affordable to grow into Pro, and strong enough for agencies and businesses that need brand control.</p>
          <ul class="check-list">
            <li>Free entry for testing real workflows</li>
            <li>Pro unlocks scale, analytics depth, and API access</li>
            <li>Business adds team, reporting, and white-label operations</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="pricing-grid">
      <article class="plan-card">
        <div class="plan-label-row">
          <div>
            <div class="plan-chip">Free</div>
            <h3>Start and ship</h3>
          </div>
          <% if (activePlan === 'free') { %><span class="plan-current">Current</span><% } %>
        </div>
        <div class="plan-price"><strong data-monthly="0" data-yearly="0">Rs 0</strong><span>Always free</span></div>
        <p class="plan-subtitle">Perfect for trying SnapLink, testing link flows, and shipping a few campaigns each month.</p>
        <ul class="plan-features">
          <li>10 URLs per month</li>
          <li>Basic click analytics</li>
          <li>30-day history</li>
          <li>QR code generation</li>
        </ul>
        <% if (user) { %>
          <span class="plan-current"><%= activePlan === 'free' ? 'Current plan' : 'Available in your account' %></span>
        <% } else { %>
          <a href="/signup" class="plan-cta">Create free account</a>
        <% } %>
      </article>

      <article class="plan-card is-featured">
        <div class="plan-label-row">
          <div>
            <div class="plan-chip popular">Most popular</div>
            <h3>Pro</h3>
          </div>
          <% if (activePlan === 'pro') { %><span class="plan-current">Current</span><% } %>
        </div>
        <div class="plan-price"><strong id="proPrice" data-monthly="99" data-yearly="990">Rs 99</strong><span id="proPeriod">per month</span></div>
        <p class="plan-subtitle">For creators and marketers who need analytics depth, custom control, and faster publishing.</p>
        <ul class="plan-features">
          <li>Unlimited URLs</li>
          <li>Full analytics and export</li>
          <li>Custom aliases</li>
          <li>Password protection and expiry</li>
          <li>Bulk shortener and API access</li>
        </ul>
        <% if (activePlan === 'pro') { %>
          <span class="plan-current">Current plan</span>
        <% } else { %>
          <a href="/upgrade?plan=pro" class="plan-cta">Upgrade to Pro</a>
        <% } %>
      </article>

      <article class="plan-card" id="enterprise">
        <div class="plan-label-row">
          <div>
            <div class="plan-chip">Business</div>
            <h3>Scale with brand control</h3>
          </div>
          <% if (activePlan === 'business') { %><span class="plan-current">Current</span><% } %>
        </div>
        <div class="plan-price"><strong id="businessPrice" data-monthly="299" data-yearly="2990">Rs 299</strong><span id="businessPeriod">per month</span></div>
        <p class="plan-subtitle">For agencies, internal teams, and businesses that need white-label delivery, reports, and operational tooling.</p>
        <ul class="plan-features">
          <li>Everything in Pro</li>
          <li>White label and custom domain</li>
          <li>5 team seats</li>
          <li>Weekly email reports</li>
          <li>Webhook support and priority workflows</li>
        </ul>
        <% if (activePlan === 'business') { %>
          <span class="plan-current">Current plan</span>
        <% } else { %>
          <a href="/upgrade?plan=business" class="plan-cta">Upgrade to Business</a>
        <% } %>
      </article>
    </section>

    <section class="section-card">
      <div class="section-kicker">Comparison</div>
      <h2 class="section-title">Where each plan starts to diverge.</h2>
      <div class="compare-grid">
        <div class="compare-row"><span>Publishing volume</span><strong>Free: 10 per month, Pro and Business: unlimited</strong></div>
        <div class="compare-row"><span>Analytics depth</span><strong>Free: basic, Pro: full, Business: full plus reporting workflows</strong></div>
        <div class="compare-row"><span>Branding control</span><strong>Custom alias in Pro, white-label and custom domain in Business</strong></div>
        <div class="compare-row"><span>Automation</span><strong>API in Pro, webhook and business reporting in Business</strong></div>
      </div>
    </section>

    <section class="section-card">
      <div class="section-kicker">FAQ</div>
      <h2 class="section-title">Common pricing questions before you upgrade.</h2>
      <div class="faq-list">
        <% faqItems.forEach((item, index) => { %>
          <article class="faq-item <%= index === 0 ? 'is-open' : '' %>">
            <button type="button" class="faq-question" onclick="toggleFaq(this)">
              <span><%= item.q %></span>
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-answer"><p><%= item.a %></p></div>
          </article>
        <% }) %>
      </div>
    </section>
  </main>

  <%- include('partials/footer', { footerCopy: 'Straightforward pricing so you can start free, grow into Pro, and scale into Business when brand control matters.' }) %>
  <script src="/js/shared/theme.js"></script>
  <script>
    let yearlyBilling = false;

    function syncPrice(nodeId, periodId) {
      const node = document.getElementById(nodeId);
      const period = document.getElementById(periodId);
      if (!node || !period) return;
      const value = yearlyBilling ? node.dataset.yearly : node.dataset.monthly;
      node.textContent = `Rs ${value}`;
      period.textContent = yearlyBilling ? 'per year' : 'per month';
    }

    function toggleFaq(button) {
      const item = button.closest('.faq-item');
      const isOpen = item.classList.contains('is-open');
      document.querySelectorAll('.faq-item').forEach((node) => node.classList.remove('is-open'));
      if (!isOpen) item.classList.add('is-open');
    }

    document.getElementById('billingToggle').addEventListener('click', function () {
      yearlyBilling = !yearlyBilling;
      this.textContent = yearlyBilling ? 'Yearly billing' : 'Monthly billing';
      syncPrice('proPrice', 'proPeriod');
      syncPrice('businessPrice', 'businessPeriod');
    });
  </script>
</body>
</html>
