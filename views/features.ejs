<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: 'SnapLink Features | Branded Links, Analytics, API, and White Label',
      description: 'Explore SnapLink features for creators, marketers, and teams: custom aliases, analytics, QR codes, bulk shortening, API access, white label, and reports.',
      keywords: 'snaplink features, branded short links, link analytics, qr generator, white label links, bulk shortener, api short links',
      path: '/features',
      stylesheets: ['/css/pages/site-shell.css', '/css/pages/marketing-pages.css'],
      jsonLd: {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'SnapLink',
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
        url: `${appUrl}/features`
      }
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
</head>
<body class="site-page features-page">
  <%- include('partials/site-navbar', { currentPage: 'features' }) %>

  <main class="page-shell page-stack">
    <section class="page-hero">
      <div class="hero-grid">
        <div>
          <div class="eyebrow">Product features</div>
          <h1 class="hero-title">Everything around your <span>short links</span>.</h1>
          <p class="hero-text">
            Create, track, brand, and scale links from one dashboard.
          </p>
          <div class="hero-actions">
            <% if (user) { %>
              <a href="/dashboard" class="btn-primary">Open Dashboard</a>
            <% } else { %>
              <a href="/signup" class="btn-primary">Create Free Account</a>
            <% } %>
            <a href="/pricing" class="btn-secondary">Compare plans</a>
          </div>
        </div>

        <aside class="hero-panel">
          <h3>Core features</h3>
          <p>Start simple, then add business controls only when you need them.</p>
          <div class="mini-metrics">
            <div class="mini-metric"><strong>Custom</strong><span>Alias, expiry, password, redirect ads</span></div>
            <div class="mini-metric"><strong>Track</strong><span>Geo, device, browser, referrer</span></div>
            <div class="mini-metric"><strong>Scale</strong><span>Bulk tools, API, webhooks, reports</span></div>
          </div>
        </aside>
      </div>
    </section>

    <section class="cards-grid three" id="analytics-engine">
      <article class="content-card"><h3>Smart link builder</h3><p class="section-copy">Create links with custom aliases, password locks, expiry rules, QR-ready delivery, and optional redirect ads.</p></article>
      <article class="content-card"><h3>Detailed analytics</h3><p class="section-copy">Track countries, cities, browsers, devices, referrers, top links, and conversion-driving trends in one view.</p></article>
      <article class="content-card"><h3>White-label control</h3><p class="section-copy">Use your own domain, brand name, and logo so every short link feels native to your business.</p></article>
      <article class="content-card"><h3>Bulk operations</h3><p class="section-copy">Shorten at scale, export data, and move faster when one-off manual creation is no longer enough.</p></article>
      <article class="content-card" id="developer-ops"><h3>API and webhooks</h3><p class="section-copy">Programmatic link creation, account-level keys, and webhook delivery for business workflows and automations.</p></article>
      <article class="content-card"><h3>Reports and support</h3><p class="section-copy">Weekly report emails, team seats, and business support flows for customers who need continuity and response time.</p></article>
    </section>

    <section class="section-card">
      <div class="section-kicker">Affiliate and wallet</div>
      <h2 class="section-title">Affiliate and wallet tools are built in.</h2>
      <div class="cards-grid three">
        <article class="content-card">
          <h3>Affiliate referrals</h3>
          <p class="section-copy">Track referrals from one dedicated dashboard.</p>
        </article>
        <article class="content-card">
          <h3>Wallet visibility</h3>
          <p class="section-copy">See balances, earnings, and payout history in one place.</p>
        </article>
        <article class="content-card">
          <h3>Business operations</h3>
          <p class="section-copy">Combine growth with white label, reports, API, and webhooks.</p>
        </article>
      </div>
      <div class="hero-actions">
        <% if (user) { %>
          <a href="/affiliate/dashboard" class="btn-primary">Open affiliate dashboard</a>
        <% } else { %>
          <a href="/signup" class="btn-primary">Create free account</a>
        <% } %>
        <a href="/pricing" class="btn-secondary">View business pricing</a>
      </div>
    </section>
  </main>

  <%- include('partials/footer', { footerCopy: 'Feature coverage that starts simple and expands into automation, reporting, and white-label delivery.' }) %>
  <script src="/js/shared/theme.js"></script>
</body>
</html>

