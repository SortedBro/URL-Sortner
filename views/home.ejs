                <td>~₹1,600/mo</td>
                <td><span class="tag red">✕</span></td>
              </tr>
              <tr class="our-row">
                <td><strong>SnapLink 🇮🇳</strong></td>
                <td><span class="tag green">10/mo</span></td>
                <td><strong class="accent">₹99/mo</strong></td>
                <td><span class="tag green">✓ UPI/Card</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="cta-inner">
        <h2 class="cta-title">Abhi shuru karo — <span class="accent">free mein</span></h2>
        <p class="cta-sub">No credit card. No hidden charges. Seedha signup karo aur apna pehla link banao.</p>
        <div class="cta-btns">
          <% if (!user) { %>
