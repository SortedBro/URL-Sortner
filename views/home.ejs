  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://snaplink.fun/" />

  <!-- Open Graph -->
  <meta property="og:title" content="SnapLink — Free URL Short Generator | Short URL Online" />
  <meta property="og:description"
    content="Create short URL links instantly. Free URL short tool with click analytics, QR codes, custom alias. India's best Bitly alternative at ₹99/mo." />
  <meta property="og:url" content="https://snaplink.fun/" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://snaplink.fun/images/url-short-snaplink-og.webp" />
