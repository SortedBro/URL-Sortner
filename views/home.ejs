<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: 'SnapLink - Free URL Shortener and URL to QR Code Generator',
      description: 'Shorten long URLs, generate QR codes instantly, track clicks, and manage cleaner share links with SnapLink.',
      keywords: 'url shortener, qr code generator, url to qr code, branded links, click analytics, short links',
      path: '/',
      stylesheets: ['/css/pages/site-shell.css', '/css/pages/home-landing.css'],
      jsonLd: {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'SnapLink',
        url: `${appUrl}/`,
        description: 'Short links, QR codes, analytics, and sharing workflows in one clean product.'
      }
    };
    const isLoggedIn = typeof user !== 'undefined' && user;
    const isFree = isLoggedIn && user.plan === 'free';
  %>
  <%- include('partials/seo-head', { seo }) %>
</head>
<body class="site-page home-page">
  <%- include('partials/site-navbar', { currentPage: '' }) %>

  <main class="page-shell home-shell">
    <section class="home-hero">
      <div class="home-hero-grid">
        <div class="hero-copy-column">
          <div class="eyebrow">Clean link workflows for modern teams</div>
          <h1 class="home-title">Shorten URLs, create QR codes, and share smarter from one polished workspace.</h1>
          <p class="home-lead">
            SnapLink keeps the first step simple. Drop in any long URL, turn it into a short link or QR code,
            then keep analytics, branding, and growth tools ready when you need them.
          </p>

          <div class="hero-stat-row">
            <article class="hero-stat-card">
              <strong>Short links</strong>
              <span>Create readable links that are easier to share across social, chat, email, and campaigns.</span>
            </article>
            <article class="hero-stat-card">
              <strong>Instant QR</strong>
              <span>Generate a QR code on the homepage without leaving the flow or opening extra tools.</span>
            </article>
            <article class="hero-stat-card">
              <strong>Built to grow</strong>
              <span>When you are ready, unlock analytics, wallet, affiliate, API, bulk actions, and white label.</span>
            </article>
          </div>

          <div class="hero-proof-row">
            <span>No credit card required</span>
            <span>Fast redirects</span>
            <span>QR downloads included</span>
          </div>
        </div>

        <div class="hero-toolbox">
          <div class="tool-switch" role="tablist" aria-label="Homepage tools">
            <button type="button" class="tool-switch-btn is-active" id="switch-short" onclick="toggleHomeMode('short')" aria-selected="true">URL Shortener</button>
            <button type="button" class="tool-switch-btn" id="switch-qr" onclick="toggleHomeMode('qr')" aria-selected="false">URL to QR Code</button>
          </div>

          <section class="hero-tool-panel is-active" id="short-panel" aria-labelledby="switch-short">
            <div class="tool-panel-head">
              <div>
                <p class="tool-panel-kicker">Fast start</p>
                <h2>Turn a long URL into a clean short link</h2>
              </div>
              <span class="tool-panel-badge">Ready in seconds</span>
            </div>

            <% if (error) { %>
              <div class="alert error home-alert"><%= error %></div>
            <% } %>

            <form action="/shorten" method="POST" class="hero-shortener" id="heroShortenerForm">
              <label class="tool-field tool-field-full">
                <span>Paste your long URL</span>
                <input type="url" name="orginalUrl" placeholder="https://example.com/your-long-link" required>
              </label>

              <% if (isLoggedIn) { %>
                <div class="advanced-block">
                  <button type="button" class="advanced-toggle" id="advancedToggleBtn" aria-expanded="false" onclick="toggleAdvanced()">
                    <span>Advanced options</span>
                    <span class="advanced-toggle-mark" id="advancedToggleMark">+</span>
                  </button>

                  <div class="advanced-panel" id="advancedPanel">
                    <div class="advanced-grid">
                      <label class="tool-field">
                        <span>Custom alias</span>
                        <input type="text" name="customAlias" placeholder="brand-launch" <%= isFree ? 'disabled' : '' %>>
                        <small><%= isFree ? 'Pro plan required for aliases.' : 'Optional vanity slug for branded sharing.' %></small>
                      </label>

                      <label class="toggle-card">
                        <input type="checkbox" name="adEnabled" value="on" id="heroAdEnabled" onchange="toggleAdState(this)">
                        <span class="toggle-card-ui"></span>
                        <span class="toggle-copy">
                          <strong>Redirect ads</strong>
                          <small>Ads off means direct open. Ads on means ad redirect first, then original URL opens.</small>
                        </span>
                      </label>
                    </div>
                  </div>
                </div>
              <% } else { %>
                <div class="signin-note">
                  <strong>Optional controls unlock after sign in.</strong>
                  <span>Log in to manage custom aliases, redirect ads, analytics, and saved links.</span>
                </div>
              <% } %>

              <button type="submit" class="hero-submit">Create short link</button>
            </form>

            <% if (shortUrl) { %>
              <div class="result-card home-result">
                <div class="result-copy">
                  <strong>Short link ready</strong>
                  <a href="<%= shortUrl %>" target="_blank" rel="noopener" class="result-link" id="resultUrl"><%= shortUrl %></a>
                </div>
                <div class="result-actions">
                  <a href="<%= shortUrl %>" target="_blank" rel="noopener" class="btn-secondary">Open</a>
                  <button type="button" class="copy-btn" onclick="copyUrl('<%= shortUrl %>', this)">Copy</button>
                </div>
              </div>
            <% } %>
          </section>

          <section class="hero-tool-panel" id="qr-panel" aria-labelledby="switch-qr" hidden>
            <div class="tool-panel-head">
              <div>
                <p class="tool-panel-kicker">Instant generator</p>
                <h2>Convert any URL into a downloadable QR code</h2>
              </div>
              <span class="tool-panel-badge">No signup needed</span>
            </div>

            <div class="qr-tool-grid">
              <label class="tool-field tool-field-full">
                <span>URL to encode</span>
                <input type="url" id="heroQrInput" placeholder="https://example.com/product-page" inputmode="url">
              </label>

              <div class="qr-actions-row">
                <button type="button" class="hero-submit" onclick="generateHeroQr()">Generate QR code</button>
                <button type="button" class="btn-secondary qr-download-btn" id="heroQrDownloadBtn" onclick="downloadHeroQr()" disabled>Download PNG</button>
              </div>

              <div class="qr-preview-card">
                <div class="qr-preview-header">
                  <strong>Preview</strong>
                  <button type="button" class="copy-btn qr-copy-btn" id="heroQrCopyBtn" onclick="copyHeroQrUrl(this)" disabled>Copy URL</button>
                </div>
                <div class="qr-preview-stage" id="heroQrPreviewStage">
                  <div class="qr-placeholder" id="heroQrPlaceholder">
                    <strong>QR preview appears here</strong>
                    <span>Paste a valid URL and generate the code.</span>
                  </div>
                  <canvas id="heroQrCanvas" width="220" height="220" hidden></canvas>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </section>

    <section class="home-signal-strip">
      <article class="signal-card">
        <span class="signal-label">Use case</span>
        <strong>Share product links, bio links, forms, and campaign pages without messy URLs.</strong>
      </article>
      <article class="signal-card">
        <span class="signal-label">Why it feels simpler</span>
        <strong>Shortener and QR generator live on the same screen, so users solve the problem faster.</strong>
      </article>
      <article class="signal-card">
        <span class="signal-label">What scales later</span>
        <strong>Analytics, affiliate, wallet, API access, white label, and business controls are already in the product.</strong>
      </article>
    </section>

    <section class="home-section">
      <div class="section-heading-row">
        <div>
          <div class="eyebrow">Everything starts from the first link</div>
          <h2 class="section-title">A cleaner homepage that helps users choose the right action immediately.</h2>
        </div>
        <p class="section-copy section-heading-copy">
          Instead of forcing users to search around the product, the homepage now gives two clear starting points:
          shorten a URL or generate a QR code.
        </p>
      </div>

      <div class="capability-grid">
        <article class="capability-card">
          <div class="capability-icon">01</div>
          <h3>Short links that feel professional</h3>
          <p>Create readable, lightweight share links with optional aliases, redirect ads, and clean copy actions.</p>
        </article>
        <article class="capability-card">
          <div class="capability-icon">02</div>
          <h3>QR generation built into the hero</h3>
          <p>Generate and download a QR code instantly from the homepage without opening a separate utility page.</p>
        </article>
        <article class="capability-card">
          <div class="capability-icon">03</div>
          <h3>Upgrade path already connected</h3>
          <p>When users are ready, SnapLink expands into analytics, wallet, affiliate, bulk actions, teams, and API workflows.</p>
        </article>
      </div>
    </section>

    <section class="home-section workflow-section">
      <div class="section-heading-row compact">
        <div>
          <div class="eyebrow">Simple flow</div>
          <h2 class="section-title">From long URL to share-ready asset in three quick steps.</h2>
        </div>
      </div>

      <div class="workflow-grid">
        <article class="workflow-card">
          <span class="workflow-step">Step 1</span>
          <h3>Paste the destination</h3>
          <p>Start with any long URL from your store, video, document, landing page, or profile link.</p>
        </article>
        <article class="workflow-card">
          <span class="workflow-step">Step 2</span>
          <h3>Pick short link or QR</h3>
          <p>Use the homepage switch to choose the output format your audience needs right now.</p>
        </article>
        <article class="workflow-card">
          <span class="workflow-step">Step 3</span>
          <h3>Share and grow</h3>
          <p>Publish it across socials, offline print, chat, email, or campaigns, then move into analytics when needed.</p>
        </article>
      </div>
    </section>

    <section class="home-cta">
      <div class="home-cta-inner">
        <div class="eyebrow">Ready to ship cleaner links</div>
        <h2>Start with one URL. Grow into a full sharing workflow.</h2>
        <p>SnapLink is designed to feel easy on day one and still stay useful when your traffic, campaigns, and team get bigger.</p>
        <div class="home-cta-actions">
          <% if (isLoggedIn) { %>
            <a href="/dashboard" class="btn-primary">Open dashboard</a>
            <a href="/qr-codes" class="btn-secondary">Manage QR codes</a>
          <% } else { %>
            <a href="/signup" class="btn-primary">Create free account</a>
            <a href="/tools" class="btn-secondary">Explore free tools</a>
          <% } %>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer', { footerCopy: 'Short links, QR generation, analytics, affiliate flows, and business-ready sharing tools in one focused SnapLink experience.' }) %>

  <script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
  <script src="/js/shared/theme.js"></script>
  <script>
    let activeHomeMode = 'short';
    let heroQrReady = false;

    function copyUrl(url, btn) {
      navigator.clipboard.writeText(url).then(() => {
        const previous = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => {
          btn.textContent = previous;
        }, 1600);
      });
    }

    function toggleHomeMode(mode) {
      activeHomeMode = mode;
      const shortBtn = document.getElementById('switch-short');
      const qrBtn = document.getElementById('switch-qr');
      const shortPanel = document.getElementById('short-panel');
      const qrPanel = document.getElementById('qr-panel');
      const shortActive = mode === 'short';

      if (shortBtn) {
        shortBtn.classList.toggle('is-active', shortActive);
        shortBtn.setAttribute('aria-selected', shortActive ? 'true' : 'false');
      }
      if (qrBtn) {
        qrBtn.classList.toggle('is-active', !shortActive);
        qrBtn.setAttribute('aria-selected', shortActive ? 'false' : 'true');
      }
      if (shortPanel) {
        shortPanel.classList.toggle('is-active', shortActive);
        shortPanel.hidden = !shortActive;
      }
      if (qrPanel) {
        qrPanel.classList.toggle('is-active', !shortActive);
        qrPanel.hidden = shortActive;
      }
    }

    function toggleAdvanced() {
      const panel = document.getElementById('advancedPanel');
      const toggle = document.getElementById('advancedToggleBtn');
      const mark = document.getElementById('advancedToggleMark');
      if (!panel || !toggle || !mark) return;
      const isOpen = panel.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      mark.textContent = isOpen ? '-' : '+';
    }

    function toggleAdState(checkbox) {
      const card = checkbox ? checkbox.closest('.toggle-card') : null;
      if (!card) return;
      card.classList.toggle('is-checked', checkbox.checked);
    }

    function getHeroQrValue() {
      const input = document.getElementById('heroQrInput');
      return input ? input.value.trim() : '';
    }

    function setHeroQrEmptyState(message) {
      const placeholder = document.getElementById('heroQrPlaceholder');
      const canvas = document.getElementById('heroQrCanvas');
      const downloadBtn = document.getElementById('heroQrDownloadBtn');
      const copyBtn = document.getElementById('heroQrCopyBtn');
      if (placeholder) {
        placeholder.hidden = false;
        placeholder.querySelector('span').textContent = message || 'Paste a valid URL and generate the code.';
      }
      if (canvas) {
        canvas.hidden = true;
      }
      if (downloadBtn) {
        downloadBtn.disabled = true;
      }
      if (copyBtn) {
        copyBtn.disabled = true;
      }
      heroQrReady = false;
    }

    function generateHeroQr() {
      const value = getHeroQrValue();
      const placeholder = document.getElementById('heroQrPlaceholder');
      const canvas = document.getElementById('heroQrCanvas');
      const downloadBtn = document.getElementById('heroQrDownloadBtn');
      const copyBtn = document.getElementById('heroQrCopyBtn');

      if (!value) {
        setHeroQrEmptyState('Add a URL first so the QR preview can be generated.');
        return;
      }

      if (!window.QRCode || !canvas) {
        setHeroQrEmptyState('QR library did not load. Refresh once and try again.');
        return;
      }

      QRCode.toCanvas(canvas, value, {
        width: 220,
        margin: 1,
        color: { dark: '#0f1720', light: '#ffffff' }
      }, (error) => {
        if (error) {
          setHeroQrEmptyState('Could not generate the QR code for this value.');
          return;
        }

        heroQrReady = true;
        canvas.hidden = false;
        if (placeholder) {
          placeholder.hidden = true;
        }
        if (downloadBtn) {
          downloadBtn.disabled = false;
        }
        if (copyBtn) {
          copyBtn.disabled = false;
        }
      });
    }

    function downloadHeroQr() {
      const canvas = document.getElementById('heroQrCanvas');
      if (!heroQrReady || !canvas) return;
      const link = document.createElement('a');
      link.download = 'snaplink-qr.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
    }

    function copyHeroQrUrl(btn) {
      const value = getHeroQrValue();
      if (!value) return;
      copyUrl(value, btn);
    }

    document.addEventListener('DOMContentLoaded', () => {
      toggleHomeMode('short');
      const adToggle = document.getElementById('heroAdEnabled');
      if (adToggle) {
        toggleAdState(adToggle);
      }

      const qrInput = document.getElementById('heroQrInput');
      if (qrInput) {
        qrInput.addEventListener('input', () => {
          if (!qrInput.value.trim()) {
            setHeroQrEmptyState('Paste a valid URL and generate the code.');
            return;
          }
          if (heroQrReady) {
            generateHeroQr();
          }
        });
      }
    });
  </script>
</body>
</html>
