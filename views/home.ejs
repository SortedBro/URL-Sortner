    href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap"
    rel="stylesheet">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/home.css">

  <style>
    /* ── SEO CONTENT SECTION ── */
    .seo-section {
      background: var(--surface, #0f0f0d);
      border-top: 1px solid rgba(255, 255, 255, .06);
      padding: 64px 24px;
      color: var(--text-muted, #6b6862);
    }

    .seo-inner {
      max-width: 900px;
      margin: 0 auto;
    }

    .seo-inner h2 {
      font-family: 'Syne', sans-serif;
      font-size: 22px;
      font-weight: 700;
      color: var(--text, #edeae2);
      margin: 0 0 12px;
      letter-spacing: -.3px;
    }

    .seo-inner h3 {
      font-family: 'Syne', sans-serif;
      font-size: 17px;
      font-weight: 600;
      color: var(--text, #edeae2);
      margin: 32px 0 10px;
    }

    .seo-inner h4 {
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      font-weight: 600;
      color: #918e87;
      margin: 22px 0 8px;
    }

    .seo-inner p {
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      line-height: 1.8;
      color: #6b6862;
      margin: 0 0 14px;
    }

    .seo-inner strong {
      color: #f5c842;
      font-weight: 600;
    }

    .seo-inner ul,
    .seo-inner ol {
      padding-left: 20px;
      margin: 0 0 16px;
    }

    .seo-inner li {
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      line-height: 1.8;
      color: #6b6862;
      margin-bottom: 5px;
    }

    .seo-inner a {
      color: #f5c842;
      text-decoration: none;
    }

    .seo-inner a:hover {
      text-decoration: underline;
    }

    .seo-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      margin: 20px 0 32px;
    }

    .seo-divider {
      height: 1px;
      background: rgba(255, 255, 255, .06);
      margin: 36px 0;
    }

    .seo-img-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 20px 0;
    }

    .seo-img-card {
      background: #141412;
      border: 1px solid #242420;
      border-radius: 12px;
      padding: 20px 16px;
      text-align: center;
    }

    .seo-img-card .seo-img-icon {
      font-size: 28px;
      margin-bottom: 10px;
    }

    .seo-img-card p {
      font-size: 12px;
      color: #55524e;
      margin: 0;
    }

    .seo-img-card strong {
      font-size: 13px;
      color: #918e87;
      display: block;
      margin-bottom: 4px;
    }

    .seo-kw-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 14px 0 24px;
    }

    .seo-kw-chip {
      background: #141412;
      border: 1px solid #242420;
      border-radius: 99px;
      padding: 4px 12px;
      font-size: 11px;
      font-family: 'DM Mono', monospace;
      color: #55524e;
    }

    @media (max-width: 640px) {
      .seo-grid {
        grid-template-columns: 1fr;
        gap: 0;
      }

      .seo-img-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <!-- ═══════════════════════════
       NAVBAR
  ═══════════════════════════ -->
  <nav class="navbar">
    <a href="/" class="nav-logo">
      <span class="logo-dot"></span>
      Snap<em>Link</em>
    </a>

    <div class="nav-center">
      <a href="/tools" class="nav-link">🛠️ Tools</a>
      <a href="/features" class="nav-link">Features</a>
      <a href="/pricing" class="nav-link">Pricing</a>
      <a href="/a/dashboard" class="nav-link">Affiliate</a>

      <a href="/about" class="nav-link">About</a>
    </div>

    <div class="nav-right">
      <button class="theme-btn" id="themeBtn" onclick="toggleTheme()">🌙</button>
      <% if (user) { %>
        <div class="nav-user">
          <div class="nav-avatar">
            <%= user.name.charAt(0).toUpperCase() %>
          </div>
          <span class="nav-username">
            <%= user.name %>
          </span>
        </div>
        <a href="/dashboard" class="nav-link">Dashboard</a>
        <a href="/logout" class="nav-btn-outline">Logout</a>
        <% } else { %>
          <a href="/login" class="nav-link">Login</a>
          <a href="/signup" class="nav-btn-solid">Get Started</a>
          <% } %>
    </div>
  </nav>

  <!-- ═══════════════════════════
       HERO
  ═══════════════════════════ -->
  <main>
    <section class="hero">
      <!-- keyword in first 50 words -->
      <div class="hero-badge">✦ Free URL Short Generator</div>
      <h1 class="hero-title">
        Long URLs ko<br>
        <span class="accent">Snap</span> karo
      </h1>
      <p class="hero-sub">
        India's fastest <strong style="color:#f5c842">URL short</strong> tool — clean, trackable short links seconds
        mein banao.
      </p>

      <!-- URL Form -->
      <div class="form-wrap">
        <% if (error) { %>
          <div class="error-msg">⚠ <%= error %>
          </div>
          <% } %>

            <form action="/shorten" method="POST" class="url-form">
              <div class="input-group">
                <% const isLoggedIn=typeof user !=='undefined' && user; %>
                  <% const isFree=isLoggedIn && user.plan==='free' ; %>

                    <input type="url" name="orginalUrl" placeholder="https://example.com/bahut-lamba-url..." required
                      class="url-input" />

                    <% if (isLoggedIn) { %>
                      <div class="alias-wrapper">
                        <input type="text" name="customAlias" placeholder="Custom alias (optional)" class="alias-input"
                          <%=isFree ? 'disabled' : '' %> />
                        <% if (isFree) { %>
                          <a href="/pricing" class="pro-chip-link">
                            <span class="pro-chip">PRO</span>
                          </a>
                          <% } %>
                      </div>
                      <% } %>
              </div>
              <button type="submit" class="snap-btn">
                <span>Snap URL</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </button>
            </form>

            <% if (shortUrl) { %>
              <div class="result-card">
                <div class="result-label">✓ Tera Short URL</div>
                <div class="result-row">
                  <a href="<%= shortUrl %>" target="_blank" class="result-url" id="resultUrl">
                    <%= shortUrl %>
                  </a>
                  <button class="copy-btn" onclick="copyUrl('<%= shortUrl %>', this)">Copy</button>
                </div>
              </div>
              <% } %>
      </div>
    </section>

    <!-- Features strip -->
    <section class="features-strip">
      <div class="feature-item">
        <span class="feature-icon">⚡</span>
        <span>Instant Short Links</span>
      </div>
      <div class="feature-divider"></div>
      <div class="feature-item">
        <span class="feature-icon">📊</span>
        <span>Click Analytics</span>
      </div>
      <div class="feature-divider"></div>
      <div class="feature-item">
        <span class="feature-icon">🎯</span>
        <span>Custom Aliases</span>
      </div>
      <div class="feature-divider"></div>
      <div class="feature-item">
        <span class="feature-icon">🔒</span>
        <span>Secure & Reliable</span>
      </div>
    </section>

    <!-- WHY SNAPLINK -->
    <section class="why-section">
      <div class="why-inner">
        <div class="section-badge">✦ Why SnapLink?</div>
        <h2 class="why-title">Bitly se <span class="accent">30x sasta</span>,<br>wahi features</h2>
        <p class="why-sub">India ke creators, marketers aur small businesses ke liye banaya — dollar pricing nahi, rupee
          pricing.</p>

        <div class="why-grid">
          <div class="why-card">
            <div class="why-icon">💸</div>
            <h3>₹99/month mein Pro</h3>
            <p>Bitly ka Pro plan ₹2,900/month hai. Humara sirf ₹99 — wahi unlimited links, wahi analytics.</p>
          </div>
          <div class="why-card">
            <div class="why-icon">🇮🇳</div>
            <h3>India-first tool</h3>
            <p>UPI se payment, rupee pricing, Hindi support — koi foreign card ki zaroorat nahi.</p>
          </div>
          <div class="why-card">
            <div class="why-icon">📊</div>
            <h3>Real-time analytics</h3>
            <p>Har click track hota hai — country, city, device, browser, referrer sab kuch ek jagah.</p>
          </div>
          <div class="why-card">
            <div class="why-icon">🔗</div>
            <h3>Custom short URLs</h3>
            <p>snap.link/tumhara-naam — apni marzi ka alias banao. Brand recall instantly badhta hai.</p>
          </div>
          <div class="why-card">
            <div class="why-icon">🔒</div>
            <h3>Password protection</h3>
            <p>Links ko password se protect karo — sirf sahi log access kar sakein.</p>
          </div>
          <div class="why-card">
            <div class="why-icon">⏰</div>
            <h3>Link expiry date</h3>
            <p>Ek date ke baad link automatically expire ho jaata hai — limited time offers ke liye perfect.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="how-section">
      <div class="how-inner">
        <div class="section-badge">✦ Itna aasaan</div>
        <h2 class="how-title">3 steps mein <span class="accent">done</span></h2>
        <div class="steps-row">
          <div class="step-card">
            <div class="step-num">01</div>
            <h3>URL paste karo</h3>
            <p>Apna lamba URL home page pe paste karo</p>
          </div>
          <div class="step-arrow">→</div>
          <div class="step-card">
            <div class="step-num">02</div>
            <h3>Snap karo</h3>
            <p>1 click mein clean short link ready</p>
          </div>
          <div class="step-arrow">→</div>
          <div class="step-card">
            <div class="step-num">03</div>
            <h3>Share & Track</h3>
            <p>Link share karo, har click real-time track hota hai</p>
          </div>
        </div>
      </div>
    </section>

    <!-- COMPETITOR COMPARISON -->
    <section class="compare-section">
      <div class="compare-inner">
        <div class="section-badge">💰 Price comparison</div>
        <h2 class="compare-title">Doosron se <span class="accent">compare karo</span></h2>
        <div class="compare-table-wrap">
          <table class="compare-table">
            <thead>
