<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SnapLink - Free URL Shortener for Fast, Branded Links</title>
  <meta name="description" content="Create clean short links, branded aliases, QR codes, and conversion-ready analytics with SnapLink. Built for creators, marketers, and growing teams." />
  <meta name="keywords" content="url shortener, branded links, short links, QR code, analytics, custom alias, white label, india link shortener" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://snaplink.fun/" />

  <meta property="og:title" content="SnapLink - Free URL Shortener" />
  <meta property="og:description" content="Create fast branded links, track every click, and launch short URLs that look professional." />
  <meta property="og:url" content="https://snaplink.fun/" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://snaplink.fun/favicon.png" />
  <meta property="og:site_name" content="SnapLink" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="SnapLink - Free URL Shortener" />
  <meta name="twitter:description" content="Shorten links, track clicks, and launch branded URLs with a clean dashboard." />
  <meta name="twitter:image" content="https://snaplink.fun/favicon.png" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "SnapLink",
    "url": "https://snaplink.fun",
    "description": "Fast link shortening platform for branded links, analytics, and QR codes.",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://snaplink.fun/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/pages/home.css">
  <link rel="stylesheet" href="/css/pages/home-landing.css">
  <script src="/js/shared/theme.js"></script>
</head>
<body class="home-page">
  <% const isLoggedIn = typeof user !== 'undefined' && user; %>
  <% const isFree = isLoggedIn && user.plan === 'free'; %>
  <% const userPlan = isLoggedIn ? String(user.plan || 'free').toUpperCase() : 'FREE'; %>

  <nav class="navbar home-navbar">
    <a href="/" class="nav-logo">
      <span class="logo-dot"></span>
      Snap<em>Link</em>
    </a>

    <div class="nav-center">
      <a href="/tools" class="nav-link">Tools</a>
      <a href="/features" class="nav-link">Features</a>
      <a href="/pricing" class="nav-link">Pricing</a>
      <a href="/about" class="nav-link">About</a>
    </div>

    <div class="nav-right">
      <button class="theme-btn" id="themeBtn" onclick="toggleTheme()">Moon</button>
      <% if (isLoggedIn) { %>
        <div class="nav-user">
          <div class="nav-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
          <span class="nav-username"><%= user.name %></span>
        </div>
        <a href="/dashboard" class="nav-link">Dashboard</a>
        <a href="/logout" class="nav-btn-outline">Logout</a>
      <% } else { %>
        <a href="/login" class="nav-link">Login</a>
        <a href="/signup" class="nav-btn-solid">Get Started</a>
      <% } %>
    </div>
  </nav>

  <main class="home-main">
    <section class="hero-shell">
      <div class="hero-copy">
        <div class="hero-chip">Fast links. Branded look. Real analytics.</div>
        <h1 class="hero-title">Turn every long URL into a sharper <span>growth asset</span>.</h1>
        <p class="hero-subtitle">
          SnapLink helps creators, marketers, and teams launch short links that look clean,
          convert better, and stay trackable from first click to final campaign report.
        </p>

        <div class="hero-points">
          <div class="hero-point">
            <span class="hero-point-kicker">Custom</span>
            <p>Aliases, password locks, expiry, QR code, and white-label support in one workflow.</p>
          </div>
          <div class="hero-point">
            <span class="hero-point-kicker">Built to scale</span>
            <p>Redis-backed redirects, buffered click logging, and business-ready API access.</p>
          </div>
        </div>

        <div class="hero-actions">
          <% if (isLoggedIn) { %>
            <a href="/dashboard" class="hero-btn-primary">Open Dashboard</a>
          <% } else { %>
            <a href="/signup" class="hero-btn-primary">Create Free Account</a>
          <% } %>
          <a href="/pricing" class="hero-btn-secondary">See Pricing</a>
        </div>

        <div class="hero-proof">
          <span>10 free links every month</span>
          <span>Pro at Rs 99 per month</span>
          <span>Business white-label ready</span>
        </div>
      </div>

      <div class="hero-panel">
        <div class="panel-header">
          <div>
            <p class="panel-label">Launch a new link</p>
            <h2>Command center</h2>
          </div>
          <span class="plan-pill"><%= userPlan %></span>
        </div>

        <% if (error) { %>
          <div class="alert error">
            <strong>Issue:</strong>
            <span><%= error %></span>
          </div>
        <% } %>

        <form action="/shorten" method="POST" class="launch-form">
          <label class="field-group field-group-wide">
            <span class="field-label">Long URL</span>
            <input type="url" name="orginalUrl" placeholder="https://example.com/really-long-campaign-url" required class="field-input field-input-lg" />
          </label>

          <% if (isLoggedIn) { %>
            <label class="field-group field-group-wide field-group-alias">
              <span class="field-label">Custom alias</span>
              <input type="text" name="customAlias" placeholder="brand-campaign" class="field-input" <%= isFree ? 'disabled' : '' %> />
              <% if (isFree) { %>
                <a href="/pricing" class="inline-upgrade">Unlock in Pro</a>
              <% } %>
            </label>
          <% } %>

          <% if (isLoggedIn) { %>
            <div class="advanced-card">
              <button type="button" class="advanced-toggle" onclick="toggleAdSettings()" id="adToggleBtn">
                <span>Ad interstitial settings</span>
                <svg id="adChevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </button>

              <div class="advanced-panel" id="adSettingsPanel">
                <label class="switch-row">
                  <div>
                    <span class="field-label">Enable ad page</span>
                    <p class="field-help">Show a timed interstitial page before opening the destination.</p>
                  </div>
                  <div class="switch-wrap">
                    <input type="checkbox" name="adEnabled" id="adEnabled" value="on" onchange="toggleAdFields(this)">
                    <span class="switch-track"></span>
                  </div>
                </label>

                <div class="advanced-fields" id="adFields">
                  <div class="timer-row">
                    <span class="field-label">Timer</span>
                    <div class="timer-options">
                      <label><input type="radio" name="adTimer" value="5" checked><span>5s</span></label>
                      <label><input type="radio" name="adTimer" value="10"><span>10s</span></label>
                      <label><input type="radio" name="adTimer" value="15"><span>15s</span></label>
                      <label><input type="radio" name="adTimer" value="30"><span>30s</span></label>
                    </div>
                  </div>

                  <label class="field-group field-group-wide">
                    <span class="field-label">Ad title</span>
                    <input type="text" name="adTitle" id="adTitle" class="field-input" placeholder="For example: Check this partner offer" maxlength="80">
                  </label>

                  <label class="field-group field-group-wide">
                    <span class="field-label">Ad description</span>
                    <input type="text" name="adDescription" id="adDescription" class="field-input" placeholder="Short supporting line for the ad page" maxlength="160">
                  </label>

                  <label class="switch-row compact">
                    <div>
                      <span class="field-label">Allow skip</span>
                      <p class="field-help">Let users continue before the timer fully ends.</p>
                    </div>
                    <div class="switch-wrap">
                      <input type="checkbox" name="adSkipable" value="on" checked>
                      <span class="switch-track"></span>
                    </div>
                  </label>
                </div>
              </div>
            </div>
          <% } %>

          <button type="submit" class="launch-button">
            <span>Snap URL</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </button>
        </form>

        <% if (shortUrl) { %>
          <div class="alert success">
            <div>
              <strong>Short link ready</strong>
              <a href="<%= shortUrl %>" target="_blank" class="result-link" id="resultUrl"><%= shortUrl %></a>
            </div>
            <button class="copy-btn" onclick="copyUrl('<%= shortUrl %>', this)">Copy</button>
          </div>
        <% } %>

        <div class="panel-footer-metrics">
          <div>
            <span>Analytics</span>
            <strong>Real-time</strong>
          </div>
          <div>
            <span>QR export</span>
            <strong>Included</strong>
          </div>
          <div>
            <span>API access</span>
            <strong>Pro+</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="signal-band">
      <div class="signal-card">
        <span class="signal-kicker">For creators</span>
        <strong>Launch memorable profile, bio, and campaign links.</strong>
      </div>
      <div class="signal-card">
        <span class="signal-kicker">For marketers</span>
        <strong>Track clicks, geo, devices, and referrers without extra tools.</strong>
      </div>
      <div class="signal-card">
        <span class="signal-kicker">For teams</span>
        <strong>Use white-label domains, reports, API keys, and business workflows.</strong>
      </div>
    </section>

    <section class="story-grid">
      <article class="story-card story-featured">
        <p class="section-kicker">Why teams switch</p>
        <h2>Clean links are only the start. SnapLink is the operating layer behind them.</h2>
        <p>
          Instead of juggling one tool for shortening, another for analytics, and a third for branded
          campaigns, SnapLink keeps the entire flow in one dashboard.
        </p>
        <ul class="story-list">
          <li>Custom aliases that stay on-brand</li>
          <li>Click insights that help campaigns improve faster</li>
          <li>White-label setup for agencies and businesses</li>
        </ul>
      </article>

      <article class="story-card">
        <p class="section-kicker">Built for action</p>
        <h3>Fast launch flow</h3>
        <p>Paste a long URL, add optional controls, and publish a polished short link in seconds.</p>
      </article>

      <article class="story-card">
        <p class="section-kicker">Smart controls</p>
        <h3>Protected when needed</h3>
        <p>Use password locks, expiry rules, ad pages, and business domains where the campaign needs more control.</p>
      </article>

      <article class="story-card">
        <p class="section-kicker">Clear visibility</p>
        <h3>One analytics view</h3>
        <p>Country, city, device, browser, referrer, and top-link snapshots all stay easy to read.</p>
      </article>
    </section>

    <section class="stack-section">
      <div class="section-heading">
        <p class="section-kicker">Product stack</p>
        <h2>Everything you need to ship, share, and optimize links.</h2>
      </div>

      <div class="stack-grid">
        <article class="stack-card">
          <span class="stack-index">01</span>
          <h3>Branded short URLs</h3>
          <p>Create memorable aliases that feel like part of the campaign, not an afterthought.</p>
        </article>
        <article class="stack-card">
          <span class="stack-index">02</span>
          <h3>QR and download flow</h3>
          <p>Generate a share-ready QR code instantly for offline print, packaging, and events.</p>
        </article>
        <article class="stack-card">
          <span class="stack-index">03</span>
          <h3>Detailed analytics</h3>
          <p>See what is working across geography, devices, timing, and referral channels.</p>
        </article>
        <article class="stack-card">
          <span class="stack-index">04</span>
          <h3>Bulk and API access</h3>
          <p>Scale link operations when you need more than one-off manual creation.</p>
        </article>
        <article class="stack-card">
          <span class="stack-index">05</span>
          <h3>White-label delivery</h3>
          <p>Use your own brand domain and business identity for a more premium customer experience.</p>
        </article>
        <article class="stack-card">
          <span class="stack-index">06</span>
          <h3>Affiliate and wallet workflows</h3>
          <p>Keep monetization features, reporting, and campaign operations close to the link data.</p>
        </article>
      </div>
    </section>

    <section class="affiliate-showcase">
      <div class="section-heading">
        <p class="section-kicker">Affiliate growth</p>
        <h2>Bring affiliate campaigns, wallet earnings, and payout visibility into the same product.</h2>
      </div>

      <div class="affiliate-grid">
        <article class="stack-card">
          <span class="stack-index">01</span>
          <h3>Affiliate dashboards</h3>
          <p>Track referred clicks, campaign activity, and performance snapshots without moving to a separate system.</p>
        </article>
        <article class="stack-card">
          <span class="stack-index">02</span>
          <h3>Wallet and payout flow</h3>
          <p>Keep earnings, payout requests, and account-level wallet history visible for creators, partners, and operators.</p>
        </article>
        <article class="stack-card">
          <span class="stack-index">03</span>
          <h3>Referral-ready landing flow</h3>
          <p>Turn link sharing into a monetizable channel with affiliate onboarding and business-ready reporting.</p>
        </article>
      </div>

      <div class="affiliate-cta-card">
        <div>
          <p class="section-kicker">Monetization layer</p>
          <h3>Affiliate and wallet tools now sit inside SnapLink, not outside it.</h3>
          <p>Perfect for creators, agencies, and partner-led growth teams that want links and revenue workflows in one place.</p>
        </div>
        <div class="cta-actions">
          <% if (isLoggedIn) { %>
            <a href="/affiliate/dashboard" class="hero-btn-primary">Open Affiliate Dashboard</a>
          <% } else { %>
            <a href="/signup" class="hero-btn-primary">Create Affiliate Account</a>
          <% } %>
          <a href="/pricing" class="hero-btn-secondary">See Business Features</a>
        </div>
      </div>
    </section>

    <section class="comparison-panel">
      <div class="comparison-copy">
        <p class="section-kicker">Why it stands out</p>
        <h2>Made for India-first pricing, serious use, and clean UI.</h2>
        <p>
          SnapLink stays affordable enough for solo creators, but structured enough for businesses that
          need analytics, white-label, team workflows, and API-backed automation.
        </p>
      </div>

      <div class="comparison-matrix">
        <div class="matrix-row matrix-head">
          <span>Capability</span>
          <span>SnapLink</span>
        </div>
        <div class="matrix-row">
          <span>Free entry point</span>
          <strong>Yes, 10 links monthly</strong>
        </div>
        <div class="matrix-row">
          <span>Pro tier</span>
          <strong>Rs 99 per month</strong>
        </div>
        <div class="matrix-row">
          <span>Business setup</span>
          <strong>White-label plus reports</strong>
        </div>
        <div class="matrix-row">
          <span>Growth tooling</span>
          <strong>Analytics, API, QR, bulk</strong>
        </div>
      </div>
    </section>

    <section class="home-cta">
      <div class="home-cta-inner">
        <p class="section-kicker">Start now</p>
        <h2>Build your next short link in under a minute.</h2>
        <p>Start free, upgrade only when you need more volume, more control, or more branding power.</p>
        <div class="cta-actions">
          <% if (isLoggedIn) { %>
            <a href="/dashboard" class="hero-btn-primary">Go to Dashboard</a>
          <% } else { %>
            <a href="/signup" class="hero-btn-primary">Create Free Account</a>
          <% } %>
          <a href="/features" class="hero-btn-secondary">Explore Features</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer', { footerCopy: 'Turn long URLs into clean, branded, and trackable links that are easy to share.' }) %>

  <script>
    function copyUrl(url, btn) {
      navigator.clipboard.writeText(url).then(() => {
        btn.textContent = 'Copied';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('copied');
        }, 1800);
      });
    }

    function toggleAdSettings() {
      const panel = document.getElementById('adSettingsPanel');
      const chevron = document.getElementById('adChevron');
      const isOpen = panel.classList.toggle('open');
      chevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    }

    function toggleAdFields(checkbox) {
      document.getElementById('adFields').classList.toggle('is-active', checkbox.checked);
    }
  </script>
</body>
</html>

