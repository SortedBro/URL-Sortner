  <meta name="twitter:description"
    content="Short URL free tool — create short links, track clicks, generate QR codes. India's best Bitly alternative." />
  <meta name="twitter:image" content="https://snaplink.fun/images/url-short-snaplink-og.webp" />

  <!-- Schema.org WebSite + SoftwareApplication -->
