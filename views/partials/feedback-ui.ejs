<div class="feedback-modal-shell" id="feedbackConfirmModal" hidden>
  <div class="feedback-modal-backdrop" data-feedback-close></div>
  <div class="feedback-dialog" role="dialog" aria-modal="true" aria-labelledby="feedbackConfirmTitle"
    aria-describedby="feedbackConfirmMessage">
    <div class="feedback-dialog-badge">Confirm action</div>
    <h2 class="feedback-dialog-title" id="feedbackConfirmTitle">Are you sure?</h2>
    <p class="feedback-dialog-message" id="feedbackConfirmMessage">Please confirm to continue.</p>
    <div class="feedback-dialog-actions">
      <button class="feedback-btn feedback-btn--ghost" type="button" id="feedbackConfirmCancel">Cancel</button>
      <button class="feedback-btn feedback-btn--accent" type="button" id="feedbackConfirmAccept">Continue</button>
    </div>
  </div>
</div>

<div class="feedback-toast-stack" id="feedbackToastStack" aria-live="polite" aria-atomic="true"></div>
