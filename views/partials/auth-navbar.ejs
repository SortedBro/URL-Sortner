<%
const authNavbarClass = ['navbar', 'auth-navbar', typeof navbarClass !== 'undefined' ? navbarClass : ''].filter(Boolean).join(' ');
const helperHref = typeof helperLinkHref !== 'undefined' ? helperLinkHref : '/signup';
const helperLabel = typeof helperLinkLabel !== 'undefined' ? helperLinkLabel : 'Get Started';
const helperCopy = typeof helperCopyText !== 'undefined' ? helperCopyText : 'Need an account?';
%>
<nav class="<%= authNavbarClass %>" data-navbar-root>
  <a href="/" class="nav-logo" aria-label="SnapLink home">SnapLink</a>

  <button
    type="button"
    class="nav-toggle"
    aria-expanded="false"
    aria-label="Open navigation menu"
    onclick="toggleSnapLinkNav(this)">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <div class="nav-center auth-nav-links">
    <a href="/features" class="nav-link">Features</a>
    <a href="/pricing" class="nav-link">Pricing</a>
    <a href="/tools" class="nav-link">Tools</a>
    <a href="/features#analytics-engine" class="nav-link">Analytics</a>
    <a href="/pricing#enterprise" class="nav-link">Enterprise</a>
  </div>

  <div class="nav-right">
    <button type="button" id="themeBtnTop" class="nav-btn-outline nav-theme-toggle" onclick="toggleTheme()">Light mode</button>
    <span class="auth-helper-copy"><%= helperCopy %></span>
    <a href="<%= helperHref %>" class="nav-btn-solid auth-helper-link"><%= helperLabel %></a>
  </div>
</nav>
<script>
  function toggleSnapLinkNav(button) {
    const nav = button.closest('[data-navbar-root]');
    if (!nav) return;
    const isOpen = nav.classList.toggle('is-open');
    button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  }

  document.addEventListener('click', (event) => {
    document.querySelectorAll('[data-navbar-root].is-open').forEach((nav) => {
      if (nav.contains(event.target)) return;
      nav.classList.remove('is-open');
      const toggle = nav.querySelector('.nav-toggle');
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('click', (event) => {
    const link = event.target.closest('[data-navbar-root] .nav-link, [data-navbar-root] .nav-btn-outline, [data-navbar-root] .nav-btn-solid');
    if (!link) return;
    const nav = link.closest('[data-navbar-root]');
    if (!nav) return;
    nav.classList.remove('is-open');
    const toggle = nav.querySelector('.nav-toggle');
    if (toggle) toggle.setAttribute('aria-expanded', 'false');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll('[data-navbar-root].is-open').forEach((nav) => {
      nav.classList.remove('is-open');
      const toggle = nav.querySelector('.nav-toggle');
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
    });
  });
</script>
