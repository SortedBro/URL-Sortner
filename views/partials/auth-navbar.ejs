<%
const authNavbarClass = ['navbar', 'auth-navbar', typeof navbarClass !== 'undefined' ? navbarClass : ''].filter(Boolean).join(' ');
const helperHref = typeof helperLinkHref !== 'undefined' ? helperLinkHref : '/signup';
const helperLabel = typeof helperLinkLabel !== 'undefined' ? helperLinkLabel : 'Create account';
const helperCopy = typeof helperCopyText !== 'undefined' ? helperCopyText : 'New here?';
%>
<nav class="<%= authNavbarClass %>">
  <a href="/" class="nav-logo">
    <span class="logo-dot"></span>
    Snap<em>Link</em>
  </a>

  <div class="nav-center auth-nav-links">
    <a href="/features" class="nav-link">Features</a>
    <a href="/pricing" class="nav-link">Pricing</a>
    <a href="/about" class="nav-link">About</a>
  </div>

  <div class="nav-right">
    <button class="theme-btn" id="themeBtn" type="button" onclick="toggleTheme()">Theme</button>
    <a href="<%= helperHref %>" class="nav-link auth-helper-link"><%= helperCopy %> <strong><%= helperLabel %></strong></a>
  </div>
</nav>
