<%
const authNavbarClass = ['navbar', 'auth-navbar', typeof navbarClass !== 'undefined' ? navbarClass : ''].filter(Boolean).join(' ');
const helperHref = typeof helperLinkHref !== 'undefined' ? helperLinkHref : '/signup';
const helperLabel = typeof helperLinkLabel !== 'undefined' ? helperLinkLabel : 'Get Started';
const helperCopy = typeof helperCopyText !== 'undefined' ? helperCopyText : 'Need an account?';
%>
<nav class="<%= authNavbarClass %>">
  <a href="/" class="nav-logo" aria-label="SnapLink home">SnapLink</a>

  <div class="nav-center auth-nav-links">
    <a href="/features" class="nav-link">Features</a>
    <a href="/pricing" class="nav-link">Pricing</a>
    <a href="/features#analytics-engine" class="nav-link">Analytics</a>
    <a href="/pricing#enterprise" class="nav-link">Enterprise</a>
  </div>

  <div class="nav-right">
    <span class="auth-helper-copy"><%= helperCopy %></span>
    <a href="<%= helperHref %>" class="nav-btn-solid auth-helper-link"><%= helperLabel %></a>
  </div>
</nav>
