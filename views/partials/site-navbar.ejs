<%
const activePage = typeof currentPage !== 'undefined' ? currentPage : '';
const navbarClassName = ['navbar', typeof navbarClass !== 'undefined' ? navbarClass : 'site-navbar'].filter(Boolean).join(' ');
const navLinks = [
  { key: 'features', href: '/features', label: 'Features' },
  { key: 'pricing', href: '/pricing', label: 'Pricing' },
  { key: 'tools', href: '/tools', label: 'Tools' },
  { key: 'analytics', href: '/features#analytics-engine', label: 'Analytics' },
  { key: 'enterprise', href: '/pricing#enterprise', label: 'Enterprise' },
];
const displayUserName = typeof user !== 'undefined' && user
  ? (user.name || [user.firstName, user.lastName].filter(Boolean).join(' ').trim() || user.email || 'User')
  : 'User';
const displayUserShortName = displayUserName.split(/\s+/)[0];
const displayUserInitial = displayUserName.charAt(0).toUpperCase();
%>
<nav class="<%= navbarClassName %>" data-navbar-root>
  <a href="/" class="nav-logo" aria-label="SnapLink home">
    SnapLink
  </a>

  <button
    type="button"
    class="nav-toggle"
    aria-expanded="false"
    aria-label="Open navigation menu"
    onclick="toggleSnapLinkNav(this)">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <div class="nav-center">
    <% navLinks.forEach((link) => { %>
      <a href="<%= link.href %>" class="nav-link <%= activePage === link.key ? 'is-active' : '' %>"><%= link.label %></a>
    <% }) %>
  </div>

  <div class="nav-right">
    <button type="button" id="themeBtnTop" class="nav-btn-outline nav-theme-toggle" onclick="toggleTheme()">Light mode</button>
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/affiliate/wallet" class="nav-link">Wallet</a>
      <div class="nav-user" title="<%= displayUserName %>">
        <div class="nav-avatar"><%= displayUserInitial %></div>
        <span class="nav-username"><%= displayUserShortName %></span>
      </div>
      <a href="/logout" class="nav-btn-outline">Logout</a>
    <% } else { %>
      <a href="/login" class="nav-link">Sign In</a>
      <a href="/signup" class="nav-btn-solid">Get Started</a>
    <% } %>
  </div>
</nav>
<script>
  function toggleSnapLinkNav(button) {
    const nav = button.closest('[data-navbar-root]');
    if (!nav) return;
    const isOpen = nav.classList.toggle('is-open');
    button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  }

  document.addEventListener('click', (event) => {
    document.querySelectorAll('[data-navbar-root].is-open').forEach((nav) => {
      if (nav.contains(event.target)) return;
      nav.classList.remove('is-open');
      const toggle = nav.querySelector('.nav-toggle');
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('click', (event) => {
    const link = event.target.closest('[data-navbar-root] .nav-link, [data-navbar-root] .nav-btn-outline, [data-navbar-root] .nav-btn-solid');
    if (!link) return;
    const nav = link.closest('[data-navbar-root]');
    if (!nav) return;
    nav.classList.remove('is-open');
    const toggle = nav.querySelector('.nav-toggle');
    if (toggle) toggle.setAttribute('aria-expanded', 'false');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll('[data-navbar-root].is-open').forEach((nav) => {
      nav.classList.remove('is-open');
      const toggle = nav.querySelector('.nav-toggle');
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
    });
  });
</script>
