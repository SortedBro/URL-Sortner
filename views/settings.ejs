<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: 'Settings | SnapLink',
      description: 'Control account, API, white-label, wallet, and business settings for your SnapLink workspace.',
      path: '/settings',
      robots: 'noindex, nofollow',
      stylesheets: ["/css/pages/site-shell.css","/css/pages/generated/settings.inline.css","/css/pages/settings-features.css","/css/pages/app-shell.css"]
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
</head>
<body class="app-shell-page">
<%
  const isFreePlan = user.plan === 'free';
  const isProPlan = user.plan === 'pro';
  const isBusinessPlan = user.plan === 'business';
  const planLabel = isFreePlan ? 'FREE' : isProPlan ? 'PRO' : 'BUSINESS';
  const apiKeyPlainTextValue = typeof apiKeyPlainText !== 'undefined' ? apiKeyPlainText : '';
  const teamMembers = user.teamWorkspace && Array.isArray(user.teamWorkspace.members)
    ? user.teamWorkspace.members
    : [];
  const teamSeatLimit = user.capabilities ? user.capabilities.teamSeatLimit : 0;
  const userDisplayName = user ? (user.name || [user.firstName, user.lastName].filter(Boolean).join(' ').trim() || user.email || 'User') : 'User';
  const userDisplayShortName = userDisplayName.split(/\s+/)[0];
  const userDisplayInitial = userDisplayName.charAt(0).toUpperCase();
  const formatDateTime = (value) => value ? new Date(value).toLocaleString('en-IN', {
    dateStyle: 'medium',
    timeStyle: 'short'
  }) : 'Never';
%>

<aside class="sidebar">
  <a class="sidebar-logo" href="/">
    <span class="dot"></span>Snap<em>Link</em>
  </a>

  <div class="sidebar-section">Main</div>
  <a class="nav-item" href="/dashboard">Dashboard</a>
  <a class="nav-item" href="/dashboard">My Links</a>

  <div class="sidebar-sep"></div>
  <div class="sidebar-section">Manage</div>
  <a class="nav-item" href="/analytics">Analytics</a>
  <a class="nav-item" href="/qr-codes">QR Codes</a>
  <a class="nav-item active" href="/settings">Settings</a>

  <div class="sidebar-sep"></div>
  <div class="sidebar-section">Growth</div>
  <a class="nav-item" href="/affiliate/dashboard">Affiliate</a>
  <a class="nav-item" href="/affiliate/wallet">Wallet</a>
  <a class="nav-item" href="/brand/campaigns">Brand</a>

  <div class="sidebar-bottom">
    <div class="theme-row">
      <span>Theme</span>
      <button class="theme-toggle" id="themeBtn" onclick="toggleTheme()">Theme</button>
    </div>

    <div class="plan-card">
      <div class="plan-card-top">
        <div class="plan-avatar"><%= userDisplayInitial %></div>
        <div>
          <div class="plan-username"><%= userDisplayShortName %></div>
          <div class="plan-label"><%= planLabel %> PLAN</div>
        </div>
      </div>
      <% if (isFreePlan) { %>
        <a href="/pricing" class="upgrade-btn">Upgrade to Pro</a>
      <% } %>
    </div>

    <a href="/logout" class="logout-link">Logout</a>
  </div>
</aside>

<div class="settings-shell">
  <header class="topbar">
    <div>
      <h1>Settings</h1>
      <p>Account, API access, white-label, aur business controls ek jagah.</p>
    </div>
    <div class="topbar-right">
      <button class="theme-toggle" id="themeBtnTop" onclick="toggleTheme()">Theme</button>
      <a href="/pricing" class="topbar-btn">Pricing</a>
      <a href="/dashboard" class="topbar-btn">Dashboard</a>
      <a href="/logout" class="topbar-btn">Logout</a>
    </div>
  </header>

  <main class="main settings-main">
    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <section class="plan-info-card">
      <div class="plan-info-left">
        <h3>Current Plan</h3>
        <p>Pricing page pe jo features dikh rahe hain, unka live control yahan milta hai.</p>
      </div>
      <div class="plan-actions">
        <span class="plan-badge"><%= planLabel %></span>
        <a href="/pricing" class="btn-manage"><%= isFreePlan ? 'Upgrade' : 'Manage plan' %></a>
      </div>
    </section>

    <section class="settings-card">
      <div class="card-header">
        <h2>Profile</h2>
        <p>Basic account details update karo.</p>
      </div>
      <form action="/settings/profile" method="POST">
        <div class="card-body">
          <div class="form-row">
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" name="name" class="form-input" value="<%= userDisplayName %>" required />
            </div>
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" name="email" class="form-input" value="<%= user.email %>" required />
            </div>
          </div>
          <button type="submit" class="save-btn">Save Changes</button>
        </div>
      </form>
    </section>

    <section class="settings-card">
      <div class="card-header">
        <h2>Change Password</h2>
        <p>Account security ko strong rakho.</p>
      </div>
      <form action="/settings/password" method="POST">
        <div class="card-body">
          <div class="form-group">
            <label>Current Password</label>
            <input type="password" name="currentPassword" class="form-input" placeholder="Current password" required />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>New Password</label>
              <input type="password" name="newPassword" class="form-input" placeholder="Minimum 6 characters" required />
            </div>
            <div class="form-group">
              <label>Confirm New Password</label>
              <input type="password" name="confirmPassword" class="form-input" placeholder="Repeat password" required />
            </div>
          </div>
          <button type="submit" class="save-btn">Update Password</button>
        </div>
      </form>
    </section>

    <section class="settings-card">
      <div class="card-header">
        <h2>API Access</h2>
        <p>External apps aur automation ke liye production API key manage karo.</p>
      </div>
      <div class="card-body">
        <% if (!user.capabilities.apiAccess) { %>
          <p class="card-note">API access Pro aur Business plans ke liye reserved hai.</p>
          <a href="/pricing" class="btn-manage">Upgrade for API Access</a>
        <% } else { %>
          <div class="feature-status-row">
            <span class="inline-badge <%= user.apiAccess.enabled ? 'is-live' : 'is-muted' %>">
              <%= user.apiAccess.enabled ? 'Active key' : 'No active key' %>
            </span>
            <% if (user.apiAccess.keyPreview) { %>
              <span class="status-meta">Preview: <code><%= user.apiAccess.keyPreview %></code></span>
            <% } %>
          </div>

          <% if (apiKeyPlainTextValue) { %>
            <div class="secret-panel">
              <div class="secret-panel-head">Copy this API key now. Security reasons ke liye yeh sirf ek baar show hoti hai.</div>
              <code><%= apiKeyPlainTextValue %></code>
            </div>
          <% } %>

          <div class="support-grid compact-grid">
            <div class="support-item">
              <span class="support-label">Last rotated</span>
              <strong><%= formatDateTime(user.apiAccess.lastRotatedAt) %></strong>
            </div>
            <div class="support-item">
              <span class="support-label">Last used</span>
              <strong><%= formatDateTime(user.apiAccess.lastUsedAt) %></strong>
            </div>
          </div>

          <div class="card-actions">
            <form action="/settings/api-access/rotate" method="POST">
              <button type="submit" class="save-btn">Generate New API Key</button>
            </form>
            <% if (user.apiAccess.enabled) { %>
              <form action="/settings/api-access/disable" method="POST">
                <button type="submit" class="secondary-btn">Disable API Access</button>
              </form>
            <% } %>
          </div>

          <div class="api-snippet">
            <div class="secret-panel-head">Quick start</div>
            <pre><code>curl -X GET <%= '/api/v1/urls' %> \
  -H "x-api-key: YOUR_API_KEY"</code></pre>
          </div>
        <% } %>
      </div>
    </section>

    <section class="settings-card">
      <div class="card-header">
        <h2>Webhook Delivery</h2>
        <p>Link create, click, aur delete events ko apne system tak bhejo.</p>
      </div>
      <div class="card-body">
        <% if (!user.capabilities.businessFeatures) { %>
          <p class="card-note">Webhook support Business plan me included hai.</p>
          <a href="/pricing" class="btn-manage">Upgrade to Business</a>
        <% } else { %>
          <form action="/settings/webhooks" method="POST">
            <div class="form-group checkbox-row">
              <label class="checkbox-label">
                <input type="checkbox" name="enabled" <%= user.webhookSettings.enabled ? 'checked' : '' %> />
                Enable outbound webhooks
              </label>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label>Endpoint URL</label>
                <input type="url" name="endpointUrl" class="form-input" placeholder="https://app.example.com/webhooks/snaplink" value="<%= user.webhookSettings.endpointUrl %>" />
              </div>
              <div class="form-group">
                <label>Signing Secret</label>
                <input type="text" name="signingSecret" class="form-input" placeholder="Auto-generated if left blank" value="<%= user.webhookSettings.signingSecret %>" />
              </div>
            </div>

            <div class="form-group">
              <label>Events</label>
              <div class="checkbox-grid">
                <% webhookEvents.forEach((eventName) => { %>
                  <label class="checkbox-pill">
                    <input
                      type="checkbox"
                      name="events"
                      value="<%= eventName %>"
                      <%= user.webhookSettings.events.includes(eventName) ? 'checked' : '' %>
                    />
                    <span><%= eventName %></span>
                  </label>
                <% }) %>
              </div>
            </div>

            <div class="support-grid compact-grid">
              <div class="support-item">
                <span class="support-label">Last delivery</span>
                <strong><%= formatDateTime(user.webhookSettings.lastTriggeredAt) %></strong>
              </div>
              <div class="support-item">
                <span class="support-label">Last status</span>
                <strong><%= user.webhookSettings.lastStatus || 'never' %></strong>
              </div>
            </div>

            <button type="submit" class="save-btn">Save Webhook Settings</button>
          </form>
        <% } %>
      </div>
    </section>

    <section class="settings-card">
      <div class="card-header">
        <h2>Weekly Email Reports</h2>
        <p>Business plan ke weekly analytics summaries directly inbox me bhejo.</p>
      </div>
      <div class="card-body">
        <% if (!user.capabilities.businessFeatures) { %>
          <p class="card-note">Weekly reports Business plan me available hain.</p>
          <a href="/pricing" class="btn-manage">Upgrade to Business</a>
        <% } else { %>
          <form action="/settings/reports/weekly" method="POST">
            <div class="form-group checkbox-row">
              <label class="checkbox-label">
                <input type="checkbox" name="enabled" <%= user.weeklyReportSettings.enabled ? 'checked' : '' %> />
                Enable weekly summary emails
              </label>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Recipient Email</label>
                <input type="email" name="recipientEmail" class="form-input" value="<%= user.weeklyReportSettings.recipientEmail %>" required />
              </div>
              <div class="form-group">
                <label>Send On</label>
                <select name="weekday" class="form-input">
                  <% weekdayOptions.forEach((weekday) => { %>
                    <option value="<%= weekday %>" <%= user.weeklyReportSettings.weekday === weekday ? 'selected' : '' %>>
                      <%= weekday.charAt(0).toUpperCase() + weekday.slice(1) %>
                    </option>
                  <% }) %>
                </select>
              </div>
            </div>
            <div class="card-actions">
              <button type="submit" class="save-btn">Save Weekly Report Settings</button>
            </div>
          </form>

          <div class="support-grid compact-grid top-gap">
            <div class="support-item">
              <span class="support-label">Last sent</span>
              <strong><%= formatDateTime(user.weeklyReportSettings.lastSentAt) %></strong>
            </div>
            <div class="support-item support-item-action">
              <span class="support-label">Manual trigger</span>
              <form action="/settings/reports/weekly/send-now" method="POST">
                <button type="submit" class="secondary-btn">Send Report Now</button>
              </form>
            </div>
          </div>
        <% } %>
      </div>
    </section>

    <section class="settings-card">
      <div class="card-header">
        <h2>Team Workspace</h2>
        <p>Business plan me up to 5 members ke saath workspace manage karo.</p>
      </div>
      <div class="card-body">
        <% if (!user.capabilities.businessFeatures) { %>
          <p class="card-note">Team workspace Business plan feature hai.</p>
          <a href="/pricing" class="btn-manage">Upgrade to Business</a>
        <% } else { %>
          <div class="team-summary">
            <strong><%= teamMembers.length %>/<%= teamSeatLimit %></strong>
            <span>Seats in use</span>
          </div>

          <form action="/settings/team/invite" method="POST">
            <div class="form-row form-row-three">
              <div class="form-group">
                <label>Name</label>
                <input type="text" name="name" class="form-input" placeholder="Optional display name" />
              </div>
              <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" class="form-input" placeholder="member@company.com" required />
              </div>
              <div class="form-group">
                <label>Role</label>
                <select name="role" class="form-input">
                  <option value="member">Member</option>
                  <option value="manager">Manager</option>
                </select>
              </div>
            </div>
            <button type="submit" class="save-btn">Add Team Member</button>
          </form>

          <% if (teamMembers.length) { %>
            <div class="member-list">
              <% teamMembers.forEach((member) => { %>
                <div class="member-item">
                  <div class="member-meta">
                    <strong><%= member.name || member.email.split('@')[0] %></strong>
                    <span><%= member.email %></span>
                  </div>
                  <div class="member-meta member-meta-right">
                    <span class="member-status <%= member.status === 'active' ? 'active' : 'invited' %>"><%= member.status %></span>
                    <span class="status-meta"><%= member.role %></span>
                    <form action="/settings/team/remove" method="POST">
                      <input type="hidden" name="email" value="<%= member.email %>" />
                      <button type="submit" class="secondary-btn">Remove</button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="card-note">Abhi tak koi team member added nahi hai.</p>
          <% } %>
        <% } %>
      </div>
    </section>

    <section class="settings-card">
      <div class="card-header">
        <h2>White Label</h2>
        <p>Apna custom domain aur branding yahan manage karo.</p>
      </div>
      <div class="card-body">
        <% if (!isBusinessPlan) { %>
          <p class="card-note">White-label sirf Business plan me available hai.</p>
          <a href="/pricing" class="btn-manage">Upgrade to Business</a>
        <% } else { %>
          <form action="/settings/white-label" method="POST">
            <div class="form-group checkbox-row">
              <label class="checkbox-label">
                <input type="checkbox" name="enabled" <%= user.whiteLabel.enabled ? 'checked' : '' %> />
                Enable branded short links
              </label>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Custom Domain</label>
                <input type="text" name="customDomain" class="form-input" placeholder="links.yourbrand.com" value="<%= user.whiteLabel.customDomain %>" />
              </div>
              <div class="form-group">
                <label>Brand Name</label>
                <input type="text" name="brandName" class="form-input" placeholder="Your Brand" value="<%= user.whiteLabel.brandName %>" />
              </div>
            </div>
            <div class="form-group">
              <label>Logo URL</label>
              <input type="url" name="logoUrl" class="form-input" placeholder="https://example.com/logo.png" value="<%= user.whiteLabel.logoUrl %>" />
            </div>
            <button type="submit" class="save-btn">Save White Label Settings</button>
          </form>
        <% } %>
      </div>
    </section>

    <section class="settings-card">
      <div class="card-header">
        <h2>Priority Support</h2>
        <p>Business customers ke liye fast response aur operational SLA visibility.</p>
      </div>
      <div class="card-body">
        <% if (isBusinessPlan) { %>
          <div class="support-grid">
            <div class="support-item">
              <span class="support-label">Support channel</span>
              <strong>priority@snaplink.fun</strong>
            </div>
            <div class="support-item">
              <span class="support-label">SLA window</span>
              <strong>Initial response within 1 business day</strong>
            </div>
          </div>
          <p class="card-note">Use this channel for white-label setup, billing help, migration, and urgent business issues.</p>
          <a class="btn-manage" href="mailto:priority@snaplink.fun?subject=SnapLink%20Priority%20Support">Open Priority Support</a>
        <% } else { %>
          <p class="card-note">Priority support aur SLA guarantee Business plan ke saath unlock hoti hai.</p>
          <a href="/pricing" class="btn-manage">Upgrade to Business</a>
        <% } %>
      </div>
    </section>

    <section class="danger-card">
      <div>
        <h3>Account Closure</h3>
        <p>Permanent deletion request ke liye verified email se support ko contact karo.</p>
      </div>
      <div class="danger-actions">
        <a class="btn-danger" href="mailto:support@snaplink.fun?subject=SnapLink%20Account%20Closure%20Request">Request Account Closure</a>
      </div>
    </section>
  </main>
</div>

<script src="/js/shared/theme.js"></script>
</body>
</html>
