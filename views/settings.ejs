<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Settings — SnapLink</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="icon" type="image/png" href="/favicon.png"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:#0d0d0b; --bg2:#141412; --bg3:#1c1c19; --bg4:#242420; --bg5:#2c2c28;
      --accent:#f5c842; --accent2:#d4a520;
      --text:#edeae2; --text2:#918e87; --text3:#55524e;
      --border:#242420; --border2:#2e2e2a;
      --green:#4ade80; --red:#f87171; --blue:#60a5fa;
      --radius:10px; --radius2:14px; --sidebar:220px;
    }
    [data-theme="light"] {
      --bg:#f5f4f0; --bg2:#ffffff; --bg3:#f0ede8; --bg4:#e8e5e0; --bg5:#dedad4;
      --text:#1a1916; --text2:#6b6862; --text3:#a09d98;
      --border:#e0ddd8; --border2:#d0cdc8;
    }
    body { background:var(--bg); color:var(--text); font-family:'Space Grotesk',sans-serif; min-height:100vh; display:grid; grid-template-columns:var(--sidebar) 1fr; }

    /* SIDEBAR */
    .sidebar { background:var(--bg2); border-right:1px solid var(--border); display:flex; flex-direction:column; padding:20px 14px; position:sticky; top:0; height:100vh; overflow-y:auto; }
    .sidebar-logo { display:flex; align-items:center; gap:8px; padding:4px 10px 22px; font-size:16px; font-weight:700; color:var(--text); text-decoration:none; }
    .sidebar-logo .dot { width:8px; height:8px; background:var(--accent); border-radius:50%; }
    .sidebar-logo em { color:var(--accent); font-style:normal; }
    .sidebar-section { font-size:9px; font-weight:600; letter-spacing:.1em; color:var(--text3); font-family:'DM Mono',monospace; text-transform:uppercase; padding:0 10px; margin:14px 0 6px; }
    .nav-item { display:flex; align-items:center; gap:9px; padding:9px 10px; border-radius:var(--radius); font-size:13px; font-weight:500; color:var(--text2); cursor:pointer; border:none; background:none; width:100%; text-align:left; text-decoration:none; transition:all .15s; }
    .nav-item:hover { background:var(--bg3); color:var(--text); }
    .nav-item.active { background:var(--bg4); color:var(--text); border:1px solid var(--border2); }
    .nav-item svg { opacity:.6; flex-shrink:0; }
    .nav-item.active svg { opacity:1; }
    .sidebar-sep { height:1px; background:var(--border); margin:10px 0; }
    .sidebar-bottom { margin-top:auto; display:flex; flex-direction:column; gap:8px; }
    .theme-row { display:flex; align-items:center; justify-content:space-between; padding:8px 10px; border-radius:var(--radius); background:var(--bg3); border:1px solid var(--border); font-size:12px; color:var(--text2); }
    .theme-toggle { background:var(--bg4); border:1px solid var(--border2); border-radius:99px; padding:3px 8px; font-size:12px; cursor:pointer; color:var(--text); }
    .plan-card { background:var(--bg3); border:1px solid var(--border2); border-radius:var(--radius2); padding:14px; }
    .plan-card-top { display:flex; align-items:center; gap:8px; margin-bottom:10px; }
    .plan-avatar { width:30px; height:30px; border-radius:50%; background:var(--accent); color:#1a1400; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; flex-shrink:0; }
    .plan-username { font-size:13px; font-weight:600; color:var(--text); }
    .plan-label { font-size:10px; color:var(--accent); font-family:'DM Mono',monospace; font-weight:600; letter-spacing:.05em; }
    .upgrade-btn { background:var(--accent); color:#1a1400; font-size:11px; font-weight:700; padding:8px 0; border-radius:8px; border:none; cursor:pointer; width:100%; font-family:'Space Grotesk',sans-serif; text-decoration:none; display:block; text-align:center; }
    .logout-link { display:block; text-align:center; font-size:11px; color:var(--text3); text-decoration:none; padding:6px; }
    .logout-link:hover { color:var(--red); }

    /* TOPBAR */
    .topbar { background:var(--bg2); border-bottom:1px solid var(--border); padding:14px 28px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:10; }
    .topbar h1 { font-size:17px; font-weight:700; }
    .topbar p { font-size:11px; color:var(--text3); margin-top:1px; }
    .topbar-right { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .topbar-btn { text-decoration:none; font-size:11px; font-weight:600; color:var(--text2); border:1px solid var(--border2); border-radius:8px; padding:6px 10px; }
    .topbar-btn:hover { color:var(--text); border-color:var(--accent); }

    /* MAIN */
    .main { padding:24px 28px; display:flex; flex-direction:column; gap:20px; max-width:680px; }

    /* CARDS */
    .settings-card { background:var(--bg2); border:1px solid var(--border); border-radius:var(--radius2); overflow:hidden; }
    .card-header { padding:18px 22px 16px; border-bottom:1px solid var(--border); }
    .card-header h2 { font-size:14px; font-weight:700; margin-bottom:2px; }
    .card-header p { font-size:12px; color:var(--text2); }
    .card-body { padding:20px 22px; display:flex; flex-direction:column; gap:16px; }

    /* FORM */
    .form-group { display:flex; flex-direction:column; gap:6px; }
    .form-group label { font-size:12px; font-weight:600; color:var(--text2); }
    .form-input { background:var(--bg3); border:1px solid var(--border2); border-radius:var(--radius); padding:10px 14px; color:var(--text); font-size:13px; font-family:'Space Grotesk',sans-serif; outline:none; transition:border-color .15s; width:100%; }
    .form-input:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(245,200,66,.08); }
    .form-input::placeholder { color:var(--text3); }
    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .save-btn { align-self:flex-start; background:var(--accent); color:#1a1400; border:none; padding:10px 22px; border-radius:var(--radius); font-size:13px; font-weight:700; cursor:pointer; font-family:'Space Grotesk',sans-serif; transition:background .15s; }
    .save-btn:hover { background:var(--accent2); }

    /* ALERTS */
    .alert { padding:10px 14px; border-radius:var(--radius); font-size:12px; margin:0 22px 0; }
    .alert-success { background:rgba(74,222,128,.08); border:1px solid rgba(74,222,128,.2); color:var(--green); }
    .alert-error { background:rgba(248,113,113,.08); border:1px solid rgba(248,113,113,.2); color:var(--red); }

    /* DANGER ZONE */
    .danger-card { background:rgba(248,113,113,.04); border:1px solid rgba(248,113,113,.15); border-radius:var(--radius2); padding:20px 22px; display:flex; align-items:center; justify-content:space-between; gap:16px; }
    .danger-card h3 { font-size:13px; font-weight:700; color:var(--red); margin-bottom:3px; }
    .danger-card p { font-size:12px; color:var(--text2); }
    .btn-danger { background:transparent; border:1px solid rgba(248,113,113,.4); color:var(--red); padding:9px 18px; border-radius:var(--radius); font-size:12px; font-weight:600; cursor:pointer; font-family:'Space Grotesk',sans-serif; white-space:nowrap; flex-shrink:0; }
    .btn-danger:hover { background:rgba(248,113,113,.1); }

    /* PLAN INFO */
    .plan-info-card { background:var(--bg2); border:1px solid var(--border); border-radius:var(--radius2); padding:20px 22px; display:flex; align-items:center; justify-content:space-between; gap:16px; }
    .plan-info-left h3 { font-size:14px; font-weight:700; margin-bottom:4px; }
    .plan-info-left p { font-size:12px; color:var(--text2); }
    .plan-badge { display:inline-flex; align-items:center; gap:5px; background:rgba(245,200,66,.1); color:var(--accent); border:1px solid rgba(245,200,66,.2); padding:5px 12px; border-radius:99px; font-size:12px; font-weight:700; font-family:'DM Mono',monospace; }
    .btn-manage { background:var(--bg3); border:1px solid var(--border2); color:var(--text2); padding:9px 18px; border-radius:var(--radius); font-size:12px; font-weight:600; cursor:pointer; font-family:'Space Grotesk',sans-serif; text-decoration:none; display:inline-block; }

    @media (max-width:900px) {
      body { grid-template-columns:1fr; }
      .sidebar { display:none; }
      .form-row { grid-template-columns:1fr; }
      .topbar { padding:12px 14px; }
      .main { padding:16px 14px; }
      .plan-info-card { flex-direction:column; align-items:flex-start; }
      .danger-card { flex-direction:column; align-items:flex-start; }
    }
  </style>
</head>
<body>

<aside class="sidebar">
  <a class="sidebar-logo" href="/">
    <span class="dot"></span>Snap<em>Link</em>
  </a>
  <div class="sidebar-section">Main</div>
  <a class="nav-item" href="/dashboard">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
    Dashboard
  </a>
  <a class="nav-item" href="/dashboard">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
    My Links
  </a>
  <div class="sidebar-sep"></div>
  <div class="sidebar-section">Manage</div>
  <a class="nav-item" href="/qr-codes">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="5" height="5"/><rect x="16" y="3" width="5" height="5"/><rect x="3" y="16" width="5" height="5"/><path d="M21 16h-3v3M21 21h-1M16 16h1"/></svg>
    QR Codes
  </a>
  <a class="nav-item active" href="/settings">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
    Settings
  </a>
  <div class="sidebar-bottom">
    <div class="theme-row">
      <span>Theme</span>
      <button class="theme-toggle" id="themeBtn" onclick="toggleTheme()">🌙</button>
    </div>
    <div class="plan-card">
      <div class="plan-card-top">
        <div class="plan-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
        <div>
          <div class="plan-username"><%= user.name.split(' ')[0] %></div>
          <div class="plan-label"><%= user.plan === 'free' ? 'FREE PLAN' : user.plan === 'pro' ? '⭐ PRO' : '💎 BUSINESS' %></div>
        </div>
      </div>
      <% if (user.plan === 'free') { %>
        <a href="/pricing" class="upgrade-btn">⚡ Upgrade — ₹99/mo</a>
      <% } %>
    </div>
    <a href="/logout" class="logout-link">Logout</a>
  </div>
</aside>

<div style="display:flex;flex-direction:column;min-height:100vh">
  <header class="topbar">
    <div>
      <h1>Settings</h1>
      <p>Account aur security manage karo</p>
    </div>
    <div class="topbar-right">
      <button class="theme-toggle" id="themeBtnTop" onclick="toggleTheme()">Theme</button>
      <a href="/dashboard" class="topbar-btn">Dashboard</a>
      <a href="/logout" class="topbar-btn">Logout</a>
    </div>
  </header>

  <div class="main">

    <% if (success) { %>
      <div class="alert alert-success">✓ <%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error">⚠ <%= error %></div>
    <% } %>

    <!-- Plan Info -->
    <div class="plan-info-card">
      <div class="plan-info-left">
        <h3>Current Plan</h3>
        <p>Tumhara active subscription</p>
      </div>
      <div style="display:flex;align-items:center;gap:10px">
        <span class="plan-badge">
          <%= user.plan === 'free' ? 'FREE' : user.plan === 'pro' ? '⭐ PRO' : '💎 BUSINESS' %>
        </span>
        <% if (user.plan === 'free') { %>
          <a href="/pricing" class="btn-manage">Upgrade →</a>
        <% } else { %>
          <a href="/pricing" class="btn-manage">Manage</a>
        <% } %>
      </div>
    </div>

    <!-- Profile -->
    <div class="settings-card">
      <div class="card-header">
        <h2>Profile</h2>
        <p>Apna naam aur email update karo</p>
      </div>
      <form action="/settings/profile" method="POST">
        <div class="card-body">
          <div class="form-row">
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" name="name" class="form-input" value="<%= user.name %>" required/>
            </div>
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" name="email" class="form-input" value="<%= user.email %>" required/>
            </div>
          </div>
          <button type="submit" class="save-btn">Save Changes</button>
        </div>
      </form>
    </div>

    <!-- Password -->
    <div class="settings-card">
      <div class="card-header">
        <h2>Change Password</h2>
        <p>Strong password rakho account secure karne ke liye</p>
      </div>
      <form action="/settings/password" method="POST">
        <div class="card-body">
          <div class="form-group">
            <label>Current Password</label>
            <input type="password" name="currentPassword" class="form-input" placeholder="••••••••" required/>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>New Password</label>
              <input type="password" name="newPassword" class="form-input" placeholder="Min. 6 characters" required/>
            </div>
            <div class="form-group">
              <label>Confirm New Password</label>
              <input type="password" name="confirmPassword" class="form-input" placeholder="Repeat password" required/>
            </div>
          </div>
          <button type="submit" class="save-btn">Update Password</button>
        </div>
      </form>
    </div>

    <!-- White Label -->
    <div class="settings-card">
      <div class="card-header">
        <h2>White Label</h2>
        <p>Apna brand domain aur branding settings manage karo</p>
      </div>
      <% if (user.plan !== 'business') { %>
        <div class="card-body">
          <p style="font-size:12px;color:var(--text2)">White-label sirf Business plan me available hai.</p>
          <a href="/pricing" class="btn-manage">Upgrade to Business</a>
        </div>
      <% } else { %>
        <form action="/settings/white-label" method="POST">
          <div class="card-body">
            <div class="form-group">
              <label style="display:flex;align-items:center;gap:10px">
                <input type="checkbox" name="enabled" <%= user.whiteLabel && user.whiteLabel.enabled ? 'checked' : '' %> />
                Enable white-label links
              </label>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Custom Domain</label>
                <input type="text" name="customDomain" class="form-input" placeholder="links.yourbrand.com" value="<%= user.whiteLabel?.customDomain || '' %>"/>
              </div>
              <div class="form-group">
                <label>Brand Name</label>
                <input type="text" name="brandName" class="form-input" placeholder="Your Brand" value="<%= user.whiteLabel?.brandName || '' %>"/>
              </div>
            </div>
            <div class="form-group">
              <label>Logo URL (optional)</label>
              <input type="url" name="logoUrl" class="form-input" placeholder="https://example.com/logo.png" value="<%= user.whiteLabel?.logoUrl || '' %>"/>
            </div>
            <button type="submit" class="save-btn">Save White Label</button>
          </div>
        </form>
      <% } %>
    </div>

    <!-- Danger Zone -->
    <div class="danger-card">
      <div>
        <h3>Delete Account</h3>
        <p>Sab links aur data permanently delete ho jayega — wapas nahi aayega</p>
      </div>
      <button class="btn-danger" onclick="return confirm('Pakka delete karna hai? Yeh action undo nahi hoga.')">Delete Account</button>
    </div>

  </div>
</div>

<script>
const saved = localStorage.getItem('theme') || 'dark';
document.documentElement.setAttribute('data-theme', saved);
const sidebarThemeBtn = document.getElementById('themeBtn');
const topThemeBtn = document.getElementById('themeBtnTop');
if (sidebarThemeBtn) sidebarThemeBtn.textContent = saved === 'dark' ? '🌙' : '☀️';
if (topThemeBtn) topThemeBtn.textContent = saved === 'dark' ? '🌙' : '☀️';
function toggleTheme() {
  const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
  const next = isDark ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('theme', next);
  if (sidebarThemeBtn) sidebarThemeBtn.textContent = next === 'dark' ? '🌙' : '☀️';
  if (topThemeBtn) topThemeBtn.textContent = next === 'dark' ? '🌙' : '☀️';
}
</script>
</body>
</html>
