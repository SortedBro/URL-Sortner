<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Settings — SnapLink</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="icon" type="image/png" href="/favicon.png"/>
  <link rel="stylesheet" href="/css/pages/generated/settings.inline.css" />
</head>
<body>

<aside class="sidebar">
  <a class="sidebar-logo" href="/">
    <span class="dot"></span>Snap<em>Link</em>
  </a>
  <div class="sidebar-section">Main</div>
  <a class="nav-item" href="/dashboard">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
    Dashboard
  </a>
  <a class="nav-item" href="/dashboard">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
    My Links
  </a>
  <div class="sidebar-sep"></div>
  <div class="sidebar-section">Manage</div>
  <a class="nav-item" href="/qr-codes">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="5" height="5"/><rect x="16" y="3" width="5" height="5"/><rect x="3" y="16" width="5" height="5"/><path d="M21 16h-3v3M21 21h-1M16 16h1"/></svg>
    QR Codes
  </a>
  <a class="nav-item active" href="/settings">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
    Settings
  </a>
  <div class="sidebar-bottom">
    <div class="theme-row">
      <span>Theme</span>
      <button class="theme-toggle" id="themeBtn" onclick="toggleTheme()">🌙</button>
    </div>
    <div class="plan-card">
      <div class="plan-card-top">
        <div class="plan-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
        <div>
          <div class="plan-username"><%= user.name.split(' ')[0] %></div>
          <div class="plan-label"><%= user.plan === 'free' ? 'FREE PLAN' : user.plan === 'pro' ? '⭐ PRO' : '💎 BUSINESS' %></div>
        </div>
      </div>
      <% if (user.plan === 'free') { %>
        <a href="/pricing" class="upgrade-btn">⚡ Upgrade — ₹99/mo</a>
      <% } %>
    </div>
    <a href="/logout" class="logout-link">Logout</a>
  </div>
</aside>

<div style="display:flex;flex-direction:column;min-height:100vh">
  <header class="topbar">
    <div>
      <h1>Settings</h1>
      <p>Account aur security manage karo</p>
    </div>
    <div class="topbar-right">
      <button class="theme-toggle" id="themeBtnTop" onclick="toggleTheme()">Theme</button>
      <a href="/dashboard" class="topbar-btn">Dashboard</a>
      <a href="/logout" class="topbar-btn">Logout</a>
    </div>
  </header>

  <div class="main">

    <% if (success) { %>
      <div class="alert alert-success">✓ <%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error">⚠ <%= error %></div>
    <% } %>

    <!-- Plan Info -->
    <div class="plan-info-card">
      <div class="plan-info-left">
        <h3>Current Plan</h3>
        <p>Tumhara active subscription</p>
      </div>
      <div style="display:flex;align-items:center;gap:10px">
        <span class="plan-badge">
          <%= user.plan === 'free' ? 'FREE' : user.plan === 'pro' ? '⭐ PRO' : '💎 BUSINESS' %>
        </span>
        <% if (user.plan === 'free') { %>
          <a href="/pricing" class="btn-manage">Upgrade →</a>
        <% } else { %>
          <a href="/pricing" class="btn-manage">Manage</a>
        <% } %>
      </div>
    </div>

    <!-- Profile -->
    <div class="settings-card">
      <div class="card-header">
        <h2>Profile</h2>
        <p>Apna naam aur email update karo</p>
      </div>
      <form action="/settings/profile" method="POST">
        <div class="card-body">
          <div class="form-row">
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" name="name" class="form-input" value="<%= user.name %>" required/>
            </div>
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" name="email" class="form-input" value="<%= user.email %>" required/>
            </div>
          </div>
          <button type="submit" class="save-btn">Save Changes</button>
        </div>
      </form>
    </div>

    <!-- Password -->
    <div class="settings-card">
      <div class="card-header">
        <h2>Change Password</h2>
        <p>Strong password rakho account secure karne ke liye</p>
      </div>
      <form action="/settings/password" method="POST">
        <div class="card-body">
          <div class="form-group">
            <label>Current Password</label>
            <input type="password" name="currentPassword" class="form-input" placeholder="••••••••" required/>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>New Password</label>
              <input type="password" name="newPassword" class="form-input" placeholder="Min. 6 characters" required/>
            </div>
            <div class="form-group">
              <label>Confirm New Password</label>
              <input type="password" name="confirmPassword" class="form-input" placeholder="Repeat password" required/>
            </div>
          </div>
          <button type="submit" class="save-btn">Update Password</button>
        </div>
      </form>
    </div>

    <!-- White Label -->
    <div class="settings-card">
      <div class="card-header">
        <h2>White Label</h2>
        <p>Apna brand domain aur branding settings manage karo</p>
      </div>
      <% if (user.plan !== 'business') { %>
        <div class="card-body">
          <p style="font-size:12px;color:var(--text2)">White-label sirf Business plan me available hai.</p>
          <a href="/pricing" class="btn-manage">Upgrade to Business</a>
        </div>
      <% } else { %>
        <form action="/settings/white-label" method="POST">
          <div class="card-body">
            <div class="form-group">
              <label style="display:flex;align-items:center;gap:10px">
                <input type="checkbox" name="enabled" <%= user.whiteLabel && user.whiteLabel.enabled ? 'checked' : '' %> />
                Enable white-label links
              </label>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Custom Domain</label>
                <input type="text" name="customDomain" class="form-input" placeholder="links.yourbrand.com" value="<%= user.whiteLabel?.customDomain || '' %>"/>
              </div>
              <div class="form-group">
                <label>Brand Name</label>
                <input type="text" name="brandName" class="form-input" placeholder="Your Brand" value="<%= user.whiteLabel?.brandName || '' %>"/>
              </div>
            </div>
            <div class="form-group">
              <label>Logo URL (optional)</label>
              <input type="url" name="logoUrl" class="form-input" placeholder="https://example.com/logo.png" value="<%= user.whiteLabel?.logoUrl || '' %>"/>
            </div>
            <button type="submit" class="save-btn">Save White Label</button>
          </div>
        </form>
      <% } %>
    </div>

    <!-- Danger Zone -->
    <div class="danger-card">
      <div>
        <h3>Delete Account</h3>
        <p>Sab links aur data permanently delete ho jayega — wapas nahi aayega</p>
      </div>
      <button class="btn-danger" onclick="return confirm('Pakka delete karna hai? Yeh action undo nahi hoga.')">Delete Account</button>
    </div>

  </div>
</div>

<script src="/js/shared/theme.js"></script>
  <script>
</script>
</body>
</html>



