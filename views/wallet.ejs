<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wallet - SnapLink</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #070b12;
      --bg2: #0f1622;
      --bg3: #172131;
      --bg4: #223047;
      --border: rgba(52, 211, 153, 0.14);
      --border-strong: rgba(52, 211, 153, 0.28);
      --text: #e6f6ef;
      --text2: #9fb8ad;
      --muted: #58736b;
      --accent: #10b981;
      --accent2: #34d399;
      --danger: #f87171;
      --danger-bg: rgba(248, 113, 113, 0.12);
      --amber: #fbbf24;
      --amber-bg: rgba(251, 191, 36, 0.12);
      --blue: #60a5fa;
      --blue-bg: rgba(96, 165, 250, 0.12);
      --radius: 14px;
      --radius-sm: 10px;
    }

    [data-theme="light"] {
      --bg: #f2fbf6;
      --bg2: #ffffff;
      --bg3: #edf9f2;
      --bg4: #dff1e7;
      --border: rgba(5, 150, 105, 0.12);
      --border-strong: rgba(5, 150, 105, 0.24);
      --text: #0d2b22;
      --text2: #3e6558;
      --muted: #82a79a;
      --accent: #059669;
      --accent2: #10b981;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(var(--border) 1px, transparent 1px),
        linear-gradient(90deg, var(--border) 1px, transparent 1px);
      background-size: 42px 42px;
      opacity: 0.45;
      pointer-events: none;
      z-index: 0;
    }

    nav {
      position: sticky;
      top: 0;
      z-index: 20;
      height: 60px;
      background: color-mix(in srgb, var(--bg) 86%, transparent);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(14px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 0 18px;
    }

    .brand {
      text-decoration: none;
      color: var(--text);
      font-family: 'Syne', sans-serif;
      font-size: 1rem;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .brand-dot {
      width: 18px;
      height: 18px;
      border-radius: 6px;
      background: var(--accent);
      box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 40%, transparent);
    }

    .nav-actions {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .btn-nav {
      text-decoration: none;
      border: 1px solid var(--border-strong);
      color: var(--text2);
      background: transparent;
      font-size: 12px;
      font-weight: 600;
      border-radius: 8px;
      padding: 6px 12px;
      cursor: pointer;
      transition: all 0.18s ease;
    }

    .btn-nav:hover {
      color: var(--text);
      border-color: var(--accent2);
    }

    main {
      position: relative;
      z-index: 1;
      max-width: 1180px;
      margin: 0 auto;
      padding: 24px 16px 50px;
      display: grid;
      gap: 16px;
    }

    .hero {
      background: var(--bg2);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius);
      padding: 22px;
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 18px;
    }

    .eyebrow {
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent2);
      font-family: 'DM Mono', monospace;
      margin-bottom: 6px;
    }

    .hero h1 {
      font-family: 'Syne', sans-serif;
      font-size: clamp(1.8rem, 5vw, 2.8rem);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .balance-line {
      margin-top: 8px;
      font-size: 13px;
      color: var(--text2);
    }

    .hero-amount {
      margin-top: 10px;
      font-family: 'Syne', sans-serif;
      font-size: clamp(2rem, 6vw, 3rem);
      font-weight: 800;
      color: var(--accent2);
      line-height: 1;
    }

    .hero-stats {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      align-content: center;
    }

    .mini-stat {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 10px 12px;
    }

    .mini-stat-label {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-family: 'DM Mono', monospace;
      margin-bottom: 5px;
    }

    .mini-stat-value {
      font-size: 16px;
      font-family: 'DM Mono', monospace;
      color: var(--text);
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .stat-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px;
    }

    .stat-label {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-family: 'DM Mono', monospace;
      margin-bottom: 8px;
    }

    .stat-value {
      font-family: 'Syne', sans-serif;
      font-size: 1.8rem;
      line-height: 1;
    }

    .chart-card,
    .list-card,
    .statement-card,
    .withdraw-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
    }

    .card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .card-title {
      font-family: 'Syne', sans-serif;
      font-size: 1rem;
      font-weight: 700;
    }

    .card-sub {
      font-size: 12px;
      color: var(--muted);
      font-family: 'DM Mono', monospace;
    }

    .chart-wrap {
      min-height: 220px;
      display: flex;
      align-items: flex-end;
      gap: 10px;
      padding: 8px 6px 2px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: var(--bg3);
      overflow-x: auto;
    }

    .chart-col {
      min-width: 72px;
      display: grid;
      gap: 8px;
      justify-items: center;
    }

    .chart-bars {
      width: 100%;
      height: 150px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 6px;
    }

    .bar {
      width: 18px;
      border-radius: 8px 8px 4px 4px;
      min-height: 2px;
      transition: height 0.3s ease;
    }

    .bar.earned { background: var(--accent2); }
    .bar.paid { background: var(--blue); }

    .bar-label {
      font-size: 11px;
      color: var(--text2);
      font-family: 'DM Mono', monospace;
    }

    .bar-value {
      font-size: 10px;
      color: var(--muted);
      font-family: 'DM Mono', monospace;
      text-align: center;
      line-height: 1.3;
    }

    .chart-legend {
      margin-top: 10px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      font-size: 11px;
      color: var(--text2);
      font-family: 'DM Mono', monospace;
    }

    .dot {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 3px;
      margin-right: 6px;
    }

    .dot.earned { background: var(--accent2); }
    .dot.paid { background: var(--blue); }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .list-wrap {
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
    }

    .list-row {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: center;
      padding: 10px 12px;
      border-bottom: 1px solid var(--border);
    }

    .list-row:last-child { border-bottom: none; }
    .list-row:hover { background: var(--bg3); }

    .row-title {
      font-size: 13px;
      color: var(--text);
      font-weight: 600;
    }

    .row-sub {
      font-size: 11px;
      color: var(--muted);
      margin-top: 2px;
      font-family: 'DM Mono', monospace;
    }

    .row-amount {
      font-family: 'DM Mono', monospace;
      font-size: 13px;
      white-space: nowrap;
    }

    .pill {
      border-radius: 999px;
      padding: 2px 8px;
      font-size: 10px;
      font-family: 'DM Mono', monospace;
      margin-left: 6px;
    }

    .pill.pending {
      color: var(--amber);
      background: var(--amber-bg);
      border: 1px solid color-mix(in srgb, var(--amber) 35%, transparent);
    }

    .pill.paid {
      color: var(--accent2);
      background: color-mix(in srgb, var(--accent2) 15%, transparent);
      border: 1px solid color-mix(in srgb, var(--accent2) 35%, transparent);
    }

    .pill.approved {
      color: var(--blue);
      background: var(--blue-bg);
      border: 1px solid color-mix(in srgb, var(--blue) 35%, transparent);
    }

    .pill.rejected {
      color: var(--danger);
      background: var(--danger-bg);
      border: 1px solid color-mix(in srgb, var(--danger) 35%, transparent);
    }

    .statement-controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .month-select {
      border: 1px solid var(--border-strong);
      background: var(--bg3);
      color: var(--text);
      border-radius: 8px;
      font-size: 12px;
      padding: 7px 10px;
      font-family: 'DM Sans', sans-serif;
    }

    .btn-download {
      text-decoration: none;
      border: 1px solid var(--border-strong);
      color: var(--text2);
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      padding: 7px 10px;
    }

    .btn-download:hover {
      border-color: var(--accent2);
      color: var(--text);
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
      margin-bottom: 10px;
    }

    .summary-box {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 9px 10px;
      background: var(--bg3);
    }

    .summary-label {
      font-size: 10px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.07em;
      font-family: 'DM Mono', monospace;
      margin-bottom: 4px;
    }

    .summary-value {
      font-size: 13px;
      font-family: 'DM Mono', monospace;
      color: var(--text);
    }

    .table-wrap {
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: auto;
      max-height: 300px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 640px;
    }

    th, td {
      border-bottom: 1px solid var(--border);
      text-align: left;
      padding: 9px 10px;
      font-size: 12px;
      white-space: nowrap;
    }

    th {
      font-family: 'DM Mono', monospace;
      color: var(--muted);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      background: var(--bg3);
      position: sticky;
      top: 0;
    }

    tr:last-child td { border-bottom: none; }

    .amount-credit { color: var(--accent2); font-family: 'DM Mono', monospace; }
    .amount-debit { color: var(--danger); font-family: 'DM Mono', monospace; }
    .amount-neutral { color: var(--text2); font-family: 'DM Mono', monospace; }

    .empty {
      font-size: 12px;
      color: var(--muted);
      text-align: center;
      padding: 18px;
      font-family: 'DM Mono', monospace;
    }

    .withdraw-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .form-group { margin-bottom: 10px; }

    .label {
      display: block;
      font-size: 12px;
      margin-bottom: 5px;
      color: var(--text2);
      font-weight: 600;
    }

    .label span { color: var(--danger); }

    .input {
      width: 100%;
      border: 1px solid var(--border-strong);
      border-radius: 9px;
      background: var(--bg3);
      color: var(--text);
      padding: 10px 12px;
      font-size: 13px;
      outline: none;
    }

    .input:focus {
      border-color: var(--accent2);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent2) 20%, transparent);
    }

    .method-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 10px;
    }

    .method-tab {
      flex: 1;
      border: 1px solid var(--border-strong);
      border-radius: 9px;
      background: transparent;
      color: var(--text2);
      font-size: 13px;
      font-weight: 600;
      padding: 9px;
      cursor: pointer;
    }

    .method-tab.active {
      border-color: var(--accent2);
      background: color-mix(in srgb, var(--accent2) 16%, transparent);
      color: var(--text);
    }

    .btn-submit {
      width: 100%;
      border: none;
      border-radius: 10px;
      background: var(--accent);
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      padding: 11px;
      cursor: pointer;
      margin-top: 4px;
    }

    .btn-submit:hover { background: var(--accent2); }
    .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }

    .form-msg {
      margin-top: 8px;
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 12px;
      display: none;
    }

    .form-msg.show { display: block; }
    .form-msg.error { color: var(--danger); border: 1px solid color-mix(in srgb, var(--danger) 35%, transparent); background: var(--danger-bg); }
    .form-msg.success { color: var(--accent2); border: 1px solid color-mix(in srgb, var(--accent2) 35%, transparent); background: color-mix(in srgb, var(--accent2) 14%, transparent); }

    .withdraw-note {
      margin-top: 8px;
      color: var(--muted);
      font-size: 11px;
      font-family: 'DM Mono', monospace;
      text-align: center;
    }

    @media (max-width: 980px) {
      .hero { grid-template-columns: 1fr; }
      .stats-row { grid-template-columns: 1fr; }
      .two-col { grid-template-columns: 1fr; }
      .summary-grid { grid-template-columns: 1fr 1fr; }
      .withdraw-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 640px) {
      nav {
        height: auto;
        min-height: 60px;
        padding: 10px 12px;
        align-items: flex-start;
        flex-direction: column;
      }

      .nav-actions {
        width: 100%;
        justify-content: flex-start;
      }

      main { padding: 14px 10px 35px; }
      .hero { padding: 16px; }
      .summary-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <nav>
    <a class="brand" href="/">
      <span class="brand-dot"></span>
      SnapLink
    </a>
    <div class="nav-actions">
      <button class="btn-nav" onclick="toggleTheme()" id="theme-btn">Light</button>
      <a class="btn-nav" href="/a/dashboard">Affiliate</a>
      <a class="btn-nav" href="/logout">Logout</a>
    </div>
  </nav>

  <main>
    <section class="hero">
      <div>
        <div class="eyebrow">Affiliate Wallet</div>
        <h1>Available Balance</h1>
        <div class="hero-amount">Rs <%= Number(wallet.balance || 0).toFixed(2) %></div>
        <div class="balance-line">Statement month: <%= statementMonthLabel %></div>
      </div>
      <div class="hero-stats">
        <div class="mini-stat">
          <div class="mini-stat-label">Total Earned</div>
          <div class="mini-stat-value">Rs <%= Number(wallet.totalEarned || 0).toFixed(2) %></div>
        </div>
        <div class="mini-stat">
          <div class="mini-stat-label">Total Paid</div>
          <div class="mini-stat-value">Rs <%= Number(wallet.totalPaid || 0).toFixed(2) %></div>
        </div>
      </div>
    </section>

    <section class="stats-row">
      <div class="stat-card">
        <div class="stat-label">Earnings This Month</div>
        <div class="stat-value"><%= counters.earningsThisMonth %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Pending Payouts</div>
        <div class="stat-value"><%= counters.pendingPayouts %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Paid This Month</div>
        <div class="stat-value"><%= counters.paidThisMonth %></div>
      </div>
    </section>

    <section class="chart-card">
      <div class="card-head">
        <div>
          <div class="card-title">Monthly Wallet Chart</div>
          <div class="card-sub">Last 6 months earned vs paid</div>
        </div>
      </div>
      <div class="chart-wrap" id="monthly-chart"></div>
      <div class="chart-legend">
        <span><span class="dot earned"></span>Earned</span>
        <span><span class="dot paid"></span>Paid</span>
      </div>
    </section>

    <section class="two-col">
      <article class="list-card">
        <div class="card-head">
          <div class="card-title">Recent Earnings</div>
          <div class="card-sub"><%= earnings.length %> records</div>
        </div>
        <div class="list-wrap">
          <% if (earnings.length === 0) { %>
            <div class="empty">No earnings yet</div>
          <% } else { %>
            <% earnings.forEach((e) => { %>
              <div class="list-row">
                <div>
                  <div class="row-title"><%= e.campaign?.title || 'Unknown campaign' %></div>
                  <div class="row-sub"><%= new Date(e.earnedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: '2-digit' }) %></div>
                </div>
                <div class="row-amount">
                  +Rs <%= Number(e.amount || 0).toFixed(2) %>
                  <span class="pill <%= e.status === 'paid' ? 'paid' : 'pending' %>"><%= e.status %></span>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </article>

      <article class="list-card">
        <div class="card-head">
          <div class="card-title">Payout Requests</div>
          <div class="card-sub"><%= payouts.length %> records</div>
        </div>
        <div class="list-wrap">
          <% if (payouts.length === 0) { %>
            <div class="empty">No payouts yet</div>
          <% } else { %>
            <% payouts.forEach((p) => { %>
              <div class="list-row">
                <div>
                  <div class="row-title"><%= p.method === 'upi' ? 'UPI' : 'Bank' %></div>
                  <div class="row-sub">
                    <%= new Date(p.requestedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: '2-digit' }) %>
                  </div>
                </div>
                <div class="row-amount">
                  Rs <%= Number(p.amount || 0).toFixed(2) %>
                  <span class="pill <%= p.status %>"><%= p.status %></span>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </article>
    </section>

    <section class="statement-card">
      <div class="card-head">
        <div>
          <div class="card-title">Ledger Statement</div>
          <div class="card-sub"><%= statementMonthLabel %></div>
        </div>
        <div class="statement-controls">
          <select class="month-select" id="statement-month" onchange="changeStatementMonth(this.value)">
            <% monthOptions.forEach((option) => { %>
              <option value="<%= option.key %>" <%= option.key === statementMonth ? 'selected' : '' %>><%= option.label %></option>
            <% }) %>
          </select>
          <a class="btn-download" href="/wallet/statement?month=<%= statementMonth %>">Download CSV</a>
        </div>
      </div>

      <div class="summary-grid">
        <div class="summary-box">
          <div class="summary-label">Opening</div>
          <div class="summary-value">Rs <%= Number(statementSummary.opening || 0).toFixed(2) %></div>
        </div>
        <div class="summary-box">
          <div class="summary-label">Credits</div>
          <div class="summary-value">Rs <%= Number(statementSummary.credit || 0).toFixed(2) %></div>
        </div>
        <div class="summary-box">
          <div class="summary-label">Debits</div>
          <div class="summary-value">Rs <%= Number(statementSummary.debit || 0).toFixed(2) %></div>
        </div>
        <div class="summary-box">
          <div class="summary-label">Closing</div>
          <div class="summary-value">Rs <%= Number(statementSummary.closing || 0).toFixed(2) %></div>
        </div>
      </div>

      <div class="table-wrap">
        <% if (!statementRows || statementRows.length === 0) { %>
          <div class="empty">No ledger transactions in this month</div>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Amount</th>
                <th>Balance</th>
                <th>Note</th>
              </tr>
            </thead>
            <tbody>
              <% statementRows.forEach((row) => { %>
                <tr>
                  <td><%= new Date(row.date).toLocaleString('en-IN') %></td>
                  <td><%= row.type %></td>
                  <td>
                    <% if (row.direction === 'credit') { %>
                      <span class="amount-credit">+Rs <%= Number(row.amount || 0).toFixed(2) %></span>
                    <% } else if (row.direction === 'debit') { %>
                      <span class="amount-debit">-Rs <%= Number(row.amount || 0).toFixed(2) %></span>
                    <% } else { %>
                      <span class="amount-neutral">Rs <%= Number(row.amount || 0).toFixed(2) %></span>
                    <% } %>
                  </td>
                  <td class="amount-neutral">Rs <%= Number(row.balanceAfter || 0).toFixed(2) %></td>
                  <td><%= row.note || '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>

    <section class="withdraw-card">
      <div class="card-head">
        <div>
          <div class="card-title">Withdraw Request</div>
          <div class="card-sub">Minimum payout Rs 100</div>
        </div>
      </div>

      <div class="method-tabs">
        <button class="method-tab active" id="tab-upi" onclick="switchMethod('upi')">UPI</button>
        <button class="method-tab" id="tab-bank" onclick="switchMethod('bank')">Bank</button>
      </div>

      <div class="form-group">
        <label class="label">Amount <span>*</span></label>
        <input class="input" type="number" id="amount" min="100" max="<%= Number(wallet.balance || 0) %>" placeholder="Enter amount" />
      </div>

      <div id="upi-fields">
        <div class="form-group">
          <label class="label">UPI ID <span>*</span></label>
          <input class="input" type="text" id="upiId" placeholder="name@upi" />
        </div>
      </div>

      <div id="bank-fields" style="display:none;">
        <div class="form-group">
          <label class="label">Account Holder <span>*</span></label>
          <input class="input" type="text" id="bankName" placeholder="Full name" />
        </div>
        <div class="withdraw-grid">
          <div class="form-group">
            <label class="label">Account Number <span>*</span></label>
            <input class="input" type="text" id="accountNumber" placeholder="Account number" />
          </div>
          <div class="form-group">
            <label class="label">IFSC <span>*</span></label>
            <input class="input" type="text" id="ifsc" placeholder="ABCD0123456" />
          </div>
        </div>
      </div>

      <div class="form-msg error" id="withdraw-error"></div>
      <div class="form-msg success" id="withdraw-success"></div>

      <button class="btn-submit" id="withdraw-btn" onclick="submitWithdraw()">Request Withdrawal</button>
      <div class="withdraw-note">Balance available: Rs <%= Number(wallet.balance || 0).toFixed(2) %></div>
    </section>
  </main>

  <script>
    const monthlySeries = <%- JSON.stringify(monthlySeries || []) %>;
    const themeBtn = document.getElementById('theme-btn');

    function setTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      themeBtn.textContent = theme === 'dark' ? 'Light' : 'Dark';
      localStorage.setItem('snaplink-theme', theme);
    }

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      setTheme(current === 'dark' ? 'light' : 'dark');
    }

    setTheme(localStorage.getItem('snaplink-theme') || 'dark');

    function renderMonthlyChart() {
      const wrap = document.getElementById('monthly-chart');
      if (!monthlySeries.length) {
        wrap.innerHTML = '<div class="empty" style="width:100%;">No monthly data yet</div>';
        return;
      }

      const max = Math.max(
        ...monthlySeries.map((item) => Number(item.earned || 0)),
        ...monthlySeries.map((item) => Number(item.paid || 0)),
        1
      );

      wrap.innerHTML = monthlySeries
        .map((item) => {
          const earned = Number(item.earned || 0);
          const paid = Number(item.paid || 0);
          const earnedH = Math.max(2, Math.round((earned / max) * 140));
          const paidH = Math.max(2, Math.round((paid / max) * 140));
          return `
            <div class="chart-col">
              <div class="chart-bars">
                <div class="bar earned" style="height:${earnedH}px" title="Earned Rs ${earned.toFixed(2)}"></div>
                <div class="bar paid" style="height:${paidH}px" title="Paid Rs ${paid.toFixed(2)}"></div>
              </div>
              <div class="bar-label">${item.label}</div>
              <div class="bar-value">E ${earned.toFixed(0)} / P ${paid.toFixed(0)}</div>
            </div>
          `;
        })
        .join('');
    }

    renderMonthlyChart();

    function changeStatementMonth(monthKey) {
      const target = `/wallet?month=${encodeURIComponent(monthKey)}`;
      window.location.href = target;
    }

    let currentMethod = 'upi';
    function switchMethod(method) {
      currentMethod = method;
      document.getElementById('upi-fields').style.display = method === 'upi' ? 'block' : 'none';
      document.getElementById('bank-fields').style.display = method === 'bank' ? 'block' : 'none';
      document.getElementById('tab-upi').classList.toggle('active', method === 'upi');
      document.getElementById('tab-bank').classList.toggle('active', method === 'bank');
    }

    async function submitWithdraw() {
      const amount = Number(document.getElementById('amount').value);
      const errorBox = document.getElementById('withdraw-error');
      const successBox = document.getElementById('withdraw-success');
      const button = document.getElementById('withdraw-btn');

      errorBox.classList.remove('show');
      successBox.classList.remove('show');

      if (!amount || amount < 100) {
        errorBox.textContent = 'Minimum payout Rs 100 hai';
        errorBox.classList.add('show');
        return;
      }

      const payload = { amount, method: currentMethod };
      if (currentMethod === 'upi') {
        payload.upiId = document.getElementById('upiId').value.trim();
        if (!payload.upiId) {
          errorBox.textContent = 'UPI ID required hai';
          errorBox.classList.add('show');
          return;
        }
      } else {
        payload.name = document.getElementById('bankName').value.trim();
        payload.accountNumber = document.getElementById('accountNumber').value.trim();
        payload.ifsc = document.getElementById('ifsc').value.trim();
        if (!payload.name || !payload.accountNumber || !payload.ifsc) {
          errorBox.textContent = 'Saari bank details required hain';
          errorBox.classList.add('show');
          return;
        }
      }

      button.disabled = true;
      button.textContent = 'Submitting...';

      try {
        const response = await fetch('/payout/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await response.json();

        if (data.success) {
          successBox.textContent = `Payout request submitted: Rs ${amount.toFixed(2)}`;
          successBox.classList.add('show');
          setTimeout(() => window.location.reload(), 1500);
          return;
        }

        errorBox.textContent = data.error || 'Request failed';
        errorBox.classList.add('show');
      } catch (error) {
        errorBox.textContent = 'Server unreachable';
        errorBox.classList.add('show');
      } finally {
        button.disabled = false;
        button.textContent = 'Request Withdrawal';
      }
    }
  </script>
</body>
</html>
