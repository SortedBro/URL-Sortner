<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: 'Affiliate Wallet | SnapLink',
      description: 'Track earnings, payouts, and affiliate balance from your SnapLink wallet workspace.',
      path: '/affiliate/wallet',
      robots: 'noindex, nofollow',
      stylesheets: ["/css/pages/site-shell.css","/css/pages/generated/wallet.inline.css","/css/pages/app-shell.css"]
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
</head>
<body class="workspace-page">
  <nav class="workspace-nav">
    <a class="brand" href="/">
      <span class="brand-dot"></span>
      SnapLink
    </a>
    <div class="nav-actions">
      <button class="btn-nav" onclick="toggleTheme()" id="theme-btn">Theme</button>
      <a class="btn-nav" href="/affiliate/dashboard">Affiliate</a>
      <a class="btn-nav" href="/logout">Logout</a>
    </div>
  </nav>

  <main>
    <section class="hero">
      <div>
        <div class="eyebrow">Affiliate Wallet</div>
        <h1>Available Balance</h1>
        <div class="hero-amount">Rs <%= Number(wallet.balance || 0).toFixed(2) %></div>
        <div class="balance-line">Statement month: <%= statementMonthLabel %></div>
      </div>
      <div class="hero-stats">
        <div class="mini-stat">
          <div class="mini-stat-label">Total Earned</div>
          <div class="mini-stat-value">Rs <%= Number(wallet.totalEarned || 0).toFixed(2) %></div>
        </div>
        <div class="mini-stat">
          <div class="mini-stat-label">Total Paid</div>
          <div class="mini-stat-value">Rs <%= Number(wallet.totalPaid || 0).toFixed(2) %></div>
        </div>
      </div>
    </section>

    <section class="stats-row">
      <div class="stat-card">
        <div class="stat-label">Earnings This Month</div>
        <div class="stat-value"><%= counters.earningsThisMonth %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Pending Payouts</div>
        <div class="stat-value"><%= counters.pendingPayouts %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Paid This Month</div>
        <div class="stat-value"><%= counters.paidThisMonth %></div>
      </div>
    </section>

    <section class="chart-card">
      <div class="card-head">
        <div>
          <div class="card-title">Monthly Wallet Chart</div>
          <div class="card-sub">Last 6 months earned vs paid</div>
        </div>
      </div>
      <div class="chart-wrap" id="monthly-chart"></div>
      <div class="chart-legend">
        <span><span class="dot earned"></span>Earned</span>
        <span><span class="dot paid"></span>Paid</span>
      </div>
    </section>

    <section class="two-col">
      <article class="list-card">
        <div class="card-head">
          <div class="card-title">Recent Earnings</div>
          <div class="card-sub"><%= earnings.length %> records</div>
        </div>
        <div class="list-wrap">
          <% if (earnings.length === 0) { %>
            <div class="empty">No earnings yet</div>
          <% } else { %>
            <% earnings.forEach((e) => { %>
              <div class="list-row">
                <div>
                  <div class="row-title"><%= e.campaign?.title || 'Unknown campaign' %></div>
                  <div class="row-sub"><%= new Date(e.earnedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: '2-digit' }) %></div>
                </div>
                <div class="row-amount">
                  +Rs <%= Number(e.amount || 0).toFixed(2) %>
                  <span class="pill <%= e.status === 'paid' ? 'paid' : 'pending' %>"><%= e.status %></span>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </article>

      <article class="list-card">
        <div class="card-head">
          <div class="card-title">Payout Requests</div>
          <div class="card-sub"><%= payouts.length %> records</div>
        </div>
        <div class="list-wrap">
          <% if (payouts.length === 0) { %>
            <div class="empty">No payouts yet</div>
          <% } else { %>
            <% payouts.forEach((p) => { %>
              <div class="list-row">
                <div>
                  <div class="row-title"><%= p.method === 'upi' ? 'UPI' : 'Bank' %></div>
                  <div class="row-sub">
                    <%= new Date(p.requestedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: '2-digit' }) %>
                  </div>
                </div>
                <div class="row-amount">
                  Rs <%= Number(p.amount || 0).toFixed(2) %>
                  <span class="pill <%= p.status %>"><%= p.status %></span>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </article>
    </section>

    <section class="statement-card">
      <div class="card-head">
        <div>
          <div class="card-title">Ledger Statement</div>
          <div class="card-sub"><%= statementMonthLabel %></div>
        </div>
        <div class="statement-controls">
          <select class="month-select" id="statement-month" onchange="changeStatementMonth(this.value)">
            <% monthOptions.forEach((option) => { %>
              <option value="<%= option.key %>" <%= option.key === statementMonth ? 'selected' : '' %>><%= option.label %></option>
            <% }) %>
          </select>
          <a class="btn-download" href="/affiliate/wallet/statements?month=<%= statementMonth %>">Download CSV</a>
        </div>
      </div>

      <div class="summary-grid">
        <div class="summary-box">
          <div class="summary-label">Opening</div>
          <div class="summary-value">Rs <%= Number(statementSummary.opening || 0).toFixed(2) %></div>
        </div>
        <div class="summary-box">
          <div class="summary-label">Credits</div>
          <div class="summary-value">Rs <%= Number(statementSummary.credit || 0).toFixed(2) %></div>
        </div>
        <div class="summary-box">
          <div class="summary-label">Debits</div>
          <div class="summary-value">Rs <%= Number(statementSummary.debit || 0).toFixed(2) %></div>
        </div>
        <div class="summary-box">
          <div class="summary-label">Closing</div>
          <div class="summary-value">Rs <%= Number(statementSummary.closing || 0).toFixed(2) %></div>
        </div>
      </div>

      <div class="table-wrap">
        <% if (!statementRows || statementRows.length === 0) { %>
          <div class="empty">No ledger transactions in this month</div>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Amount</th>
                <th>Balance</th>
                <th>Note</th>
              </tr>
            </thead>
            <tbody>
              <% statementRows.forEach((row) => { %>
                <tr>
                  <td><%= new Date(row.date).toLocaleString('en-IN') %></td>
                  <td><%= row.type %></td>
                  <td>
                    <% if (row.direction === 'credit') { %>
                      <span class="amount-credit">+Rs <%= Number(row.amount || 0).toFixed(2) %></span>
                    <% } else if (row.direction === 'debit') { %>
                      <span class="amount-debit">-Rs <%= Number(row.amount || 0).toFixed(2) %></span>
                    <% } else { %>
                      <span class="amount-neutral">Rs <%= Number(row.amount || 0).toFixed(2) %></span>
                    <% } %>
                  </td>
                  <td class="amount-neutral">Rs <%= Number(row.balanceAfter || 0).toFixed(2) %></td>
                  <td><%= row.note || '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </section>

    <section class="withdraw-card">
      <div class="card-head">
        <div>
          <div class="card-title">Withdraw Request</div>
          <div class="card-sub">Minimum payout Rs 100</div>
        </div>
      </div>

      <div class="method-tabs">
        <button class="method-tab active" id="tab-upi" onclick="switchMethod('upi')">UPI</button>
        <button class="method-tab" id="tab-bank" onclick="switchMethod('bank')">Bank</button>
      </div>

      <div class="form-group">
        <label class="label">Amount <span>*</span></label>
        <input class="input" type="number" id="amount" min="100" max="<%= Number(wallet.balance || 0) %>" placeholder="Enter amount" />
      </div>

      <div id="upi-fields">
        <div class="form-group">
          <label class="label">UPI ID <span>*</span></label>
          <input class="input" type="text" id="upiId" placeholder="name@upi" />
        </div>
      </div>

      <div id="bank-fields" style="display:none;">
        <div class="form-group">
          <label class="label">Account Holder <span>*</span></label>
          <input class="input" type="text" id="bankName" placeholder="Full name" />
        </div>
        <div class="withdraw-grid">
          <div class="form-group">
            <label class="label">Account Number <span>*</span></label>
            <input class="input" type="text" id="accountNumber" placeholder="Account number" />
          </div>
          <div class="form-group">
            <label class="label">IFSC <span>*</span></label>
            <input class="input" type="text" id="ifsc" placeholder="ABCD0123456" />
          </div>
        </div>
      </div>

      <div class="form-msg error" id="withdraw-error"></div>
      <div class="form-msg success" id="withdraw-success"></div>

      <button class="btn-submit" id="withdraw-btn" onclick="submitWithdraw()">Request Withdrawal</button>
      <div class="withdraw-note">Balance available: Rs <%= Number(wallet.balance || 0).toFixed(2) %></div>
    </section>
  </main>

  <script>
    const monthlySeries = <%- JSON.stringify(monthlySeries || []) %>;
    const themeBtn = document.getElementById('theme-btn');

    function setTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      themeBtn.textContent = theme === 'dark' ? 'Light' : 'Dark';
      localStorage.setItem('snaplink-theme', theme);
    }

    function toggleTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      setTheme(current === 'dark' ? 'light' : 'dark');
    }

    setTheme(localStorage.getItem('snaplink-theme') || 'dark');

    function renderMonthlyChart() {
      const wrap = document.getElementById('monthly-chart');
      if (!monthlySeries.length) {
        wrap.innerHTML = '<div class="empty" style="width:100%;">No monthly data yet</div>';
        return;
      }

      const max = Math.max(
        ...monthlySeries.map((item) => Number(item.earned || 0)),
        ...monthlySeries.map((item) => Number(item.paid || 0)),
        1
      );

      wrap.innerHTML = monthlySeries
        .map((item) => {
          const earned = Number(item.earned || 0);
          const paid = Number(item.paid || 0);
          const earnedH = Math.max(2, Math.round((earned / max) * 140));
          const paidH = Math.max(2, Math.round((paid / max) * 140));
          return `
            <div class="chart-col">
              <div class="chart-bars">
                <div class="bar earned" style="height:${earnedH}px" title="Earned Rs ${earned.toFixed(2)}"></div>
                <div class="bar paid" style="height:${paidH}px" title="Paid Rs ${paid.toFixed(2)}"></div>
              </div>
              <div class="bar-label">${item.label}</div>
              <div class="bar-value">E ${earned.toFixed(0)} / P ${paid.toFixed(0)}</div>
            </div>
          `;
        })
        .join('');
    }

    renderMonthlyChart();

    function changeStatementMonth(monthKey) {
      const target = `/affiliate/wallet?month=${encodeURIComponent(monthKey)}`;
      window.location.href = target;
    }

    let currentMethod = 'upi';
    function switchMethod(method) {
      currentMethod = method;
      document.getElementById('upi-fields').style.display = method === 'upi' ? 'block' : 'none';
      document.getElementById('bank-fields').style.display = method === 'bank' ? 'block' : 'none';
      document.getElementById('tab-upi').classList.toggle('active', method === 'upi');
      document.getElementById('tab-bank').classList.toggle('active', method === 'bank');
    }

    async function submitWithdraw() {
      const amount = Number(document.getElementById('amount').value);
      const errorBox = document.getElementById('withdraw-error');
      const successBox = document.getElementById('withdraw-success');
      const button = document.getElementById('withdraw-btn');

      errorBox.classList.remove('show');
      successBox.classList.remove('show');

      if (!amount || amount < 100) {
        errorBox.textContent = 'Minimum payout Rs 100 hai';
        errorBox.classList.add('show');
        return;
      }

      const payload = { amount, method: currentMethod };
      if (currentMethod === 'upi') {
        payload.upiId = document.getElementById('upiId').value.trim();
        if (!payload.upiId) {
          errorBox.textContent = 'UPI ID required hai';
          errorBox.classList.add('show');
          return;
        }
      } else {
        payload.name = document.getElementById('bankName').value.trim();
        payload.accountNumber = document.getElementById('accountNumber').value.trim();
        payload.ifsc = document.getElementById('ifsc').value.trim();
        if (!payload.name || !payload.accountNumber || !payload.ifsc) {
          errorBox.textContent = 'Saari bank details required hain';
          errorBox.classList.add('show');
          return;
        }
      }

      button.disabled = true;
      button.textContent = 'Submitting...';

      try {
        const response = await fetch('/affiliate/payout-requests', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await response.json();

        if (data.success) {
          successBox.textContent = `Payout request submitted: Rs ${amount.toFixed(2)}`;
          successBox.classList.add('show');
          setTimeout(() => window.location.reload(), 1500);
          return;
        }

        errorBox.textContent = data.error || 'Request failed';
        errorBox.classList.add('show');
      } catch (error) {
        errorBox.textContent = 'Server unreachable';
        errorBox.classList.add('show');
      } finally {
        button.disabled = false;
        button.textContent = 'Request Withdrawal';
      }
    }
  </script>
</body>
</html>


