<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: 'Campaign Approvals | SnapLink Admin',
      description: 'Review, approve, or reject brand campaigns from the SnapLink admin workspace.',
      path: '/admin/campaigns',
      robots: 'noindex, nofollow',
      stylesheets: ["/css/pages/site-shell.css","/css/pages/generated/admin-panel.inline.css","/css/pages/app-shell.css"]
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
</head>
<body class="workspace-page">

<nav class="workspace-nav">
  <a class="nav-logo" href="/">
    <div class="logo-mark">ADM</div>
    SnapLink
  </a>
  <span class="admin-badge">Admin</span>
  <div class="nav-right">
    <a class="btn-nav" href="/dashboard">User Dashboard</a>
    <a class="btn-nav" href="/logout">Logout</a>
  </div>
</nav>

<main>

  <div class="hero">
    <div class="hero-eyebrow">Admin Control</div>
    <h1>Campaign <em>Approvals</em></h1>
    <p class="hero-sub">Brand campaigns approve ya reject karo — affiliates tabhi use kar sakte hain</p>
  </div>

  <div class="stats-bar">
    <div class="stat-tile">
      <span class="stat-label">Total</span>
      <span class="stat-val purple"><%= stats.total %></span>
    </div>
    <div class="stat-tile">
      <span class="stat-label">Pending Review</span>
      <span class="stat-val amber"><%= stats.pending %></span>
    </div>
    <div class="stat-tile">
      <span class="stat-label">Approved</span>
      <span class="stat-val green"><%= stats.approved %></span>
    </div>
    <div class="stat-tile">
      <span class="stat-label">Rejected</span>
      <span class="stat-val red"><%= stats.rejected %></span>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="filter-tabs">
    <button class="filter-tab active" data-filter="all" onclick="filterCards('all', this)">All</button>
    <button class="filter-tab pending" data-filter="pending" onclick="filterCards('pending', this)">Pending</button>
    <button class="filter-tab approved" data-filter="approved" onclick="filterCards('approved', this)">Approved</button>
    <button class="filter-tab rejected" data-filter="rejected" onclick="filterCards('rejected', this)">Rejected</button>
  </div>

  <!-- Campaigns List -->
  <div class="campaigns-list" id="campaigns-list">
    <% if (campaigns.length === 0) { %>
      <div class="empty-state">
        <span class="empty-glyph">MAIL</span>
        <h3>Koi campaign nahi hai abhi</h3>
        <p>Brands abhi tak koi campaign submit nahi ki</p>
      </div>
    <% } else { %>
      <% campaigns.forEach((c, i) => { %>
      <div class="campaign-card highlight-<%= c.status %>"
           data-status="<%= c.status %>"
           style="animation: fadeUp 0.35s <%= 0.05 + i * 0.04 %>s ease both; opacity:0">

        <div class="card-main">
          <div class="card-row1">
            <span class="card-title"><%= c.title %></span>
            <span class="badge <%= c.status %>">
              <%= c.status === 'pending' ? 'Pending' : c.status === 'approved' ? 'Approved' : 'Rejected' %>
            </span>
          </div>
          <div class="brand-info">
            Brand: <strong><%= c.brandName %></strong> &nbsp;·&nbsp; <%= c.brandEmail %>
            <% if (c.createdBy && c.createdBy.name) { %>
              &nbsp;·&nbsp; User: <%= c.createdBy.name %>
            <% } %>
          </div>
          <div class="card-desc"><%= c.description %></div>
          <div class="card-url">Target URL -> <%= c.targetUrl %></div>
          <div class="card-meta">
            <span class="meta-chip"><%= new Date(c.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'2-digit'}) %></span>
            <span class="meta-chip commission">
              <%= c.commissionType === 'percentage' ? c.commissionValue + '%' : '₹' + c.commissionValue %>
            </span>
            <% if (c.budget) { %><span class="meta-chip">Budget: ₹<%= c.budget %></span><% } %>
            <% if (c.refParam) { %><span class="meta-chip">?<%= c.refParam %></span><% } %>
          </div>
          <% if (c.adminNote) { %>
            <div class="admin-note-display <%= c.status === 'rejected' ? 'rejection' : '' %>">
              Note: "<%= c.adminNote %>"
            </div>
          <% } %>
        </div>

        <!-- Actions — sirf pending ke liye full actions, baki ke liye sirf note -->
        <div class="card-actions">
          <% if (c.status === 'pending') { %>
            <label class="note-label">Admin Note (optional)</label>
            <textarea class="note-area" id="note-<%= c._id %>" placeholder="Reason ya feedback..."></textarea>
            <form action="/admin/campaigns/<%= c._id %>/approve" method="POST" id="approve-<%= c._id %>">
              <input type="hidden" name="note" id="approve-note-<%= c._id %>"/>
              <button class="btn-approve" type="button" onclick="submitAction('approve', '<%= c._id %>')">Approve</button>
            </form>
            <form action="/admin/campaigns/<%= c._id %>/reject" method="POST" id="reject-<%= c._id %>">
              <input type="hidden" name="note" id="reject-note-<%= c._id %>"/>
              <button class="btn-reject" type="button" onclick="submitAction('reject', '<%= c._id %>')">Reject</button>
            </form>
          <% } else { %>
            <div style="font-size:0.75rem; color:var(--text3); text-align:center; padding-top:8px;">
              Already <%= c.status %>
            </div>
          <% } %>
        </div>

      </div>
      <% }) %>
    <% } %>
  </div>

</main>

<script>
  // Fill hidden note input then submit form
  function submitAction(action, id) {
    const note = document.getElementById('note-' + id).value.trim();
    document.getElementById(action + '-note-' + id).value = note;
    document.getElementById(action + '-' + id).submit();
  }

  // Filter by status
  function filterCards(status, btn) {
    document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.campaign-card').forEach(card => {
      if (status === 'all' || card.dataset.status === status) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }
</script>

</body>
</html>


