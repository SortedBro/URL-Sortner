<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Panel — SnapLink</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;500;600;700&family=Outfit:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg:           #07080f;
      --bg2:          #0d0f1a;
      --bg3:          #141728;
      --bg4:          #1b2038;
      --border:       rgba(239,68,68,0.08);
      --border2:      rgba(239,68,68,0.18);
      --accent:       #ef4444;
      --accent2:      #fca5a5;
      --accent-soft:  rgba(239,68,68,0.12);
      --green:        #34d399;
      --green-bg:     rgba(52,211,153,0.08);
      --red:          #f87171;
      --red-bg:       rgba(248,113,113,0.08);
      --amber:        #fbbf24;
      --amber-bg:     rgba(251,191,36,0.08);
      --purple:       #a78bfa;
      --text:         #eeeaf8;
      --text2:        #9d96c0;
      --text3:        #4d4870;
      --mono:         'JetBrains Mono', monospace;
      --display:      'Clash Display', sans-serif;
      --body:         'Outfit', sans-serif;
      --radius:       16px;
      --radius-sm:    10px;
      --radius-xs:    6px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--body); background: var(--bg); color: var(--text); min-height: 100vh; overflow-x: hidden; }
    body::after {
      content: ''; position: fixed; top: -200px; right: -200px; width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(239,68,68,0.08) 0%, transparent 65%);
      pointer-events: none; z-index: 0;
    }

    /* NAV */
    nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 2rem; height: 60px;
      background: rgba(7,8,15,0.9); backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(239,68,68,0.12);
    }
    .nav-logo { font-family: var(--display); font-size: 1.1rem; font-weight: 700; color: var(--text); text-decoration: none; display: flex; align-items: center; gap: 10px; }
    .logo-mark { width: 28px; height: 28px; background: var(--accent); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 13px; box-shadow: 0 0 20px rgba(239,68,68,0.4); }
    .admin-badge { font-family: var(--mono); font-size: 0.65rem; color: var(--accent2); background: var(--accent-soft); border: 1px solid rgba(239,68,68,0.2); border-radius: 20px; padding: 2px 10px; text-transform: uppercase; letter-spacing: 0.08em; }
    .nav-right { display: flex; gap: 8px; align-items: center; }
    .btn-nav { padding: 7px 16px; border-radius: var(--radius-sm); font-family: var(--body); font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s; border: 1px solid rgba(239,68,68,0.2); background: transparent; color: var(--text2); text-decoration: none; }
    .btn-nav:hover { color: var(--text); }

    /* MAIN */
    main { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem 6rem; }

    /* HERO */
    .hero { margin-bottom: 2rem; }
    .hero-eyebrow { font-family: var(--mono); font-size: 0.7rem; color: var(--accent2); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
    .hero-eyebrow::before { content: ''; display: inline-block; width: 20px; height: 1px; background: var(--accent2); }
    .hero h1 { font-family: var(--display); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 700; letter-spacing: -0.04em; }
    .hero h1 em { font-style: normal; color: var(--accent2); }
    .hero-sub { margin-top: 8px; color: var(--text2); font-size: 0.9rem; }

    /* STATS */
    .stats-bar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
    @media(max-width:700px){ .stats-bar { grid-template-columns: repeat(2,1fr); } }
    .stat-tile { background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.2rem 1.4rem; display: flex; flex-direction: column; gap: 6px; }
    .stat-label { font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text3); }
    .stat-val { font-family: var(--display); font-size: 2rem; font-weight: 700; color: var(--text); }
    .stat-val.red { color: var(--red); }
    .stat-val.amber { color: var(--amber); }
    .stat-val.green { color: var(--green); }
    .stat-val.purple { color: var(--purple); }

    /* FILTER TABS */
    .filter-tabs { display: flex; gap: 6px; margin-bottom: 1.5rem; padding: 4px; background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius-sm); width: fit-content; }
    .filter-tab { padding: 6px 18px; border-radius: 8px; font-size: 0.8rem; font-weight: 500; color: var(--text3); cursor: pointer; border: none; background: transparent; transition: all 0.15s; font-family: var(--body); }
    .filter-tab.active { background: var(--bg4); color: var(--text); }
    .filter-tab.pending.active { color: var(--amber); }
    .filter-tab.approved.active { color: var(--green); }
    .filter-tab.rejected.active { color: var(--red); }

    /* CAMPAIGNS TABLE */
    .campaigns-list { display: flex; flex-direction: column; gap: 0.75rem; }

    .campaign-card {
      background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 1.4rem 1.6rem; display: flex; align-items: flex-start; justify-content: space-between;
      gap: 1.5rem; transition: border-color 0.2s;
    }
    .campaign-card:hover { border-color: var(--border2); }
    .campaign-card.highlight-pending { border-left: 3px solid var(--amber); }
    .campaign-card.highlight-approved { border-left: 3px solid var(--green); }
    .campaign-card.highlight-rejected { border-left: 3px solid var(--red); }

    .card-main { flex: 1; min-width: 0; }
    .card-row1 { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
    .card-title { font-family: var(--display); font-size: 1rem; font-weight: 600; color: var(--text); }

    .badge { font-family: var(--mono); font-size: 0.65rem; padding: 3px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.06em; flex-shrink: 0; }
    .badge.pending  { background: var(--amber-bg); color: var(--amber); border: 1px solid rgba(251,191,36,0.2); }
    .badge.approved { background: var(--green-bg); color: var(--green); border: 1px solid rgba(52,211,153,0.2); }
    .badge.rejected { background: var(--red-bg); color: var(--red); border: 1px solid rgba(248,113,113,0.2); }

    .brand-info { font-size: 0.82rem; color: var(--text2); margin-bottom: 6px; }
    .brand-info strong { color: var(--text); }
    .card-desc { font-size: 0.82rem; color: var(--text3); line-height: 1.5; margin-bottom: 8px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .card-url { font-family: var(--mono); font-size: 0.72rem; color: var(--text3); margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card-meta { display: flex; gap: 8px; flex-wrap: wrap; }
    .meta-chip { font-family: var(--mono); font-size: 0.65rem; color: var(--text3); background: var(--bg3); border: 1px solid rgba(255,255,255,0.05); border-radius: 6px; padding: 2px 8px; }
    .meta-chip.commission { color: var(--green); background: var(--green-bg); }
    .admin-note-display { margin-top: 8px; font-size: 0.78rem; color: var(--text3); font-style: italic; }
    .admin-note-display.rejection { color: var(--red); }

    /* ACTION BUTTONS */
    .card-actions { display: flex; flex-direction: column; gap: 8px; flex-shrink: 0; min-width: 150px; }

    .btn-approve, .btn-reject {
      padding: 8px 16px; border-radius: var(--radius-xs); font-family: var(--body); font-size: 0.8rem; font-weight: 600;
      border: none; cursor: pointer; transition: all 0.2s; text-align: center; width: 100%;
    }
    .btn-approve { background: var(--green-bg); color: var(--green); border: 1px solid rgba(52,211,153,0.25); }
    .btn-approve:hover { background: rgba(52,211,153,0.18); }
    .btn-reject { background: var(--red-bg); color: var(--red); border: 1px solid rgba(248,113,113,0.25); }
    .btn-reject:hover { background: rgba(248,113,113,0.18); }

    /* NOTE INPUT */
    .note-area { width: 100%; background: var(--bg3); border: 1px solid rgba(255,255,255,0.07); border-radius: var(--radius-xs); padding: 7px 10px; color: var(--text); font-family: var(--body); font-size: 0.78rem; resize: none; outline: none; min-height: 60px; }
    .note-area:focus { border-color: rgba(239,68,68,0.3); }
    .note-label { font-size: 0.7rem; color: var(--text3); margin-bottom: 4px; display: block; }

    /* EMPTY */
    .empty-state { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 4rem 2rem; text-align: center; color: var(--text3); background: var(--bg2); border: 1px dashed var(--border2); border-radius: var(--radius); }
    .empty-glyph { font-size: 2.5rem; }
    .empty-state h3 { font-family: var(--display); color: var(--text2); }

    @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
<body>

<nav>
  <a class="nav-logo" href="/">
    <div class="logo-mark">🛡</div>
    SnapLink
  </a>
  <span class="admin-badge">Admin</span>
  <div class="nav-right">
    <a class="btn-nav" href="/dashboard">User Dashboard</a>
    <a class="btn-nav" href="/logout">Logout</a>
  </div>
</nav>

<main>

  <div class="hero">
    <div class="hero-eyebrow">Admin Control</div>
    <h1>Campaign <em>Approvals</em></h1>
    <p class="hero-sub">Brand campaigns approve ya reject karo — affiliates tabhi use kar sakte hain</p>
  </div>

  <div class="stats-bar">
    <div class="stat-tile">
      <span class="stat-label">Total</span>
      <span class="stat-val purple"><%= stats.total %></span>
    </div>
    <div class="stat-tile">
      <span class="stat-label">Pending Review</span>
      <span class="stat-val amber"><%= stats.pending %></span>
    </div>
    <div class="stat-tile">
      <span class="stat-label">Approved</span>
      <span class="stat-val green"><%= stats.approved %></span>
    </div>
    <div class="stat-tile">
      <span class="stat-label">Rejected</span>
      <span class="stat-val red"><%= stats.rejected %></span>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="filter-tabs">
    <button class="filter-tab active" data-filter="all" onclick="filterCards('all', this)">All</button>
    <button class="filter-tab pending" data-filter="pending" onclick="filterCards('pending', this)">⏳ Pending</button>
    <button class="filter-tab approved" data-filter="approved" onclick="filterCards('approved', this)">✅ Approved</button>
    <button class="filter-tab rejected" data-filter="rejected" onclick="filterCards('rejected', this)">❌ Rejected</button>
  </div>

  <!-- Campaigns List -->
  <div class="campaigns-list" id="campaigns-list">
    <% if (campaigns.length === 0) { %>
      <div class="empty-state">
        <span class="empty-glyph">📭</span>
        <h3>Koi campaign nahi hai abhi</h3>
        <p>Brands abhi tak koi campaign submit nahi ki</p>
      </div>
    <% } else { %>
      <% campaigns.forEach((c, i) => { %>
      <div class="campaign-card highlight-<%= c.status %>"
           data-status="<%= c.status %>"
           style="animation: fadeUp 0.35s <%= 0.05 + i * 0.04 %>s ease both; opacity:0">

        <div class="card-main">
          <div class="card-row1">
            <span class="card-title"><%= c.title %></span>
            <span class="badge <%= c.status %>">
              <%= c.status === 'pending' ? '⏳ Pending' : c.status === 'approved' ? '✅ Approved' : '❌ Rejected' %>
            </span>
          </div>
          <div class="brand-info">
            Brand: <strong><%= c.brandName %></strong> &nbsp;·&nbsp; <%= c.brandEmail %>
            <% if (c.createdBy && c.createdBy.name) { %>
              &nbsp;·&nbsp; User: <%= c.createdBy.name %>
            <% } %>
          </div>
          <div class="card-desc"><%= c.description %></div>
          <div class="card-url">→ <%= c.targetUrl %></div>
          <div class="card-meta">
            <span class="meta-chip"><%= new Date(c.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'2-digit'}) %></span>
            <span class="meta-chip commission">
              <%= c.commissionType === 'percentage' ? c.commissionValue + '%' : '₹' + c.commissionValue %>
            </span>
            <% if (c.budget) { %><span class="meta-chip">Budget: ₹<%= c.budget %></span><% } %>
            <% if (c.refParam) { %><span class="meta-chip">?<%= c.refParam %></span><% } %>
          </div>
          <% if (c.adminNote) { %>
            <div class="admin-note-display <%= c.status === 'rejected' ? 'rejection' : '' %>">
              Note: "<%= c.adminNote %>"
            </div>
          <% } %>
        </div>

        <!-- Actions — sirf pending ke liye full actions, baki ke liye sirf note -->
        <div class="card-actions">
          <% if (c.status === 'pending') { %>
            <label class="note-label">Admin Note (optional)</label>
            <textarea class="note-area" id="note-<%= c._id %>" placeholder="Reason ya feedback..."></textarea>
            <form action="/admin/campaigns/<%= c._id %>/approve" method="POST" id="approve-<%= c._id %>">
              <input type="hidden" name="note" id="approve-note-<%= c._id %>"/>
              <button class="btn-approve" type="button" onclick="submitAction('approve', '<%= c._id %>')">
                ✅ Approve
              </button>
            </form>
            <form action="/admin/campaigns/<%= c._id %>/reject" method="POST" id="reject-<%= c._id %>">
              <input type="hidden" name="note" id="reject-note-<%= c._id %>"/>
              <button class="btn-reject" type="button" onclick="submitAction('reject', '<%= c._id %>')">
                ❌ Reject
              </button>
            </form>
          <% } else { %>
            <div style="font-size:0.75rem; color:var(--text3); text-align:center; padding-top:8px;">
              Already <%= c.status %>
            </div>
          <% } %>
        </div>

      </div>
      <% }) %>
    <% } %>
  </div>

</main>

<script>
  // Fill hidden note input then submit form
  function submitAction(action, id) {
    const note = document.getElementById('note-' + id).value.trim();
    document.getElementById(action + '-note-' + id).value = note;
    document.getElementById(action + '-' + id).submit();
  }

  // Filter by status
  function filterCards(status, btn) {
    document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.campaign-card').forEach(card => {
      if (status === 'all' || card.dataset.status === status) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }
</script>

</body>
</html>
