<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Link Expired</title>
  <link rel="stylesheet" href="/css/pages/generated/link-expired.inline.css" />
</head>
<body>
  <div class="card">
    <h1>Link expired</h1>
    <p>Yeh short link ab active nahi hai. Owner ne expiry set ki thi ya link disable kiya gaya hai.</p>
    <% if (url && url.shortCode) { %>
      <div class="code">/<%= url.shortCode %></div>
    <% } %>
    <a href="/">Back to SnapLink</a>
  </div>
</body>
</html>


