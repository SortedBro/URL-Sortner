<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: page.metaTitle,
      description: page.summary,
      path: page.key === 'privacy' ? '/privacy' : '/terms',
      robots: 'index, follow',
      stylesheets: ['/css/pages/site-shell.css', '/css/pages/marketing-pages.css']
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
</head>
<body class="site-page legal-page">
  <%- include('partials/site-navbar', { currentPage: '' }) %>

  <main class="page-shell page-stack">
    <section class="page-hero">
      <div class="hero-grid">
        <div>
          <div class="eyebrow">Legal</div>
          <h1 class="hero-title"><span><%= page.title %></span> for SnapLink.</h1>
          <p class="hero-text"><%= page.summary %></p>
          <div class="hero-stats">
            <div class="hero-stat"><strong><%= page.effectiveDate %></strong><span>Effective date</span></div>
            <div class="hero-stat"><strong>Policy</strong><span>Applies to usage, analytics, billing, and white-label workflows</span></div>
          </div>
        </div>
        <aside class="hero-panel">
          <h3>Policy center</h3>
          <p><%= page.note %></p>
          <div class="btn-row">
            <% legalLinks.forEach((link) => { %>
              <a href="<%= link.href %>" class="btn-secondary"><%= link.label %></a>
            <% }) %>
          </div>
        </aside>
      </div>
    </section>

    <section class="legal-shell">
      <aside class="legal-sidebar">
        <div class="section-kicker">Directory</div>
        <h3>Legal pages</h3>
        <div class="legal-directory">
          <% legalLinks.forEach((link) => { %>
            <a href="<%= link.href %>" class="<%= link.key === page.key ? 'active' : '' %>">
              <span><%= link.label %></span>
              <span>/</span>
            </a>
          <% }) %>
        </div>
      </aside>

      <article class="legal-content">
        <div class="legal-chip">SnapLink policy document</div>
        <h2 class="legal-title"><span><%= page.title %></span></h2>
        <p class="legal-summary"><%= page.summary %></p>
        <p class="legal-note"><%= page.note %></p>

        <% page.sections.forEach((section, index) => { %>
          <section class="legal-section">
            <div class="legal-section-index"><%= String(index + 1).padStart(2, '0') %></div>
            <div class="legal-section-body">
              <h3><%= section.title %></h3>
              <% section.body.forEach((paragraph) => { %>
                <p class="section-copy"><%= paragraph %></p>
              <% }) %>
              <% if (section.list && section.list.length) { %>
                <ul>
                  <% section.list.forEach((item) => { %>
                    <li><%= item %></li>
                  <% }) %>
                </ul>
              <% } %>
            </div>
          </section>
        <% }) %>
      </article>
    </section>
  </main>

  <%- include('partials/footer', { footerCopy: 'Clear policies for product usage, analytics, billing, affiliate workflows, and white-label operations.' }) %>
  <script src="/js/shared/theme.js"></script>
</body>
</html>
