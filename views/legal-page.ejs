<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= page.metaTitle %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@500;700;800&family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/pages/legal.css" />
  <link rel="stylesheet" href="/css/footer.css" />
</head>
<body>
  <header class="legal-topbar">
    <a href="/" class="legal-brand">Snap<em>Link</em></a>

    <nav class="legal-toplinks" aria-label="Main">
      <a href="/features">Features</a>
      <a href="/pricing">Pricing</a>
      <a href="/about">About</a>
    </nav>

    <div class="legal-actions">
      <% if (user) { %>
        <a href="/dashboard" class="legal-btn legal-btn-ghost">Dashboard</a>
      <% } else { %>
        <a href="/login" class="legal-btn legal-btn-ghost">Login</a>
        <a href="/signup" class="legal-btn legal-btn-solid">Get Started</a>
      <% } %>
      <button class="theme-btn" id="themeBtn" type="button" onclick="toggleTheme()" aria-label="Toggle theme"></button>
    </div>
  </header>

  <main class="legal-main">
    <section class="legal-shell">
      <aside class="legal-sidebar">
        <p class="legal-kicker">Legal</p>
        <h1 class="legal-sidebar-title">Policy Center</h1>
        <p class="legal-sidebar-copy">
          Core policies for SnapLink usage, analytics, billing, affiliate flows, and platform operations.
        </p>

        <nav class="legal-directory" aria-label="Legal pages">
          <% legalLinks.forEach((link) => { %>
            <a href="<%= link.href %>" class="<%= link.key === page.key ? 'active' : '' %>">
              <span><%= link.label %></span>
              <span class="legal-arrow">/</span>
            </a>
          <% }) %>
        </nav>

        <div class="legal-meta-card">
          <span class="meta-label">Effective date</span>
          <strong><%= page.effectiveDate %></strong>
        </div>
      </aside>

      <article class="legal-content">
        <div class="legal-chip">Production Legal Template</div>
        <h2 class="legal-title"><%= page.title %></h2>
        <p class="legal-summary"><%= page.summary %></p>
        <div class="legal-note"><%= page.note %></div>

        <% page.sections.forEach((section, index) => { %>
          <section class="legal-section">
            <div class="legal-section-index"><%= String(index + 1).padStart(2, '0') %></div>
            <div class="legal-section-body">
              <h3><%= section.title %></h3>

              <% section.body.forEach((paragraph) => { %>
                <p><%= paragraph %></p>
              <% }) %>

              <% if (section.list && section.list.length) { %>
                <ul>
                  <% section.list.forEach((item) => { %>
                    <li><%= item %></li>
                  <% }) %>
                </ul>
              <% } %>
            </div>
          </section>
        <% }) %>
      </article>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/shared/theme.js"></script>
</body>
</html>
