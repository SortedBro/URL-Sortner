<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
  <%
    const seo = {
      title: 'Dashboard | SnapLink',
      description: 'Manage your short links, analytics, exports, and plan activity from the SnapLink dashboard.',
      path: '/dashboard',
      robots: 'noindex, nofollow',
      stylesheets: ["/css/pages/site-shell.css","/css/pages/dashboard.css","/css/pages/app-shell.css"]
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
  <script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
</head>

<body class="app-shell-page">
  <%
    const userDisplayName = user ? (user.name || [user.firstName, user.lastName].filter(Boolean).join(' ').trim() || user.email || 'User') : 'User';
    const userDisplayShortName = userDisplayName.split(/\s+/)[0];
    const userDisplayInitial = userDisplayName.charAt(0).toUpperCase();
  %>

  <!-- Sidebar -->
  <aside class="sidebar">
    <a class="sidebar-logo" href="/">
      <span class="logo-dot"></span>
      Snap<em>Link</em>
    </a>

    <div class="sidebar-section">Main</div>
    <button class="nav-item active" onclick="showTab('links',this)">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
      </svg>
      My Links
    </button>
    <button class="nav-item" onclick="showTab('create',this)">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
      New Link
    </button>
    <button class="nav-item" onclick="showTab('bulk',this)">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7" />
        <rect x="14" y="3" width="7" height="7" />
        <rect x="14" y="14" width="7" height="7" />
        <rect x="3" y="14" width="7" height="7" />
      </svg>
      Bulk Shorten
      <% if (typeof user !=='undefined' && user && user.plan==='free' ) { %>
        <span class="nav-pro-chip">PRO</span>
        <% } %>
    </button>

    <div class="sidebar-sep"></div>
    <div class="sidebar-section">Manage</div>


    <a class="nav-item" href="/analytics">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
      </svg>
      Analytics
    </a>
    <a class="nav-item" href="/qr-codes">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="5" height="5" />
        <rect x="16" y="3" width="5" height="5" />
        <rect x="3" y="16" width="5" height="5" />
        <path d="M21 16h-3v3M21 21h-1M16 16h1" />
      </svg>
      QR Codes
    </a>
    <a class="nav-item" href="/settings">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3" />
        <path
          d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
      </svg>
      Settings
    </a>

    <div class="sidebar-sep"></div>
    <div class="sidebar-section">Growth</div>
    <a class="nav-item" href="/affiliate/dashboard">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 17l6-6 4 4 8-8" />
        <path d="M14 7h7v7" />
      </svg>
      Affiliate
    </a>
    <a class="nav-item" href="/affiliate/wallet">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="2" y="6" width="20" height="12" rx="2" />
        <path d="M16 12h.01" />
      </svg>
      Wallet
    </a>
    <a class="nav-item" href="/brand/campaigns">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2l8 4v6c0 5-3.5 9.5-8 10-4.5-.5-8-5-8-10V6l8-4z" />
      </svg>
      Brand
    </a>

    <div class="sidebar-bottom">
      <div class="theme-row">
        <span>Theme</span>
        <button class="theme-toggle" id="themeBtn" onclick="toggleTheme()">Theme</button>
      </div>

      <% if (typeof user !=='undefined' && user) { %>
        <div class="plan-card">
          <div class="plan-card-top">
            <div class="plan-avatar">
              <%= userDisplayInitial %>
            </div>
            <div class="plan-name-wrap">
              <div class="plan-username">
                <%= userDisplayShortName %></div>
            <div class="plan-label">
              <%= user.plan === 'free' ? 'FREE PLAN' : user.plan==='pro' ? 'PRO' : 'BUSINESS' %>
              </div>
            </div>
          </div>
          <% if (user.plan==='free' ) { %>
            <div class="plan-free-bar">
              <div class="plan-free-text">
                <span>Links used</span>
                <span>
                  <%= urls.length %>/10
                </span>
              </div>
              <div class="plan-bar-bg">
                <div class="plan-bar-fill" style="width:<%= Math.min((urls.length/10)*100,100) %>%"></div>
              </div>
            </div>
            <a href="/pricing" class="upgrade-btn">Upgrade - Rs 99/mo</a>
            <% } else { %>
              <a href="/pricing" class="upgrade-btn"
                style="background:var(--bg4);color:var(--text2);border:1px solid var(--border2)">Manage Plan</a>
              <% } %>
        </div>
        <a href="/logout" class="logout-link">Logout</a>
        <% } %>
    </div>
  </aside>

  <!-- Topbar -->
  <header class="topbar">
    <div class="topbar-left">
      <h1>Hey, <span>
          <%= typeof user !=='undefined' ? userDisplayShortName : ' there' %>
        </span></h1>
      <p>Tumhare saare links aur unki analytics ek jagah</p>
    </div>
    <div class="topbar-right">
      <button class="btn btn-ghost" onclick="showTab('create', document.querySelectorAll('.nav-item')[1])">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19" />
          <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
        New Link
      </button>
    </div>
  </header>

  <!-- Main content -->
  <main class="main-content">

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card s1">
        <div class="stat-label">Total Links</div>
        <div class="stat-value accent">
          <%= urls.length %>
        </div>
        <div class="stat-sub">banaye gaye</div>
      </div>
      <div class="stat-card s2">
        <div class="stat-label">Total Clicks</div>
        <div class="stat-value">
          <%= summary.totalClicks %>
        </div>
        <div class="stat-sub">across all links</div>
      </div>
      <div class="stat-card s3">
        <div class="stat-label">Top Link</div>
        <% const top = summary.topLink; %>
          <div class="stat-value mono">
            <%= top ? '/' +top.shortCode : '-' %>
          </div>
          <div class="stat-sub">
            <%= top ? (top.clicks||0)+' clicks' : 'koi link nahi' %>
          </div>
      </div>
      <div class="stat-card s4">
        <div class="stat-label">This Month</div>
          <div class="stat-value">
            <%= summary.linksThisMonth %>
          </div>
          <div class="stat-sub">links created</div>
      </div>
    </div>

    <!-- Tab: My Links -->
    <div class="tab-content active" id="tab-links">
      <div class="table-section">
        <div class="table-header">
          <span class="table-title">All Links</span>
          <div class="table-actions">
            <div class="search-wrap">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.35-4.35" />
              </svg>
              <input type="text" placeholder="Search..." oninput="filterLinks(this.value)">
            </div>
            <% if (typeof user !=='undefined' && user && user.plan !=='free' ) { %>
              <button class="btn-export" onclick="exportCSV()">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                Links CSV
              </button>
              <a href="/bulk-export/analytics" class="btn-export">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                Analytics CSV
              </a>
              <% } else { %>
                <a href="/pricing" class="btn-export locked">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                  Export <span class="pro-chip">PRO</span>
                </a>
                <% } %>
                  <span class="table-count">
                    <%= urls.length %> links
                  </span>
          </div>
        </div>

        <% if (urls.length===0) { %>
          <div class="empty-state">
            <div class="empty-icon">Link</div>
            <h3>Koi link nahi abhi tak</h3>
            <p>Pehla short URL banao aur track karna shuru karo</p>
            <button onclick="showTab('create', document.querySelectorAll('.nav-item')[1])" class="empty-cta">Pehla link
              banao</button>
          </div>
          <% } else { %>
            <div class="table-wrap">
              <table id="linksTable">
                <thead>
                  <tr>
                    <th>Original URL</th>
                    <th>Short URL</th>
                    <th>Ad</th>
                    <th>Clicks</th>
                    <th class="hide-mobile">Status</th>
                    <th class="hide-mobile">Created</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% urls.forEach(url=> {
                    const isExpired = url.expiresAt && new Date(url.expiresAt) < new Date(); %>
                      <tr class="link-row" data-search="<%= url.originalUrl %> <%= url.shortUrl %> <%= url.shortCode %>">
                        <td class="td-url">
                          <span class="url-original" title="<%= url.originalUrl %>">
                            <%= url.originalUrl %>
                          </span>
                          <div class="url-tags">
                            <% if (url.customAlias) { %><span class="tag-badge alias">alias</span>
                              <% } %>
                                <% if (url.hasPassword) { %><span class="tag-badge pw">Locked</span>
                                  <% } %>
                                    <% if (url.whiteLabelDomain) { %><span class="tag-badge alias">wl: <%= url.whiteLabelDomain %></span>
                                      <% } %>
                                    <% if (url.expiresAt) { %><span class="tag-badge exp <%= isExpired?'red':'' %>">
                                        <%= isExpired ? 'expired' : 'expires ' +new
                                          Date(url.expiresAt).toLocaleDateString('en-IN',{day:'numeric',month:'short'})
                                          %>
                                      </span>
                                      <% } %>
                          </div>
                        </td>
                        <td>
                          <a class="url-short" href="/<%= url.shortCode %>" target="_blank">
                            <%= url.shortUrl %>
                          </a>
                        </td>
                        <td>
                          <span class="status-badge <%= url.adEnabled ? 'active' : '' %>">
                            <%= url.adEnabled ? 'On' : 'Off' %>
                          </span>
                          <a class="btn-action" href="/manage/ad/<%= url.shortCode %>">Edit</a>
                        </td>
                        <td>
                          <span class="click-badge <%= (url.clicks||0)===0?'zero':'' %>">
                            <% if ((url.clicks||0)>0) { %>+<% } %>
                                <%= url.clicks||0 %>
                          </span>
                        </td>
                        <td class="hide-mobile">
                          <span class="status-badge <%= isExpired?'expired':'active' %>">
                            <%= isExpired ? 'Expired' : 'Active' %>
                          </span>
                        </td>
                        <td class="hide-mobile">
                          <span class="date-text">
                            <%= new
                              Date(url.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'2-digit'})
                              %>
                          </span>
                        </td>
                        <td>
                          <div class="action-btns">
                            <button class="btn-copy" onclick="copyUrl('<%= url.shortUrl %>',this)">Copy</button>
                            <button class="btn-qr"
                              onclick="openQR('<%= url.shortUrl %>','<%= url.shortCode %>')">QR</button>
                            <a class="btn-analytics" href="/analytics/<%= url.shortCode %>">Stats</a>
                            <form action="/delete/<%= url.shortCode %>" method="POST" style="margin:0"
                              data-confirm-dialog
                              data-confirm-title="Delete this short link?"
                              data-confirm-message="This short link will be removed from your dashboard. Click data will stop updating after deletion."
                              data-confirm-confirm="Delete link"
                              data-confirm-tone="danger">
                              <button class="btn-delete" type="submit">Delete</button>
                            </form>
                          </div>
                        </td>
                      </tr>
                      <% }) %>
                </tbody>
              </table>
            </div>
            <% } %>
      </div>
    </div>

    <!-- Tab: New Link -->
    <div class="tab-content" id="tab-create">
      <div class="create-grid">
        <div class="create-card">
          <div class="create-card-header">
            <h2>New Short Link</h2>
            <p>URL short karo - customize bhi kar sakte ho</p>
          </div>

          <% if (typeof error !=='undefined' && error) { %>
            <div class="alert alert-error">Error: <%= error %>
            </div>
            <% } %>
              <% if (typeof shortUrl !=='undefined' && shortUrl) { %>
                <div class="result-card">
                  <div class="result-label">Short URL ready!</div>
                  <div class="result-row">
                    <a href="<%= shortUrl %>" target="_blank" class="result-url">
                      <%= shortUrl %>
                    </a>
                    <button class="copy-btn" onclick="copyUrl('<%= shortUrl %>',this)">Copy</button>
                  </div>
                </div>
                <% } %>

                  <form action="/shorten" method="POST" class="create-form">
                    <input type="hidden" name="returnTo" value="dashboard" />
                    <div class="form-group">
                      <label>Long URL <span class="req">*</span></label>
                      <input type="url" name="orginalUrl" placeholder="https://example.com/bahut-lamba-url..." required
                        class="form-input" />
                    </div>

                    <div class="form-group">
                      <label>
                        Custom Alias
                        <% if (typeof user!=='undefined' &&user&&user.plan==='free' ){%><span
                            class="pro-chip">PRO</span>
                          <%}%>
                      </label>
                      <div class="input-prefix-wrap">
                        <span class="input-prefix">snap.link/</span>
                        <input type="text" name="customAlias" placeholder="mera-link" class="form-input with-prefix"
                          <%=(typeof user!=='undefined' &&user&&user.plan==='free' )?'disabled':''%>/>
                      </div>
                    </div>

                    <div class="pro-features-row">
                      <div class="form-group half">
                        <label>Password <% if (typeof user!=='undefined' &&user&&user.plan==='free' ){%><span
                              class="pro-chip">PRO</span>
                            <%}%></label>
                        <input type="password" name="password" placeholder="Optional" class="form-input" <%=(typeof
                          user!=='undefined' &&user&&user.plan==='free' )?'disabled':''%>/>
                      </div>
                      <div class="form-group half">
                        <label>Expiry Date <% if (typeof user!=='undefined' &&user&&user.plan==='free' ){%><span
                              class="pro-chip">PRO</span>
                            <%}%></label>
                        <input type="date" name="expiresAt" class="form-input"
                          min="<%=new Date().toISOString().split('T')[0]%>" <%=(typeof user!=='undefined'
                          &&user&&user.plan==='free' )?'disabled':''%>/>
                      </div>
                    </div>

                    <div class="form-group">
                      <label>
                        White Label Domain
                        <% if (typeof user!=='undefined' &&user&&user.plan!=='business' ){%><span
                            class="pro-chip">BUSINESS</span>
                          <%}%>
                      </label>
                      <input type="text" name="whiteLabelDomain" placeholder="links.yourbrand.com" class="form-input"
                        value="<%= (user && user.whiteLabel && user.whiteLabel.customDomain) ? user.whiteLabel.customDomain : '' %>"
                        <%=(typeof user!=='undefined' &&user&&user.plan!=='business' )?'disabled':''%> />
                    </div>

                    <button type="submit" class="snap-btn">
                      Snap URL
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2.5">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                      </svg>
                    </button>
                  </form>

                  <% if (typeof user!=='undefined' &&user&&user.plan==='free' ) { %>
                    <div class="upgrade-nudge">
                      <span>Custom alias, password, expiry date - Pro mein unlock hote hain</span>
                      <a href="/pricing">Upgrade Rs 99/mo</a>
                    </div>
                    <% } %>
        </div>

        <div class="tips-card">
          <h3>Tips</h3>
          <div class="tip-item">
            <div class="tip-dot"></div>
            <div><strong>Custom Alias</strong>
              <p>snap.link/brand-name - memorable links zyada click hote hain</p>
            </div>
          </div>
          <div class="tip-item">
            <div class="tip-dot"></div>
            <div><strong>Password Lock</strong>
              <p>Sirf sahi log hi link khol sakein</p>
            </div>
          </div>
          <div class="tip-item">
            <div class="tip-dot"></div>
            <div><strong>Expiry Date</strong>
              <p>Limited time offers ke liye auto-expire links</p>
            </div>
          </div>
          <div class="tip-item">
            <div class="tip-dot"></div>
            <div><strong>White Label</strong>
              <p>Business plan me apna domain use karke brand links banao</p>
            </div>
          </div>
          <div class="tip-item">
            <div class="tip-dot"></div>
            <div><strong>QR Code</strong>
              <p>Har link ka QR download karo - print mein use karo</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab: Bulk -->
        <div class="tab-content" id="tab-bulk">
      <% if (typeof user !== 'undefined' && user && user.plan === 'free') { %>
        <div class="locked-feature">
          <div class="locked-icon">LOCK</div>
          <h2>Bulk Operations</h2>
          <p>Bulk shorten, update, delete, and analytics export are available on Pro and Business plans.</p>
          <div class="locked-perks">
            <span>500 links at once</span>
            <span>Bulk update destinations</span>
            <span>Bulk delete by short code</span>
            <span>Analytics export CSV</span>
          </div>
          <a href="/pricing" class="snap-btn"
            style="display:inline-flex;width:auto;padding:12px 28px;margin-top:1.5rem;text-decoration:none">Upgrade to Pro - Rs 99/mo</a>
        </div>
      <% } else { %>
        <div class="bulk-grid">
          <div class="bulk-card">
            <div class="create-card-header">
              <h2>Bulk URL Shortener</h2>
              <p>Paste one URL per line and create short links in a single pass.</p>
            </div>
            <form action="/bulk-shorten" method="POST">
              <div class="form-group">
                <label>URLs (one per line)</label>
                <textarea name="urls" class="bulk-textarea" rows="10"
                  placeholder="https://example.com/link1&#10;https://example.com/link2&#10;https://example.com/link3"></textarea>
              </div>
              <div class="bulk-actions">
                <button type="button" class="btn-secondary" onclick="document.getElementById('csvImport').click()">CSV Import</button>
                <input type="file" id="csvImport" accept=".csv,.txt" style="display:none" onchange="loadCSV(this)">
                <button type="submit" class="snap-btn" style="width:auto;padding:11px 28px">Shorten All</button>
              </div>
            </form>
            <% if (bulkResults && bulkResults.length > 0) { %>
              <div class="bulk-results bulk-results-shorten">
                <div class="bulk-results-header">
                  <span>OK <%= bulkResults.length %> URLs shortened</span>
                  <button onclick="exportBulkCSV('.bulk-results-shorten .bulk-row', 'bulk-results.csv')" class="btn-export">Download CSV</button>
                </div>
                <% bulkResults.forEach((r) => { %>
                  <div class="bulk-row">
                    <span class="bulk-original"><%= r.original %></span>
                    <span class="bulk-arrow">-&gt;</span>
                    <a class="bulk-short" href="<%= r.short %>" target="_blank"><%= r.short %></a>
                    <button class="btn-copy" onclick="copyUrl('<%= r.short %>', this)">Copy</button>
                  </div>
                <% }) %>
              </div>
            <% } %>
            <% if (bulkErrors && bulkErrors.length > 0) { %>
              <div class="bulk-errors">
                <div class="bulk-errors-header">Skipped rows: <%= bulkErrors.length %></div>
                <% bulkErrors.forEach((item) => { %>
                  <div class="bulk-error-row">
                    <span class="bulk-error-entry"><%= item.url || item.entry || 'Row' %></span>
                    <span class="bulk-error-text"><%= item.reason %></span>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>

          <div class="bulk-card">
            <div class="create-card-header">
              <h2>Bulk Update</h2>
              <p>Format each line as <code>shortCode, https://new-destination.com</code>.</p>
            </div>
            <form action="/bulk-update" method="POST">
              <div class="form-group">
                <label>Short code + new destination</label>
                <textarea name="updates" class="bulk-textarea" rows="10"
                  placeholder="spring-sale, https://example.com/new-landing&#10;creator-bio, https://example.com/updated-bio"></textarea>
              </div>
              <div class="bulk-actions">
                <button type="button" class="btn-secondary" onclick="document.getElementById('updateCsvImport').click()">CSV Import</button>
                <input type="file" id="updateCsvImport" accept=".csv,.txt" style="display:none" onchange="loadUpdateCSV(this)">
                <button type="submit" class="snap-btn" style="width:auto;padding:11px 28px">Update Links</button>
              </div>
            </form>
            <% if (bulkUpdateResults && bulkUpdateResults.length > 0) { %>
              <div class="bulk-results bulk-results-update">
                <div class="bulk-results-header">
                  <span>OK <%= bulkUpdateResults.length %> links updated</span>
                  <button onclick="exportBulkCSV('.bulk-results-update .bulk-row', 'bulk-updated-links.csv')" class="btn-export">Download CSV</button>
                </div>
                <% bulkUpdateResults.forEach((item) => { %>
                  <div class="bulk-row">
                    <span class="bulk-original">/<%= item.shortCode %></span>
                    <span class="bulk-arrow">-&gt;</span>
                    <span class="bulk-short"><%= item.original %></span>
                  </div>
                <% }) %>
              </div>
            <% } %>
            <% if (bulkUpdateErrors && bulkUpdateErrors.length > 0) { %>
              <div class="bulk-errors">
                <div class="bulk-errors-header">Update errors: <%= bulkUpdateErrors.length %></div>
                <% bulkUpdateErrors.forEach((item) => { %>
                  <div class="bulk-error-row">
                    <span class="bulk-error-entry"><%= item.entry || 'Row' %></span>
                    <span class="bulk-error-text"><%= item.reason %></span>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>

          <div class="bulk-card">
            <div class="create-card-header">
              <h2>Bulk Delete</h2>
              <p>Paste short codes or short URLs. One entry per line.</p>
            </div>
            <form action="/bulk-delete" method="POST"
              data-confirm-dialog
              data-confirm-title="Delete selected links?"
              data-confirm-message="Bulk delete will permanently remove every listed short link. Please confirm before we continue."
              data-confirm-confirm="Delete selected links"
              data-confirm-tone="danger">
              <div class="form-group">
                <label>Short codes / short URLs</label>
                <textarea name="codes" class="bulk-textarea" rows="10"
                  placeholder="spring-sale&#10;https://snaplink.fun/creator-bio&#10;/launch-offer"></textarea>
              </div>
              <div class="bulk-actions">
                <button type="button" class="btn-secondary" onclick="document.getElementById('deleteCsvImport').click()">CSV Import</button>
                <input type="file" id="deleteCsvImport" accept=".csv,.txt" style="display:none" onchange="loadDeleteCSV(this)">
                <button type="submit" class="btn-danger">Delete Links</button>
              </div>
            </form>
            <% if (bulkDeleteResults && bulkDeleteResults.length > 0) { %>
              <div class="bulk-results bulk-results-delete">
                <div class="bulk-results-header">
                  <span>OK <%= bulkDeleteResults.length %> links deleted</span>
                  <button onclick="exportBulkCSV('.bulk-results-delete .bulk-row', 'bulk-deleted-links.csv')" class="btn-export">Download CSV</button>
                </div>
                <% bulkDeleteResults.forEach((item) => { %>
                  <div class="bulk-row">
                    <span class="bulk-original"><%= item.original %></span>
                    <span class="bulk-arrow">-&gt;</span>
                    <span class="bulk-short">/<%= item.shortCode %></span>
                  </div>
                <% }) %>
              </div>
            <% } %>
            <% if (bulkDeleteErrors && bulkDeleteErrors.length > 0) { %>
              <div class="bulk-errors">
                <div class="bulk-errors-header">Delete errors: <%= bulkDeleteErrors.length %></div>
                <% bulkDeleteErrors.forEach((item) => { %>
                  <div class="bulk-error-row">
                    <span class="bulk-error-entry"><%= item.entry || 'Row' %></span>
                    <span class="bulk-error-text"><%= item.reason %></span>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>

          <div class="bulk-card">
            <div class="create-card-header">
              <h2>Analytics Export</h2>
              <p>Download one CSV for all links with clicks, unique visitors, top device, country, and last activity.</p>
            </div>
            <div class="bulk-note-list">
              <span>Total clicks per short link</span>
              <span>Unique visitors estimate</span>
              <span>Top country, browser, and device</span>
              <span>Created and last-click timestamps</span>
            </div>
            <div class="bulk-actions">
              <a href="/bulk-export/analytics" class="btn-secondary">Download Analytics CSV</a>
            </div>
          </div>
        </div>
      <% } %>
    </div>

  </main>

  <!-- QR Modal -->
  <div class="qr-modal-bg" id="qrModalBg" onclick="closeQR(event)">
    <div class="qr-modal">
      <button class="qr-modal-close" onclick="closeQRBtn()">Close</button>
      <div class="qr-modal-title">QR Code</div>
      <div class="qr-modal-url" id="qrUrl"></div>
      <div id="qr-canvas-wrap"><canvas id="qrCanvas"></canvas></div>
      <div class="qr-actions">
        <button class="btn-download" onclick="downloadQR()">Download</button>
        <button class="btn-modal-copy" onclick="copyQRUrl()">Copy URL</button>
      </div>
    </div>
  </div>

  <%- include('partials/feedback-ui') %>

  <script src="/js/shared/theme.js"></script>
  <script src="/js/shared/feedback-ui.js"></script>
  <script>

    function showTab(name, btn) {
      document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
      document.getElementById('tab-' + name).classList.add('active');
      if (btn) btn.classList.add('active');
    }
    function getNavButton(index) {
      return document.querySelectorAll('.nav-item')[index] || null;
    }

    window.addEventListener('DOMContentLoaded', () => {
      const tabFromQuery = new URLSearchParams(window.location.search).get('tab');
      if (tabFromQuery === 'bulk') {
        showTab('bulk', getNavButton(2));
        return;
      }
<% if ((typeof shortUrl !== 'undefined' && shortUrl) || (typeof error !== 'undefined' && error)) { %>
      showTab('create', getNavButton(1));
<% } %>
    });

      function copyUrl(url, btn) {
        navigator.clipboard.writeText(url).then(() => {
          const orig = btn.textContent;
          btn.textContent = 'Copied!'; btn.classList.add('copied');
          setTimeout(() => { btn.textContent = orig; btn.classList.remove('copied'); }, 2000);
        });
      }

    function filterLinks(q) {
      document.querySelectorAll('.link-row').forEach(row => {
        row.style.display = row.dataset.search.toLowerCase().includes(q.toLowerCase()) ? '' : 'none';
      });
    }

    function exportCSV() {
      const rows = [['Original URL', 'Short URL', 'Ad', 'Clicks', 'Created']];
      document.querySelectorAll('.link-row').forEach(row => {
        const cols = row.querySelectorAll('td');
        rows.push([
          cols[0].querySelector('.url-original')?.textContent.trim() || '',
          cols[1].querySelector('.url-short')?.textContent.trim() || '',
          cols[2]?.textContent.replace(/\s+/g, ' ').trim() || '',
          cols[3].querySelector('.click-badge')?.textContent.trim() || '0',
          cols[5]?.querySelector('.date-text')?.textContent.trim() || ''
        ]);
      });
      const csv = rows.map(r => r.map(c => `"${c}"`).join(',')).join('\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
      a.download = 'snaplink-export.csv'; a.click();
    }

    function readTextFile(input, onLoad) {
      if (!input.files || !input.files[0]) return;
      const reader = new FileReader();
      reader.onload = e => onLoad(String(e.target.result || ''));
      reader.readAsText(input.files[0]);
    }

    function loadCSV(input) {
      readTextFile(input, (text) => {
        const lines = text.split(/\r?\n/).map(l => l.trim()).filter(l => l.startsWith('http'));
        document.querySelector('textarea[name=urls]').value = lines.join('\n');
      });
    }

    function loadUpdateCSV(input) {
      readTextFile(input, (text) => {
        const rows = text.split(/\r?\n/).map(line => line.trim()).filter(Boolean);
        const lines = rows
          .filter((line, index) => !(index === 0 && /short\s*code|short\s*url/i.test(line)))
          .map(line => line.split(/[,\t|]/).map(part => part.trim()))
          .filter(parts => parts.length >= 2)
          .map(parts => parts[0] + ', ' + parts.slice(1).join(', '));
        document.querySelector('textarea[name=updates]').value = lines.join('\n');
      });
    }

    function loadDeleteCSV(input) {
      readTextFile(input, (text) => {
        const rows = text.split(/\r?\n/).map(line => line.trim()).filter(Boolean);
        const lines = rows
          .filter((line, index) => !(index === 0 && /short\s*code|short\s*url/i.test(line)))
          .map(line => line.split(/[,\t|]/)[0].trim())
          .filter(Boolean);
        document.querySelector('textarea[name=codes]').value = lines.join('\n');
      });
    }

    function exportBulkCSV(rowSelector, filename) {
      const rows = [['Primary', 'Secondary']];
      document.querySelectorAll(rowSelector).forEach(row => {
        rows.push([
          row.querySelector('.bulk-original')?.textContent.trim() || '',
          row.querySelector('.bulk-short')?.textContent.trim() || ''
        ]);
      });
      const csv = rows
        .map(r => r.map(c => '"' + String(c).replace(/"/g, '""') + '"').join(','))
        .join('\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
      a.download = filename;
      a.click();
    }

    let currentQRUrl = '';
    function openQR(url, code) {
      currentQRUrl = url;
      document.getElementById('qrUrl').textContent = url;
      document.getElementById('qrModalBg').classList.add('open');
      document.getElementById('qr-canvas-wrap').innerHTML = '<canvas id="qrCanvas"></canvas>';
      QRCode.toCanvas(document.getElementById('qrCanvas'), url, { width: 200, margin: 2, color: { dark: '#000', light: '#fff' } }, err => { if (err) console.error(err); });
    }
    function closeQR(e) { if (e.target === document.getElementById('qrModalBg')) closeQRBtn(); }
    function closeQRBtn() { document.getElementById('qrModalBg').classList.remove('open'); }
    function downloadQR() {
      const canvas = document.querySelector('#qr-canvas-wrap canvas');
      if (!canvas) return;
      const a = document.createElement('a'); a.download = 'snaplink-qr.png'; a.href = canvas.toDataURL('image/png'); a.click();
    }
    function copyQRUrl() {
      navigator.clipboard.writeText(currentQRUrl).then(() => {
        const btn = document.querySelector('.btn-modal-copy');
        btn.textContent = 'Copied!'; setTimeout(() => btn.textContent = 'Copy URL', 2000);
      });
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeQRBtn(); });
  </script>
</body>

</html>





