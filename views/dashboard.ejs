<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard — SnapLink</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="icon" type="image/png" href="/favicon.png"/>
  <link rel="stylesheet" href="/css/dashboard.css"/>
  <script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
</head>
<body>

<!-- ═══════ NAVBAR ═══════ -->
<nav>
  <a class="nav-logo" href="/">
    <span class="logo-dot"></span>
    Snap<em>Link</em>
  </a>

  <div class="nav-center-tabs">
    <button class="tab-btn active" onclick="showTab('links',this)">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      My Links
    </button>
    <button class="tab-btn" onclick="showTab('create',this)">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Link
    </button>
    <button class="tab-btn" onclick="showTab('bulk',this)">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      Bulk
      <% if (typeof user !== 'undefined' && user && user.plan === 'free') { %><span class="pro-chip">PRO</span><% } %>
    </button>
  </div>

  <div class="nav-right">
    <button class="theme-btn" id="themeBtn" onclick="toggleTheme()">🌙</button>
    <% if (typeof user !== 'undefined' && user) { %>
      <% if (user.plan === 'free') { %>
        <a href="/pricing" class="upgrade-pill">⚡ Upgrade</a>
      <% } else { %>
        <span class="plan-pill"><%= user.plan === 'pro' ? '⭐ Pro' : '💎 Business' %></span>
      <% } %>
      <div class="nav-user">
        <div class="nav-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
        <span class="nav-username"><%= user.name %></span>
      </div>
      <a href="/logout" class="btn-logout">Logout</a>
    <% } %>
  </div>
</nav>

<!-- ═══════ MAIN ═══════ -->
<main>

  <!-- Page Header -->
  <div class="page-header">
    <div>
      <h1>Hey, <span><%= typeof user !== 'undefined' ? user.name.split(' ')[0] : 'there' %></span> 👋</h1>
      <p>Tumhare saare links aur unki analytics ek jagah</p>
    </div>
    <% if (typeof user !== 'undefined' && user && user.plan === 'free') { %>
      <div class="plan-banner">
        <span>🚀</span>
        <div>
          <strong>Free Plan</strong>
          <span><%= urls.length %>/10 links this month</span>
        </div>
        <a href="/pricing" class="plan-banner-btn">Upgrade ₹99/mo →</a>
      </div>
    <% } %>
  </div>

  <!-- Stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon">🔗</div>
      <div class="stat-label">Total Links</div>
      <div class="stat-value accent"><%= urls.length %></div>
      <div class="stat-sub">banaye gaye</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">👆</div>
      <div class="stat-label">Total Clicks</div>
      <div class="stat-value"><%= urls.reduce((s,u)=>s+(u.clicks||0),0) %></div>
      <div class="stat-sub">across all links</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">🏆</div>
      <div class="stat-label">Top Link</div>
      <div class="stat-value"><%= urls.length ? Math.max(...urls.map(u=>u.clicks||0)) : 0 %></div>
      <div class="stat-sub">
        <% const top=urls.length?urls.reduce((a,b)=>(a.clicks||0)>(b.clicks||0)?a:b,urls[0]):null; %>
        <%= top ? '/'+top.shortCode : '—' %>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">📅</div>
      <div class="stat-label">This Month</div>
      <div class="stat-value">
        <% const n=new Date(); const mo=urls.filter(u=>{const d=new Date(u.createdAt);return d.getMonth()===n.getMonth()&&d.getFullYear()===n.getFullYear();}).length; %>
        <%= mo %>
      </div>
      <div class="stat-sub">links created</div>
    </div>
  </div>

  <!-- ══ TAB: MY LINKS ══ -->
  <div class="tab-content active" id="tab-links">
    <div class="table-section">
      <div class="table-header">
        <span class="table-title">All Links</span>
        <div class="table-actions">
          <div class="search-wrap">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input type="text" id="searchInput" placeholder="Search..." oninput="filterLinks(this.value)">
          </div>
          <% if (typeof user !== 'undefined' && user && user.plan !== 'free') { %>
            <button class="btn-export" onclick="exportCSV()">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Export CSV
            </button>
          <% } else { %>
            <a href="/pricing" class="btn-export locked">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Export <span class="pro-chip">PRO</span>
            </a>
          <% } %>
          <span class="table-count"><%= urls.length %> links</span>
        </div>
      </div>

      <% if (urls.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">🔗</div>
          <h3>Koi link nahi abhi tak</h3>
          <p>Pehla short URL banao aur track karna shuru karo</p>
          <button onclick="showTab('create',document.querySelectorAll('.tab-btn')[1])" class="empty-cta">Pehla link banao →</button>
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table id="linksTable">
            <thead>
              <tr>
                <th>Original URL</th>
                <th>Short URL</th>
                <th>Clicks</th>
                <th class="hide-mobile">Status</th>
                <th class="hide-mobile">Created</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% urls.forEach(url => {
                const isExpired = url.expiresAt && new Date(url.expiresAt) < new Date();
              %>
              <tr class="link-row" data-search="<%= url.orginalUrl %> <%= url.shortUrl %> <%= url.shortCode %>">
                <td class="td-url">
                  <span class="url-original" title="<%= url.orginalUrl %>"><%= url.orginalUrl %></span>
                  <div class="url-tags">
                    <% if (url.customAlias) { %><span class="tag-badge alias">alias</span><% } %>
                    <% if (url.password) { %><span class="tag-badge pw">🔒 protected</span><% } %>
                    <% if (url.expiresAt) { %><span class="tag-badge exp <%= isExpired?'red':'' %>"><%= isExpired?'expired':'expires '+new Date(url.expiresAt).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></span><% } %>
                  </div>
                </td>
                <td>
                  <a class="url-short" href="/<%= url.shortCode %>" target="_blank"><%= url.shortUrl %></a>
                </td>
                <td>
                  <span class="click-badge <%= (url.clicks||0)===0?'zero':'' %>">
                    <% if ((url.clicks||0)>0) { %>▲<% } %> <%= url.clicks||0 %>
                  </span>
                </td>
                <td class="hide-mobile">
                  <span class="status-badge <%= isExpired?'expired':'active' %>">
                    <%= isExpired ? '✕ Expired' : '● Active' %>
                  </span>
                </td>
                <td class="hide-mobile">
                  <span class="date-text"><%= new Date(url.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'2-digit'}) %></span>
                </td>
                <td>
                  <div class="action-btns">
                    <button class="btn-copy" onclick="copyUrl('<%= url.shortUrl %>',this)">Copy</button>
                    <button class="btn-qr" onclick="openQR('<%= url.shortUrl %>','<%= url.shortCode %>')">QR</button>
                    <a class="btn-analytics" href="/analytics/<%= url.shortCode %>">📊</a>
                    <form action="/delete/<%= url.shortCode %>" method="POST" style="margin:0">
                      <button class="btn-delete" type="submit" onclick="return confirm('Delete karo?')">✕</button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- ══ TAB: NEW LINK ══ -->
  <div class="tab-content" id="tab-create">
    <div class="create-grid">
      <div class="create-card">
        <div class="create-card-header">
          <h2>New Short Link</h2>
          <p>URL short karo — customize bhi kar sakte ho</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error">⚠ <%= error %></div>
        <% } %>
        <% if (typeof shortUrl !== 'undefined' && shortUrl) { %>
          <div class="result-card">
            <div class="result-label">✓ Short URL ready!</div>
            <div class="result-row">
              <a href="<%= shortUrl %>" target="_blank" class="result-url"><%= shortUrl %></a>
              <button class="copy-btn" onclick="copyUrl('<%= shortUrl %>',this)">Copy</button>
            </div>
          </div>
        <% } %>

        <form action="/shorten" method="POST" class="create-form">
          <div class="form-group">
            <label>Long URL <span class="req">*</span></label>
            <input type="url" name="orginalUrl" placeholder="https://example.com/bahut-lamba-url..." required class="form-input"/>
          </div>

          <div class="form-group">
            <label>Custom Alias <% if (typeof user!=='undefined'&&user&&user.plan==='free'){%><span class="pro-chip">PRO</span><%}%></label>
            <div class="input-prefix-wrap">
              <span class="input-prefix">snap.link/</span>
              <input type="text" name="customAlias" placeholder="mera-link" class="form-input with-prefix"
                <%=(typeof user!=='undefined'&&user&&user.plan==='free')?'disabled':''%>/>
            </div>
          </div>

          <div class="pro-features-row">
            <div class="form-group half">
              <label>Password <% if (typeof user!=='undefined'&&user&&user.plan==='free'){%><span class="pro-chip">PRO</span><%}%></label>
              <input type="password" name="password" placeholder="Optional" class="form-input"
                <%=(typeof user!=='undefined'&&user&&user.plan==='free')?'disabled':''%>/>
            </div>
            <div class="form-group half">
              <label>Expiry Date <% if (typeof user!=='undefined'&&user&&user.plan==='free'){%><span class="pro-chip">PRO</span><%}%></label>
              <input type="date" name="expiresAt" class="form-input"
                min="<%=new Date().toISOString().split('T')[0]%>"
                <%=(typeof user!=='undefined'&&user&&user.plan==='free')?'disabled':''%>/>
            </div>
          </div>

          <button type="submit" class="snap-btn">
            Snap URL
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </form>

        <% if (typeof user!=='undefined'&&user&&user.plan==='free') { %>
          <div class="upgrade-nudge">
            <span>🔒 Custom alias, password, expiry date — Pro mein unlock hote hain</span>
            <a href="/pricing">Upgrade ₹99/mo →</a>
          </div>
        <% } %>
      </div>

      <div class="tips-card">
        <h3>💡 Tips</h3>
        <div class="tip-item"><div class="tip-dot"></div><div><strong>Custom Alias</strong><p>snap.link/brand-name — memorable links zyada click hote hain</p></div></div>
        <div class="tip-item"><div class="tip-dot"></div><div><strong>Password Lock</strong><p>Sirf sahi log hi link khol sakein</p></div></div>
        <div class="tip-item"><div class="tip-dot"></div><div><strong>Expiry Date</strong><p>Limited time offers ke liye auto-expire links</p></div></div>
        <div class="tip-item"><div class="tip-dot"></div><div><strong>QR Code</strong><p>Har link ka QR download karo — print mein use karo</p></div></div>
      </div>
    </div>
  </div>

  <!-- ══ TAB: BULK ══ -->
  <div class="tab-content" id="tab-bulk">
    <% if (typeof user!=='undefined'&&user&&user.plan==='free') { %>
      <div class="locked-feature">
        <div class="locked-icon">🔒</div>
        <h2>Bulk Shortener</h2>
        <p>Ek saath 100+ URLs shorten karo — Pro aur Business plan mein available.</p>
        <div class="locked-perks">
          <span>✓ 500 URLs at once</span>
          <span>✓ CSV import & export</span>
          <span>✓ Custom aliases in bulk</span>
        </div>
        <a href="/pricing" class="snap-btn" style="display:inline-flex;width:auto;padding:12px 28px;margin-top:1.5rem;text-decoration:none">⚡ Upgrade to Pro — ₹99/mo</a>
      </div>
    <% } else { %>
      <div class="bulk-card">
        <div class="create-card-header">
          <h2>Bulk URL Shortener</h2>
          <p>Ek saath multiple URLs — ek line mein ek URL likhao</p>
        </div>
        <form action="/bulk-shorten" method="POST" class="bulk-form">
          <div class="form-group">
            <label>URLs (ek line mein ek)</label>
            <textarea name="urls" class="bulk-textarea" rows="10"
              placeholder="https://example.com/link1&#10;https://example.com/link2&#10;https://example.com/link3"></textarea>
          </div>
          <div class="bulk-actions">
            <button type="button" class="btn-secondary" onclick="document.getElementById('csvImport').click()">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              CSV Import
            </button>
            <input type="file" id="csvImport" accept=".csv,.txt" style="display:none" onchange="loadCSV(this)">
            <button type="submit" class="snap-btn" style="width:auto;padding:11px 28px">Sab Shorten Karo →</button>
          </div>
        </form>
        <% if (typeof bulkResults!=='undefined'&&bulkResults&&bulkResults.length>0) { %>
          <div class="bulk-results">
            <div class="bulk-results-header">
              <span>✓ <%= bulkResults.length %> URLs shortened</span>
              <button onclick="exportBulkCSV()" class="btn-export">Download CSV</button>
            </div>
            <% bulkResults.forEach(r=>{ %>
              <div class="bulk-row">
                <span class="bulk-original"><%= r.original %></span>
                <span class="bulk-arrow">→</span>
                <a class="bulk-short" href="<%= r.short %>" target="_blank"><%= r.short %></a>
                <button class="btn-copy" onclick="copyUrl('<%= r.short %>',this)">Copy</button>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>

</main>

<!-- QR Modal -->
<div class="qr-modal-bg" id="qrModalBg" onclick="closeQR(event)">
  <div class="qr-modal">
    <button class="qr-modal-close" onclick="closeQRBtn()">✕</button>
    <div class="qr-modal-title">QR Code</div>
    <div class="qr-modal-url" id="qrUrl"></div>
    <div id="qr-canvas-wrap"><canvas id="qrCanvas"></canvas></div>
    <div class="qr-actions">
      <button class="btn-download" onclick="downloadQR()">⬇ Download</button>
      <button class="btn-modal-copy" onclick="copyQRUrl()">Copy URL</button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
<script>
// Theme
const saved = localStorage.getItem('theme') || 'dark';
document.documentElement.setAttribute('data-theme', saved);
document.getElementById('themeBtn').textContent = saved === 'dark' ? '🌙' : '☀️';
function toggleTheme() {
  const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
  const next = isDark ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('theme', next);
  document.getElementById('themeBtn').textContent = next === 'dark' ? '🌙' : '☀️';
}

// Tabs
function showTab(name, btn) {
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-'+name).classList.add('active');
  if (btn) btn.classList.add('active');
}
<% if (typeof shortUrl !== 'undefined' && shortUrl) { %>
window.addEventListener('DOMContentLoaded', () => showTab('create', document.querySelectorAll('.tab-btn')[1]));
<% } %>

// Copy
function copyUrl(url, btn) {
  navigator.clipboard.writeText(url).then(() => {
    const orig = btn.textContent;
    btn.textContent = 'Copied!'; btn.classList.add('copied');
    setTimeout(() => { btn.textContent = orig; btn.classList.remove('copied'); }, 2000);
  });
}

// Search
function filterLinks(q) {
  document.querySelectorAll('.link-row').forEach(row => {
    row.style.display = row.dataset.search.toLowerCase().includes(q.toLowerCase()) ? '' : 'none';
  });
}

// Export CSV
function exportCSV() {
  const rows = [['Original URL','Short URL','Clicks','Created']];
  document.querySelectorAll('.link-row').forEach(row => {
    const cols = row.querySelectorAll('td');
    rows.push([
      cols[0].querySelector('.url-original')?.textContent.trim()||'',
      cols[1].querySelector('.url-short')?.textContent.trim()||'',
      cols[2].querySelector('.click-badge')?.textContent.trim()||'0',
      cols[4]?.querySelector('.date-text')?.textContent.trim()||''
    ]);
  });
  const csv = rows.map(r=>r.map(c=>`"${c}"`).join(',')).join('\n');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv],{type:'text/csv'}));
  a.download = 'snaplink-export.csv'; a.click();
}

// Bulk CSV import
function loadCSV(input) {
  const reader = new FileReader();
  reader.onload = e => {
    const lines = e.target.result.split('\n').map(l=>l.trim()).filter(l=>l.startsWith('http'));
    document.querySelector('textarea[name=urls]').value = lines.join('\n');
  };
  reader.readAsText(input.files[0]);
}

// Export bulk results
function exportBulkCSV() {
  const rows = [['Original URL','Short URL']];
  document.querySelectorAll('.bulk-row').forEach(row => {
    rows.push([row.querySelector('.bulk-original')?.textContent.trim()||'', row.querySelector('.bulk-short')?.textContent.trim()||'']);
  });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([rows.map(r=>r.map(c=>`"${c}"`).join(',')).join('\n')],{type:'text/csv'}));
  a.download = 'bulk-results.csv'; a.click();
}

// QR
let currentQRUrl = '';
function openQR(url, code) {
  currentQRUrl = url;
  document.getElementById('qrUrl').textContent = url;
  document.getElementById('qrModalBg').classList.add('open');
  document.getElementById('qr-canvas-wrap').innerHTML = '<canvas id="qrCanvas"></canvas>';
  QRCode.toCanvas(document.getElementById('qrCanvas'), url, {width:200,margin:2,color:{dark:'#000',light:'#fff'}}, err => { if(err) console.error(err); });
}
function closeQR(e) { if (e.target===document.getElementById('qrModalBg')) closeQRBtn(); }
function closeQRBtn() { document.getElementById('qrModalBg').classList.remove('open'); }
function downloadQR() {
  const canvas = document.querySelector('#qr-canvas-wrap canvas');
  if (!canvas) return;
  const a = document.createElement('a'); a.download = 'snaplink-qr.png'; a.href = canvas.toDataURL('image/png'); a.click();
}
function copyQRUrl() {
  navigator.clipboard.writeText(currentQRUrl).then(() => {
    const btn = document.querySelector('.btn-modal-copy');
    btn.textContent = 'Copied!'; setTimeout(() => btn.textContent = 'Copy URL', 2000);
  });
}
document.addEventListener('keydown', e => { if (e.key==='Escape') closeQRBtn(); });
</script>
</body>
</html>
