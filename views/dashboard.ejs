<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard — SnapLink</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&display=swap"
    rel="stylesheet" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
  <script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>

  <style>
    /* ── QR Button ── */
    .btn-qr {
      padding: 4px 10px;
      font-size: 11px;
      font-family: 'DM Mono', monospace;
      background: transparent;
      border: 0.5px solid var(--border);
      border-radius: 6px;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-qr:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    /* ── Analytics Button ── */
    .btn-analytics {
      padding: 4px 10px;
      font-size: 11px;
      font-family: 'DM Mono', monospace;
      background: transparent;
      border: 0.5px solid var(--border);
      border-radius: 6px;
      color: var(--text-muted);
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
      display: inline-block;
    }

    .btn-analytics:hover {
      border-color: #5DCAA5;
      color: #5DCAA5;
    }

    /* ── QR Modal ── */
    .qr-modal-bg {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(4px);
    }

    .qr-modal-bg.open {
      display: flex;
    }

    .qr-modal {
      background: var(--card-bg, #1a1a18);
      border: 0.5px solid var(--border, #2a2a28);
      border-radius: 16px;
      padding: 2rem;
      text-align: center;
      width: 300px;
      position: relative;
      animation: popIn 0.25s ease;
    }

    @keyframes popIn {
      from {
        transform: scale(0.9);
        opacity: 0;
      }

      to {
        transform: scale(1);
        opacity: 1;
      }
    }

    .qr-modal-close {
      position: absolute;
      top: 12px;
      right: 14px;
      background: none;
      border: none;
      color: var(--text-muted, #666);
      font-size: 18px;
      cursor: pointer;
      line-height: 1;
    }

    .qr-modal-close:hover {
      color: var(--text, #f0f0ee);
    }

    .qr-modal-title {
      font-family: 'Syne', sans-serif;
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 4px;
      color: var(--text, #f0f0ee);
    }

    .qr-modal-url {
      font-size: 11px;
      font-family: 'DM Mono', monospace;
      color: var(--accent, #FAC775);
      margin-bottom: 1.2rem;
      word-break: break-all;
    }

    #qr-canvas-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      background: #ffffff;
      border-radius: 10px;
      padding: 12px;
      margin-bottom: 1rem;
    }

    #qr-canvas-wrap canvas {
      display: block;
    }

    .qr-actions {
      display: flex;
      gap: 8px;
      justify-content: center;
    }

    .btn-download {
      padding: 8px 18px;
      font-size: 12px;
      font-family: 'DM Mono', monospace;
      background: var(--accent, #FAC775);
      color: #1a1a18;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 500;
      transition: opacity 0.2s;
    }

    .btn-download:hover {
      opacity: 0.85;
    }

    .btn-modal-copy {
      padding: 8px 18px;
      font-size: 12px;
      font-family: 'DM Mono', monospace;
      background: transparent;
      color: var(--text-muted, #666);
      border: 0.5px solid var(--border, #2a2a28);
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-modal-copy:hover {
      border-color: var(--text-muted, #666);
      color: var(--text, #f0f0ee);
    }
  </style>
</head>

<body>

  <nav>
    <a class="nav-logo" href="/">
      <span class="logo-dot"></span>
      Snap<em>Link</em>
    </a>
    <div class="nav-right">
      <button class="btn-theme" onclick="toggleTheme()" id="theme-btn">🌙</button>
      <% if (user) { %>
        <div class="nav-user">
          <div class="nav-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
          <span class="nav-username"><%= user.name %></span>
        </div>
        <a href="/logout" class="btn-logout">Logout</a>
      <% } else { %>
        <a href="/login" class="btn-logout">Login</a>
      <% } %>
    </div>
  </nav>

  <main>

    <!-- Page Header -->
    <div class="page-header">
      <h1>My <span>Links</span></h1>
      <p>Saari short URLs aur unki analytics ek jagah</p>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">Total URLs</div>
        <div class="stat-value accent">
          <%= urls.length %>
        </div>
        <div class="stat-sub">banaye gaye links</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Total Clicks</div>
        <div class="stat-value">
          <%= urls.reduce((sum, u)=> sum + (u.clicks || 0), 0) %>
        </div>
        <div class="stat-sub">across all links</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Most Clicked</div>
        <div class="stat-value">
          <%= urls.length ? Math.max(...urls.map(u=> u.clicks || 0)) : 0 %>
        </div>
        <div class="stat-sub">
          <% const top=urls.length ? urls.reduce((a, b)=> (a.clicks||0) > (b.clicks||0) ? a : b, urls[0]) : null; %>
            <%= top ? '/' + top.shortCode : 'koi link nahi' %>
        </div>
      </div>
    </div>

    <!-- Table -->
    <div class="table-section">
      <div class="table-header">
        <span class="table-title">All Links</span>
        <span class="table-count">
          <%= urls.length %> total
        </span>
      </div>

      <% if (urls.length===0) { %>
        <div class="empty-state">
          <div class="empty-icon">🔗</div>
          <h3>Koi URL nahi mili</h3>
          <p>Abhi tak koi short URL nahi banaya</p>
          <a href="/">Pehla link banao →</a>
        </div>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>Link</th>
                <th>Short URL</th>
                <th>Clicks</th>
                <th class="hide-mobile">Last Click</th>
                <th class="hide-mobile">Created</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% urls.forEach(url=> { %>
                <tr>
                  <td class="td-url">
                    <span class="url-original" title="<%= url.orginalUrl %>">
                      <%= url.orginalUrl %>
                    </span>
                  </td>
                  <td>
                    <a class="url-short" href="/<%= url.shortCode %>" target="_blank">
                      <%= url.shortUrl %>
                    </a>
                  </td>
                  <td>
                    <span class="click-badge <%= url.clicks === 0 ? 'zero' : '' %>">
                      <% if (url.clicks> 0) { %>▲<% } %>
                          <%= url.clicks || 0 %>
                    </span>
                  </td>
                  <td class="hide-mobile">
                    <span class="date-text">
                      <%= url.lastClickedAt ? new Date(url.lastClickedAt).toLocaleDateString('en-IN', {day:'numeric',
                        month:'short'}) : '—' %>
                    </span>
                  </td>
                  <td class="hide-mobile">
                    <span class="date-text">
                      <%= new Date(url.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short',
                        year:'2-digit'}) %>
                    </span>
                  </td>
                  <td style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                    <button class="btn-copy" onclick="copyUrl('<%= url.shortUrl %>', this)">Copy</button>

                    <%# QR Code button %>
                      <button class="btn-qr" onclick="openQR('<%= url.shortUrl %>', '<%= url.shortCode %>')">QR</button>

                      <%# Analytics button %>
                        <a class="btn-analytics" href="/analytics/<%= url.shortCode %>">📊</a>

                        <form action="/delete/<%= url.shortCode %>" method="POST" style="margin:0">
                          <button class="btn-delete" type="submit" onclick="return confirm('Delete karo?')">✕</button>
                        </form>
                  </td>
                </tr>
                <% }) %>
            </tbody>
          </table>
          <% } %>
    </div>

  </main>

  <!-- QR Modal -->
  <div class="qr-modal-bg" id="qrModalBg" onclick="closeQR(event)">
    <div class="qr-modal">
      <button class="qr-modal-close" onclick="closeQRBtn()">✕</button>
      <div class="qr-modal-title">QR Code</div>
      <div class="qr-modal-url" id="qrUrl"></div>
      <div id="qr-canvas-wrap">
        <canvas id="qrCanvas"></canvas>
      </div>
      <div class="qr-actions">
        <button class="btn-download" onclick="downloadQR()">Download</button>
        <button class="btn-modal-copy" onclick="copyQRUrl()">Copy URL</button>
      </div>
    </div>
  </div>

  <!-- QRCode.js library -->
  <!-- <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script> -->
  <!-- ✅ Yeh lagao -->
  <script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>

  <script>
    // ── Theme toggle ──
    function toggleTheme() {
      const html = document.documentElement;
      const isDark = html.getAttribute('data-theme') === 'dark';
      const next = isDark ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      document.getElementById('theme-btn').textContent = next === 'dark' ? '🌙' : '☀️';
    }
    const saved = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', saved);
    document.getElementById('theme-btn').textContent = saved === 'dark' ? '🌙' : '☀️';

    // ── Copy URL ──
    function copyUrl(url, btn) {
      navigator.clipboard.writeText(url).then(() => {
        btn.textContent = 'Copied!';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('copied');
        }, 2000);
      });
    }

    // ── QR Code ──
    let currentQRUrl = '';
    function openQR(url, code) {
      currentQRUrl = url;
      document.getElementById('qrUrl').textContent = url;
      document.getElementById('qrModalBg').classList.add('open');

      // Canvas clear karo
      const wrap = document.getElementById('qr-canvas-wrap');
      wrap.innerHTML = '<canvas id="qrCanvas"></canvas>';

      // ✅ Naya library use karo
      QRCode.toCanvas(document.getElementById('qrCanvas'), url, {
        width: 200,
        margin: 2,
        color: {
          dark: '#000000',
          light: '#ffffff'
        }
      }, function (error) {
        if (error) console.error(error);
      });
    }


    function closeQR(e) {
      if (e.target === document.getElementById('qrModalBg')) {
        document.getElementById('qrModalBg').classList.remove('open');
      }
    }

    function closeQRBtn() {
      document.getElementById('qrModalBg').classList.remove('open');
    }

    function downloadQR() {
      const canvas = document.querySelector('#qr-canvas-wrap canvas');
      if (!canvas) return;
      const link = document.createElement('a');
      link.download = 'snaplink-qr.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
    }

    function copyQRUrl() {
      navigator.clipboard.writeText(currentQRUrl).then(() => {
        const btn = document.querySelector('.btn-modal-copy');
        btn.textContent = 'Copied!';
        setTimeout(() => btn.textContent = 'Copy URL', 2000);
      });
    }

    // ESC se modal band karo
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeQRBtn();
    });
  </script>

</body>

</html>