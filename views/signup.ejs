<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up — SnapLink</title>
  <link rel="stylesheet" href="/css/pages/signup.css">
  <link rel="icon" type="image/png" href="/favicon.png">
</head>
<body>

  <nav class="navbar">
    <a href="/" class="logo">
      <span class="logo-dot"></span>
      Snap<span>Link</span>
    </a>
    <div class="nav-right">
      <button class="theme-btn" id="themeBtn" onclick="toggleTheme()">🌙</button>
      <a href="/login" class="nav-link">Pehle se account hai? <strong>Log in</strong></a>
    </div>
  </nav>

  <main class="page-center">
    <div class="card">

      <!-- Left decorative panel -->
      <div class="card-left">
        <div class="brand-icon">⚡</div>
        <h1>Shorten.<br>Share.<br>Track.</h1>
        <p>Free account banao aur long URLs ko clean, powerful links mein badlo — seconds mein.</p>
        <ul class="features">
          <li><span class="dot"></span> 10 free links per month</li>
          <li><span class="dot"></span> Click analytics</li>
          <li><span class="dot"></span> QR Code generator</li>
          <li><span class="dot"></span> Custom aliases</li>
        </ul>
      </div>

      <!-- Right form panel -->
      <div class="card-right">

        <div class="form-header">
          <h2>Account banao ✨</h2>
          <p>Free hai. Koi credit card nahi chahiye.</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error">⚠ <%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success">✓ <%= success %></div>
        <% } %>

        <form action="/signup" method="POST" class="form" novalidate>

          <div class="form-row">
            <div class="form-group">
              <label for="firstName">First name</label>
              <input type="text" id="firstName" name="firstName" placeholder="Azmat" required
                value="<%= typeof formData !== 'undefined' ? formData.firstName || '' : '' %>">
            </div>
            <div class="form-group">
              <label for="lastName">Last name</label>
              <input type="text" id="lastName" name="lastName" placeholder="Ali" required
                value="<%= typeof formData !== 'undefined' ? formData.lastName || '' : '' %>">
            </div>
          </div>

          <div class="form-group">
            <label for="email">Email address</label>
            <input type="email" id="email" name="email" placeholder="tum@example.com" required
              value="<%= typeof formData !== 'undefined' ? formData.email || '' : '' %>">
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <div class="input-wrap">
              <input type="password" id="password" name="password"
                placeholder="Min. 8 characters" required minlength="8">
              <button type="button" class="eye-btn" id="togglePass" title="Show password">
                <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            </div>
            <div class="strength-bar" id="strengthBar">
              <span></span><span></span><span></span><span></span>
            </div>
            <p class="strength-label" id="strengthLabel"></p>
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm password</label>
            <input type="password" id="confirmPassword" name="confirmPassword"
              placeholder="Dobara likho" required>
          </div>

          <div class="checkbox-group">
            <input type="checkbox" id="terms" name="terms" required>
            <label for="terms">
              Main <a href="/terms">Terms of Service</a> aur <a href="/privacy">Privacy Policy</a> se agree karta/karti hoon
            </label>
          </div>

          <button type="submit" class="btn-submit">Account banao →</button>

        </form>

        <p class="login-hint">Pehle se account hai? <a href="/login">Log in karo</a></p>

      </div>
    </div>
  </main>

  <script src="/js/shared/theme.js"></script>
  <script>
    // Eye toggle
    const togglePass = document.getElementById('togglePass');
    const passInput  = document.getElementById('password');
    togglePass.addEventListener('click', () => {
      passInput.type = passInput.type === 'password' ? 'text' : 'password';
    });

    // Password strength
    passInput.addEventListener('input', () => {
      const val = passInput.value;
      const bar = document.getElementById('strengthBar');
      const lbl = document.getElementById('strengthLabel');
      bar.className = 'strength-bar';
      if (!val) { lbl.textContent = ''; return; }
      let score = 0;
      if (val.length >= 8) score++;
      if (/[A-Z]/.test(val)) score++;
      if (/[0-9]/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val)) score++;
      const levels = ['', 's1', 's2', 's3', 's4'];
      const labels = ['', 'Kamzor', 'Theek', 'Achha', 'Bahut strong'];
      bar.classList.add(levels[score]);
      lbl.textContent = labels[score];
    });
  </script>

</body>
</html>



