<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: 'Sign Up | Create Your SnapLink Account',
      description: 'Create a SnapLink account to start shortening URLs, tracking analytics, and unlocking branded link workflows.',
      path: '/signup',
      robots: 'noindex, nofollow',
      stylesheets: ['/css/pages/site-shell.css', '/css/pages/marketing-pages.css', '/css/pages/auth-shell.css']
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
</head>
<body class="site-page auth-page">
  <%- include('partials/auth-navbar', { helperLinkHref: '/login', helperLinkLabel: 'Log in', helperCopyText: 'Already have an account?' }) %>

  <main class="auth-main">
    <section class="auth-shell">
      <aside class="auth-aside">
        <div class="auth-kicker">Create account</div>
        <h1 class="auth-title">Create your account.</h1>
        <p class="auth-copy">Start free and shorten your first link in a minute.</p>
      </aside>

      <div class="auth-card">
        <div class="auth-kicker">Open your account</div>
        <h2 class="auth-title">Create your SnapLink profile.</h2>
        <p class="auth-copy">No card required.</p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="inline-alert error"><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="inline-alert success"><%= success %></div>
        <% } %>

        <form action="/signup" method="POST" class="auth-form" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="firstName">First name</label>
              <input class="auth-input" type="text" id="firstName" name="firstName" placeholder="First name" required value="<%= typeof formData !== 'undefined' ? formData.firstName || '' : '' %>">
            </div>
            <div class="form-group">
              <label for="lastName">Last name</label>
              <input class="auth-input" type="text" id="lastName" name="lastName" placeholder="Last name" required value="<%= typeof formData !== 'undefined' ? formData.lastName || '' : '' %>">
            </div>
          </div>

          <div class="form-group">
            <label for="email">Email address</label>
            <input class="auth-input" type="email" id="email" name="email" placeholder="you@example.com" required value="<%= typeof formData !== 'undefined' ? formData.email || '' : '' %>">
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <div class="input-wrap">
              <input class="auth-input" type="password" id="password" name="password" placeholder="Create a password" minlength="8" required>
              <button type="button" class="eye-btn" id="togglePass" aria-label="Toggle password visibility">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
            <div class="strength-bar" id="strengthBar">
              <span></span><span></span><span></span><span></span>
            </div>
            <p class="form-note" id="strengthLabel"></p>
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm password</label>
            <input class="auth-input" type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm password" required>
          </div>

          <label class="checkbox-row" for="terms">
            <input type="checkbox" id="terms" name="terms" required>
            <span>I agree to the <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>.</span>
          </label>

          <button type="submit" class="btn-submit">Create account</button>
        </form>

        <p class="auth-hint">Already registered? <a href="/login">Log in here.</a></p>
      </div>
    </section>
  </main>

  <script src="/js/shared/theme.js"></script>
  <script>
    const togglePass = document.getElementById('togglePass');
    const passInput = document.getElementById('password');
    const strengthBar = document.getElementById('strengthBar');
    const strengthLabel = document.getElementById('strengthLabel');

    if (togglePass && passInput) {
      togglePass.addEventListener('click', () => {
        passInput.type = passInput.type === 'password' ? 'text' : 'password';
      });

      passInput.addEventListener('input', () => {
        const value = passInput.value;
        strengthBar.className = 'strength-bar';
        if (!value) {
          strengthLabel.textContent = '';
          return;
        }

        let score = 0;
        if (value.length >= 8) score += 1;
        if (/[A-Z]/.test(value)) score += 1;
        if (/[0-9]/.test(value)) score += 1;
        if (/[^A-Za-z0-9]/.test(value)) score += 1;

        const labels = ['', 'Weak', 'Fair', 'Good', 'Strong'];
        strengthBar.classList.add(`s${score}`);
        strengthLabel.textContent = labels[score];
      });
    }
  </script>
</body>
</html>
