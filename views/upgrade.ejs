<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Upgrade — SnapLink</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/home.css"/>
  <style>
    .upgrade-wrap {
      max-width: 480px;
      margin: 4rem auto;
      padding: 0 1.5rem;
    }
    .upgrade-card {
      background: var(--card);
      border: 0.5px solid var(--border);
      border-radius: 16px;
      padding: 2rem;
      animation: fadeUp 0.5s ease both;
    }
    .upgrade-card.pro-card  { border-color: var(--accent); }
    .upgrade-card.biz-card  { border-color: #7EB8F7; }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--text2);
      text-decoration: none;
      margin-bottom: 1.5rem;
      font-family: 'DM Mono', monospace;
    }
    .back-link:hover { color: var(--accent); }

    .upgrade-plan-name {
      font-family: 'Syne', sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 6px;
    }
    .upgrade-title {
      font-family: 'Syne', sans-serif;
      font-size: 1.8rem;
      font-weight: 800;
      letter-spacing: -1px;
      margin-bottom: 1.5rem;
    }

    /* Billing toggle */
    .billing-row {
      display: flex;
      gap: 8px;
      margin-bottom: 1.5rem;
    }
    .billing-opt {
      flex: 1;
      padding: 10px;
      background: var(--surface);
      border: 0.5px solid var(--border);
      border-radius: 8px;
      font-size: 12px;
      font-family: 'DM Mono', monospace;
      cursor: pointer;
      text-align: center;
      transition: all 0.2s;
      color: var(--text2);
    }
    .billing-opt.active {
      border-color: var(--accent);
      color: var(--accent);
      background: var(--card);
    }
    .billing-opt .save {
      display: block;
      font-size: 10px;
      color: var(--green);
      margin-top: 2px;
    }

    /* Price display */
    .price-display {
      text-align: center;
      margin-bottom: 1.5rem;
      padding: 1.5rem;
      background: var(--surface);
      border-radius: 10px;
      border: 0.5px solid var(--border);
    }
    .price-big {
      font-family: 'Syne', sans-serif;
      font-size: 3rem;
      font-weight: 800;
      letter-spacing: -2px;
      color: var(--accent);
    }
    .price-sub {
      font-size: 12px;
      color: var(--muted);
      font-family: 'DM Mono', monospace;
      margin-top: 4px;
    }

    /* Features */
    .upgrade-features {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 1.5rem;
    }
    .upgrade-features li {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--text2);
    }
    .upgrade-features li span:first-child {
      color: var(--green);
      font-weight: 700;
      flex-shrink: 0;
    }

    /* Pay button */
    .pay-btn {
      width: 100%;
      padding: 14px;
      background: var(--accent);
      color: #1a1a18;
      font-size: 14px;
      font-weight: 700;
      font-family: 'Syne', sans-serif;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .pay-btn:hover { background: var(--accent-dark); transform: translateY(-1px); }
    .pay-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

    .secure-note {
      text-align: center;
      font-size: 11px;
      color: var(--muted);
      margin-top: 10px;
      font-family: 'DM Mono', monospace;
    }

    .success-box {
      display: none;
      text-align: center;
      padding: 2rem;
    }
    .success-box .success-icon { font-size: 3rem; margin-bottom: 1rem; }
    .success-box h2 {
      font-family: 'Syne', sans-serif;
      font-size: 1.4rem;
      font-weight: 800;
      margin-bottom: 6px;
    }
    .success-box p { font-size: 13px; color: var(--text2); margin-bottom: 1.5rem; }
    .success-box a {
      display: inline-block;
      padding: 10px 24px;
      background: var(--accent);
      color: #1a1a18;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 700;
      font-family: 'Syne', sans-serif;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar">
    <a href="/" class="nav-logo"><span class="logo-dot"></span>Snap<em>Link</em></a>
    <div class="nav-right">
      <button class="theme-btn" id="themeBtn" onclick="toggleTheme()">🌙</button>
      <% if (user) { %>
        <div class="nav-user">
          <div class="nav-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
          <span class="nav-username"><%= user.name %></span>
        </div>
        <a href="/logout" class="nav-btn-outline">Logout</a>
      <% } %>
    </div>
  </nav>

  <div class="upgrade-wrap">
    <a href="/pricing" class="back-link">← Pricing pe wapas</a>

    <div class="upgrade-card <%= plan === 'pro' ? 'pro-card' : 'biz-card' %>">

      <!-- Success box (hidden by default) -->
      <div class="success-box" id="successBox">
        <div class="success-icon">🎉</div>
        <h2>Welcome to <span style="color:var(--accent)"><%= plan.charAt(0).toUpperCase() + plan.slice(1) %></span>!</h2>
        <p>Tera plan upgrade ho gaya. Ab sab features unlock hain!</p>
        <a href="/dashboard">Dashboard pe jao →</a>
      </div>

      <!-- Payment form -->
      <div id="paymentForm">
        <div class="upgrade-plan-name"><%= plan.toUpperCase() %> PLAN</div>
        <h1 class="upgrade-title">Upgrade karo 🚀</h1>

        <!-- Billing options -->
        <div class="billing-row">
          <div class="billing-opt active" id="opt-monthly" onclick="selectBilling('monthly')">
            Monthly
            <span class="save">&nbsp;</span>
          </div>
          <div class="billing-opt" id="opt-yearly" onclick="selectBilling('yearly')">
            Yearly
            <span class="save">2 months free!</span>
          </div>
        </div>

        <!-- Price -->
        <div class="price-display">
          <div class="price-big" id="priceDisplay">
            ₹<span id="priceNum"><%= plan === 'pro' ? '99' : '299' %></span>
          </div>
          <div class="price-sub" id="priceSub">per month</div>
        </div>

        <!-- Features -->
        <ul class="upgrade-features">
          <% if (plan === 'pro') { %>
            <li><span>✓</span> Unlimited URLs</li>
            <li><span>✓</span> Full analytics</li>
            <li><span>✓</span> Custom alias</li>
            <li><span>✓</span> Password protected links</li>
            <li><span>✓</span> Link expiry date</li>
            <li><span>✓</span> Bulk shortener</li>
            <li><span>✓</span> API access + CSV export</li>
          <% } else { %>
            <li><span>✓</span> Sab Pro features</li>
            <li><span>✓</span> 5 team members</li>
            <li><span>✓</span> Custom domain</li>
            <li><span>✓</span> White label</li>
            <li><span>✓</span> Priority support + SLA</li>
          <% } %>
        </ul>

        <button class="pay-btn" id="payBtn" onclick="startPayment()">
          🔒 Secure Payment karo
        </button>
        <p class="secure-note">Razorpay se secure payment • UPI, Card, Net Banking</p>
      </div>

    </div>
  </div>

  <%- include('partials/footer') %>

  <!-- Razorpay SDK -->
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <script>
    // Theme
    const saved = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', saved);
    document.getElementById('themeBtn').textContent = saved === 'dark' ? '🌙' : '☀️';
    function toggleTheme() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const next = isDark ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      document.getElementById('themeBtn').textContent = next === 'dark' ? '🌙' : '☀️';
    }

    // Plan data
    const plan = '<%= plan %>';
    const prices = {
      pro:      { monthly: 99,  yearly: 990  },
      business: { monthly: 299, yearly: 2990 },
    };
    let billing = 'monthly';

    function selectBilling(type) {
      billing = type;
      document.getElementById('opt-monthly').classList.toggle('active', type === 'monthly');
      document.getElementById('opt-yearly').classList.toggle('active',  type === 'yearly');
      document.getElementById('priceNum').textContent = prices[plan][type];
      document.getElementById('priceSub').textContent = type === 'yearly' ? 'per year (2 months free!)' : 'per month';
    }

    async function startPayment() {
      const btn = document.getElementById('payBtn');
      btn.disabled = true;
      btn.textContent = 'Order create ho raha hai...';

      try {
        // ✅ Step 1 — Order create karo
        const orderRes = await fetch('/payment/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ plan, billing }),
        });
        const order = await orderRes.json();

        if (!order.orderId) throw new Error('Order nahi bana');

        // ✅ Step 2 — Razorpay checkout open karo
        const options = {
          key:         '<%= razorpayKeyId %>',
          amount:      order.amount,
          currency:    order.currency,
          order_id:    order.orderId,
          name:        'SnapLink',
          description: `${plan.charAt(0).toUpperCase() + plan.slice(1)} Plan — ${billing}`,
          handler: async function(response) {
            // ✅ Step 3 — Payment verify karo
            const verifyRes = await fetch('/payment/verify', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                razorpay_order_id:   response.razorpay_order_id,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_signature:  response.razorpay_signature,
                plan,
                billing,
              }),
            });
            const result = await verifyRes.json();
            if (result.success) {
              document.getElementById('paymentForm').style.display = 'none';
              document.getElementById('successBox').style.display  = 'block';
            }
          },
          prefill: {
            name:  '<%= user ? user.name : "" %>',
            email: '',
          },
          theme: { color: '#FAC775' },
          modal: {
            ondismiss: function() {
              btn.disabled = false;
              btn.innerHTML = '🔒 Secure Payment karo';
            }
          }
        };

        const rzp = new Razorpay(options);
        rzp.open();

      } catch (error) {
        console.error(error);
        btn.disabled = false;
        btn.textContent = '❌ Error — Try Again';
        setTimeout(() => {
          btn.innerHTML = '🔒 Secure Payment karo';
        }, 2000);
      }
    }
  </script>

</body>
</html>
