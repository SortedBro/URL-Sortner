<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: `Upgrade to ${plan === 'business' ? 'Business' : 'Pro'} | SnapLink`,
      description: 'Choose the plan that matches your SnapLink workflow and complete secure checkout for advanced features.',
      path: '/upgrade',
      robots: 'noindex, nofollow',
      stylesheets: ['/css/pages/site-shell.css', '/css/pages/marketing-pages.css', '/css/pages/auth-shell.css']
    };
    const planName = plan === 'business' ? 'Business' : 'Pro';
    const priceMap = {
      pro: { monthly: 99, yearly: 990 },
      business: { monthly: 299, yearly: 2990 }
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
</head>
<body class="site-page upgrade-page">
  <%- include('partials/site-navbar', { currentPage: 'pricing' }) %>

  <main class="auth-main">
    <section class="upgrade-shell">
      <aside class="upgrade-summary">
        <div class="auth-kicker"><%= planName %> plan</div>
        <h1 class="upgrade-title">Move into <span><%= planName %></span>.</h1>
        <p class="upgrade-copy">Secure checkout for the features that unlock higher link volume, stronger analytics, and better branding control.</p>
        <div class="upgrade-points">
          <% if (plan === 'pro') { %>
            <div class="upgrade-point"><strong>Unlimited links</strong><p class="section-copy">Publish without the free monthly cap.</p></div>
            <div class="upgrade-point"><strong>API and exports</strong><p class="section-copy">Programmatic creation and CSV access for growth workflows.</p></div>
            <div class="upgrade-point"><strong>Advanced controls</strong><p class="section-copy">Custom aliases, password locks, expiry dates, and bulk shortening.</p></div>
          <% } else { %>
            <div class="upgrade-point"><strong>White-label delivery</strong><p class="section-copy">Use your own domain, logo, and branded identity.</p></div>
            <div class="upgrade-point"><strong>Team operations</strong><p class="section-copy">Add seats, automate with webhooks, and manage shared reporting.</p></div>
            <div class="upgrade-point"><strong>Business workflows</strong><p class="section-copy">Weekly reports, priority response paths, and business support features.</p></div>
          <% } %>
        </div>
      </aside>

      <div class="upgrade-card">
        <div id="paymentForm" class="upgrade-form">
          <div class="auth-kicker">Secure checkout</div>
          <h2 class="upgrade-title">Choose your billing cycle.</h2>
          <p class="upgrade-copy">Switch between monthly and yearly before continuing to Razorpay checkout.</p>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="inline-alert error"><%= error %></div>
          <% } %>

          <div class="upgrade-switch-row">
            <button type="button" class="upgrade-switch is-active" id="opt-monthly" onclick="selectBilling('monthly')">Monthly</button>
            <button type="button" class="upgrade-switch" id="opt-yearly" onclick="selectBilling('yearly')">Yearly</button>
          </div>

          <div class="upgrade-price">
            <strong id="priceNum">Rs <%= priceMap[plan].monthly %></strong>
            <span id="priceSub">per month</span>
          </div>

          <div class="upgrade-points">
            <% if (plan === 'pro') { %>
              <div class="upgrade-point"><strong>Includes</strong><p class="section-copy">Unlimited URLs, full analytics, bulk shortener, exports, password protection, expiry, and API access.</p></div>
            <% } else { %>
              <div class="upgrade-point"><strong>Includes</strong><p class="section-copy">Everything in Pro plus white label, custom domain, team seats, webhook support, and weekly reports.</p></div>
            <% } %>
          </div>

          <button class="upgrade-pay-btn" id="payBtn" type="button" onclick="startPayment()">Continue to secure payment</button>
          <p class="secure-note">Checkout is processed through Razorpay and supports UPI, cards, net banking, and wallets.</p>
        </div>

        <div class="success-box" id="successBox">
          <div class="auth-kicker">Payment complete</div>
          <h3>Welcome to <%= planName %>.</h3>
          <p>Your account upgrade is complete. Open the dashboard to start using your new features.</p>
          <div class="btn-row">
            <a href="/dashboard" class="btn-primary">Open dashboard</a>
            <a href="/pricing" class="btn-secondary">Back to pricing</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script src="/js/shared/theme.js"></script>
  <script>
    const plan = '<%= plan %>';
    const prices = {
      pro: { monthly: 99, yearly: 990 },
      business: { monthly: 299, yearly: 2990 }
    };
    let billing = 'monthly';

    function selectBilling(type) {
      billing = type;
      document.getElementById('opt-monthly').classList.toggle('is-active', type === 'monthly');
      document.getElementById('opt-yearly').classList.toggle('is-active', type === 'yearly');
      document.getElementById('priceNum').textContent = `Rs ${prices[plan][type]}`;
      document.getElementById('priceSub').textContent = type === 'yearly' ? 'per year' : 'per month';
    }

    async function startPayment() {
      const btn = document.getElementById('payBtn');
      btn.disabled = true;
      btn.textContent = 'Creating order...';

      try {
        const orderRes = await fetch('/payment/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ plan, billing })
        });
        const order = await orderRes.json();
        if (!order.orderId) throw new Error('Order creation failed');

        const options = {
          key: '<%= razorpayKeyId || '' %>',
          amount: order.amount,
          currency: order.currency,
          order_id: order.orderId,
          name: 'SnapLink',
          description: `${plan} ${billing}`,
          handler: async function (response) {
            const verifyRes = await fetch('/payment/verify', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                razorpay_order_id: response.razorpay_order_id,
                razorpay_payment_id: response.razorpay_payment_id,
                razorpay_signature: response.razorpay_signature,
                plan,
                billing
              })
            });
            const result = await verifyRes.json();
            if (result.success) {
              document.getElementById('paymentForm').style.display = 'none';
              document.getElementById('successBox').classList.add('is-visible');
            }
          },
          theme: { color: '#f4c96c' },
          modal: {
            ondismiss: function () {
              btn.disabled = false;
              btn.textContent = 'Continue to secure payment';
            }
          }
        };

        const rzp = new Razorpay(options);
        rzp.open();
      } catch (error) {
        btn.disabled = false;
        btn.textContent = 'Try again';
      }
    }
  </script>
</body>
</html>
