<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About — SnapLink</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
        href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap"
        rel="stylesheet">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="/css/pages/home.css">
    <link rel="stylesheet" href="/css/pages/about.css">
    
</head>

<body>

    <!-- ═══ NAVBAR ═══ -->
    <nav class="navbar">
        <a href="/" class="nav-logo">
            <span class="logo-dot"></span>
            Snap<em>Link</em>
        </a>
        <div class="nav-center">
            <a href="/" class="nav-link">Home</a>
            <a href="/features" class="nav-link">Features</a>
            <a href="/pricing" class="nav-link">Pricing</a>
            <a href="/about" class="nav-link" style="color:var(--accent)">About</a>
        </div>
        <div class="nav-right">
            <button class="theme-btn" id="themeBtn" onclick="toggleTheme()">🌙</button>
            <% if (typeof user !=='undefined' && user) { %>
                <div class="nav-user">
                    <div class="nav-avatar">
                        <%= user.name.charAt(0).toUpperCase() %>
                    </div>
                    <span class="nav-username">
                        <%= user.name %>
                    </span>
                </div>
                <a href="/dashboard" class="nav-link">Dashboard</a>
                <a href="/logout" class="nav-btn-outline">Logout</a>
                <% } else { %>
                    <a href="/login" class="nav-link">Login</a>
                    <a href="/signup" class="nav-btn-solid">Get Started</a>
                    <% } %>
        </div>
    </nav>

    <main>

        <!-- ═══ HERO ═══ -->
        <section class="about-hero">
            <div class="avatar-wrap">
                <div class="avatar-circle">AA</div>
                <div class="avatar-status"></div>
            </div>
            <div class="about-badge">⚡ Backend Developer</div>
            <h1 class="about-title">Hey, I'm <span>Azmat Ali</span></h1>
            <p class="about-tagline">A passionate backend developer building real-world projects with Node.js, Express &
                MongoDB.</p>
            <div class="hero-btns">
                <a href="mailto:tajmatali311@gmail.com" class="btn-primary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </svg>
                    Get in Touch
                </a>
                <a href="https://github.com/SortedBro" target="_blank" class="btn-outline">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <path
                            d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.38.6.11.82-.26.82-.58v-2.03c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3-.4c1.02 0 2.04.13 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
                    </svg>
                    View GitHub
                </a>
            </div>
        </section>

        <hr class="section-divider">

        <!-- ═══ ABOUT ═══ -->
        <section class="section">
            <div class="two-col">
                <div class="about-text">
                    <h2 class="section-title">About <span>Me</span></h2>
                    <p>I'm Azmat — a self-driven backend developer who loves turning ideas into working products. I
                        built SnapLink as a hands-on project to sharpen my skills in full-stack development.</p>
                    <p>I enjoy solving real problems with clean code, learning new technologies, and sharing knowledge
                        with others in the community.</p>
                    <p>Currently focused on Node.js, REST APIs, JWT authentication, and database design with MongoDB.
                    </p>
                </div>
                <div class="stats-grid">
                    <div class="stat-card">
                        <span class="stat-num">Node</span>
                        <span class="stat-label">Primary Stack</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-num">24/7</span>
                        <span class="stat-label">Learning Mode</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-num">REST</span>
                        <span class="stat-label">API Design</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-num">∞</span>
                        <span class="stat-label">Curiosity</span>
                    </div>
                </div>
            </div>
        </section>

        <hr class="section-divider">

        <!-- ═══ SKILLS ═══ -->
        <section class="section">
            <h2 class="section-title center">My <span>Skills</span></h2>
            <p class="section-sub center">Technologies I work with</p>
            <div class="skills-grid">
                <div class="skill-card">
                    <div class="skill-icon">🟢</div>
                    <div>
                        <h4>Node.js</h4>
                        <p>Backend runtime for fast, scalable server-side apps</p>
                    </div>
                </div>
                <div class="skill-card">
                    <div class="skill-icon">⚙️</div>
                    <div>
                        <h4>Express.js</h4>
                        <p>Minimal web framework for REST APIs and routing</p>
                    </div>
                </div>
                <div class="skill-card">
                    <div class="skill-icon">🍃</div>
                    <div>
                        <h4>MongoDB</h4>
                        <p>NoSQL database for flexible document-based storage</p>
                    </div>
                </div>
                <div class="skill-card">
                    <div class="skill-icon">🔐</div>
                    <div>
                        <h4>JWT Auth</h4>
                        <p>Secure authentication with JSON Web Tokens & bcrypt</p>
                    </div>
                </div>
                <div class="skill-card">
                    <div class="skill-icon">🎨</div>
                    <div>
                        <h4>EJS & CSS</h4>
                        <p>Templating and styling for clean, responsive interfaces</p>
                    </div>
                </div>
                <div class="skill-card">
                    <div class="skill-icon">🐙</div>
                    <div>
                        <h4>Git & GitHub</h4>
                        <p>Version control and open-source project management</p>
                    </div>
                </div>
            </div>
        </section>

        <hr class="section-divider">

        <!-- ═══ CONTACT ═══ -->
        <section class="section">
            <h2 class="section-title center">Get In <span>Touch</span></h2>
            <p class="section-sub center">Have a project idea or just want to say hi?</p>

            <div class="contact-wrap">
                <div class="social-links">
                    <a href="https://github.com/SortedBro" target="_blank" class="social-card">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path
                                d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.38.6.11.82-.26.82-.58v-2.03c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3-.4c1.02 0 2.04.13 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
                        </svg>
                        <div>
                            <h4>GitHub</h4>
                            <p>github.com/SortedBro</p>
                        </div>
                    </a>
                    <a href="https://x.com/AliAzmat35014" target="_blank" class="social-card">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path
                                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                        </svg>
                        <div>
                            <h4>X (Twitter)</h4>
                            <p>@AliAzmat35014</p>
                        </div>
                    </a>
                    <a href="mailto:tajmatali311@gmail.com" class="social-card">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2">
                            <rect x="2" y="4" width="20" height="16" rx="2" />
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                        </svg>
                        <div>
                            <h4>Email</h4>
                            <p>tajmatali311@gmail.com</p>
                        </div>
                    </a>
                    <a href="https://wa.me/918167045246" target="_blank" class="social-card whatsapp">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path
                                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
                        </svg>
                        <div>
                            <h4>WhatsApp</h4>
                            <p>+91 8167045246</p>
                        </div>
                    </a>
                </div>

                <form class="contact-form" action="/contact" method="POST">
                    <div class="form-group">
                        <label>Your Name</label>
                        <input type="text" name="name" placeholder="John Doe" required>
                    </div>
                    <div class="form-group">
                        <label>Your Email</label>
                        <input type="email" name="email" placeholder="you@example.com" required>
                    </div>
                    <div class="form-group">
                        <label>Message</label>
                        <textarea name="message" rows="4" placeholder="Hey Azmat, I wanted to..." required></textarea>
                    </div>
                    <button type="submit" class="btn-submit">Send Message →</button>
                </form>
            </div>
        </section>

    </main>

    <!-- ═══ FOOTER ═══ -->
    <%- include('partials/footer') %>

        <script src="/js/shared/theme.js"></script>
  <script>
        </script>

</body>

</html>


