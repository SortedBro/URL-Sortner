<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: 'About SnapLink | Product Story, Builder, and Contact',
      description: 'Learn how SnapLink was built, what the platform helps teams do, and how to contact the builder behind the product.',
      keywords: 'about snaplink, azmat ali, snaplink founder, contact snaplink, url shortener team',
      path: '/about',
      stylesheets: ['/css/pages/site-shell.css', '/css/pages/marketing-pages.css'],
      jsonLd: {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Azmat Ali',
        jobTitle: 'Backend Developer',
        url: `${appUrl}/about`,
        sameAs: ['https://github.com/SortedBro', 'https://x.com/AliAzmat35014']
      }
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
</head>
<body class="site-page about-page">
  <%- include('partials/site-navbar', { currentPage: 'about' }) %>

  <main class="page-shell page-stack">
    <section class="page-hero">
      <div class="hero-grid">
        <div>
          <div class="eyebrow">About the product</div>
          <h1 class="hero-title">A practical link platform built for <span>daily use</span>.</h1>
          <p class="hero-text">
            SnapLink brings short links, QR codes, analytics, and growth tools into one simple workflow.
          </p>
          <div class="hero-stats">
            <div class="hero-stat"><strong>Node</strong><span>Core application stack</span></div>
            <div class="hero-stat"><strong>API</strong><span>Production routing and integrations</span></div>
            <div class="hero-stat"><strong>Growth</strong><span>Built for creators and teams</span></div>
          </div>
        </div>

        <aside class="person-card">
          <div class="person-avatar">AA</div>
          <div>
            <div class="eyebrow">Builder profile</div>
            <h3>Azmat Ali</h3>
            <p class="person-role">Backend developer focused on clean Node.js products and practical shipping workflows.</p>
          </div>
          <ul class="check-list">
            <li>Builds auth, payments, analytics, and API systems</li>
            <li>Focuses on performance, routing, and operational clarity</li>
            <li>Ships product improvements through live iterations</li>
          </ul>
          <div class="btn-row">
            <a href="https://github.com/SortedBro" target="_blank" rel="noreferrer" class="btn-primary">View GitHub</a>
            <a href="mailto:tajmatali311@gmail.com" class="btn-secondary">Email</a>
          </div>
        </aside>
      </div>
    </section>

    <section class="cards-grid two">
      <article class="section-card">
        <div class="section-kicker">What SnapLink solves</div>
        <h3>One place for publishing and tracking links.</h3>
        <p class="section-copy">
          SnapLink keeps shortening, QR generation, analytics, and branding in one product so the workflow stays easier to manage.
        </p>
        <ul class="check-list">
          <li>Branded aliases and white-label domains</li>
          <li>Analytics for geography, devices, browsers, and referrers</li>
          <li>Business features like API keys, reports, and webhooks</li>
        </ul>
      </article>

      <article class="section-card">
        <div class="section-kicker">How the product is built</div>
        <h3>Built with production-focused choices.</h3>
        <p class="section-copy">
          The app uses server-side rendering, Redis caching, structured controllers, and production routing.
        </p>
        <div class="mini-metrics">
          <div class="mini-metric"><strong>Redis</strong><span>Cache and queue hot paths</span></div>
          <div class="mini-metric"><strong>MongoDB</strong><span>Analytics and link storage</span></div>
          <div class="mini-metric"><strong>Railway</strong><span>Deployment and scaling</span></div>
        </div>
      </article>
    </section>

    <section class="section-card">
      <div class="section-kicker">Contact</div>
      <h2 class="section-title">Reach out for product ideas, integrations, or collaboration.</h2>

      <% if (success) { %>
        <div class="inline-alert success"><%= success %></div>
      <% } %>
      <% if (error) { %>
        <div class="inline-alert error"><%= error %></div>
      <% } %>

      <div class="contact-grid">
        <div class="content-card">
          <h3>Direct channels</h3>
          <ul class="contact-methods">
            <li>Email: tajmatali311@gmail.com</li>
            <li>GitHub: github.com/SortedBro</li>
            <li>X: @AliAzmat35014</li>
            <li>WhatsApp: +91 8167045246</li>
          </ul>
          <p class="section-copy">If you want to discuss a feature build, deployment setup, or product improvement, this is the fastest place to start.</p>
        </div>

        <form class="contact-form content-card" action="/contact" method="POST">
          <div class="form-row">
            <div class="form-group">
              <label for="contactName">Your name</label>
              <input class="form-input" id="contactName" type="text" name="name" placeholder="Your name" required>
            </div>
            <div class="form-group">
              <label for="contactEmail">Your email</label>
              <input class="form-input" id="contactEmail" type="email" name="email" placeholder="you@example.com" required>
            </div>
          </div>
          <div class="form-group">
            <label for="contactMessage">Message</label>
            <textarea class="form-textarea" id="contactMessage" name="message" rows="5" placeholder="Tell me about the feature, issue, or collaboration you want to discuss." required></textarea>
          </div>
          <button type="submit" class="btn-submit">Send message</button>
        </form>
      </div>
    </section>
  </main>

  <%- include('partials/footer', { footerCopy: 'Built in public and improved through real deployment, performance, and product iterations.' }) %>
  <script src="/js/shared/theme.js"></script>
</body>
</html>
