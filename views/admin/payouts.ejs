<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: 'Payout Requests | SnapLink Admin',
      description: 'Review affiliate payout requests and status updates from the SnapLink admin workspace.',
      path: '/admin/payout-requests',
      robots: 'noindex, nofollow',
      stylesheets: ["/css/pages/site-shell.css","/css/pages/generated/admin/payouts.inline.css","/css/pages/app-shell.css"]
    };
  %>
  <%- include('../partials/seo-head', { seo }) %>
</head>
<body class="workspace-page">

<nav class="workspace-nav">
  <a class="nav-logo" href="/admin/dashboard">
    <div class="logo-dot"></div>Admin
  </a>
  <div class="nav-links">
    <a class="nav-link" href="/admin/dashboard">Dashboard</a>
    <a class="nav-link" href="/admin/users">Users</a>
    <a class="nav-link" href="/admin/campaigns">Campaigns</a>
    <a class="nav-link active" href="/admin/payout-requests">Payouts</a>
  </div>
  <div class="nav-right">
    <button class="btn-nav" onclick="toggleTheme()" id="theme-btn">Theme</button>
    <a class="btn-nav" href="/logout">Logout</a>
  </div>
</nav>

<main>

  <div class="page-header">
    <div class="eyebrow">Admin Panel</div>
    <h1>Payout <em>Requests</em></h1>
  </div>

  <!-- Stats -->
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-label">Pending</div>
      <div class="stat-val amber"><%= stats.pending %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Approved</div>
      <div class="stat-val purple"><%= stats.approved %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Paid</div>
      <div class="stat-val green"><%= stats.paid %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Pending Amount</div>
      <div class="stat-val red">₹<%= stats.totalPendingAmount.toFixed(0) %></div>
    </div>
  </div>

  <!-- Filter + Table -->
  <div class="filter-bar">
    <div class="filter-tabs">
      <button class="filter-tab active" onclick="filterPayouts('all', this)">All</button>
      <button class="filter-tab" onclick="filterPayouts('pending', this)">Pending</button>
      <button class="filter-tab" onclick="filterPayouts('approved', this)">Approved</button>
      <button class="filter-tab" onclick="filterPayouts('paid', this)">Paid</button>
      <button class="filter-tab" onclick="filterPayouts('rejected', this)">Rejected</button>
    </div>
  </div>

  <div class="table-wrap">
    <div class="table-head">
      <span class="table-title">All Requests</span>
      <span class="table-count"><%= payouts.length %> total</span>
    </div>

    <% if (payouts.length === 0) { %>
      <div class="empty-state">Koi payout request nahi abhi</div>
    <% } else { %>
    <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Affiliate</th>
          <th>Amount</th>
          <th>Method</th>
          <th>Status</th>
          <th>Requested</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="payouts-tbody">
        <% payouts.forEach(p => { %>
        <tr data-status="<%= p.status %>">
          <td>
            <div class="user-info">
              <span class="user-name"><%= p.affiliate?.firstName %> <%= p.affiliate?.lastName %></span>
              <span class="user-email"><%= p.affiliate?.email %></span>
            </div>
          </td>
          <td><span class="amount-cell">₹<%= p.amount.toFixed(2) %></span></td>
          <td>
            <div class="method-info">
              <span class="method-type"><%= p.method === 'upi' ? '📱 UPI' : '🏦 Bank' %></span>
              <span class="method-detail">
                <% if (p.method === 'upi') { %>
                  <%= p.upiId %>
                <% } else { %>
                  <%= p.bankDetails?.name %> · <%= p.bankDetails?.ifsc %>
                <% } %>
              </span>
            </div>
          </td>
          <td><span class="status-pill <%= p.status %>"><%= p.status %></span></td>
          <td>
            <span class="date-cell">
              <%= new Date(p.requestedAt).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'2-digit'}) %>
            </span>
          </td>
          <td>
            <div class="actions">
              <% if (p.status === 'pending') { %>
                <button class="btn-action approve" onclick="openModal('<%= p._id %>', 'approve')">Approve</button>
                <button class="btn-action reject"  onclick="openModal('<%= p._id %>', 'reject')">Reject</button>
              <% } else if (p.status === 'approved') { %>
                <button class="btn-action paid" onclick="openModal('<%= p._id %>', 'paid')">Mark Paid</button>
                <button class="btn-action reject" onclick="openModal('<%= p._id %>', 'reject')">Reject</button>
              <% } else { %>
                <span class="btn-action done"><%= p.status === 'paid' ? '✅ Paid' : '❌ Rejected' %></span>
              <% } %>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>

</main>

<!-- Action Modal -->
<div class="modal-overlay" id="modal">
  <div class="modal">
    <div class="modal-title" id="modal-title">Confirm Action</div>
    <textarea class="modal-input" id="modal-note" rows="3"
              placeholder="Note (optional) — reason ya message"></textarea>
    <div class="modal-actions">
      <button class="btn-modal cancel" onclick="closeModal()">Cancel</button>
      <button class="btn-modal confirm" id="modal-confirm" onclick="submitAction()">Confirm</button>
    </div>
  </div>
</div>

<script>
  // Theme
  function toggleTheme() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    document.documentElement.setAttribute('data-theme', isDark ? 'light' : 'dark');
    document.getElementById('theme-btn').textContent = isDark ? '☾ Dark' : '☀ Light';
    localStorage.setItem('snaplink-theme', isDark ? 'light' : 'dark');
  }
  const saved = localStorage.getItem('snaplink-theme') || 'dark';
  document.documentElement.setAttribute('data-theme', saved);
  document.getElementById('theme-btn').textContent = saved === 'dark' ? '☀ Light' : '☾ Dark';

  // Filter
  function filterPayouts(status, btn) {
    document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('#payouts-tbody tr').forEach(row => {
      row.style.display = (status === 'all' || row.dataset.status === status) ? '' : 'none';
    });
  }

  // Modal
  let currentId = null;
  let currentAction = null;

  function openModal(id, action) {
    currentId = id;
    currentAction = action;
    const titles = { approve: 'Approve Payout?', paid: 'Mark as Paid?', reject: 'Reject Payout?' };
    document.getElementById('modal-title').textContent = titles[action];
    document.getElementById('modal-note').value = '';
    const btn = document.getElementById('modal-confirm');
    btn.className = `btn-modal confirm ${action}`;
    btn.textContent = action === 'approve' ? 'Approve' : action === 'paid' ? 'Mark Paid' : 'Reject';
    document.getElementById('modal').classList.add('open');
  }

  function closeModal() {
    document.getElementById('modal').classList.remove('open');
    currentId = null; currentAction = null;
  }

  async function submitAction() {
    const note = document.getElementById('modal-note').value;
    const urls = {
      approve: `/admin/payout-requests/${currentId}/approve`,
      paid:    `/admin/payout-requests/${currentId}/mark-paid`,
      reject:  `/admin/payout-requests/${currentId}/reject`,
    };

    try {
      const res = await fetch(urls[currentAction], {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ note })
      });
      const data = await res.json();
      if (data.success) { closeModal(); window.location.reload(); }
      else alert(data.error || 'Kuch gadbad hui');
    } catch (err) {
      alert('Server error');
    }
  }

  // ESC
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
</script>

</body>
</html>



