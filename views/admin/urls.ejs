<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: 'URLs | SnapLink Admin',
      description: 'Inspect and manage every short link from the SnapLink admin workspace.',
      path: '/admin/urls',
      robots: 'noindex, nofollow',
      stylesheets: ["/css/pages/site-shell.css","/css/pages/generated/admin/urls.inline.css","/css/pages/app-shell.css"]
    };
  %>
  <%- include('../partials/seo-head', { seo }) %>
</head>
<body class="app-shell-page">
  <%
    const userDisplayName = user ? (user.name || [user.firstName, user.lastName].filter(Boolean).join(' ').trim() || user.email || 'User') : 'User';
    const userDisplayInitial = userDisplayName.charAt(0).toUpperCase();
  %>

  <!-- ═══ SIDEBAR ═══ -->
  <aside class="sidebar">
    <a href="/" class="sidebar-logo">Snap<em>Link</em><span class="admin-badge">ADMIN</span></a>
    <nav class="sidebar-nav">
      <div class="nav-section">Overview</div>
      <a href="/admin/dashboard" class="nav-item"><span class="nav-icon" aria-hidden="true"></span> Dashboard</a>
      <div class="nav-section">Manage</div>
      <a href="/admin/users" class="nav-item"><span class="nav-icon" aria-hidden="true"></span> Users</a>
      <a href="/admin/urls"  class="nav-item active"><span class="nav-icon" aria-hidden="true"></span> URLs</a>
      <div class="nav-section">Site</div>
      <a href="/"         class="nav-item"><span class="nav-icon" aria-hidden="true"></span> View Site</a>
      <a href="/dashboard" class="nav-item"><span class="nav-icon" aria-hidden="true"></span> My Dashboard</a>
      <a href="/logout"   class="nav-item"><span class="nav-icon" aria-hidden="true"></span> Logout</a>
    </nav>
    <div class="sidebar-bottom">
      <div class="sidebar-user">
        <div class="s-avatar"><%= userDisplayInitial %></div>
        <div>
          <div class="s-name"><%= userDisplayName %></div>
          <div class="s-role">Administrator</div>
        </div>
      </div>
    </div>
  </aside>

  <!-- ═══ MAIN ═══ -->
  <div class="main-content">
    <div class="topbar">
      <div class="topbar-title">URLs Management</div>
      <div class="topbar-right">
        <button class="btn-theme" onclick="toggleTheme()" id="theme-btn">Theme</button>
      </div>
    </div>

    <div class="page">
      <div class="page-title">All URLsAll URLs</div>

      <!-- Search -->
      <form method="GET" action="/admin/urls">
        <div class="toolbar">
          <input class="search-input" type="text" name="search" placeholder="Search by short code or original URL..." value="<%= search %>"/>
          <button class="search-btn" type="submit">Search</button>
          <span class="total-badge"><%= total %> URLs</span>
        </div>
      </form>

      <div class="table-wrap">
        <% if (urls.length === 0) { %>
          <div class="empty-row">Koi URL nahi mili</div>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Short Code</th>
                <th>Original URL</th>
                <th>Clicks</th>
                <th>Created By</th>
                <th>Created</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% urls.forEach((u, i) => { %>
                <tr id="url-row-<%= u._id %>">
                  <td style="color:var(--muted)"><%= (page-1)*20 + i + 1 %></td>
                  <td>
                    <span class="short-code">/<%= u.shortCode %></span>
                  </td>
                  <td>
                    <div class="original-url" title="<%= u.originalUrl %>"><%= u.originalUrl %></div>
                  </td>
                  <td>
                    <span class="clicks-badge"><%= u.clicks %></span>
                  </td>
                  <td>
                    <% if (u.createdBy) { %>
                      <div style="color:var(--text2)"><%= u.createdBy.firstName %></div>
                      <div class="creator-info"><%= u.createdBy.email %></div>
                    <% } else { %>
                      <span style="color:var(--muted)">Guest</span>
                    <% } %>
                  </td>
                  <td>
                    <%= new Date(u.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'2-digit'}) %>
                  </td>
                  <td style="display:flex;gap:6px;align-items:center;">
                    <a class="btn-visit" href="/<%= u.shortCode %>" target="_blank">Visit</a>
                    <button class="btn-del" onclick="deleteUrl('<%= u._id %>')">Delete</button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>

          <!-- Pagination -->
          <% if (totalPages > 1) { %>
            <div class="pagination">
              <% if (page > 1) { %>
                <a href="/admin/urls?page=<%= page-1 %>&search=<%= search %>" class="page-btn">← Prev</a>
              <% } %>
              <% for(let i = 1; i <= totalPages; i++) { %>
                <a href="/admin/urls?page=<%= i %>&search=<%= search %>" class="page-btn <%= page===i ? 'active' : '' %>"><%= i %></a>
              <% } %>
              <% if (page < totalPages) { %>
                <a href="/admin/urls?page=<%= page+1 %>&search=<%= search %>" class="page-btn">Next →</a>
              <% } %>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>

  <%- include('../partials/feedback-ui') %>

  <script src="/js/shared/theme.js"></script>
  <script src="/js/shared/feedback-ui.js"></script>
  <script>
    // Theme

    // Delete URL
    async function deleteUrl(urlId) {
      const ok = await window.snaplinkUI.confirm({
        title: 'Delete this short URL?',
        message: 'This URL will be removed from the platform and cannot be restored from the admin panel.',
        confirmText: 'Delete URL',
        tone: 'danger'
      });
      if (!ok) return;

      try {
        const res = await fetch(`/admin/urls/${urlId}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          document.getElementById(`url-row-${urlId}`).remove();
          window.snaplinkUI.toast('URL deleted successfully.', { tone: 'success' });
        } else {
          window.snaplinkUI.toast(data.error || 'URL delete nahi ho paya.', { tone: 'error' });
        }
      } catch (e) {
        window.snaplinkUI.toast('Delete request fail ho gaya. Dobara try karo.', { tone: 'error' });
      }
    }
  </script>

</body>
</html>




