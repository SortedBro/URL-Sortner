<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>URLs — Admin | SnapLink</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <style>
    :root { --bg:#0a0a09; --surface:#111110; --card:#1c1c1a; --border:#2a2a28; --text:#f0f0ee; --text2:#aaaaaa; --muted:#555552; --accent:#FAC775; --green:#5DCAA5; --red:#F09595; --blue:#7EB8F7; --sidebar:220px; }
    [data-theme="light"] { --bg:#f5f5f3; --surface:#fff; --card:#fff; --border:#e0e0de; --text:#1a1a1a; --text2:#555; --muted:#aaa; }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); display: flex; min-height: 100vh; }

    /* ── SIDEBAR ── */
    .sidebar { width:var(--sidebar); background:var(--surface); border-right:0.5px solid var(--border); display:flex; flex-direction:column; position:fixed; top:0; left:0; bottom:0; z-index:100; }
    .sidebar-logo { padding:1.2rem 1.5rem; border-bottom:0.5px solid var(--border); font-family:'Syne',sans-serif; font-weight:800; font-size:16px; color:var(--text); text-decoration:none; display:flex; align-items:center; gap:8px; }
    .sidebar-logo em { font-style:normal; color:var(--accent); }
    .admin-badge { background:var(--red); color:#1a1a18; font-size:9px; font-weight:700; padding:2px 6px; border-radius:4px; font-family:'DM Mono',monospace; }
    .sidebar-nav { flex:1; padding:1rem 0; }
    .nav-section { padding:0 1rem 0.5rem; font-size:10px; color:var(--muted); letter-spacing:1px; text-transform:uppercase; font-family:'DM Mono',monospace; margin-top:0.8rem; }
    .nav-item { display:flex; align-items:center; gap:10px; padding:8px 1.2rem; font-size:13px; color:var(--text2); text-decoration:none; border-radius:6px; margin:1px 8px; transition:all 0.2s; }
    .nav-item:hover { background:var(--card); color:var(--text); }
    .nav-item.active { background:var(--card); color:var(--accent); border:0.5px solid var(--border); }
    .nav-icon { font-size:15px; width:20px; text-align:center; }
    .sidebar-bottom { padding:1rem; border-top:0.5px solid var(--border); }
    .sidebar-user { display:flex; align-items:center; gap:8px; }
    .s-avatar { width:30px; height:30px; border-radius:50%; background:var(--accent); color:#1a1a18; font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center; font-family:'Syne',sans-serif; }
    .s-name { font-size:12px; font-weight:600; }
    .s-role { font-size:10px; color:var(--red); font-family:'DM Mono',monospace; }

    /* ── MAIN ── */
    .main-content { margin-left:var(--sidebar); flex:1; }
    .topbar { height:54px; background:var(--surface); border-bottom:0.5px solid var(--border); display:flex; align-items:center; justify-content:space-between; padding:0 2rem; position:sticky; top:0; z-index:50; }
    .topbar-title { font-family:'Syne',sans-serif; font-size:15px; font-weight:700; }
    .topbar-right { display:flex; align-items:center; gap:10px; }
    .btn-theme { background:none; border:0.5px solid var(--border); border-radius:6px; color:var(--text2); font-size:11px; padding:4px 10px; cursor:pointer; font-family:'DM Mono',monospace; }

    .page { padding:2rem; }
    .page-title { font-family:'Syne',sans-serif; font-size:1.4rem; font-weight:800; letter-spacing:-0.5px; margin-bottom:1.5rem; }

    /* Toolbar */
    .toolbar { display:flex; gap:10px; margin-bottom:1.5rem; flex-wrap:wrap; align-items:center; }
    .search-input { flex:1; min-width:200px; padding:8px 12px; background:var(--card); border:0.5px solid var(--border); border-radius:8px; color:var(--text); font-size:13px; font-family:'DM Mono',monospace; outline:none; }
    .search-input:focus { border-color:var(--accent); }
    .search-btn { padding:8px 16px; font-size:12px; font-family:'DM Mono',monospace; background:var(--accent); color:#1a1a18; border:none; border-radius:8px; cursor:pointer; font-weight:700; }
    .total-badge { font-size:12px; color:var(--muted); font-family:'DM Mono',monospace; margin-left:auto; }

    /* Table */
    .table-wrap { background:var(--card); border:0.5px solid var(--border); border-radius:12px; overflow:hidden; }
    table { width:100%; border-collapse:collapse; font-size:12px; }
    th { padding:10px 12px; text-align:left; font-size:10px; color:var(--muted); font-family:'DM Mono',monospace; letter-spacing:1px; text-transform:uppercase; border-bottom:0.5px solid var(--border); background:var(--surface); font-weight:500; }
    td { padding:11px 12px; border-bottom:0.5px solid var(--border); color:var(--text2); font-family:'DM Mono',monospace; vertical-align:middle; }
    tr:last-child td { border-bottom:none; }
    tr:hover td { background:var(--surface); }

    .short-code { color:var(--accent); font-weight:600; }
    .original-url { max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--text2); }
    .clicks-badge { display:inline-block; padding:2px 8px; background:rgba(93,202,165,0.1); color:var(--green); border:0.5px solid var(--green); border-radius:4px; font-size:10px; }
    .creator-info { font-size:10px; color:var(--muted); }

    .btn-del { padding:4px 10px; font-size:10px; font-family:'DM Mono',monospace; border-radius:5px; cursor:pointer; transition:all 0.2s; border:0.5px solid var(--muted); color:var(--muted); background:transparent; }
    .btn-del:hover { background:rgba(255,0,0,0.1); border-color:var(--red); color:var(--red); }

    .btn-visit { padding:4px 10px; font-size:10px; font-family:'DM Mono',monospace; border-radius:5px; cursor:pointer; transition:all 0.2s; border:0.5px solid var(--border); color:var(--text2); background:transparent; text-decoration:none; display:inline-block; }
    .btn-visit:hover { border-color:var(--accent); color:var(--accent); }

    /* Pagination */
    .pagination { display:flex; align-items:center; justify-content:center; gap:6px; padding:1rem; border-top:0.5px solid var(--border); }
    .page-btn { padding:5px 10px; font-size:11px; font-family:'DM Mono',monospace; background:transparent; border:0.5px solid var(--border); border-radius:6px; color:var(--muted); cursor:pointer; text-decoration:none; transition:all 0.2s; }
    .page-btn:hover { border-color:var(--accent); color:var(--accent); }
    .page-btn.active { border-color:var(--accent); color:var(--accent); background:rgba(250,199,117,0.08); }

    .empty-row { text-align:center; padding:3rem; color:var(--muted); font-family:'DM Mono',monospace; font-size:13px; }
  </style>
</head>
<body>

  <!-- ═══ SIDEBAR ═══ -->
  <aside class="sidebar">
    <a href="/" class="sidebar-logo">Snap<em>Link</em><span class="admin-badge">ADMIN</span></a>
    <nav class="sidebar-nav">
      <div class="nav-section">Overview</div>
      <a href="/admin/dashboard" class="nav-item"><span class="nav-icon">📊</span> Dashboard</a>
      <div class="nav-section">Manage</div>
      <a href="/admin/users" class="nav-item"><span class="nav-icon">👥</span> Users</a>
      <a href="/admin/urls"  class="nav-item active"><span class="nav-icon">🔗</span> URLs</a>
      <div class="nav-section">Site</div>
      <a href="/"         class="nav-item"><span class="nav-icon">🏠</span> View Site</a>
      <a href="/dashboard" class="nav-item"><span class="nav-icon">⚡</span> My Dashboard</a>
      <a href="/logout"   class="nav-item"><span class="nav-icon">🚪</span> Logout</a>
    </nav>
    <div class="sidebar-bottom">
      <div class="sidebar-user">
        <div class="s-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
        <div>
          <div class="s-name"><%= user.name %></div>
          <div class="s-role">Administrator</div>
        </div>
      </div>
    </div>
  </aside>

  <!-- ═══ MAIN ═══ -->
  <div class="main-content">
    <div class="topbar">
      <div class="topbar-title">URLs Management</div>
      <div class="topbar-right">
        <button class="btn-theme" onclick="toggleTheme()" id="theme-btn">☀ Light</button>
      </div>
    </div>

    <div class="page">
      <div class="page-title">🔗 All URLs</div>

      <!-- Search -->
      <form method="GET" action="/admin/urls">
        <div class="toolbar">
          <input class="search-input" type="text" name="search" placeholder="Search by short code or original URL..." value="<%= search %>"/>
          <button class="search-btn" type="submit">Search</button>
          <span class="total-badge"><%= total %> URLs</span>
        </div>
      </form>

      <div class="table-wrap">
        <% if (urls.length === 0) { %>
          <div class="empty-row">Koi URL nahi mili</div>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Short Code</th>
                <th>Original URL</th>
                <th>Clicks</th>
                <th>Created By</th>
                <th>Created</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% urls.forEach((u, i) => { %>
                <tr id="url-row-<%= u._id %>">
                  <td style="color:var(--muted)"><%= (page-1)*20 + i + 1 %></td>
                  <td>
                    <span class="short-code">/<%= u.shortCode %></span>
                  </td>
                  <td>
                    <div class="original-url" title="<%= u.orginalUrl %>"><%= u.orginalUrl %></div>
                  </td>
                  <td>
                    <span class="clicks-badge"><%= u.clicks %></span>
                  </td>
                  <td>
                    <% if (u.createdBy) { %>
                      <div style="color:var(--text2)"><%= u.createdBy.firstName %></div>
                      <div class="creator-info"><%= u.createdBy.email %></div>
                    <% } else { %>
                      <span style="color:var(--muted)">Guest</span>
                    <% } %>
                  </td>
                  <td>
                    <%= new Date(u.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'2-digit'}) %>
                  </td>
                  <td style="display:flex;gap:6px;align-items:center;">
                    <a class="btn-visit" href="/<%= u.shortCode %>" target="_blank">Visit</a>
                    <button class="btn-del" onclick="deleteUrl('<%= u._id %>')">Delete</button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>

          <!-- Pagination -->
          <% if (totalPages > 1) { %>
            <div class="pagination">
              <% if (page > 1) { %>
                <a href="/admin/urls?page=<%= page-1 %>&search=<%= search %>" class="page-btn">← Prev</a>
              <% } %>
              <% for(let i = 1; i <= totalPages; i++) { %>
                <a href="/admin/urls?page=<%= i %>&search=<%= search %>" class="page-btn <%= page===i ? 'active' : '' %>"><%= i %></a>
              <% } %>
              <% if (page < totalPages) { %>
                <a href="/admin/urls?page=<%= page+1 %>&search=<%= search %>" class="page-btn">Next →</a>
              <% } %>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    // Theme
    const saved = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', saved);
    document.getElementById('theme-btn').textContent = saved === 'dark' ? '☀ Light' : '☾ Dark';
    function toggleTheme() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const next = isDark ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      document.getElementById('theme-btn').textContent = next === 'dark' ? '☀ Light' : '☾ Dark';
    }

    // Delete URL
    async function deleteUrl(urlId) {
      if (!confirm('Yeh URL delete karo? Yeh action undo nahi hoga!')) return;
      try {
        const res = await fetch(`/admin/urls/${urlId}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          document.getElementById(`url-row-${urlId}`).remove();
        }
      } catch(e) {
        alert('Error! Try again.');
      }
    }
  </script>

</body>
</html>
