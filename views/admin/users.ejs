<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Users — Admin | SnapLink</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/pages/generated/admin/users.inline.css" />
</head>
<body>

  <aside class="sidebar">
    <a href="/" class="sidebar-logo">Snap<em>Link</em><span class="admin-badge">ADMIN</span></a>
    <nav class="sidebar-nav">
      <div class="nav-section">Overview</div>
      <a href="/admin/dashboard" class="nav-item"><span class="nav-icon">📊</span> Dashboard</a>
      <div class="nav-section">Manage</div>
      <a href="/admin/users" class="nav-item active"><span class="nav-icon">👥</span> Users</a>
      <a href="/admin/urls"  class="nav-item"><span class="nav-icon">🔗</span> URLs</a>
      <div class="nav-section">Site</div>
      <a href="/"        class="nav-item"><span class="nav-icon">🏠</span> View Site</a>
      <a href="/dashboard" class="nav-item"><span class="nav-icon">⚡</span> My Dashboard</a>
      <a href="/logout"  class="nav-item"><span class="nav-icon">🚪</span> Logout</a>
    </nav>
    <div class="sidebar-bottom">
      <div class="sidebar-user">
        <div class="s-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
        <div>
          <div class="s-name"><%= user.name %></div>
          <div class="s-role">Administrator</div>
        </div>
      </div>
    </div>
  </aside>

  <div class="main-content">
    <div class="topbar">
      <div class="topbar-title">Users Management</div>
      <div class="topbar-right">
        <button class="btn-theme" onclick="toggleTheme()" id="theme-btn">☀ Light</button>
      </div>
    </div>

    <div class="page">
      <div class="page-title">👥 All Users</div>

      <form method="GET" action="/admin/users">
        <div class="toolbar">
          <input class="search-input" type="text" name="search" placeholder="Search by name or email..." value="<%= search %>"/>
          <a href="/admin/users?filter=all"      class="filter-btn <%= filter==='all'      ? 'active' : '' %>">All</a>
          <a href="/admin/users?filter=pro"      class="filter-btn <%= filter==='pro'      ? 'active' : '' %>">Pro</a>
          <a href="/admin/users?filter=business" class="filter-btn <%= filter==='business' ? 'active' : '' %>">Business</a>
          <a href="/admin/users?filter=free"     class="filter-btn <%= filter==='free'     ? 'active' : '' %>">Free</a>
          <a href="/admin/users?filter=banned"   class="filter-btn <%= filter==='banned'   ? 'active' : '' %>">Banned</a>
          <span class="total-badge"><%= total %> users</span>
        </div>
      </form>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>User</th>
              <th>Plan</th>
              <th>URLs This Month</th>
              <th>Joined</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach((u, i) => { %>
              <tr class="<%= u.isBanned ? 'banned-row' : '' %>" id="row-<%= u._id %>">
                <td style="color:var(--muted)"><%= (page-1)*20 + i + 1 %></td>
                <td>
                  <div style="color:var(--text)"><%= u.firstName %> <%= u.lastName || '' %></div>
                  <div style="font-size:10px;color:var(--muted)"><%= u.email %></div>
                  <% if (u.isBanned) { %><span class="banned-tag">⛔ banned</span><% } %>
                </td>
                <td><span class="plan-badge <%= u.plan %>"><%= u.plan %></span></td>
                <td style="color:var(--text2)"><%= u.urlsThisMonth || 0 %></td>
                <td><%= new Date(u.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'2-digit'}) %></td>
                <td style="display:flex;gap:6px;align-items:center;">
                  <button
                    class="action-btn <%= u.isBanned ? 'btn-unban' : 'btn-ban' %>"
                    id="ban-btn-<%= u._id %>"
                    onclick="toggleBan('<%= u._id %>', <%= u.isBanned %>)">
                    <%= u.isBanned ? 'Unban' : 'Ban' %>
                  </button>
                  <button class="action-btn btn-del" onclick="deleteUser('<%= u._id %>')">Delete</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <% if (totalPages > 1) { %>
          <div class="pagination">
            <% if (page > 1) { %><a href="/admin/users?page=<%= page-1 %>&filter=<%= filter %>&search=<%= search %>" class="page-btn">← Prev</a><% } %>
            <% for(let i = 1; i <= totalPages; i++) { %>
              <a href="/admin/users?page=<%= i %>&filter=<%= filter %>&search=<%= search %>" class="page-btn <%= page===i ? 'active' : '' %>"><%= i %></a>
            <% } %>
            <% if (page < totalPages) { %><a href="/admin/users?page=<%= page+1 %>&filter=<%= filter %>&search=<%= search %>" class="page-btn">Next →</a><% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <script src="/js/shared/theme.js"></script>
  <script>

    async function toggleBan(userId, isBanned) {
      if (!confirm(isBanned ? 'Unban karo?' : 'Ban karo?')) return;
      const res  = await fetch(`/admin/users/${userId}/ban`, { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        const btn = document.getElementById(`ban-btn-${userId}`);
        const row = document.getElementById(`row-${userId}`);
        btn.textContent = data.isBanned ? 'Unban' : 'Ban';
        btn.className   = `action-btn ${data.isBanned ? 'btn-unban' : 'btn-ban'}`;
        row.className   = data.isBanned ? 'banned-row' : '';
      }
    }

    async function deleteUser(userId) {
      if (!confirm('User aur uske saare URLs delete ho jaayenge. Sure ho?')) return;
      const res  = await fetch(`/admin/users/${userId}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        document.getElementById(`row-${userId}`).remove();
      }
    }
  </script>
</body>
</html>




