<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Redirecting - SnapLink</title>
    <style>
        html, body {
            margin: 0;
            height: 100%;
            background: #0d0e13;
            overflow: hidden;
        }
    </style>
    <noscript>
        <meta http-equiv="refresh" content="0;url=<%= url.destinationUrl || url.orginalUrl %>" />
    </noscript>
</head>

<body>
    <script>
        const TARGET = <%- JSON.stringify(url.destinationUrl || url.orginalUrl) %>;
        const MONETAG_ZONE_ID = <%- JSON.stringify(monetagZoneId || '') %>;
        const MONETAG_SCRIPT_URL = <%- JSON.stringify(monetagScriptUrl || '') %>;

        let hasNavigated = false;
        let scriptResolved = false;
        const MIN_AD_BRIDGE_MS = 650;
        const MAX_AD_BRIDGE_MS = 1800;
        const startTime = Date.now();

        function appendMonetagScript() {
            if (!MONETAG_ZONE_ID || !MONETAG_SCRIPT_URL) {
                return false;
            }

            try {
                const anchor = [document.documentElement, document.body].filter(Boolean).pop();
                if (!anchor) return false;

                const script = document.createElement('script');
                script.dataset.zone = MONETAG_ZONE_ID;
                script.src = MONETAG_SCRIPT_URL;
                script.async = true;
                script.onload = markScriptResolved;
                script.onerror = markScriptResolved;
                anchor.appendChild(script);
                return true;
            } catch (error) {
                console.error('Monetag script load failed:', error);
                return false;
            }
        }

        function markScriptResolved() {
            if (scriptResolved) return;
            scriptResolved = true;
            scheduleNavigation();
        }

        function scheduleNavigation() {
            const elapsed = Date.now() - startTime;
            const remaining = Math.max(0, MIN_AD_BRIDGE_MS - elapsed);
            window.setTimeout(goToDestination, remaining);
        }

        function goToDestination() {
            if (hasNavigated) return;
            hasNavigated = true;
            window.location.assign(TARGET);
        }

        if (!appendMonetagScript()) {
            markScriptResolved();
        }

        window.addEventListener('load', scheduleNavigation, { once: true });
        window.setTimeout(goToDestination, MAX_AD_BRIDGE_MS);
    </script>
</body>

</html>
