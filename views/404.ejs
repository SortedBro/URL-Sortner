<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>404 — Link Not Found | SnapLink</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/pages/generated/404.inline.css" />
</head>
<body>

  <div class="bg-grid"></div>
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <div class="container">

    <div class="icon-wrap">
      <span class="chain chain-left">🔗</span>
      <div class="chain-break"></div>
      <span class="chain chain-right">🔗</span>
    </div>

    <div class="error-code">404</div>

    <div class="title">Yeh link toot gaya!</div>
    <div class="subtitle">
      Jo short URL tune open kiya woh exist nahi karta,<br>
      ya delete ho chuka hai. Double check karo!
    </div>

    <div class="url-pill">
      <div class="url-dot"></div>
      Link not found
    </div>

    <div class="btn-group">
      <a href="/" class="btn btn-primary">
        ← Wapas jao
      </a>
      <a href="/dashboard" class="btn btn-ghost">
        Dashboard
      </a>
    </div>

  </div>

  <div class="bottom-tag">snaplink.fun — <span>URL- Shortener</span></div>

