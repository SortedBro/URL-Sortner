<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: '404 | Page Not Found | SnapLink',
      description: 'The page or short link you requested could not be found on SnapLink.',
      path: '',
      robots: 'noindex, nofollow',
      stylesheets: ['/css/pages/site-shell.css', '/css/pages/auth-shell.css']
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
</head>
<body class="site-page error-page">
  <%- include('partials/site-navbar', { currentPage: '' }) %>

  <main class="auth-main">
    <section class="error-shell">
      <div class="auth-aside">
        <div class="eyebrow">Page not found</div>
        <div class="error-code">404</div>
        <p class="section-copy">The page or short link you opened does not exist, may have expired, or may have been removed.</p>
      </div>

      <div class="auth-card">
        <div class="auth-kicker">Recovery options</div>
        <h1 class="error-title">This route is no longer available.</h1>
        <p class="section-copy">Use the links below to get back to the main experience, browse features, or open your dashboard if you already have an account.</p>
        <div class="error-links">
          <a href="/" class="btn-primary">Back to homepage</a>
          <a href="/features" class="btn-secondary">Explore features</a>
          <a href="/dashboard" class="btn-secondary">Open dashboard</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/footer', { footerCopy: 'If a short link looks broken, return to the homepage or dashboard and create a fresh one.' }) %>
  <script src="/js/shared/theme.js"></script>
</body>
</html>
