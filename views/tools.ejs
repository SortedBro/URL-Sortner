    <!-- â”€â”€â”€ PASSWORD GENERATOR â”€â”€â”€ -->
    <div class="tpanel" id="tp-pass">
      <div class="tpanel-header"><div><h2>Password Generator</h2><p>Strong, secure password banao - customize karo</p></div></div>
      <div class="tpanel-body">
        <div class="tform-col">
          <div class="tfield"><label>Length: <span id="passLenVal">16</span></label><input type="range" id="passLen" min="6" max="64" value="16" class="trange" oninput="document.getElementById('passLenVal').textContent=this.value;genPass()"></div>
          <div class="tfield">
            <label>Include</label>
            <div class="pass-opts">
              <label class="pass-opt"><input type="checkbox" id="passUpper" checked onchange="genPass()"> Uppercase (A-Z)</label>
              <label class="pass-opt"><input type="checkbox" id="passLower" checked onchange="genPass()"> Lowercase (a-z)</label>
              <label class="pass-opt"><input type="checkbox" id="passNum"   checked onchange="genPass()"> Numbers (0-9)</label>
              <label class="pass-opt"><input type="checkbox" id="passSym"   checked onchange="genPass()"> Symbols (!@#$)</label>
            </div>
          </div>
          <div class="tfield">
            <label>Exclude Ambiguous</label>
            <label class="pass-opt"><input type="checkbox" id="passAmb" onchange="genPass()"> 0, O, l, 1, I hata do</label>
          </div>
          <div class="tfield"><label>Generated Password</label><div class="pass-output-wrap"><input type="text" id="passOutput" class="tinput" readonly><button class="tbtn-xs" onclick="copyText(document.getElementById('passOutput').value,this)">Copy</button></div></div>
          <div class="pass-strength-wrap"><div class="pass-strength-bar" id="passStrBar"></div><span id="passStrLabel"></span></div>
          <div class="tactions">
            <button class="tbtn primary" onclick="genPass()">New Password</button>
            <button class="tbtn secondary" onclick="genMultiPass()">Generate 5</button>
          </div>
          <div id="multiPassList" style="display:none" class="multi-pass-list"></div>
        </div>
        <div class="tpreview-col">
          <div class="pass-tips-box">
            <h4>Strong Password Tips</h4>
