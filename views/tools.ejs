<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Free Tools — SnapLink</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/css/home.css">
  <link rel="stylesheet" href="/css/tools.css">
</head>
<body>

<!-- ═══ NAVBAR (same as home) ═══ -->
<nav class="navbar">
  <a href="/" class="nav-logo">
    <span class="logo-dot"></span>
    Snap<em>Link</em>
  </a>
  <div class="nav-center">
    <a href="/features" class="nav-link">Features</a>
    <a href="/tools" class="nav-link" style="color:var(--accent)">🛠️ Tools</a>
    <a href="/pricing" class="nav-link">Pricing</a>
    <a href="/about" class="nav-link">About</a>
  </div>
  <div class="nav-right">
    <button class="theme-btn" id="themeBtn" onclick="toggleTheme()">🌙</button>
    <% if (typeof user !== 'undefined' && user) { %>
      <div class="nav-user">
        <div class="nav-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
        <span class="nav-username"><%= user.name %></span>
      </div>
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/logout" class="nav-btn-outline">Logout</a>
    <% } else { %>
      <a href="/login" class="nav-link">Login</a>
      <a href="/signup" class="nav-btn-solid">Get Started</a>
    <% } %>
  </div>
</nav>

<main class="tools-main">

  <!-- ═══ HERO ═══ -->
  <section class="tools-hero">
    <div class="tools-badge">🛠️ Free Tools</div>
    <h1 class="tools-title">Sab tools, <span class="accent">bilkul free</span></h1>
    <p class="tools-subtitle">Koi login nahi • Koi limit nahi • Browser mein kaam karta hai</p>

    <!-- Tool grid cards for quick navigation -->
    <div class="tools-nav-grid">
      <button class="tnav-card" onclick="openTool('qr')">
        <span class="tnav-icon">📱</span>
        <span class="tnav-label">QR Generator</span>
      </button>
      <button class="tnav-card" onclick="openTool('img')">
        <span class="tnav-icon">🗜️</span>
        <span class="tnav-label">Image Compressor</span>
      </button>
      <button class="tnav-card" onclick="openTool('yt')">
        <span class="tnav-icon">▶️</span>
        <span class="tnav-label">YT Downloader</span>
      </button>
      <button class="tnav-card" onclick="openTool('utm')">
        <span class="tnav-icon">📊</span>
        <span class="tnav-label">UTM Builder</span>
      </button>
      <button class="tnav-card" onclick="openTool('json')">
        <span class="tnav-icon">{ }</span>
        <span class="tnav-label">JSON Formatter</span>
      </button>
      <button class="tnav-card" onclick="openTool('hash')">
        <span class="tnav-icon">#</span>
        <span class="tnav-label">Hash Generator</span>
      </button>
      <button class="tnav-card" onclick="openTool('b64')">
        <span class="tnav-icon">🔄</span>
        <span class="tnav-label">Base64</span>
      </button>
      <button class="tnav-card" onclick="openTool('color')">
        <span class="tnav-icon">🎨</span>
        <span class="tnav-label">Color Picker</span>
      </button>
      <button class="tnav-card" onclick="openTool('word')">
        <span class="tnav-icon">📝</span>
        <span class="tnav-label">Word Counter</span>
      </button>
      <button class="tnav-card" onclick="openTool('url')">
        <span class="tnav-icon">✂️</span>
        <span class="tnav-label">URL Shortener</span>
      </button>
    </div>
  </section>

  <!-- ═══ TOOL TABS BAR ═══ -->
  <div class="tool-tabs-bar">
    <div class="tool-tabs-scroll">
      <button class="ttab active" id="ttab-qr"    onclick="openTool('qr',this)">📱 QR Code</button>
      <button class="ttab" id="ttab-img"   onclick="openTool('img',this)">🗜️ Image Compressor</button>
      <button class="ttab" id="ttab-yt"    onclick="openTool('yt',this)">▶️ YT Downloader</button>
      <button class="ttab" id="ttab-utm"   onclick="openTool('utm',this)">📊 UTM Builder</button>
      <button class="ttab" id="ttab-json"  onclick="openTool('json',this)">{ } JSON</button>
      <button class="ttab" id="ttab-hash"  onclick="openTool('hash',this)"># Hash</button>
      <button class="ttab" id="ttab-b64"   onclick="openTool('b64',this)">🔄 Base64</button>
      <button class="ttab" id="ttab-color" onclick="openTool('color',this)">🎨 Color</button>
      <button class="ttab" id="ttab-word"  onclick="openTool('word',this)">📝 Word Count</button>
      <button class="ttab" id="ttab-url"   onclick="openTool('url',this)">✂️ URL Short</button>
    </div>
  </div>

  <!-- ═══ TOOL PANELS ═══ -->
  <div class="tools-panels-wrap">

    <!-- ────────────────────────────
         1. QR CODE GENERATOR
    ──────────────────────────── -->
    <div class="tpanel active" id="tp-qr">
      <div class="tpanel-header">
        <div>
          <h2>📱 QR Code Generator</h2>
          <p>Kisi bhi URL, text ya number ka QR banao — customize karo, download karo</p>
        </div>
      </div>
      <div class="tpanel-body">
        <div class="tform-col">
          <div class="tfield">
            <label>URL ya Text</label>
            <input type="text" id="qrInput" class="tinput" placeholder="https://example.com ya koi bhi text..." oninput="genQR()">
          </div>
          <div class="tfield-row">
            <div class="tfield">
              <label>Size</label>
              <select id="qrSize" class="tinput" onchange="genQR()">
                <option value="200">200×200 (Small)</option>
                <option value="300" selected>300×300 (Medium)</option>
                <option value="500">500×500 (Large)</option>
                <option value="1000">1000×1000 (HD)</option>
              </select>
            </div>
            <div class="tfield">
              <label>Error Correction</label>
              <select id="qrEC" class="tinput" onchange="genQR()">
                <option value="L">L — Low (7%)</option>
                <option value="M" selected>M — Medium (15%)</option>
                <option value="Q">Q — Quartile (25%)</option>
                <option value="H">H — High (30%)</option>
              </select>
            </div>
          </div>
          <div class="tfield">
            <label>Colors</label>
            <div class="color-row-wrap">
              <label class="color-picker-label">
                QR Color
                <input type="color" id="qrFg" value="#000000" onchange="genQR()">
              </label>
              <label class="color-picker-label">
                Background
                <input type="color" id="qrBg" value="#ffffff" onchange="genQR()">
              </label>
            </div>
          </div>
          <div class="tactions">
            <button class="tbtn primary" onclick="dlQR()">⬇ Download PNG</button>
            <button class="tbtn secondary" onclick="copyQRDataURL()">Copy as Image</button>
          </div>
        </div>
        <div class="tpreview-col">
          <div class="qr-box" id="qrBox">
            <canvas id="qrCanvas"></canvas>
            <div class="tplaceholder" id="qrPlaceholder">
              <span>📱</span>
              <p>URL daalo, QR yahan dikhega</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ────────────────────────────
         2. IMAGE COMPRESSOR
    ──────────────────────────── -->
    <div class="tpanel" id="tp-img">
      <div class="tpanel-header">
        <div>
          <h2>🗜️ Image Compressor</h2>
          <p>JPG, PNG, WebP compress karo — quality rakho, size kam karo</p>
        </div>
      </div>
      <div class="tpanel-body">
        <div class="tform-col">
          <div class="tfield">
            <label>Image Upload Karo</label>
            <div class="drop-zone" id="imgDZ" onclick="document.getElementById('imgFile').click()" ondragover="event.preventDefault()" ondrop="imgDrop(event)">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span id="imgDZText">Click karo ya drag &amp; drop — JPG, PNG, WebP</span>
            </div>
            <input type="file" id="imgFile" accept="image/*" style="display:none" onchange="loadImg(this)">
          </div>
          <div class="tfield">
            <label>Quality: <span id="qVal">80</span>%</label>
            <input type="range" id="imgQ" min="10" max="100" value="80" class="trange" oninput="document.getElementById('qVal').textContent=this.value;compressImg()">
          </div>
          <div class="tfield">
            <label>Output Format</label>
            <select id="imgFmt" class="tinput" onchange="compressImg()">
              <option value="">Same as input</option>
              <option value="image/jpeg">JPEG</option>
              <option value="image/png">PNG</option>
              <option value="image/webp">WebP</option>
            </select>
          </div>
          <div id="imgStatsRow" class="stats-row" style="display:none">
            <div class="stat-pill"><span>Original</span><b id="iOrig">—</b></div>
            <div class="stat-pill green"><span>Compressed</span><b id="iComp">—</b></div>
            <div class="stat-pill accent"><span>Saved</span><b id="iSave">—</b></div>
          </div>
          <button class="tbtn primary" id="imgDlBtn" onclick="dlImg()" style="display:none">⬇ Download Compressed</button>
        </div>
        <div class="tpreview-col">
          <canvas id="imgCanvas" style="max-width:100%;border-radius:12px;display:none"></canvas>
          <div class="tplaceholder" id="imgPlaceholder">
            <span>🖼️</span>
            <p>Image yahan dikhegi</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ────────────────────────────
         3. YT VIDEO DOWNLOADER
    ──────────────────────────── -->
    <div class="tpanel" id="tp-yt">
      <div class="tpanel-header">
        <div>
          <h2>▶️ YouTube Video Downloader</h2>
          <p>YouTube video ya audio download karo — MP4, MP3, free mein</p>
        </div>
        <div class="yt-powered-badge">
          Powered by <strong>cobalt.tools</strong>
        </div>
      </div>

      <div class="tpanel-body">
        <div class="tform-col">

          <!-- URL input -->
          <div class="tfield">
            <label>YouTube Video URL</label>
            <input type="text" id="ytVidUrl" class="tinput"
              placeholder="https://youtube.com/watch?v=dQw4w9WgXcQ">
          </div>

          <!-- Options row -->
          <div class="tfield-row">
            <div class="tfield">
              <label>Type</label>
              <select id="ytType" class="tinput" onchange="ytTypeChange()">
                <option value="video">🎬 Video (MP4)</option>
                <option value="audio">🎵 Audio Only (MP3)</option>
                <option value="mute">🔇 Video Only (No Audio)</option>
              </select>
            </div>
            <div class="tfield">
              <label>Quality</label>
              <select id="ytQuality" class="tinput">
                <option value="max">Max (Best)</option>
                <option value="2160">4K (2160p)</option>
                <option value="1440">2K (1440p)</option>
                <option value="1080" selected>Full HD (1080p)</option>
                <option value="720">HD (720p)</option>
                <option value="480">SD (480p)</option>
                <option value="360">Low (360p)</option>
              </select>
            </div>
          </div>

          <!-- Audio format (shown only for audio mode) -->
          <div class="tfield" id="ytAudioFmtField" style="display:none">
            <label>Audio Format</label>
            <select id="ytAudioFmt" class="tinput">
              <option value="mp3">MP3</option>
              <option value="ogg">OGG</option>
              <option value="wav">WAV</option>
              <option value="opus">OPUS</option>
            </select>
          </div>

          <!-- Download button -->
          <button class="tbtn primary" id="ytDlBtn" onclick="downloadYTVideo()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download Karo
          </button>

          <!-- Status / result -->
          <div id="ytStatus" style="display:none" class="yt-status-box">
            <div id="ytStatusMsg"></div>
            <a id="ytDlLink" href="#" target="_blank" class="tbtn primary" style="display:none;margin-top:10px;text-decoration:none">
              ⬇ File Download Karo
            </a>
          </div>

          <!-- Info note -->
          <div class="yt-note" style="margin-top:1rem">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div>
              Yeh tool <strong>cobalt.tools</strong> API use karta hai. Sirf apne personal use ke liye download karo.
              Copyright content ka commercial use allowed nahi hai.
            </div>
          </div>

          <!-- Thumbnail section -->
          <div class="yt-thumb-section" id="ytThumbSection" style="display:none">
            <div class="yt-thumb-divider">
              <span>Ya sirf Thumbnail download karo</span>
            </div>
            <div class="yt-quality-btns" id="ytThumbBtns"></div>
          </div>

        </div>

        <!-- Right preview -->
        <div class="tpreview-col">
          <div class="tplaceholder" id="ytVidPlaceholder">
            <span>▶️</span>
            <p>YouTube URL daalo<br>aur download karo</p>
          </div>

          <!-- Video preview card -->
          <div id="ytVideoCard" style="display:none">
            <div class="yt-video-preview">
              <img id="ytPreviewThumb" src="" alt="thumbnail" style="width:100%;border-radius:10px">
              <div class="yt-play-overlay" onclick="ytOpenVideo()">
                <div class="yt-play-btn">▶</div>
              </div>
            </div>
            <div class="yt-video-meta">
              <div class="yt-meta-row">
                <span class="yt-meta-label">Video ID</span>
                <code id="ytMetaVidId">—</code>
              </div>
              <div class="yt-meta-row">
                <span class="yt-meta-label">Platform</span>
                <code>YouTube</code>
              </div>
            </div>
            <div class="yt-formats-info">
              <div class="yt-fmt-pill">🎬 MP4 Video</div>
              <div class="yt-fmt-pill">🎵 MP3 Audio</div>
              <div class="yt-fmt-pill">🖼️ Thumbnail</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ────────────────────────────
         4. UTM BUILDER
    ──────────────────────────── -->
    <div class="tpanel" id="tp-utm">
      <div class="tpanel-header">
        <div>
          <h2>📊 UTM Link Builder</h2>
          <p>Google Analytics ke liye campaign tracking links banao</p>
        </div>
      </div>
      <div class="tpanel-body">
        <div class="tform-col">
          <div class="tfield">
            <label>Website URL <span class="req">*</span></label>
            <input type="url" id="utmBase" class="tinput" placeholder="https://tumharasite.com/page" oninput="buildUTM()">
          </div>
          <div class="tfield-row">
            <div class="tfield">
              <label>Source <span class="req">*</span></label>
              <input type="text" id="utmSrc" class="tinput" placeholder="google, facebook, email..." oninput="buildUTM()">
            </div>
            <div class="tfield">
              <label>Medium</label>
              <input type="text" id="utmMed" class="tinput" placeholder="cpc, organic, social..." oninput="buildUTM()">
            </div>
          </div>
          <div class="tfield-row">
            <div class="tfield">
              <label>Campaign</label>
              <input type="text" id="utmCamp" class="tinput" placeholder="diwali_sale, launch..." oninput="buildUTM()">
            </div>
            <div class="tfield">
              <label>Content</label>
              <input type="text" id="utmCont" class="tinput" placeholder="banner_top, cta_btn..." oninput="buildUTM()">
            </div>
          </div>
          <div class="tfield">
            <label>Term (Keyword)</label>
            <input type="text" id="utmTerm" class="tinput" placeholder="url shortener india..." oninput="buildUTM()">
          </div>
          <div class="tactions">
            <button class="tbtn primary" onclick="copyUTM()">Copy UTM Link</button>
            <button class="tbtn secondary" onclick="resetUTM()">Reset</button>
          </div>
        </div>
        <div class="tpreview-col">
          <div class="utm-output">
            <div class="utm-out-label">Generated Link</div>
            <div class="utm-out-val" id="utmOut">URL aur Source bharo...</div>
            <div class="utm-params" id="utmParams"></div>
          </div>
          <div class="utm-guide">
            <h4>📖 Quick Guide</h4>
            <div class="ug-row"><b>Source</b><span>Traffic kahan se aaya — google, newsletter, instagram</span></div>
            <div class="ug-row"><b>Medium</b><span>Channel type — cpc, email, social, organic</span></div>
            <div class="ug-row"><b>Campaign</b><span>Campaign naam — diwali_2024, product_launch</span></div>
            <div class="ug-row"><b>Content</b><span>Ad variant — banner_a, cta_button_red</span></div>
            <div class="ug-row"><b>Term</b><span>Paid keyword — url shortener india</span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ────────────────────────────
         5. JSON FORMATTER
    ──────────────────────────── -->
    <div class="tpanel" id="tp-json">
      <div class="tpanel-header">
        <div>
          <h2>{ } JSON Formatter &amp; Validator</h2>
          <p>JSON ko pretty print karo, validate karo, minify karo, sort karo</p>
        </div>
      </div>
      <div class="tpanel-body col-2-equal">
        <div class="tform-col">
          <div class="tfield" style="flex:1">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
              <label style="margin:0">Input JSON</label>
              <div style="display:flex;gap:6px">
                <button class="tbtn-xs" onclick="fmtJSON()">Format</button>
                <button class="tbtn-xs secondary" onclick="minJSON()">Minify</button>
                <button class="tbtn-xs secondary" onclick="sortJSON()">Sort Keys</button>
                <button class="tbtn-xs secondary" onclick="clearJSON()">Clear</button>
              </div>
            </div>
            <textarea id="jsonIn" class="tcode" placeholder='{"name":"Azmat","project":"SnapLink","version":1}' oninput="fmtJSON()" style="min-height:320px"></textarea>
          </div>
        </div>
        <div class="tform-col">
          <div class="tfield" style="flex:1">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
              <label style="margin:0">Output <span id="jsonStat"></span></label>
              <button class="tbtn-xs" onclick="copyText(document.getElementById('jsonOut').value,this)">Copy</button>
            </div>
            <textarea id="jsonOut" class="tcode" readonly placeholder="Formatted JSON yahan..." style="min-height:320px"></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- ────────────────────────────
         6. HASH GENERATOR
    ──────────────────────────── -->
    <div class="tpanel" id="tp-hash">
      <div class="tpanel-header">
        <div>
          <h2># Hash Generator</h2>
          <p>Text ka MD5, SHA-1, SHA-256, SHA-512 hash banao — browser mein hi</p>
        </div>
      </div>
      <div class="tpanel-body">
        <div class="tform-col">
          <div class="tfield">
            <label>Input Text</label>
            <textarea id="hashIn" class="tinput" rows="5" placeholder="Yahan text daalo..." oninput="genHash()"></textarea>
          </div>
          <div class="hash-results-list">
            <div class="hrow"><span>MD5</span><code id="hMD5">—</code><button onclick="copyText(document.getElementById('hMD5').textContent,this)">Copy</button></div>
            <div class="hrow"><span>SHA-1</span><code id="hSHA1">—</code><button onclick="copyText(document.getElementById('hSHA1').textContent,this)">Copy</button></div>
            <div class="hrow"><span>SHA-256</span><code id="hSHA256">—</code><button onclick="copyText(document.getElementById('hSHA256').textContent,this)">Copy</button></div>
            <div class="hrow"><span>SHA-512</span><code id="hSHA512">—</code><button onclick="copyText(document.getElementById('hSHA512').textContent,this)">Copy</button></div>
          </div>
        </div>
        <div class="tpreview-col">
          <div class="hash-info">
            <h4>Hash algorithms kab use hote hain?</h4>
            <div class="hi-row"><b>MD5</b><p>Checksums, file integrity (not for passwords)</p></div>
            <div class="hi-row"><b>SHA-1</b><p>Git commits, legacy systems</p></div>
            <div class="hi-row"><b>SHA-256</b><p>Passwords, digital signatures, blockchain</p></div>
            <div class="hi-row"><b>SHA-512</b><p>High security applications</p></div>
            <div class="hi-note">⚠ Passwords ke liye bcrypt ya Argon2 use karo — SHA alone kaafi nahi hai</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ────────────────────────────
         7. BASE64
    ──────────────────────────── -->
    <div class="tpanel" id="tp-b64">
      <div class="tpanel-header">
        <div>
          <h2>🔄 Base64 Encoder / Decoder</h2>
          <p>Text ya image ko Base64 mein encode/decode karo</p>
        </div>
      </div>
      <div class="tpanel-body">
        <div style="margin-bottom:1rem">
          <div class="mode-tabs">
            <button class="mtab active" onclick="b64Mode('text',this)">Text</button>
            <button class="mtab" onclick="b64Mode('image',this)">Image → Base64</button>
          </div>
        </div>
        <!-- Text mode -->
        <div id="b64TextMode" class="tpanel-body col-2-equal" style="padding:0">
          <div class="tform-col">
            <div class="tfield">
              <label>Input</label>
              <textarea id="b64In" class="tcode" placeholder="Encode ya decode karna hai..." style="min-height:240px"></textarea>
            </div>
            <div class="tactions">
              <button class="tbtn primary" onclick="doB64Enc()">Encode →</button>
              <button class="tbtn secondary" onclick="doB64Dec()">← Decode</button>
              <button class="tbtn secondary" onclick="document.getElementById('b64In').value='';document.getElementById('b64Out').value=''">Clear</button>
            </div>
          </div>
          <div class="tform-col">
            <div class="tfield">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                <label style="margin:0">Output</label>
                <button class="tbtn-xs" onclick="copyText(document.getElementById('b64Out').value,this)">Copy</button>
              </div>
              <textarea id="b64Out" class="tcode" readonly placeholder="Result yahan..." style="min-height:240px"></textarea>
            </div>
          </div>
        </div>
        <!-- Image mode -->
        <div id="b64ImgMode" style="display:none">
          <div class="tfield">
