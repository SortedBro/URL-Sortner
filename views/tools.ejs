<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: 'Free Tools | QR, UTM, JSON, Password, and Utility Generators | SnapLink',
      description: 'Use SnapLink free tools for QR generation, UTM building, JSON formatting, password generation, image compression, and more browser-based utilities.',
      keywords: 'free tools, qr code generator, utm builder, json formatter, password generator, free online utilities',
      path: '/tools',
      stylesheets: ['/css/pages/site-shell.css', '/css/pages/marketing-pages.css', '/css/pages/tools.css'],
      jsonLd: {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'QR Code Generator' },
          { '@type': 'ListItem', position: 2, name: 'Image Compressor' },
          { '@type': 'ListItem', position: 3, name: 'UTM Builder' },
          { '@type': 'ListItem', position: 4, name: 'JSON Formatter' },
          { '@type': 'ListItem', position: 5, name: 'Password Generator' },
          { '@type': 'ListItem', position: 6, name: 'URL Encode / Decode' },
          { '@type': 'ListItem', position: 7, name: 'Text Case Converter' },
          { '@type': 'ListItem', position: 8, name: 'UUID Generator' }
        ]
      }
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
</head>
<body class="site-page tools-page">
<%- include('partials/site-navbar', { currentPage: 'tools' }) %>

<main class="page-shell page-stack tools-main">

  <section class="tool-overview">
    <div class="tool-directory">
      <div>
        <div class="eyebrow">Free tools</div>
        <h1 class="hero-title">Utility tools that stay <span>fast, simple, and browser-first</span>.</h1>
        <p class="hero-text">Use these tools without logging in. Generate QR codes, compress images, build UTM links, format JSON, and handle day-to-day utility work in one place.</p>
        <div class="hero-stats">
          <div class="hero-stat"><strong>Free</strong><span>No account required</span></div>
          <div class="hero-stat"><strong>Browser</strong><span>Instant utility workflows</span></div>
          <div class="hero-stat"><strong>Wide set</strong><span>Marketing, dev, and productivity helpers</span></div>
        </div>
      </div>

      <aside class="tool-summary-card">
        <div class="section-kicker">Popular picks</div>
        <h3>Jump into the tools most users open first.</h3>
        <p class="tool-summary-copy">The full panel set below stays intact. This quick directory just helps you land faster.</p>
        <div class="tool-tags">
          <span onclick="openTool('qr')">QR Generator</span>
          <span onclick="openTool('img')">Image Compressor</span>
          <span onclick="openTool('utm')">UTM Builder</span>
          <span onclick="openTool('json')">JSON Formatter</span>
          <span onclick="openTool('pass')">Password Generator</span>
          <span onclick="openTool('meta')">Meta Tag Generator</span>
        </div>
      </aside>
    </div>

    <div class="tools-hero">
      <div class="tools-badge">Free tools collection</div>
      <h2 class="tools-title">Open any tool from the directory below.</h2>
      <p class="tools-subtitle">No install. No workflow friction. Just open, generate, copy, and move on.</p>

      <div class="tools-nav-grid">
        <button class="tnav-card" onclick="openTool('qr')"><span class="tnav-icon">QR</span><span class="tnav-label">QR Generator</span></button>
        <button class="tnav-card" onclick="openTool('img')"><span class="tnav-icon">IMG</span><span class="tnav-label">Image Compressor</span></button>
        <button class="tnav-card" onclick="openTool('yt')"><span class="tnav-icon">VID</span><span class="tnav-label">Video Downloader</span></button>
        <button class="tnav-card" onclick="openTool('utm')"><span class="tnav-icon">UTM</span><span class="tnav-label">UTM Builder</span></button>
        <button class="tnav-card" onclick="openTool('json')"><span class="tnav-icon">{ }</span><span class="tnav-label">JSON Formatter</span></button>
        <button class="tnav-card" onclick="openTool('hash')"><span class="tnav-icon">#</span><span class="tnav-label">Hash Generator</span></button>
        <button class="tnav-card" onclick="openTool('b64')"><span class="tnav-icon">B64</span><span class="tnav-label">Base64</span></button>
        <button class="tnav-card" onclick="openTool('color')"><span class="tnav-icon">CLR</span><span class="tnav-label">Color Picker</span></button>
        <button class="tnav-card" onclick="openTool('word')"><span class="tnav-icon">TXT</span><span class="tnav-label">Word Counter</span></button>
        <button class="tnav-card" onclick="openTool('codec')"><span class="tnav-icon">URL</span><span class="tnav-label">Encode / Decode</span></button>
        <button class="tnav-card" onclick="openTool('case')"><span class="tnav-icon">Aa</span><span class="tnav-label">Case Converter</span></button>
        <button class="tnav-card" onclick="openTool('uuid')"><span class="tnav-icon">ID</span><span class="tnav-label">UUID Generator</span></button>
        <button class="tnav-card" onclick="openTool('pass')"><span class="tnav-icon">KEY</span><span class="tnav-label">Password Generator</span></button>
        <button class="tnav-card" onclick="openTool('fake')"><span class="tnav-icon">ID</span><span class="tnav-label">Fake Data</span></button>
        <button class="tnav-card" onclick="openTool('md')"><span class="tnav-icon">MD</span><span class="tnav-label">Markdown Editor</span></button>
        <button class="tnav-card" onclick="openTool('meta')"><span class="tnav-icon">SEO</span><span class="tnav-label">Meta Tag Generator</span></button>
        <button class="tnav-card" onclick="openTool('emoji')"><span class="tnav-icon">EMJ</span><span class="tnav-label">Emoji Picker</span></button>
        <button class="tnav-card" onclick="openTool('inv')"><span class="tnav-icon">INV</span><span class="tnav-label">Invoice Generator</span></button>
        <button class="tnav-card" onclick="openTool('num')"><span class="tnav-icon">123</span><span class="tnav-label">Number to Words</span></button>
        <button class="tnav-card" onclick="openTool('aspect')"><span class="tnav-icon">RTO</span><span class="tnav-label">Aspect Ratio</span></button>
        <button class="tnav-card" onclick="openTool('gst')"><span class="tnav-icon">GST</span><span class="tnav-label">GST Calculator</span></button>
        <button class="tnav-card" onclick="openTool('profit')"><span class="tnav-icon">ROI</span><span class="tnav-label">Profit Margin</span></button>
        <button class="tnav-card" onclick="openTool('pomo')"><span class="tnav-icon">TMR</span><span class="tnav-label">Pomodoro Timer</span></button>
        <button class="tnav-card" onclick="openTool('unit')"><span class="tnav-icon">UNIT</span><span class="tnav-label">Unit Converter</span></button>
        <button class="tnav-card" onclick="openTool('grad')"><span class="tnav-icon">CSS</span><span class="tnav-label">CSS Gradient</span></button>
        <button class="tnav-card" onclick="openTool('age')"><span class="tnav-icon">AGE</span><span class="tnav-label">Age Calculator</span></button>
      </div>
    </div>
  </section>

  <!-- Tool tabs -->
  <div class="tool-tabs-bar">
    <div class="tool-tabs-scroll">
      <button class="ttab active" id="ttab-qr"    onclick="openTool('qr',this)">QR Code</button>
      <button class="ttab" id="ttab-img"   onclick="openTool('img',this)">Image Compressor</button>
      <button class="ttab" id="ttab-yt"    onclick="openTool('yt',this)">Video Downloader</button>
      <button class="ttab" id="ttab-utm"   onclick="openTool('utm',this)">UTM Builder</button>
      <button class="ttab" id="ttab-pass"  onclick="openTool('pass',this)">Password</button>
      <button class="ttab" id="ttab-fake"  onclick="openTool('fake',this)">Fake Data</button>
      <button class="ttab" id="ttab-md"    onclick="openTool('md',this)">Markdown</button>
      <button class="ttab" id="ttab-meta"  onclick="openTool('meta',this)">Meta Tags</button>
      <button class="ttab" id="ttab-emoji" onclick="openTool('emoji',this)">Emoji</button>
      <button class="ttab" id="ttab-inv"   onclick="openTool('inv',this)">Invoice</button>
      <button class="ttab" id="ttab-json"  onclick="openTool('json',this)">{ } JSON</button>
      <button class="ttab" id="ttab-hash"  onclick="openTool('hash',this)"># Hash</button>
      <button class="ttab" id="ttab-b64"   onclick="openTool('b64',this)">Base64</button>
      <button class="ttab" id="ttab-color" onclick="openTool('color',this)">Color</button>
      <button class="ttab" id="ttab-word"  onclick="openTool('word',this)">Word Count</button>
      <button class="ttab" id="ttab-codec" onclick="openTool('codec',this)">URL Codec</button>
      <button class="ttab" id="ttab-case"  onclick="openTool('case',this)">Case</button>
      <button class="ttab" id="ttab-uuid"  onclick="openTool('uuid',this)">UUID</button>

      <button class="ttab" id="ttab-num"    onclick="openTool('num',this)">Num to Words</button>
      <button class="ttab" id="ttab-aspect" onclick="openTool('aspect',this)">Aspect</button>
      <button class="ttab" id="ttab-gst"    onclick="openTool('gst',this)">GST Calc</button>
      <button class="ttab" id="ttab-profit" onclick="openTool('profit',this)">Profit</button>
      <button class="ttab" id="ttab-pomo"   onclick="openTool('pomo',this)">Pomodoro</button>
      <button class="ttab" id="ttab-unit"   onclick="openTool('unit',this)">Units</button>
      <button class="ttab" id="ttab-grad"   onclick="openTool('grad',this)">Gradient</button>
      <button class="ttab" id="ttab-age"    onclick="openTool('age',this)">Age Calc</button>
    </div>
  </div>

  <!-- Tool panels -->
  <div class="tools-panels-wrap">

    <!-- 1. QR code generator -->
    <div class="tpanel active" id="tp-qr">
      <div class="tpanel-header">
        <div>
          <h2>QR Code Generator</h2>
          <p>Create a QR code for any URL, text, or number, then customize and download it.</p>
        </div>
      </div>
      <div class="tpanel-body">
        <div class="tform-col">
          <div class="tfield">
            <label>URL ya Text</label>
            <input type="text" id="qrInput" class="tinput" placeholder="https://example.com ya koi bhi text..." oninput="genQR()">
          </div>
          <div class="tfield-row">
            <div class="tfield">
              <label>Size</label>
              <select id="qrSize" class="tinput" onchange="genQR()">
                <option value="200">200x200 (Small)</option>
                <option value="300" selected>300x300 (Medium)</option>
                <option value="500">500x500 (Large)</option>
                <option value="1000">1000x1000 (HD)</option>
              </select>
            </div>
            <div class="tfield">
              <label>Error Correction</label>
              <select id="qrEC" class="tinput" onchange="genQR()">
                <option value="L">L - Low (7%)</option>
                <option value="M" selected>M - Medium (15%)</option>
                <option value="Q">Q - Quartile (25%)</option>
                <option value="H">H - High (30%)</option>
              </select>
            </div>
          </div>
          <div class="tfield">
            <label>Colors</label>
            <div class="color-row-wrap">
              <label class="color-picker-label">
                QR Color
                <input type="color" id="qrFg" value="#000000" onchange="genQR()">
              </label>
              <label class="color-picker-label">
                Background
                <input type="color" id="qrBg" value="#ffffff" onchange="genQR()">
              </label>
            </div>
          </div>
          <div class="tactions">
            <button class="tbtn primary" onclick="dlQR()">Download PNG</button>
            <button class="tbtn secondary" onclick="copyQRDataURL()">Copy as Image</button>
          </div>
        </div>
        <div class="tpreview-col">
          <div class="qr-box" id="qrBox">
            <canvas id="qrCanvas"></canvas>
            <div class="tplaceholder" id="qrPlaceholder">
              <span>QR</span>
              <p>Enter a URL or text and the QR preview will appear here.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
         2. IMAGE COMPRESSOR
    â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <div class="tpanel" id="tp-img">
      <div class="tpanel-header">
        <div>
          <h2>Image Compressor</h2>
          <p>JPG, PNG, WebP compress karo - quality rakho, size kam karo</p>
        </div>
      </div>
      <div class="tpanel-body">
        <div class="tform-col">
          <div class="tfield">
            <label>Image Upload Karo</label>
            <div class="drop-zone" id="imgDZ" onclick="document.getElementById('imgFile').click()" ondragover="event.preventDefault()" ondrop="imgDrop(event)">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span id="imgDZText">Click karo ya drag &amp; drop - JPG, PNG, WebP</span>
            </div>
            <input type="file" id="imgFile" accept="image/*" style="display:none" onchange="loadImg(this)">
          </div>
          <div class="tfield">
            <label>Quality: <span id="qVal">80</span>%</label>
            <input type="range" id="imgQ" min="10" max="100" value="80" class="trange" oninput="document.getElementById('qVal').textContent=this.value;compressImg()">
          </div>
          <div class="tfield">
            <label>Output Format</label>
            <select id="imgFmt" class="tinput" onchange="compressImg()">
              <option value="">Same as input</option>
              <option value="image/jpeg">JPEG</option>
              <option value="image/png">PNG</option>
              <option value="image/webp">WebP</option>
            </select>
          </div>
          <div id="imgStatsRow" class="stats-row" style="display:none">
            <div class="stat-pill"><span>Original</span><b id="iOrig">-</b></div>
            <div class="stat-pill green"><span>Compressed</span><b id="iComp">-</b></div>
            <div class="stat-pill accent"><span>Saved</span><b id="iSave">-</b></div>
          </div>
          <button class="tbtn primary" id="imgDlBtn" onclick="dlImg()" style="display:none">Download Compressed</button>
        </div>
        <div class="tpreview-col">
          <canvas id="imgCanvas" style="max-width:100%;border-radius:12px;display:none"></canvas>
          <div class="tplaceholder" id="imgPlaceholder">
            <span>IMG</span>
            <p>Image preview yahan dikhegi</p>
          </div>
        </div>
      </div>
    </div>

    <!-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
         3. YT VIDEO DOWNLOADER
    â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <div class="tpanel" id="tp-yt">
      <div class="tpanel-header">
        <div>
          <h2>YouTube Video Downloader</h2>
          <p>YouTube video ya audio download karo - MP4, MP3, free mein</p>
        </div>
        <div class="yt-powered-badge">
          Powered by <strong>cobalt.tools</strong>
        </div>
      </div>

      <div class="tpanel-body">
        <div class="tform-col">

          <!-- URL input -->
          <div class="tfield">
            <label>YouTube Video URL</label>
            <input type="text" id="ytVidUrl" class="tinput"
              placeholder="https://youtube.com/watch?v=dQw4w9WgXcQ">
          </div>

          <!-- Options row -->
          <div class="tfield-row">
            <div class="tfield">
              <label>Type</label>
              <select id="ytType" class="tinput" onchange="ytTypeChange()">
                <option value="video">Video (MP4)</option>
                <option value="audio">Audio Only (MP3)</option>
                <option value="mute">Video Only (No Audio)</option>
              </select>
            </div>
            <div class="tfield">
              <label>Quality</label>
              <select id="ytQuality" class="tinput">
                <option value="max">Max (Best)</option>
                <option value="2160">4K (2160p)</option>
                <option value="1440">2K (1440p)</option>
                <option value="1080" selected>Full HD (1080p)</option>
                <option value="720">HD (720p)</option>
                <option value="480">SD (480p)</option>
                <option value="360">Low (360p)</option>
              </select>
            </div>
          </div>

          <!-- Audio format (shown only for audio mode) -->
          <div class="tfield" id="ytAudioFmtField" style="display:none">
            <label>Audio Format</label>
            <select id="ytAudioFmt" class="tinput">
              <option value="mp3">MP3</option>
              <option value="ogg">OGG</option>
              <option value="wav">WAV</option>
              <option value="opus">OPUS</option>
            </select>
          </div>

          <!-- Download button -->
          <button class="tbtn primary" id="ytDlBtn" onclick="downloadYTVideo()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download Karo
          </button>

          <!-- Status / result -->
          <div id="ytStatus" style="display:none" class="yt-status-box">
            <div id="ytStatusMsg"></div>
            <a id="ytDlLink" href="#" target="_blank" class="tbtn primary" style="display:none;margin-top:10px;text-decoration:none">
              Download File
            </a>
          </div>

          <!-- Info note -->
          <div class="yt-note" style="margin-top:1rem">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div>
              Yeh tool <strong>cobalt.tools</strong> API use karta hai. Sirf apne personal use ke liye download karo.
              Copyright content ka commercial use allowed nahi hai.
            </div>
          </div>

          <!-- Thumbnail section -->
          <div class="yt-thumb-section" id="ytThumbSection" style="display:none">
            <div class="yt-thumb-divider">
              <span>Ya sirf Thumbnail download karo</span>
            </div>
            <div class="yt-quality-btns" id="ytThumbBtns"></div>
          </div>

        </div>

        <!-- Right preview -->
        <div class="tpreview-col">
          <div class="tplaceholder" id="ytVidPlaceholder">
            <span>PLAY</span>
            <p>YouTube URL daalo<br>aur download karo</p>
          </div>

          <!-- Video preview card -->
          <div id="ytVideoCard" style="display:none">
            <div class="yt-video-preview">
              <img id="ytPreviewThumb" src="" alt="thumbnail" style="width:100%;border-radius:10px">
              <div class="yt-play-overlay" onclick="ytOpenVideo()">
                <div class="yt-play-btn">PLAY</div>
              </div>
            </div>
            <div class="yt-video-meta">
              <div class="yt-meta-row">
                <span class="yt-meta-label">Video ID</span>
                <code id="ytMetaVidId">-</code>
              </div>
              <div class="yt-meta-row">
                <span class="yt-meta-label">Platform</span>
                <code>YouTube</code>
              </div>
            </div>
            <div class="yt-formats-info">
              <div class="yt-fmt-pill">MP4 Video</div>
              <div class="yt-fmt-pill">MP3 Audio</div>
              <div class="yt-fmt-pill">Thumbnail</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
         4. UTM BUILDER
    â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <div class="tpanel" id="tp-utm">
      <div class="tpanel-header">
        <div>
          <h2>UTM Link Builder</h2>
          <p>Google Analytics ke liye campaign tracking links banao</p>
        </div>
      </div>
      <div class="tpanel-body">
        <div class="tform-col">
          <div class="tfield">
            <label>Website URL <span class="req">*</span></label>
            <input type="url" id="utmBase" class="tinput" placeholder="https://tumharasite.com/page" oninput="buildUTM()">
          </div>
          <div class="tfield-row">
            <div class="tfield">
              <label>Source <span class="req">*</span></label>
              <input type="text" id="utmSrc" class="tinput" placeholder="google, facebook, email..." oninput="buildUTM()">
            </div>
            <div class="tfield">
              <label>Medium</label>
              <input type="text" id="utmMed" class="tinput" placeholder="cpc, organic, social..." oninput="buildUTM()">
            </div>
          </div>
          <div class="tfield-row">
            <div class="tfield">
              <label>Campaign</label>
              <input type="text" id="utmCamp" class="tinput" placeholder="diwali_sale, launch..." oninput="buildUTM()">
            </div>
            <div class="tfield">
              <label>Content</label>
              <input type="text" id="utmCont" class="tinput" placeholder="banner_top, cta_btn..." oninput="buildUTM()">
            </div>
          </div>
          <div class="tfield">
            <label>Term (Keyword)</label>
            <input type="text" id="utmTerm" class="tinput" placeholder="url shortener india..." oninput="buildUTM()">
          </div>
          <div class="tactions">
            <button class="tbtn primary" onclick="copyUTM()">Copy UTM Link</button>
            <button class="tbtn secondary" onclick="resetUTM()">Reset</button>
          </div>
        </div>
        <div class="tpreview-col">
          <div class="utm-output">
            <div class="utm-out-label">Generated Link</div>
            <div class="utm-out-val" id="utmOut">URL aur Source bharo...</div>
            <div class="utm-params" id="utmParams"></div>
          </div>
          <div class="utm-guide">
            <h4>Quick Guide</h4>
            <div class="ug-row"><b>Source</b><span>Traffic kahan se aaya - google, newsletter, instagram</span></div>
            <div class="ug-row"><b>Medium</b><span>Channel type - cpc, email, social, organic</span></div>
            <div class="ug-row"><b>Campaign</b><span>Campaign naam - diwali_2024, product_launch</span></div>
            <div class="ug-row"><b>Content</b><span>Ad variant - banner_a, cta_button_red</span></div>
            <div class="ug-row"><b>Term</b><span>Paid keyword - url shortener india</span></div>
          </div>
        </div>
      </div>
    </div>

    <!-- â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
         5. JSON FORMATTER
    â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
