            <div class="grad-types">
              <button class="grad-type-btn active" onclick="setGradType('linear',this)">Linear</button>
              <button class="grad-type-btn" onclick="setGradType('radial',this)">Radial</button>
              <button class="grad-type-btn" onclick="setGradType('conic',this)">Conic</button>
            </div>
          </div>
          <div class="tfield" id="gradAngleField"><label>Angle: <span id="gradAngleVal">135</span>°</label><input type="range" id="gradAngle" min="0" max="360" value="135" class="trange" oninput="document.getElementById('gradAngleVal').textContent=this.value;updateGrad()"></div>
          <div class="tfield">
            <label>Colors</label>
            <div id="gradColorsList"></div>
            <button class="tbtn-xs secondary" onclick="addGradColor()" style="margin-top:8px">+ Color Add Karo</button>
          </div>
          <div class="tfield"><label>Presets</label>
            <div class="grad-presets" id="gradPresets"></div>
          </div>
          <div class="tfield">
            <label>Generated CSS</label>
            <div class="grad-css-output">
              <code id="gradCSS"></code>
              <button class="tbtn-xs" onclick="copyText(document.getElementById('gradCSS').textContent,this)">Copy</button>
            </div>
          </div>
        </div>
        <div class="tpreview-col">
          <div class="grad-preview" id="gradPreview"></div>
          <div class="grad-usage-preview">
            <div class="grad-btn-prev" id="gradBtnPrev">Button Example</div>
            <div class="grad-text-prev" id="gradTextPrev">Text Background</div>
            <div class="grad-card-prev" id="gradCardPrev">Card Header</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ─── AGE CALCULATOR ─── -->
    <div class="tpanel" id="tp-age2">
      <div class="tpanel-header"><div><h2>📅 Age &amp; Date Calculator</h2><p>Exact age nikalo, days count karo, koi bhi date difference</p></div></div>
      <div class="tpanel-body">
        <div class="tform-col">
          <div class="tfield"><label>Date of Birth</label><input type="date" id="ageDOB" class="tinput" oninput="calcAge()"></div>
          <div class="tfield"><label>Calculate Age As Of</label><input type="date" id="ageAsOf" class="tinput" oninput="calcAge()"></div>
          <hr style="border:none;border-top:0.5px solid var(--border);margin:8px 0">
          <div class="tfield"><label>Date Difference (2 dates ke beech)</label></div>
          <div class="tfield-row">
            <div class="tfield"><label>Start Date</label><input type="date" id="dateStart" class="tinput" oninput="calcDateDiff()"></div>
            <div class="tfield"><label>End Date</label><input type="date" id="dateEnd" class="tinput" oninput="calcDateDiff()"></div>
          </div>
          <div class="tfield"><label>Upcoming Event</label><input type="date" id="dateEvent" class="tinput" oninput="calcCountdown()"><div id="countdownResult" style="margin-top:6px;font-size:13px;color:var(--accent);font-family:var(--mono)"></div></div>
        </div>
        <div class="tpreview-col">
          <div class="age-result-box" id="ageResult">
            <div class="age-main"><div class="age-big" id="ageYears">—</div><div class="age-label">Years Old</div></div>
            <div class="age-breakdown">
              <div class="age-row"><span>Months</span><strong id="ageMonths">—</strong></div>
              <div class="age-row"><span>Weeks</span><strong id="ageWeeks">—</strong></div>
              <div class="age-row"><span>Days</span><strong id="ageDays">—</strong></div>
              <div class="age-row"><span>Hours</span><strong id="ageHours">—</strong></div>
              <div class="age-row accent"><span>Next Birthday</span><strong id="ageNextBday">—</strong></div>
            </div>
          </div>
          <div class="date-diff-result" id="dateDiffResult" style="display:none">
            <div class="age-row"><span>Total Days</span><strong id="ddDays">—</strong></div>
            <div class="age-row"><span>Weeks</span><strong id="ddWeeks">—</strong></div>
            <div class="age-row"><span>Months (approx)</span><strong id="ddMonths">—</strong></div>
            <div class="age-row"><span>Working Days (approx)</span><strong id="ddWork">—</strong></div>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /tools-panels-wrap -->

</main>

