<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: 'Verify OTP | SnapLink',
      description: 'Verify your email with the OTP sent during SnapLink signup.',
      path: '/verify-otp',
      robots: 'noindex, nofollow',
      stylesheets: ['/css/pages/site-shell.css', '/css/pages/marketing-pages.css', '/css/pages/auth-shell.css']
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
</head>
<body class="site-page auth-page">
  <%- include('partials/auth-navbar', { helperLinkHref: '/login', helperLinkLabel: 'Log in', helperCopyText: 'Already verified?' }) %>

  <main class="auth-main">
    <section class="auth-shell">
      <aside class="auth-aside">
        <div class="auth-kicker">Email verification</div>
        <h1 class="auth-title">Confirm your email to activate the account.</h1>
        <p class="auth-copy">We sent a six-digit code to <strong><%= email %></strong>. Enter it below to finish signup.</p>
        <div class="auth-points">
          <div class="auth-point"><strong>Secure activation</strong><p class="section-copy">The account stays protected until the OTP is verified.</p></div>
          <div class="auth-point"><strong>Fast retry</strong><p class="section-copy">If the code is delayed, use the resend action after the timer ends.</p></div>
        </div>
      </aside>

      <div class="auth-card">
        <div class="auth-kicker">One-time password</div>
        <h2 class="auth-title">Enter your 6-digit OTP.</h2>
        <p class="auth-copy">Check your inbox and paste the code if you copied it from email.</p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="inline-alert error"><%= error %></div>
        <% } else if (typeof success !== 'undefined' && success) { %>
          <div class="inline-alert success"><%= success %></div>
        <% } else { %>
          <div class="inline-alert" id="clientMsg" style="display:none;"></div>
        <% } %>

        <form action="/verify-otp" method="POST" id="otpForm" class="auth-form">
          <input type="hidden" name="email" value="<%= email %>">
          <input type="hidden" name="otp" id="otpValue">
          <div class="otp-grid">
            <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off">
            <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off">
            <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off">
            <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off">
            <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off">
            <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off">
          </div>
          <button class="btn-submit" type="submit" id="verifyBtn" disabled>Verify OTP</button>
        </form>

        <div class="otp-helper">
          <span>Did not receive the code?</span>
          <button class="text-button" id="resendBtn" type="button" disabled onclick="resendOtp()">Resend in <span id="timer">30</span>s</button>
        </div>
      </div>
    </section>
  </main>

  <script src="/js/shared/theme.js"></script>
  <script>
    const boxes = Array.from(document.querySelectorAll('.otp-box'));
    const verifyBtn = document.getElementById('verifyBtn');
    const otpValue = document.getElementById('otpValue');
    const clientMsg = document.getElementById('clientMsg');
    const resendBtn = document.getElementById('resendBtn');
    let seconds = 30;
    let countdownId = null;

    function checkComplete() {
      const otp = boxes.map((box) => box.value).join('');
      otpValue.value = otp;
      verifyBtn.disabled = otp.length < 6;
    }

    function startCountdown() {
      clearInterval(countdownId);
      seconds = 30;
      resendBtn.disabled = true;
      resendBtn.innerHTML = `Resend in <span id="timer">${seconds}</span>s`;
      countdownId = setInterval(() => {
        seconds -= 1;
        const timerNode = document.getElementById('timer');
        if (timerNode) timerNode.textContent = seconds;
        if (seconds <= 0) {
          clearInterval(countdownId);
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend OTP';
        }
      }, 1000);
    }

    boxes.forEach((box, index) => {
      box.addEventListener('input', () => {
        box.value = box.value.replace(/[^0-9]/g, '');
        if (box.value && index < boxes.length - 1) boxes[index + 1].focus();
        checkComplete();
      });

      box.addEventListener('keydown', (event) => {
        if (event.key === 'Backspace' && !box.value && index > 0) {
          boxes[index - 1].focus();
        }
      });

      box.addEventListener('paste', (event) => {
        event.preventDefault();
        const pasted = event.clipboardData.getData('text').replace(/[^0-9]/g, '').slice(0, 6);
        pasted.split('').forEach((char, pastedIndex) => {
          if (boxes[pastedIndex]) boxes[pastedIndex].value = char;
        });
        checkComplete();
      });
    });

    async function resendOtp() {
      resendBtn.disabled = true;
      resendBtn.textContent = 'Sending...';
      try {
        const response = await fetch('/resend-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: '<%= email %>' })
        });

        if (response.ok && clientMsg) {
          clientMsg.textContent = 'OTP sent again successfully.';
          clientMsg.className = 'inline-alert success';
          clientMsg.style.display = 'block';
        }
      } catch (error) {
        if (clientMsg) {
          clientMsg.textContent = 'Could not resend OTP right now.';
          clientMsg.className = 'inline-alert error';
          clientMsg.style.display = 'block';
        }
      }
      startCountdown();
    }

    boxes[0].focus();
    startCountdown();
  </script>
</body>
</html>
