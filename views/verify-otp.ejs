<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify OTP</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/pages/generated/verify-otp.inline.css" />
</head>

<body>

    <button class="theme-btn" onclick="toggleTheme()" id="themeBtn">🌙</button>

    <div class="card">
        <span class="otp-icon">📩</span>

        <div class="card-title">OTP verify karo</div>
        <div class="card-sub">
            Humne ek 6-digit code bheja hai<br>
            <!-- Server se email pass karo: -->
            <strong>
                <%= email %>
            </strong> pe
        </div>
        <% if (typeof error !=='undefined' && error) { %>
            <div class="msg error">
                <%= error %>
            </div>
            <% } else if (typeof success !=='undefined' && success) { %>
                <div class="msg success">
                    <%= success %>
                </div>
                <% } else { %>
                    <div class="msg" id="clientMsg"></div>
                    <% } %>


                        <form action="/verify-otp" method="POST" id="otpForm">
                            <!-- Hidden field — email bhi saath bhejo -->
                            <input type="hidden" name="email" value="<%= email %>" />

                            <!-- 6 OTP boxes -->
                            <div class="otp-inputs">
                                <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                                    autocomplete="off" id="o1" />
                                <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                                    autocomplete="off" id="o2" />
                                <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                                    autocomplete="off" id="o3" />
                                <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                                    autocomplete="off" id="o4" />
                                <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                                    autocomplete="off" id="o5" />
                                <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]"
                                    autocomplete="off" id="o6" />
                            </div>

                            <!-- Hidden combined OTP -->
                            <input type="hidden" name="otp" id="otpValue" />

                            <button class="verify-btn" type="submit" id="verifyBtn" disabled>
                                Verify karo
                            </button>
                        </form>

                        <!-- Resend -->
                        <div class="resend-row">
                            Code nahi aaya?
                            <button class="resend-btn" id="resendBtn" disabled onclick="resendOtp()">
                                Resend karo (<span id="timer">30</span>s)
                            </button>
                        </div>

                        <div class="divider"></div>
                        <a href="/login" class="back-link">← Login pe wapas jao</a>
    </div>

    <script>
        // ── Dark mode ──
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
            document.body.classList.add('dark');
            document.getElementById('themeBtn').textContent = '☀️';
        }
        function toggleTheme() {
            document.body.classList.toggle('dark');
            const isDark = document.body.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            document.getElementById('themeBtn').textContent = isDark ? '☀️' : '🌙';
        }

        // ── OTP boxes logic ──
        const boxes = Array.from(document.querySelectorAll('.otp-box'));
        const verifyBtn = document.getElementById('verifyBtn');
        const otpValue = document.getElementById('otpValue');
        const clientMsg = document.getElementById('clientMsg');

        boxes.forEach((box, i) => {
            box.addEventListener('input', (e) => {
                // Sirf number allow karo
                box.value = box.value.replace(/[^0-9]/g, '');

                if (box.value) {
                    box.classList.add('filled');
                    box.classList.remove('error');
                    // Agla box pe focus
                    if (i < 5) boxes[i + 1].focus();
                } else {
                    box.classList.remove('filled');
                }
                checkComplete();
            });

            // Backspace — pichle box pe jao
            box.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !box.value && i > 0) {
                    boxes[i - 1].focus();
                    boxes[i - 1].value = '';
                    boxes[i - 1].classList.remove('filled');
                    checkComplete();
                }
            });

            // Paste support — 6 digit ek saath paste
            box.addEventListener('paste', (e) => {
                e.preventDefault();
                const pasted = e.clipboardData.getData('text').replace(/[^0-9]/g, '').slice(0, 6);
                pasted.split('').forEach((char, idx) => {
                    if (boxes[idx]) {
                        boxes[idx].value = char;
                        boxes[idx].classList.add('filled');
                    }
                });
                if (pasted.length === 6) boxes[5].focus();
                checkComplete();
            });
        });

        function checkComplete() {
            const otp = boxes.map(b => b.value).join('');
            otpValue.value = otp;
            verifyBtn.disabled = otp.length < 6;
        }

    // Shake on server error
     if (typeof error !== 'undefined' && error) { 
            boxes.forEach(b => b.classList.add('error'));
     } 

            // ── Resend timer ──
            let seconds = 30;
        const timerEl = document.getElementById('timer');
        const resendBtn = document.getElementById('resendBtn');

        const countdown = setInterval(() => {
            seconds--;
            timerEl.textContent = seconds;
            if (seconds <= 0) {
                clearInterval(countdown);
                resendBtn.disabled = false;
                resendBtn.innerHTML = 'Resend karo';
            }
        }, 1000);

        async function resendOtp() {
            resendBtn.disabled = true;
            resendBtn.textContent = 'Bhej raha hai...';

            try {
                const res = await fetch('/resend-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: '<%= email %>' })
                });

                if (res.ok) {
                    if (clientMsg) {
                        clientMsg.textContent = '✓ OTP dobara bhej diya!';
                        clientMsg.className = 'msg success';
                    }
                    // Timer reset
                    seconds = 30;
                    timerEl.textContent = seconds;
                    resendBtn.innerHTML = `Resend karo (<span id="timer">${seconds}</span>s)`;
                    const newTimer = setInterval(() => {
                        seconds--;
                        document.getElementById('timer').textContent = seconds;
                        if (seconds <= 0) {
                            clearInterval(newTimer);
                            resendBtn.disabled = false;
                            resendBtn.innerHTML = 'Resend karo';
                        }
                    }, 1000);
                }
            } catch (e) {
                resendBtn.disabled = false;
                resendBtn.textContent = 'Resend karo';
            }
        }

        // Auto focus first box
        boxes[0].focus();
    </script>

</body>

</html>

