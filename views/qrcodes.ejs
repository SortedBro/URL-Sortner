<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>QR Codes — SnapLink</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="icon" type="image/png" href="/favicon.png"/>
  <script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }
    :root {
      --bg:#0d0d0b; --bg2:#141412; --bg3:#1c1c19; --bg4:#242420;
      --accent:#f5c842; --accent2:#d4a520;
      --text:#edeae2; --text2:#918e87; --text3:#55524e;
      --border:#242420; --border2:#2e2e2a;
      --green:#4ade80; --red:#f87171;
      --radius:10px; --radius2:14px; --sidebar:220px;
    }
    [data-theme="light"] {
      --bg:#f5f4f0; --bg2:#ffffff; --bg3:#f0ede8; --bg4:#e8e5e0;
      --text:#1a1916; --text2:#6b6862; --text3:#a09d98;
      --border:#e0ddd8; --border2:#d0cdc8;
    }
    body { background:var(--bg); color:var(--text); font-family:'Space Grotesk',sans-serif; min-height:100vh; display:grid; grid-template-columns:var(--sidebar) 1fr; }

    /* SIDEBAR — same as other pages */
    .sidebar { background:var(--bg2); border-right:1px solid var(--border); display:flex; flex-direction:column; padding:20px 14px; position:sticky; top:0; height:100vh; overflow-y:auto; }
    .sidebar-logo { display:flex; align-items:center; gap:8px; padding:4px 10px 22px; font-size:16px; font-weight:700; color:var(--text); text-decoration:none; }
    .sidebar-logo .dot { width:8px; height:8px; background:var(--accent); border-radius:50%; }
    .sidebar-logo em { color:var(--accent); font-style:normal; }
    .sidebar-section { font-size:9px; font-weight:600; letter-spacing:.1em; color:var(--text3); font-family:'DM Mono',monospace; text-transform:uppercase; padding:0 10px; margin:14px 0 6px; }
    .nav-item { display:flex; align-items:center; gap:9px; padding:9px 10px; border-radius:var(--radius); font-size:13px; font-weight:500; color:var(--text2); cursor:pointer; border:none; background:none; width:100%; text-align:left; text-decoration:none; transition:all .15s; }
    .nav-item:hover { background:var(--bg3); color:var(--text); }
    .nav-item.active { background:var(--bg4); color:var(--text); border:1px solid var(--border2); }
    .nav-item svg { opacity:.6; flex-shrink:0; }
    .nav-item.active svg { opacity:1; }
    .sidebar-sep { height:1px; background:var(--border); margin:10px 0; }
    .sidebar-bottom { margin-top:auto; display:flex; flex-direction:column; gap:8px; }
    .theme-row { display:flex; align-items:center; justify-content:space-between; padding:8px 10px; border-radius:var(--radius); background:var(--bg3); border:1px solid var(--border); font-size:12px; color:var(--text2); }
    .theme-toggle { background:var(--bg4); border:1px solid var(--border2); border-radius:99px; padding:3px 8px; font-size:12px; cursor:pointer; color:var(--text); }
    .plan-card { background:var(--bg3); border:1px solid var(--border2); border-radius:var(--radius2); padding:14px; }
    .plan-card-top { display:flex; align-items:center; gap:8px; margin-bottom:10px; }
    .plan-avatar { width:30px; height:30px; border-radius:50%; background:var(--accent); color:#1a1400; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; flex-shrink:0; }
    .plan-username { font-size:13px; font-weight:600; color:var(--text); }
    .plan-label { font-size:10px; color:var(--accent); font-family:'DM Mono',monospace; font-weight:600; }
    .upgrade-btn { background:var(--accent); color:#1a1400; font-size:11px; font-weight:700; padding:8px 0; border-radius:8px; border:none; cursor:pointer; width:100%; font-family:'Space Grotesk',sans-serif; text-decoration:none; display:block; text-align:center; }
    .logout-link { display:block; text-align:center; font-size:11px; color:var(--text3); text-decoration:none; padding:6px; }
    .logout-link:hover { color:var(--red); }

    /* TOPBAR */
    .topbar { background:var(--bg2); border-bottom:1px solid var(--border); padding:14px 28px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:10; }
    .topbar h1 { font-size:17px; font-weight:700; }
    .topbar p { font-size:11px; color:var(--text3); margin-top:1px; }
    .btn-dl-all { background:var(--accent); color:#1a1400; border:none; padding:8px 16px; border-radius:var(--radius); font-size:12px; font-weight:700; cursor:pointer; font-family:'Space Grotesk',sans-serif; }

    /* MAIN */
    .main { padding:24px 28px; }

    /* GRID */
    .qr-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(220px, 1fr)); gap:14px; }
    .qr-card {
      background:var(--bg2); border:1px solid var(--border);
      border-radius:var(--radius2); padding:20px;
      display:flex; flex-direction:column; align-items:center; gap:12px;
      transition:border-color .15s;
    }
    .qr-card:hover { border-color:var(--border2); }
    .qr-canvas-wrap { background:#fff; border-radius:8px; padding:8px; display:flex; align-items:center; justify-content:center; }
    .qr-canvas-wrap canvas { display:block; }
    .qr-info { width:100%; text-align:center; }
    .qr-shortcode { font-family:'DM Mono',monospace; font-size:13px; color:var(--accent); font-weight:500; margin-bottom:3px; }
    .qr-original { font-size:11px; color:var(--text3); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:100%; }
    .qr-clicks { font-size:10px; color:var(--text3); font-family:'DM Mono',monospace; margin-top:2px; }
    .qr-actions { display:flex; gap:6px; width:100%; }
    .qr-btn { flex:1; background:var(--bg3); border:1px solid var(--border2); border-radius:8px; padding:7px 0; font-size:11px; font-weight:600; color:var(--text2); cursor:pointer; font-family:'Space Grotesk',sans-serif; transition:all .15s; text-align:center; }
    .qr-btn:hover { color:var(--text); }
    .qr-btn.dl:hover { color:var(--accent); border-color:rgba(245,200,66,.3); }
    .qr-btn.copy:hover { color:var(--green); border-color:rgba(74,222,128,.3); }
    .qr-btn.copied { color:var(--green); }

    /* EMPTY */
    .empty-state { text-align:center; padding:80px 24px; }
    .empty-state .empty-icon { font-size:40px; margin-bottom:14px; }
    .empty-state h3 { font-size:16px; font-weight:600; margin-bottom:6px; }
    .empty-state p { font-size:13px; color:var(--text2); margin-bottom:20px; }
    .empty-cta { background:var(--accent); color:#1a1400; border:none; padding:10px 22px; border-radius:var(--radius); font-size:13px; font-weight:600; cursor:pointer; font-family:'Space Grotesk',sans-serif; text-decoration:none; display:inline-block; }

    /* QR MODAL */
    .qr-modal-bg { display:none; position:fixed; inset:0; background:rgba(0,0,0,.7); backdrop-filter:blur(4px); z-index:100; align-items:center; justify-content:center; }
    .qr-modal-bg.open { display:flex; }
    .qr-modal { background:var(--bg2); border:1px solid var(--border2); border-radius:var(--radius2); padding:28px; text-align:center; position:relative; max-width:300px; width:100%; }
    .qr-modal-close { position:absolute; top:14px; right:14px; background:var(--bg3); border:1px solid var(--border2); border-radius:7px; padding:4px 8px; font-size:12px; color:var(--text2); cursor:pointer; }
    .qr-modal-title { font-size:15px; font-weight:700; margin-bottom:6px; }
    .qr-modal-url { font-size:11px; color:var(--text3); font-family:'DM Mono',monospace; margin-bottom:18px; word-break:break-all; }
    #modal-canvas-wrap { display:flex; justify-content:center; margin-bottom:18px; }
    #modal-canvas-wrap canvas { border-radius:8px; }
    .modal-actions { display:flex; gap:8px; justify-content:center; }
    .btn-download, .btn-modal-copy { background:var(--bg3); border:1px solid var(--border2); border-radius:var(--radius); padding:8px 16px; font-size:12px; font-weight:600; color:var(--text2); cursor:pointer; font-family:'Space Grotesk',sans-serif; }
    .btn-download:hover { color:var(--accent); }
    .btn-modal-copy:hover { color:var(--text); }

    @media (max-width:900px) {
      body { grid-template-columns:1fr; }
      .sidebar { display:none; }
      .qr-grid { grid-template-columns:repeat(auto-fill, minmax(160px, 1fr)); }
      .main { padding:16px 12px; }
      .topbar { padding:12px; }
    }

    @media (max-width:560px) {
      .topbar {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
      }

      .btn-dl-all {
        width: 100%;
      }

      .qr-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

<aside class="sidebar">
  <a class="sidebar-logo" href="/">
    <span class="dot"></span>Snap<em>Link</em>
  </a>
  <div class="sidebar-section">Main</div>
  <a class="nav-item" href="/dashboard">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
    Dashboard
  </a>
  <a class="nav-item" href="/dashboard">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
    My Links
  </a>
  <div class="sidebar-sep"></div>
  <div class="sidebar-section">Manage</div>
  <a class="nav-item active" href="/qr-codes">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="5" height="5"/><rect x="16" y="3" width="5" height="5"/><rect x="3" y="16" width="5" height="5"/><path d="M21 16h-3v3M21 21h-1M16 16h1"/></svg>
    QR Codes
  </a>
  <a class="nav-item" href="/settings">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
    Settings
  </a>
  <div class="sidebar-bottom">
    <div class="theme-row">
      <span>Theme</span>
      <button class="theme-toggle" id="themeBtn" onclick="toggleTheme()">🌙</button>
    </div>
    <div class="plan-card">
      <div class="plan-card-top">
        <div class="plan-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
        <div>
          <div class="plan-username"><%= user.name.split(' ')[0] %></div>
          <div class="plan-label"><%= user.plan === 'free' ? 'FREE PLAN' : user.plan === 'pro' ? '⭐ PRO' : '💎 BUSINESS' %></div>
        </div>
      </div>
      <% if (user.plan === 'free') { %>
        <a href="/pricing" class="upgrade-btn">⚡ Upgrade — ₹99/mo</a>
      <% } %>
    </div>
    <a href="/logout" class="logout-link">Logout</a>
  </div>
</aside>

<div style="display:flex;flex-direction:column;min-height:100vh">
  <header class="topbar">
    <div>
      <h1>QR Codes</h1>
      <p>Saare links ke QR codes ek jagah</p>
    </div>
    <% if (urls.length > 0) { %>
      <button class="btn-dl-all" onclick="downloadAll()">⬇ Download All</button>
    <% } %>
  </header>

  <div class="main">
    <% if (urls.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">📷</div>
        <h3>Koi link nahi abhi tak</h3>
        <p>Pehle kuch links banao, phir unke QR codes yahan dikhenge</p>
        <a href="/dashboard" class="empty-cta">Dashboard pe jao →</a>
      </div>
    <% } else { %>
      <div class="qr-grid" id="qrGrid">
        <% urls.forEach((url, i) => { %>
          <div class="qr-card">
            <div class="qr-canvas-wrap">
              <canvas id="qr-<%= i %>" width="160" height="160"></canvas>
            </div>
            <div class="qr-info">
              <div class="qr-shortcode">/<%= url.shortCode %></div>
              <div class="qr-original" title="<%= url.orginalUrl %>"><%= url.orginalUrl %></div>
              <div class="qr-clicks"><%= url.clicks || 0 %> clicks</div>
            </div>
            <div class="qr-actions">
              <button class="qr-btn dl" onclick="downloadQR('qr-<%= i %>', '<%= url.shortCode %>')">⬇ Save</button>
              <button class="qr-btn copy" id="copybtn-<%= i %>" onclick="copyUrl('<%= url.shortUrl %>', 'copybtn-<%= i %>')">Copy URL</button>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<!-- Full-size QR Modal -->
<div class="qr-modal-bg" id="qrModalBg" onclick="if(event.target===this)closeModal()">
  <div class="qr-modal">
    <button class="qr-modal-close" onclick="closeModal()">✕</button>
    <div class="qr-modal-title">QR Code</div>
    <div class="qr-modal-url" id="modalUrl"></div>
    <div id="modal-canvas-wrap"></div>
    <div class="modal-actions">
      <button class="btn-download" onclick="downloadModalQR()">⬇ Download</button>
      <button class="btn-modal-copy" onclick="copyModalUrl()">Copy URL</button>
    </div>
  </div>
</div>

<script>
// Theme
const saved = localStorage.getItem('theme') || 'dark';
document.documentElement.setAttribute('data-theme', saved);
document.getElementById('themeBtn').textContent = saved === 'dark' ? '🌙' : '☀️';
function toggleTheme() {
  const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
  const next = isDark ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('theme', next);
  document.getElementById('themeBtn').textContent = next === 'dark' ? '🌙' : '☀️';
}

// Generate all QR codes on page load
const urls = <%- JSON.stringify(urls.map(u => u.shortUrl)) %>;
window.addEventListener('DOMContentLoaded', () => {
  urls.forEach((url, i) => {
    QRCode.toCanvas(document.getElementById('qr-' + i), url, {
      width: 160, margin: 1, color: { dark: '#000000', light: '#ffffff' }
    }, err => { if (err) console.error(err); });
  });
});

// Download single QR
function downloadQR(canvasId, code) {
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;
  const a = document.createElement('a');
  a.download = 'snaplink-qr-' + code + '.png';
  a.href = canvas.toDataURL('image/png');
  a.click();
}

// Copy URL
function copyUrl(url, btnId) {
  navigator.clipboard.writeText(url).then(() => {
    const btn = document.getElementById(btnId);
    const orig = btn.textContent;
    btn.textContent = 'Copied!'; btn.classList.add('copied');
    setTimeout(() => { btn.textContent = orig; btn.classList.remove('copied'); }, 2000);
  });
}

// Download all QRs as individual files
async function downloadAll() {
  for (let i = 0; i < urls.length; i++) {
    await new Promise(res => setTimeout(res, 200));
    const canvas = document.getElementById('qr-' + i);
    if (!canvas) continue;
    const a = document.createElement('a');
    a.download = 'snaplink-qr-' + i + '.png';
    a.href = canvas.toDataURL('image/png');
    a.click();
  }
}

// Modal
let modalUrl = '';
function closeModal() { document.getElementById('qrModalBg').classList.remove('open'); }
function copyModalUrl() {
  navigator.clipboard.writeText(modalUrl).then(() => {
    const btn = document.querySelector('.btn-modal-copy');
    btn.textContent = 'Copied!';
    setTimeout(() => btn.textContent = 'Copy URL', 2000);
  });
}
function downloadModalQR() {
  const canvas = document.querySelector('#modal-canvas-wrap canvas');
  if (!canvas) return;
  const a = document.createElement('a');
  a.download = 'snaplink-qr.png'; a.href = canvas.toDataURL('image/png'); a.click();
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
</script>
</body>
</html>
