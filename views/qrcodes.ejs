<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%
    const seo = {
      title: 'QR Codes | SnapLink',
      description: 'Download and manage QR codes for every short link inside your SnapLink workspace.',
      path: '/qr-codes',
      robots: 'noindex, nofollow',
      stylesheets: ["/css/pages/site-shell.css","/css/pages/generated/qrcodes.inline.css","/css/pages/app-shell.css"]
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
  <script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>
</head>
<body class="app-shell-page">

<aside class="sidebar">
  <a class="sidebar-logo" href="/">
    <span class="dot"></span>Snap<em>Link</em>
  </a>
  <div class="sidebar-section">Main</div>
  <a class="nav-item" href="/dashboard">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
    Dashboard
  </a>
  <a class="nav-item" href="/dashboard">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
    My Links
  </a>
  <div class="sidebar-sep"></div>
  <div class="sidebar-section">Manage</div>
  <a class="nav-item active" href="/qr-codes">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="5" height="5"/><rect x="16" y="3" width="5" height="5"/><rect x="3" y="16" width="5" height="5"/><path d="M21 16h-3v3M21 21h-1M16 16h1"/></svg>
    QR Codes
  </a>
  <a class="nav-item" href="/settings">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
    Settings
  </a>
  <div class="sidebar-bottom">
    <div class="theme-row">
      <span>Theme</span>
      <button class="theme-toggle" id="themeBtn" onclick="toggleTheme()">Theme</button>
    </div>
    <div class="plan-card">
      <div class="plan-card-top">
        <div class="plan-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
        <div>
          <div class="plan-username"><%= user.name.split(' ')[0] %></div>
          <div class="plan-label"><%= user.plan === 'free' ? 'FREE PLAN' : user.plan === 'pro' ? 'PRO' : 'BUSINESS' %></div>
        </div>
      </div>
      <% if (user.plan === 'free') { %>
        <a href="/pricing" class="upgrade-btn">Upgrade - Rs 99/mo</a>
      <% } %>
    </div>
    <a href="/logout" class="logout-link">Logout</a>
  </div>
</aside>

<div style="display:flex;flex-direction:column;min-height:100vh">
  <header class="topbar">
    <div>
      <h1>QR Codes</h1>
      <p>Saare links ke QR codes ek jagah</p>
    </div>
    <% if (urls.length > 0) { %>
      <button class="btn-dl-all" onclick="downloadAll()">Download All</button>
    <% } %>
  </header>

  <div class="main">
    <% if (urls.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">📷</div>
        <h3>Koi link nahi abhi tak</h3>
        <p>Pehle kuch links banao, phir unke QR codes yahan dikhenge</p>
        <a href="/dashboard" class="empty-cta">Dashboard pe jao →</a>
      </div>
    <% } else { %>
      <div class="qr-grid" id="qrGrid">
        <% urls.forEach((url, i) => { %>
          <div class="qr-card">
            <div class="qr-canvas-wrap">
              <canvas id="qr-<%= i %>" width="160" height="160"></canvas>
            </div>
            <div class="qr-info">
              <div class="qr-shortcode">/<%= url.shortCode %></div>
              <div class="qr-original" title="<%= url.orginalUrl %>"><%= url.orginalUrl %></div>
              <div class="qr-clicks"><%= url.clicks || 0 %> clicks</div>
            </div>
            <div class="qr-actions">
              <button class="qr-btn dl" onclick="downloadQR('qr-<%= i %>', '<%= url.shortCode %>')">⬇ Save</button>
              <button class="qr-btn copy" id="copybtn-<%= i %>" onclick="copyUrl('<%= url.shortUrl %>', 'copybtn-<%= i %>')">Copy URL</button>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<!-- Full-size QR Modal -->
<div class="qr-modal-bg" id="qrModalBg" onclick="if(event.target===this)closeModal()">
  <div class="qr-modal">
    <button class="qr-modal-close" onclick="closeModal()">Close</button>
    <div class="qr-modal-title">QR Code</div>
    <div class="qr-modal-url" id="modalUrl"></div>
    <div id="modal-canvas-wrap"></div>
    <div class="modal-actions">
      <button class="btn-download" onclick="downloadModalQR()">⬇ Download</button>
      <button class="btn-modal-copy" onclick="copyModalUrl()">Copy URL</button>
    </div>
  </div>
</div>

<script src="/js/shared/theme.js"></script>
  <script>
// Theme

// Generate all QR codes on page load
const urls = <%- JSON.stringify(urls.map(u => u.shortUrl)) %>;
window.addEventListener('DOMContentLoaded', () => {
  urls.forEach((url, i) => {
    QRCode.toCanvas(document.getElementById('qr-' + i), url, {
      width: 160, margin: 1, color: { dark: '#000000', light: '#ffffff' }
    }, err => { if (err) console.error(err); });
  });
});

// Download single QR
function downloadQR(canvasId, code) {
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;
  const a = document.createElement('a');
  a.download = 'snaplink-qr-' + code + '.png';
  a.href = canvas.toDataURL('image/png');
  a.click();
}

// Copy URL
function copyUrl(url, btnId) {
  navigator.clipboard.writeText(url).then(() => {
    const btn = document.getElementById(btnId);
    const orig = btn.textContent;
    btn.textContent = 'Copied!'; btn.classList.add('copied');
    setTimeout(() => { btn.textContent = orig; btn.classList.remove('copied'); }, 2000);
  });
}

// Download all QRs as individual files
async function downloadAll() {
  for (let i = 0; i < urls.length; i++) {
    await new Promise(res => setTimeout(res, 200));
    const canvas = document.getElementById('qr-' + i);
    if (!canvas) continue;
    const a = document.createElement('a');
    a.download = 'snaplink-qr-' + i + '.png';
    a.href = canvas.toDataURL('image/png');
    a.click();
  }
}

// Modal
let modalUrl = '';
function closeModal() { document.getElementById('qrModalBg').classList.remove('open'); }
function copyModalUrl() {
  navigator.clipboard.writeText(modalUrl).then(() => {
    const btn = document.querySelector('.btn-modal-copy');
    btn.textContent = 'Copied!';
    setTimeout(() => btn.textContent = 'Copy URL', 2000);
  });
}
function downloadModalQR() {
  const canvas = document.querySelector('#modal-canvas-wrap canvas');
  if (!canvas) return;
  const a = document.createElement('a');
  a.download = 'snaplink-qr.png'; a.href = canvas.toDataURL('image/png'); a.click();
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
</script>
</body>
</html>



