<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= link.title %> — Analytics</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <link rel="stylesheet" href="/css/pages/generated/affiliate-analytics.inline.css" />
</head>
<body>

<nav>
  <div class="nav-left">
    <a class="nav-logo" href="/"><div class="nav-logo-dot"></div>SnapLink</a>
    <span class="nav-sep">/</span>
    <span class="nav-page">Analytics</span>
  </div>
  <div class="nav-right">
    <button class="btn-sm" onclick="toggleTheme()" id="theme-btn">☀ Light</button>
    <a class="btn-sm" href="/affiliate/dashboard">← Dashboard</a>
  </div>
</nav>

<main>

  <!-- Page Header -->
  <div class="page-header">
    <div>
      <h1><%= link.title %></h1>
      <div class="campaign-meta">
        <span class="meta-pill <%= link.isActive ? 'green' : '' %>">
          <%= link.isActive ? '● Active' : '○ Inactive' %>
        </span>
        <span class="meta-pill blue">/<%= link.shortCode %></span>
        <span class="meta-pill">Created <%= new Date(link.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'}) %></span>
      </div>
    </div>
    <div style="display:flex; gap:8px;">
      <button class="btn-sm primary" onclick="copyUrl('<%= link.shortUrl %>', this)">Copy Link</button>
    </div>
  </div>

  <!-- Stats Row -->
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-icon blue">📊</div>
      <div class="stat-label">Total Clicks</div>
      <div class="stat-value"><%= link.totalClicks %></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon green">📅</div>
      <div class="stat-label">Last 7 Days</div>
      <div class="stat-value"><%= analytics.totalLogs %></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon amber">🌍</div>
      <div class="stat-label">Countries</div>
      <div class="stat-value"><%= Object.keys(analytics.countries).length %></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon purple">📱</div>
      <div class="stat-label">Top Device</div>
      <div class="stat-value" style="font-size:1.1rem; padding-top:4px;">
        <%= analytics.topDevice || 'N/A' %>
      </div>
    </div>
  </div>

  <!-- Daily Clicks Chart -->
  <div class="charts-grid">
    <div class="chart-card">
      <div class="chart-header">
        <div>
          <div class="chart-title">Daily Clicks</div>
          <div class="chart-sub">Last 7 days</div>
        </div>
      </div>
      <canvas id="dailyChart"></canvas>
    </div>

    <!-- Country Breakdown -->
    <div class="chart-card">
      <div class="chart-header">
        <div>
          <div class="chart-title">Countries</div>
          <div class="chart-sub">Traffic source</div>
        </div>
      </div>
      <div class="breakdown-list" id="countryList"></div>
    </div>
  </div>

  <!-- Device + Browser -->
  <div class="charts-row2">
    <div class="chart-card">
      <div class="chart-header">
        <div>
          <div class="chart-title">Devices</div>
          <div class="chart-sub">Mobile vs Desktop</div>
        </div>
      </div>
      <canvas id="deviceChart"></canvas>
    </div>
    <div class="chart-card">
      <div class="chart-header">
        <div>
          <div class="chart-title">Browsers</div>
          <div class="chart-sub">Which browser</div>
        </div>
      </div>
      <div class="breakdown-list" id="browserList"></div>
    </div>
  </div>

  <!-- Link Info -->
  <div class="link-info-card">
    <div class="chart-title">Link Details</div>
    <div class="link-info-grid">
      <div class="info-item">
        <span class="info-label">Short URL</span>
        <div class="copy-wrap">
          <span class="info-value"><%= link.shortUrl %></span>
          <button class="btn-copy-inline" onclick="copyUrl('<%= link.shortUrl %>', this)">Copy</button>
        </div>
      </div>
      <div class="info-item">
        <span class="info-label">Original URL</span>
        <span class="info-value"><%= link.originalUrl %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Ref Param</span>
        <span class="info-value"><%= link.refParam || '—' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Status</span>
        <span class="info-value normal"><%= link.isActive ? '✅ Active' : '❌ Inactive' %></span>
      </div>
    </div>
  </div>

</main>

<script>
  // ── DATA FROM SERVER ──
  const dailyClicks = <%- JSON.stringify(analytics.dailyClicks) %>;
  const countries   = <%- JSON.stringify(analytics.countries) %>;
  const devices     = <%- JSON.stringify(analytics.devices) %>;
  const browsers    = <%- JSON.stringify(analytics.browsers) %>;

  const isDark = () => document.documentElement.getAttribute('data-theme') === 'dark';

  // ── CHART DEFAULTS ──
  Chart.defaults.font.family = "'JetBrains Mono', monospace";
  Chart.defaults.font.size = 11;

  function chartColors() {
    return {
      grid: isDark() ? 'rgba(99,179,237,0.06)' : 'rgba(59,130,246,0.08)',
      text: isDark() ? '#475569' : '#94a3b8',
    };
  }

  // ── DAILY CLICKS CHART ──
  const dailyCtx = document.getElementById('dailyChart').getContext('2d');

  const gradient = dailyCtx.createLinearGradient(0, 0, 0, 200);
  gradient.addColorStop(0, 'rgba(59,130,246,0.3)');
  gradient.addColorStop(1, 'rgba(59,130,246,0.0)');

  const dailyChart = new Chart(dailyCtx, {
    type: 'line',
    data: {
      labels: Object.keys(dailyClicks).map(d => {
        const dt = new Date(d);
        return dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
      }),
      datasets: [{
        label: 'Clicks',
        data: Object.values(dailyClicks),
        borderColor: '#3b82f6',
        backgroundColor: gradient,
        borderWidth: 2,
        pointBackgroundColor: '#3b82f6',
        pointBorderColor: '#080c14',
        pointBorderWidth: 2,
        pointRadius: 4,
        pointHoverRadius: 6,
        fill: true,
        tension: 0.4
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#0e1420',
          borderColor: 'rgba(99,179,237,0.15)',
          borderWidth: 1,
          titleColor: '#94a3b8',
          bodyColor: '#e2e8f0',
          padding: 10,
        }
      },
      scales: {
        x: {
          grid: { color: chartColors().grid },
          ticks: { color: chartColors().text }
        },
        y: {
          grid: { color: chartColors().grid },
          ticks: { color: chartColors().text, stepSize: 1 },
          beginAtZero: true
        }
      }
    }
  });

  // ── DEVICE DOUGHNUT CHART ──
  const deviceCtx = document.getElementById('deviceChart').getContext('2d');
  new Chart(deviceCtx, {
    type: 'doughnut',
    data: {
      labels: Object.keys(devices),
      datasets: [{
        data: Object.values(devices),
        backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6'],
        borderColor: isDark() ? '#0e1420' : '#ffffff',
        borderWidth: 3,
        hoverOffset: 6
      }]
    },
    options: {
      responsive: true,
      cutout: '68%',
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            color: isDark() ? '#94a3b8' : '#475569',
            padding: 16,
            usePointStyle: true,
            pointStyleWidth: 8,
            font: { size: 11 }
          }
        },
        tooltip: {
          backgroundColor: '#0e1420',
          borderColor: 'rgba(99,179,237,0.15)',
          borderWidth: 1,
          titleColor: '#94a3b8',
          bodyColor: '#e2e8f0',
        }
      }
    }
  });

  // ── COUNTRY BREAKDOWN BARS ──
  function renderBreakdown(containerId, data, color) {
    const container = document.getElementById(containerId);
    const total = Object.values(data).reduce((a, b) => a + b, 0);
    const sorted = Object.entries(data).sort((a, b) => b[1] - a[1]).slice(0, 6);

    if (sorted.length === 0) {
      container.innerHTML = '<p style="color:var(--text3);font-size:0.8rem;text-align:center;padding:2rem 0">No data yet</p>';
      return;
    }

    container.innerHTML = sorted.map(([name, count]) => {
      const pct = total > 0 ? Math.round((count / total) * 100) : 0;
      return `
        <div class="breakdown-item">
          <div class="breakdown-label">
            <span>${name}</span>
            <span>${count} (${pct}%)</span>
          </div>
          <div class="breakdown-bar-bg">
            <div class="breakdown-bar-fill" style="width:0%; background:${color}"
                 data-width="${pct}%"></div>
          </div>
        </div>
      `;
    }).join('');

    // Animate bars
    setTimeout(() => {
      container.querySelectorAll('.breakdown-bar-fill').forEach(bar => {
        bar.style.width = bar.dataset.width;
      });
    }, 100);
  }

  renderBreakdown('countryList', countries, '#3b82f6');
  renderBreakdown('browserList', browsers, '#8b5cf6');

  // ── THEME TOGGLE ──
  function toggleTheme() {
    const isDarkNow = document.documentElement.getAttribute('data-theme') === 'dark';
    document.documentElement.setAttribute('data-theme', isDarkNow ? 'light' : 'dark');
    document.getElementById('theme-btn').textContent = isDarkNow ? '☾ Dark' : '☀ Light';
    localStorage.setItem('snaplink-theme', isDarkNow ? 'light' : 'dark');
  }

  const saved = localStorage.getItem('snaplink-theme') || 'dark';
  document.documentElement.setAttribute('data-theme', saved);
  document.getElementById('theme-btn').textContent = saved === 'dark' ? '☀ Light' : '☾ Dark';

  // ── COPY URL ──
  function copyUrl(url, btn) {
    navigator.clipboard.writeText(url).then(() => {
      const orig = btn.textContent;
      btn.textContent = 'Copied!';
      btn.classList.add('ok');
      setTimeout(() => { btn.textContent = orig; btn.classList.remove('ok'); }, 2000);
    });
  }
</script>

</body>
</html>


