<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= link.title %> — Analytics</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <style>
    :root {
      --bg:          #080c14;
      --bg2:         #0e1420;
      --bg3:         #151d2e;
      --bg4:         #1c2640;
      --border:      rgba(99,179,237,0.08);
      --border2:     rgba(99,179,237,0.15);
      --accent:      #3b82f6;
      --accent2:     #60a5fa;
      --accent-glow: rgba(59,130,246,0.15);
      --green:       #10b981;
      --green-bg:    rgba(16,185,129,0.1);
      --amber:       #f59e0b;
      --amber-bg:    rgba(245,158,11,0.1);
      --red:         #ef4444;
      --red-bg:      rgba(239,68,68,0.1);
      --purple:      #8b5cf6;
      --purple-bg:   rgba(139,92,246,0.1);
      --text:        #e2e8f0;
      --text2:       #94a3b8;
      --text3:       #475569;
      --mono:        'JetBrains Mono', monospace;
      --sans:        'Space Grotesk', sans-serif;
      --radius:      16px;
      --radius-sm:   10px;
    }
    [data-theme="light"] {
      --bg:          #f0f4ff;
      --bg2:         #ffffff;
      --bg3:         #e8eeff;
      --bg4:         #dde5ff;
      --border:      rgba(59,130,246,0.1);
      --border2:     rgba(59,130,246,0.2);
      --accent:      #2563eb;
      --accent2:     #3b82f6;
      --accent-glow: rgba(37,99,235,0.1);
      --text:        #0f172a;
      --text2:       #475569;
      --text3:       #94a3b8;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--sans);
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* Animated grid bg */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(var(--border) 1px, transparent 1px),
        linear-gradient(90deg, var(--border) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0;
    }

    /* Top glow */
    body::after {
      content: '';
      position: fixed;
      top: -300px;
      right: -100px;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, var(--accent-glow) 0%, transparent 65%);
      pointer-events: none;
      z-index: 0;
    }

    /* NAV */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
      height: 58px;
      background: rgba(8,12,20,0.85);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
    }
    [data-theme="light"] nav { background: rgba(240,244,255,0.9); }

    .nav-left { display: flex; align-items: center; gap: 16px; }
    .nav-logo {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .nav-logo-dot {
      width: 20px; height: 20px;
      background: var(--accent);
      border-radius: 6px;
      box-shadow: 0 0 12px var(--accent-glow);
    }
    .nav-sep { color: var(--text3); font-size: 0.8rem; }
    .nav-page { font-size: 0.88rem; color: var(--text2); font-weight: 500; }

    .nav-right { display: flex; gap: 10px; align-items: center; }
    .btn-sm {
      padding: 6px 14px;
      border-radius: var(--radius-sm);
      font-family: var(--sans);
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      border: 1px solid var(--border2);
      background: var(--bg3);
      color: var(--text2);
      text-decoration: none;
    }
    .btn-sm:hover { color: var(--text); border-color: var(--accent); }
    .btn-sm.primary {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .btn-sm.primary:hover { background: var(--accent2); }

    /* MAIN */
    main {
      position: relative;
      z-index: 1;
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1.5rem 5rem;
    }

    /* PAGE HEADER */
    .page-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 2rem;
      animation: fadeUp 0.4s ease both;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .page-header h1 {
      font-size: clamp(1.5rem, 3vw, 2.2rem);
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.1;
    }
    .page-header h1 span { color: var(--accent2); }
    .campaign-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 8px;
      flex-wrap: wrap;
    }
    .meta-pill {
      font-family: var(--mono);
      font-size: 0.72rem;
      padding: 3px 10px;
      border-radius: 20px;
      border: 1px solid var(--border2);
      color: var(--text2);
      background: var(--bg3);
    }
    .meta-pill.green { color: var(--green); background: var(--green-bg); border-color: var(--green); }
    .meta-pill.blue  { color: var(--accent2); background: var(--accent-glow); border-color: var(--accent); }

    /* STATS ROW */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .stat-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.4rem;
      position: relative;
      overflow: hidden;
      animation: fadeUp 0.4s ease both;
      transition: border-color 0.2s, transform 0.2s;
    }
    .stat-card:hover { border-color: var(--border2); transform: translateY(-2px); }
    .stat-card::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 2px;
      background: var(--accent);
      opacity: 0;
      transition: opacity 0.2s;
    }
    .stat-card:hover::after { opacity: 1; }
    .stat-card:nth-child(1) { animation-delay: 0.05s; }
    .stat-card:nth-child(2) { animation-delay: 0.1s; }
    .stat-card:nth-child(3) { animation-delay: 0.15s; }
    .stat-card:nth-child(4) { animation-delay: 0.2s; }

    .stat-icon {
      width: 32px; height: 32px;
      border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: 15px;
      margin-bottom: 12px;
    }
    .stat-icon.blue   { background: var(--accent-glow); }
    .stat-icon.green  { background: var(--green-bg); }
    .stat-icon.amber  { background: var(--amber-bg); }
    .stat-icon.purple { background: var(--purple-bg); }

    .stat-label {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text3);
      margin-bottom: 6px;
    }
    .stat-value {
      font-size: 1.9rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--text);
      line-height: 1;
      font-family: var(--mono);
    }

    /* CHARTS GRID */
    .charts-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    @media (max-width: 768px) { .charts-grid { grid-template-columns: 1fr; } }

    .charts-row2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    @media (max-width: 600px) { .charts-row2 { grid-template-columns: 1fr; } }

    .chart-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.4rem;
      animation: fadeUp 0.4s ease both;
    }
    .chart-card:nth-child(1) { animation-delay: 0.25s; }
    .chart-card:nth-child(2) { animation-delay: 0.3s; }

    .chart-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.2rem;
    }
    .chart-title {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text);
    }
    .chart-sub {
      font-size: 0.72rem;
      color: var(--text3);
      font-family: var(--mono);
      margin-top: 2px;
    }

    canvas { max-height: 220px; }

    /* BREAKDOWN BARS */
    .breakdown-list { display: flex; flex-direction: column; gap: 10px; }
    .breakdown-item { display: flex; flex-direction: column; gap: 4px; }
    .breakdown-label {
      display: flex;
      justify-content: space-between;
      font-size: 0.78rem;
      color: var(--text2);
    }
    .breakdown-label span:last-child {
      font-family: var(--mono);
      color: var(--text3);
    }
    .breakdown-bar-bg {
      height: 6px;
      background: var(--bg4);
      border-radius: 3px;
      overflow: hidden;
    }
    .breakdown-bar-fill {
      height: 100%;
      border-radius: 3px;
      background: var(--accent);
      transition: width 1s ease;
    }

    /* LINK INFO */
    .link-info-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.4rem;
      margin-bottom: 1rem;
      animation: fadeUp 0.4s 0.35s ease both;
    }
    .link-info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
      margin-top: 1rem;
    }
    .info-item { display: flex; flex-direction: column; gap: 4px; }
    .info-label {
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text3);
    }
    .info-value {
      font-family: var(--mono);
      font-size: 0.82rem;
      color: var(--accent2);
      word-break: break-all;
    }
    .info-value.normal { color: var(--text2); font-family: var(--sans); }

    /* COPY BTN */
    .copy-wrap { display: flex; align-items: center; gap: 8px; }
    .btn-copy-inline {
      font-size: 0.68rem;
      padding: 2px 8px;
      border-radius: 4px;
      border: 1px solid var(--border2);
      background: var(--bg3);
      color: var(--text3);
      cursor: pointer;
      font-family: var(--sans);
      transition: all 0.15s;
    }
    .btn-copy-inline:hover { color: var(--accent2); border-color: var(--accent); }
    .btn-copy-inline.ok { color: var(--green); border-color: var(--green); }

    /* ANIMATIONS */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* PERIOD TABS */
    .period-tabs { display: flex; gap: 4px; }
    .period-btn {
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.72rem;
      font-weight: 600;
      font-family: var(--sans);
      cursor: pointer;
      border: 1px solid transparent;
      background: transparent;
      color: var(--text3);
      transition: all 0.15s;
    }
    .period-btn.active {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .period-btn:hover:not(.active) { color: var(--text2); border-color: var(--border2); }
  </style>
</head>
<body>

<nav>
  <div class="nav-left">
    <a class="nav-logo" href="/"><div class="nav-logo-dot"></div>SnapLink</a>
    <span class="nav-sep">/</span>
    <span class="nav-page">Analytics</span>
  </div>
  <div class="nav-right">
    <button class="btn-sm" onclick="toggleTheme()" id="theme-btn">☀ Light</button>
    <a class="btn-sm" href="/a/dashboard">← Dashboard</a>
  </div>
</nav>

<main>

  <!-- Page Header -->
  <div class="page-header">
    <div>
      <h1><%= link.title %></h1>
      <div class="campaign-meta">
        <span class="meta-pill green">● Active</span>
        <span class="meta-pill blue">/<%= link.shortCode %></span>
        <span class="meta-pill">Created <%= new Date(link.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'}) %></span>
      </div>
    </div>
    <div style="display:flex; gap:8px;">
      <button class="btn-sm primary" onclick="copyUrl('<%= link.shortUrl %>', this)">Copy Link</button>
    </div>
  </div>

  <!-- Stats Row -->
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-icon blue">📊</div>
      <div class="stat-label">Total Clicks</div>
      <div class="stat-value"><%= link.totalClicks %></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon green">📅</div>
      <div class="stat-label">Last 7 Days</div>
      <div class="stat-value"><%= analytics.totalLogs %></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon amber">🌍</div>
      <div class="stat-label">Countries</div>
      <div class="stat-value"><%= Object.keys(analytics.countries).length %></div>
    </div>
    <div class="stat-card">
      <div class="stat-icon purple">📱</div>
      <div class="stat-label">Top Device</div>
      <div class="stat-value" style="font-size:1.1rem; padding-top:4px;">
        <%= Object.entries(analytics.devices).sort((a,b)=>b[1]-a[1])[0]?.[0] || 'N/A' %>
      </div>
    </div>
  </div>

  <!-- Daily Clicks Chart -->
  <div class="charts-grid">
    <div class="chart-card">
      <div class="chart-header">
        <div>
          <div class="chart-title">Daily Clicks</div>
          <div class="chart-sub">Last 7 days</div>
        </div>
      </div>
      <canvas id="dailyChart"></canvas>
    </div>

    <!-- Country Breakdown -->
    <div class="chart-card">
      <div class="chart-header">
        <div>
          <div class="chart-title">Countries</div>
          <div class="chart-sub">Traffic source</div>
        </div>
      </div>
      <div class="breakdown-list" id="countryList"></div>
    </div>
  </div>

  <!-- Device + Browser -->
  <div class="charts-row2">
    <div class="chart-card">
      <div class="chart-header">
        <div>
          <div class="chart-title">Devices</div>
          <div class="chart-sub">Mobile vs Desktop</div>
        </div>
      </div>
      <canvas id="deviceChart"></canvas>
    </div>
    <div class="chart-card">
      <div class="chart-header">
        <div>
          <div class="chart-title">Browsers</div>
          <div class="chart-sub">Which browser</div>
        </div>
      </div>
      <div class="breakdown-list" id="browserList"></div>
    </div>
  </div>

  <!-- Link Info -->
  <div class="link-info-card">
    <div class="chart-title">Link Details</div>
    <div class="link-info-grid">
      <div class="info-item">
        <span class="info-label">Short URL</span>
        <div class="copy-wrap">
          <span class="info-value"><%= link.shortUrl %></span>
          <button class="btn-copy-inline" onclick="copyUrl('<%= link.shortUrl %>', this)">Copy</button>
        </div>
      </div>
      <div class="info-item">
        <span class="info-label">Original URL</span>
        <span class="info-value"><%= link.originalUrl %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Ref Param</span>
        <span class="info-value"><%= link.refParam || '—' %></span>
      </div>
      <div class="info-item">
        <span class="info-label">Status</span>
        <span class="info-value normal"><%= link.isActive ? '✅ Active' : '❌ Inactive' %></span>
      </div>
    </div>
  </div>

</main>

<script>
  // ── DATA FROM SERVER ──
  const dailyClicks = <%- JSON.stringify(analytics.dailyClicks) %>;
  const countries   = <%- JSON.stringify(analytics.countries) %>;
  const devices     = <%- JSON.stringify(analytics.devices) %>;
  const browsers    = <%- JSON.stringify(analytics.browsers) %>;

  const isDark = () => document.documentElement.getAttribute('data-theme') === 'dark';

  // ── CHART DEFAULTS ──
  Chart.defaults.font.family = "'JetBrains Mono', monospace";
  Chart.defaults.font.size = 11;

  function chartColors() {
    return {
      grid: isDark() ? 'rgba(99,179,237,0.06)' : 'rgba(59,130,246,0.08)',
      text: isDark() ? '#475569' : '#94a3b8',
    };
  }

  // ── DAILY CLICKS CHART ──
  const dailyCtx = document.getElementById('dailyChart').getContext('2d');

  const gradient = dailyCtx.createLinearGradient(0, 0, 0, 200);
  gradient.addColorStop(0, 'rgba(59,130,246,0.3)');
  gradient.addColorStop(1, 'rgba(59,130,246,0.0)');

  const dailyChart = new Chart(dailyCtx, {
    type: 'line',
    data: {
      labels: Object.keys(dailyClicks).map(d => {
        const dt = new Date(d);
        return dt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
      }),
      datasets: [{
        label: 'Clicks',
        data: Object.values(dailyClicks),
        borderColor: '#3b82f6',
        backgroundColor: gradient,
        borderWidth: 2,
        pointBackgroundColor: '#3b82f6',
        pointBorderColor: '#080c14',
        pointBorderWidth: 2,
        pointRadius: 4,
        pointHoverRadius: 6,
        fill: true,
        tension: 0.4
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#0e1420',
          borderColor: 'rgba(99,179,237,0.15)',
          borderWidth: 1,
          titleColor: '#94a3b8',
          bodyColor: '#e2e8f0',
          padding: 10,
        }
      },
      scales: {
        x: {
          grid: { color: chartColors().grid },
          ticks: { color: chartColors().text }
        },
        y: {
          grid: { color: chartColors().grid },
          ticks: { color: chartColors().text, stepSize: 1 },
          beginAtZero: true
        }
      }
    }
  });

  // ── DEVICE DOUGHNUT CHART ──
  const deviceCtx = document.getElementById('deviceChart').getContext('2d');
  new Chart(deviceCtx, {
    type: 'doughnut',
    data: {
      labels: Object.keys(devices),
      datasets: [{
        data: Object.values(devices),
        backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6'],
        borderColor: isDark() ? '#0e1420' : '#ffffff',
        borderWidth: 3,
        hoverOffset: 6
      }]
    },
    options: {
      responsive: true,
      cutout: '68%',
      plugins: {
        legend: {
          position: 'bottom',
          labels: {
            color: isDark() ? '#94a3b8' : '#475569',
            padding: 16,
            usePointStyle: true,
            pointStyleWidth: 8,
            font: { size: 11 }
          }
        },
        tooltip: {
          backgroundColor: '#0e1420',
          borderColor: 'rgba(99,179,237,0.15)',
          borderWidth: 1,
          titleColor: '#94a3b8',
          bodyColor: '#e2e8f0',
        }
      }
    }
  });

  // ── COUNTRY BREAKDOWN BARS ──
  function renderBreakdown(containerId, data, color) {
    const container = document.getElementById(containerId);
    const total = Object.values(data).reduce((a, b) => a + b, 0);
    const sorted = Object.entries(data).sort((a, b) => b[1] - a[1]).slice(0, 6);

    if (sorted.length === 0) {
      container.innerHTML = '<p style="color:var(--text3);font-size:0.8rem;text-align:center;padding:2rem 0">No data yet</p>';
      return;
    }

    container.innerHTML = sorted.map(([name, count]) => {
      const pct = total > 0 ? Math.round((count / total) * 100) : 0;
      return `
        <div class="breakdown-item">
          <div class="breakdown-label">
            <span>${name}</span>
            <span>${count} (${pct}%)</span>
          </div>
          <div class="breakdown-bar-bg">
            <div class="breakdown-bar-fill" style="width:0%; background:${color}"
                 data-width="${pct}%"></div>
          </div>
        </div>
      `;
    }).join('');

    // Animate bars
    setTimeout(() => {
      container.querySelectorAll('.breakdown-bar-fill').forEach(bar => {
        bar.style.width = bar.dataset.width;
      });
    }, 100);
  }

  renderBreakdown('countryList', countries, '#3b82f6');
  renderBreakdown('browserList', browsers, '#8b5cf6');

  // ── THEME TOGGLE ──
  function toggleTheme() {
    const isDarkNow = document.documentElement.getAttribute('data-theme') === 'dark';
    document.documentElement.setAttribute('data-theme', isDarkNow ? 'light' : 'dark');
    document.getElementById('theme-btn').textContent = isDarkNow ? '☾ Dark' : '☀ Light';
    localStorage.setItem('snaplink-theme', isDarkNow ? 'light' : 'dark');
  }

  const saved = localStorage.getItem('snaplink-theme') || 'dark';
  document.documentElement.setAttribute('data-theme', saved);
  document.getElementById('theme-btn').textContent = saved === 'dark' ? '☀ Light' : '☾ Dark';

  // ── COPY URL ──
  function copyUrl(url, btn) {
    navigator.clipboard.writeText(url).then(() => {
      const orig = btn.textContent;
      btn.textContent = 'Copied!';
      btn.classList.add('ok');
      setTimeout(() => { btn.textContent = orig; btn.classList.remove('ok'); }, 2000);
    });
  }
</script>

</body>
</html>
