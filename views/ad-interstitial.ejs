<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ad — SnapLink</title>

    <!-- ✅ Monetag Popunder -->
    <script>(function (s) { s.dataset.zone = '10796169', s.src = 'https://al5sm.com/tag.min.js' })([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
        href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap"
        rel="stylesheet" />
    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #060812;
            color: #e2e8f0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            overflow: hidden;
            position: relative;
        }

        .bg-grid {
            position: fixed;
            inset: 0;
            z-index: 0;
            background-image:
                linear-gradient(rgba(99, 102, 241, 0.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(99, 102, 241, 0.04) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .bg-glow-1 {
            position: fixed;
            top: -30%;
            left: -20%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.12) 0%, transparent 60%);
            pointer-events: none;
            z-index: 0;
            animation: floatGlow1 8s ease-in-out infinite;
        }

        .bg-glow-2 {
            position: fixed;
            bottom: -30%;
            right: -20%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(236, 72, 153, 0.08) 0%, transparent 60%);
            pointer-events: none;
            z-index: 0;
            animation: floatGlow2 10s ease-in-out infinite;
        }

        @keyframes floatGlow1 {

            0%,
            100% {
                transform: translate(0, 0);
            }

            50% {
                transform: translate(30px, 20px);
            }
        }

        @keyframes floatGlow2 {

            0%,
            100% {
                transform: translate(0, 0);
            }

            50% {
                transform: translate(-20px, -30px);
            }
        }

        .ad-card {
            position: relative;
            z-index: 1;
            background: rgba(13, 15, 30, 0.9);
            border: 1px solid rgba(99, 102, 241, 0.2);
            border-radius: 24px;
            padding: 2.4rem;
            max-width: 480px;
            width: 100%;
            backdrop-filter: blur(20px);
            box-shadow: 0 0 0 1px rgba(99, 102, 241, 0.08), 0 40px 80px rgba(0, 0, 0, 0.5);
            animation: cardIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        @keyframes cardIn {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.97);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .card-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.6rem;
        }

        .ad-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-family: 'DM Mono', monospace;
            font-size: 0.65rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #f59e0b;
            background: rgba(245, 158, 11, 0.08);
            border: 1px solid rgba(245, 158, 11, 0.2);
            padding: 4px 10px;
            border-radius: 20px;
        }

        .ad-badge::before {
            content: '';
            width: 5px;
            height: 5px;
            background: #f59e0b;
            border-radius: 50%;
            animation: pulse 1.5s ease-in-out infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: 0.5;
                transform: scale(0.8);
            }
        }

        .snaplink-brand {
            font-family: 'Syne', sans-serif;
            font-size: 0.78rem;
            font-weight: 700;
            color: rgba(255, 255, 255, 0.2);
            text-decoration: none;
            transition: color 0.2s;
        }

        .snaplink-brand:hover {
            color: rgba(255, 255, 255, 0.5);
        }

        .ad-banner-wrap {
            width: 100%;
            border-radius: 14px;
            overflow: hidden;
            margin-bottom: 1.4rem;
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        .ad-banner {
            width: 100%;
            display: block;
            max-height: 180px;
            object-fit: cover;
        }

        .ad-content {
            margin-bottom: 1.8rem;
        }

        .ad-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.4rem;
            font-weight: 800;
            color: #f8fafc;
            letter-spacing: -0.03em;
            line-height: 1.2;
            margin-bottom: 8px;
        }

        .ad-desc {
            font-size: 0.88rem;
            color: #64748b;
            line-height: 1.65;
        }

        .timer-section {
            display: flex;
            align-items: center;
            gap: 1.4rem;
            background: rgba(99, 102, 241, 0.06);
            border: 1px solid rgba(99, 102, 241, 0.12);
            border-radius: 14px;
            padding: 1rem 1.2rem;
            margin-bottom: 1.2rem;
        }

        .timer-ring {
            position: relative;
            width: 64px;
            height: 64px;
            flex-shrink: 0;
        }

        .timer-svg {
            width: 64px;
            height: 64px;
            transform: rotate(-90deg);
        }

        .ring-bg {
            fill: none;
            stroke: rgba(99, 102, 241, 0.12);
            stroke-width: 3.5;
        }

        .ring-fill {
            fill: none;
            stroke: url(#ring-gradient);
            stroke-width: 3.5;
            stroke-linecap: round;
            stroke-dasharray: 175.9;
            stroke-dashoffset: 0;
            transition: stroke-dashoffset 1s linear;
        }

        .timer-text {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .timer-num {
            font-family: 'DM Mono', monospace;
            font-size: 1.3rem;
            font-weight: 500;
            color: #818cf8;
            line-height: 1;
        }

        .timer-s {
            font-size: 0.55rem;
            color: #475569;
            margin-top: 1px;
        }

        .timer-info {
            flex: 1;
        }

        .timer-info-title {
            font-size: 0.82rem;
            font-weight: 600;
            color: #e2e8f0;
            margin-bottom: 3px;
        }

        .timer-info-sub {
            font-size: 0.75rem;
            color: #475569;
            font-family: 'DM Mono', monospace;
        }

        .progress-bar-wrap {
            margin-top: 8px;
            height: 3px;
            background: rgba(99, 102, 241, 0.1);
            border-radius: 2px;
            overflow: hidden;
        }

        .progress-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #6366f1, #818cf8);
            border-radius: 2px;
            width: 100%;
            transition: width 1s linear;
        }

        .btn-continue {
            display: block;
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: #fff;
            border: none;
            border-radius: 12px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.92rem;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
            transition: all 0.25s;
            box-shadow: 0 4px 20px rgba(79, 70, 229, 0.35);
            margin-bottom: 8px;
            position: relative;
            overflow: hidden;
        }

        .btn-continue::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), transparent);
            opacity: 0;
            transition: opacity 0.2s;
        }

        .btn-continue:hover::before {
            opacity: 1;
        }

        .btn-continue:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(79, 70, 229, 0.5);
        }

        .btn-continue.disabled {
            background: rgba(255, 255, 255, 0.04);
            color: #334155;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
            pointer-events: none;
        }

        .btn-continue.disabled::before {
            display: none;
        }

        .btn-skip {
            display: block;
            width: 100%;
            padding: 10px;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.8rem;
            font-weight: 500;
            color: #334155;
            cursor: pointer;
            transition: all 0.2s;
            opacity: 0;
            pointer-events: none;
        }

        .btn-skip.visible {
            opacity: 1;
            pointer-events: all;
            color: #64748b;
        }

        .btn-skip.visible:hover {
            color: #94a3b8;
            border-color: rgba(255, 255, 255, 0.14);
        }

        .destination-preview {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 1rem;
            padding: 8px 12px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 8px;
        }

        .dest-icon {
            width: 16px;
            height: 16px;
            background: rgba(255, 255, 255, 0.06);
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            flex-shrink: 0;
        }

        .dest-url {
            font-family: 'DM Mono', monospace;
            font-size: 0.68rem;
            color: #334155;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            flex: 1;
        }

        .dest-label {
            font-size: 0.62rem;
            color: #1e293b;
            flex-shrink: 0;
        }
    </style>
</head>

<body>
    <div class="bg-grid"></div>
    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>

    <div class="ad-card">

        <div class="card-topbar">
            <span class="ad-badge">Sponsored</span>
            <a class="snaplink-brand" href="/">SnapLink</a>
        </div>

        <% if (url.adBannerUrl) { %>
            <div class="ad-banner-wrap">
                <img class="ad-banner" src="<%= url.adBannerUrl %>" alt="Ad Banner" />
            </div>
            <% } %>

                <div class="ad-content">
                    <div class="ad-title">
                        <%= url.adTitle || 'Sponsored Content' %>
                    </div>
                    <% if (url.adDescription) { %>
                        <div class="ad-desc">
                            <%= url.adDescription %>
                        </div>
                        <% } %>
                </div>

                <div class="timer-section">
                    <div class="timer-ring">
                        <svg class="timer-svg" viewBox="0 0 64 64">
                            <defs>
                                <linearGradient id="ring-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" stop-color="#6366f1" />
                                    <stop offset="100%" stop-color="#a78bfa" />
                                </linearGradient>
                            </defs>
                            <circle class="ring-bg" cx="32" cy="32" r="28" />
                            <circle class="ring-fill" id="ring-fill" cx="32" cy="32" r="28" />
                        </svg>
                        <div class="timer-text">
                            <span class="timer-num" id="timer-num">
                                <%= adTimer %>
                            </span>
                            <span class="timer-s">sec</span>
                        </div>
                    </div>
                    <div class="timer-info">
                        <div class="timer-info-title" id="timer-msg">Thoda wait karo...</div>
                        <div class="timer-info-sub" id="timer-sub">Ad dekh ke continue karo</div>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar-fill" id="progress-fill"></div>
                        </div>
                    </div>
                </div>

                <!-- ✅ originalUrl — sahi variable name -->
                <a class="btn-continue disabled" id="continue-btn" href="<%= url.originalUrl %>">
                    Continue to Destination →
                </a>

                <% if (url.adSkipable) { %>
                    <button class="btn-skip" id="skip-btn" onclick="skipNow()">
                        Skip Ad
                    </button>
                    <% } %>

                        <div class="destination-preview">
                            <div class="dest-icon">🔗</div>
                            <span class="dest-url">
                                <%= url.originalUrl %>
                            </span>
                            <span class="dest-label">destination</span>
                        </div>

    </div>

    <script>
        // ✅ Sahi variable names — controller se jo pass kiya
        const TOTAL = <%= url.adTimer %>;
        const SKIPABLE = <%= url.adSkipable ? 'true' : 'false' %>;
        const TARGET = '<%= url.originalUrl.replace(/' / g, "\\'") %> ';
        const CIRCUM = 2 * Math.PI * 28;

        let timeLeft = TOTAL;

        const ringEl = document.getElementById('ring-fill');
        const numEl = document.getElementById('timer-num');
        const msgEl = document.getElementById('timer-msg');
        const subEl = document.getElementById('timer-sub');
        const progressEl = document.getElementById('progress-fill');
        const continueBtn = document.getElementById('continue-btn');
        const skipBtn = document.getElementById('skip-btn');

        ringEl.style.strokeDasharray = CIRCUM;
        ringEl.style.strokeDashoffset = 0;

        const tick = setInterval(() => {
            timeLeft--;

            const pct = timeLeft / TOTAL;
            const offset = CIRCUM * (1 - pct);
            ringEl.style.strokeDashoffset = offset;
            progressEl.style.width = (pct * 100) + '%';
            numEl.textContent = timeLeft;

            if (timeLeft <= 3) {
                msgEl.textContent = 'Almost done!';
                subEl.textContent = timeLeft + ' second bacha...';
            } else if (timeLeft <= Math.floor(TOTAL / 2)) {
                msgEl.textContent = 'Jaldi khatam hoga';
                subEl.textContent = timeLeft + ' seconds remaining';
            }

            if (SKIPABLE && skipBtn && timeLeft <= Math.floor(TOTAL / 2)) {
                skipBtn.classList.add('visible');
            }

            if (timeLeft <= 0) {
                clearInterval(tick);
                continueBtn.classList.remove('disabled');
                numEl.textContent = '✓';
                msgEl.textContent = 'Ready!';
                subEl.textContent = 'Continue button active ho gaya';
                progressEl.style.width = '0%';
                ringEl.style.stroke = '#34d399';
                setTimeout(() => { window.location.href = TARGET; }, 800);
            }
        }, 1000);

        function skipNow() {
            clearInterval(tick);
            window.location.href = TARGET;
        }
    </script>
</body>

</html>