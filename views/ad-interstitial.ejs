<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ad - SnapLink</title>

    <% if (monetagZoneId && monetagScriptUrl) { %>
        <script>
            (function (s) {
                s.dataset.zone = <%- JSON.stringify(monetagZoneId) %>;
                s.src = <%- JSON.stringify(monetagScriptUrl) %>;
            })([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')));
        </script>
    <% } %>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
        href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="/css/pages/generated/ad-interstitial.inline.css" />
</head>

<body>
    <div class="bg-grid"></div>
    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>

    <div class="ad-card">
        <div class="card-topbar">
            <span class="ad-badge">Sponsored</span>
            <a class="snaplink-brand" href="/">SnapLink</a>
        </div>

        <% if (url.adBannerUrl) { %>
            <div class="ad-banner-wrap">
                <img class="ad-banner" src="<%= url.adBannerUrl %>" alt="Ad Banner" />
            </div>
        <% } %>

        <div class="ad-content">
            <div class="ad-title">
                <%= url.adTitle || 'Sponsored Content' %>
            </div>
            <% if (url.adDescription) { %>
                <div class="ad-desc">
                    <%= url.adDescription %>
                </div>
            <% } %>
        </div>

        <div class="timer-section">
            <div class="timer-ring">
                <svg class="timer-svg" viewBox="0 0 64 64">
                    <defs>
                        <linearGradient id="ring-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="#6366f1" />
                            <stop offset="100%" stop-color="#a78bfa" />
                        </linearGradient>
                    </defs>
                    <circle class="ring-bg" cx="32" cy="32" r="28" />
                    <circle class="ring-fill" id="ring-fill" cx="32" cy="32" r="28" />
                </svg>
                <div class="timer-text">
                    <span class="timer-num" id="timer-num"><%= url.adTimer || 5 %></span>
                    <span class="timer-s">sec</span>
                </div>
            </div>
            <div class="timer-info">
                <div class="timer-info-title" id="timer-msg">Thoda wait karo...</div>
                <div class="timer-info-sub" id="timer-sub">Ad dekh ke continue karo</div>
                <div class="progress-bar-wrap">
                    <div class="progress-bar-fill" id="progress-fill"></div>
                </div>
            </div>
        </div>

        <a class="btn-continue disabled" id="continue-btn" href="<%= url.destinationUrl || url.orginalUrl %>">
            Continue to Destination ->
        </a>

        <% if (url.adSkipable) { %>
            <button class="btn-skip" id="skip-btn" onclick="skipNow()">
                Skip Ad
            </button>
        <% } %>

        <div class="destination-preview">
            <div class="dest-icon">Link</div>
            <span class="dest-url"><%= url.destinationUrl || url.orginalUrl %></span>
            <span class="dest-label">destination</span>
        </div>
    </div>

    <script>
        const TOTAL = <%= url.adTimer || 5 %>;
        const SKIPABLE = <%= url.adSkipable ? 'true' : 'false' %>;
        const TARGET = <%- JSON.stringify(url.destinationUrl || url.orginalUrl) %>;
        const CIRCUM = 2 * Math.PI * 28;

        let timeLeft = TOTAL;

        const ringEl = document.getElementById('ring-fill');
        const numEl = document.getElementById('timer-num');
        const msgEl = document.getElementById('timer-msg');
        const subEl = document.getElementById('timer-sub');
        const progressEl = document.getElementById('progress-fill');
        const continueBtn = document.getElementById('continue-btn');
        const skipBtn = document.getElementById('skip-btn');

        ringEl.style.strokeDasharray = CIRCUM;
        ringEl.style.strokeDashoffset = 0;

        const tick = setInterval(() => {
            timeLeft -= 1;

            const pct = timeLeft / TOTAL;
            const offset = CIRCUM * (1 - pct);
            ringEl.style.strokeDashoffset = offset;
            progressEl.style.width = `${pct * 100}%`;
            numEl.textContent = timeLeft;

            if (timeLeft <= 3) {
                msgEl.textContent = 'Almost done!';
                subEl.textContent = `${timeLeft} second bacha...`;
            } else if (timeLeft <= Math.floor(TOTAL / 2)) {
                msgEl.textContent = 'Jaldi khatam hoga';
                subEl.textContent = `${timeLeft} seconds remaining`;
            }

            if (SKIPABLE && skipBtn && timeLeft <= Math.floor(TOTAL / 2)) {
                skipBtn.classList.add('visible');
            }

            if (timeLeft <= 0) {
                clearInterval(tick);
                continueBtn.classList.remove('disabled');
                numEl.textContent = 'OK';
                msgEl.textContent = 'Ready!';
                subEl.textContent = 'Continue button active ho gaya';
                progressEl.style.width = '0%';
                ringEl.style.stroke = '#34d399';
                setTimeout(() => {
                    window.location.href = TARGET;
                }, 800);
            }
        }, 1000);

        function skipNow() {
            clearInterval(tick);
            window.location.href = TARGET;
        }
    </script>
</body>

</html>
