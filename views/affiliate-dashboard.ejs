<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
  <%
    const seo = {
      title: 'Affiliate Campaigns | SnapLink',
      description: 'Monitor affiliate campaigns, clicks, and pending earnings inside your SnapLink workspace.',
      path: '/affiliate/dashboard',
      robots: 'noindex, nofollow',
      stylesheets: ["/css/pages/site-shell.css","/css/pages/generated/affiliate-dashboard.inline.css","/css/pages/app-shell.css"]
    };
  %>
  <%- include('partials/seo-head', { seo }) %>
</head>

<body class="workspace-page">

  <nav class="workspace-nav">
    <a class="nav-logo" href="/">
      <div class="logo-mark">SL</div>
      SnapLink
    </a>
    <div class="nav-links">
      <a class="nav-link" href="/dashboard">URLs</a>
      <a class="nav-link active" href="/affiliate/dashboard">Affiliate</a>
      <a class="nav-link" href="/brand/campaigns">Brand</a>
      <a class="nav-link" href="/affiliate/wallet">Wallet</a>

    </div>
    <div class="nav-right">
      <button class="btn-nav" onclick="toggleTheme()" id="theme-btn">Theme</button>
      <a class="btn-nav ghost" href="/logout">Logout</a>
    </div>
  </nav>

  <main>

    <!-- Hero -->
    <div class="hero">
      <div class="hero-eyebrow">Affiliate Tracker</div>
      <h1>Your <em>Campaigns</em></h1>
      <p class="hero-sub">Saare affiliate links aur unki real-time analytics ek jagah</p>
    </div>

    <!-- Stats Bar -->
    <div class="stats-bar">
      <div class="stat-tile">
        <span class="stat-tile-label">Total Campaigns</span>
        <span class="stat-tile-val accent">
          <%= stats.totalLinks %>
        </span>
      </div>
      <div class="stat-tile">
        <span class="stat-tile-label">Total Clicks</span>
        <span class="stat-tile-val">
          <%= stats.totalClicks %>
        </span>
      </div>
      <div class="stat-tile">
        <span class="stat-tile-label">Active Links</span>
        <span class="stat-tile-val green">
          <%= stats.activeLinks %>
        </span>
      </div>
      <div class="stat-tile">
        <span class="stat-tile-label">Pending Earn</span>
        <span class="stat-tile-val green">
          ₹<%= (stats.pendingEarnings || 0).toFixed(0) %>
        </span>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="toolbar">
      <div class="toolbar-left">
        <span class="section-title">All Campaigns</span>
        <span class="count-badge">
          <span id="visible-count"><%= links.length %></span> / <%= links.length %>
        </span>
        <div class="filter-group">
          <input
            class="filter-input"
            type="text"
            id="campaign-search"
            placeholder="Search title or URL"
            oninput="filterCampaigns()"
          />
          <select class="filter-select" id="status-filter" onchange="filterCampaigns()">
            <option value="all">All status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
          <select class="filter-select" id="source-filter" onchange="filterCampaigns()">
            <option value="all">All sources</option>
            <option value="personal">Personal links</option>
            <option value="campaign">Brand campaigns</option>
          </select>
        </div>
      </div>
      <button class="btn-new" onclick="openModal()">
        <span class="btn-new-icon">+</span>
        New Campaign
      </button>
    </div>

    <!-- Campaigns List -->
    <div class="campaigns-grid">
      <% if (links.length===0) { %>
        <div class="empty-state">
          <span class="empty-glyph">LINK</span>
          <h3>Koi campaign nahi hai abhi</h3>
          <p>Pehla affiliate link banao aur track karna shuru karo</p>
          <button class="btn-new" onclick="openModal()" style="display:inline-flex">
            <span class="btn-new-icon">+</span>
            Pehla Campaign Banao
          </button>
        </div>
        <% } else { %>
          <% links.forEach((link, i)=> { %>
            <div
              class="campaign-card"
              data-title="<%= link.title %>"
              data-short="<%= link.shortCode %>"
              data-original="<%= link.originalUrl %>"
              data-status="<%= link.isActive ? 'Active' : 'Inactive' %>"
              data-source="<%= link.campaign ? 'campaign' : 'personal' %>"
              style="animation: fadeUp 0.4s <%= 0.1 + i * 0.05 %>s ease both; opacity:0"
            >
              <div class="card-main">
                <div class="card-top">
                  <span class="card-title">
                    <%= link.title %>
                  </span>
                  <span class="card-status <%= link.isActive ? 'active' : 'inactive' %>">
                    <%= link.isActive ? '● Active' : '○ Inactive' %>
                  </span>
                </div>
                <div class="card-urls">
                  <a class="card-short" href="/a/<%= link.shortCode %>" target="_blank">
                    /a/<%= link.shortCode %>
                  </a>
                  <span class="card-arrow">→</span>
                  <span class="card-original" title="<%= link.originalUrl %>">
                    <%= link.originalUrl %>
                  </span>
                </div>
                <div class="card-meta">
                  <span class="meta-chip">
                    <%= new Date(link.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short',
                      year:'2-digit'}) %>
                  </span>
                  <% if (link.campaign) { %>
                    <span class="meta-chip">Campaign: <%= link.campaign.title %></span>
                  <% } %>
                  <% if (link.refParam) { %>
                    <span class="meta-chip ref">?<%= link.refParam %></span>
                    <% } %>
                </div>
              </div>

              <div class="card-right">
                <div class="card-clicks">
                  <div class="clicks-num">
                    <%= link.totalClicks %>
                  </div>
                  <div class="clicks-label">clicks</div>
                </div>
                <div class="card-actions">
                  <button class="btn-action copy" onclick="copyUrl('<%= link.shortUrl %>', this)">
                    Copy
                  </button>
                  <a class="btn-action" href="/affiliate/links/<%= link.shortCode %>/analytics">
                    Analytics →
                  </a>
                  <form action="/affiliate/links/<%= link.shortCode %>/delete" method="POST" style="margin:0">
                    <button class="btn-action danger" type="submit" onclick="return confirm('Delete karo?')">✕</button>
                  </form>
                </div>
              </div>
            </div>
            <% }) %>
              <% } %>
    </div>

  </main>

  <!-- New Campaign Modal -->
  <div class="modal-overlay" id="modal" onclick="handleOverlayClick(event)">
    <div class="modal">
      <div class="modal-header">
        <span class="modal-title">New Campaign</span>
        <button class="modal-close" onclick="closeModal()">✕</button>
      </div>

      <form id="campaign-form" onsubmit="submitCampaign(event)">
        <div class="form-group">
          <label class="form-label">Campaign Title <span>*</span></label>
          <input class="form-input" type="text" id="title" placeholder="e.g. Amazon Shoes Summer Sale" required />
        </div>
        <div class="form-group">
          <label class="form-label">Brand Campaign (optional)</label>
          <select class="form-input" id="campaignId" onchange="onCampaignChange()">
            <option value="">Personal affiliate link</option>
            <% if (typeof campaigns !== 'undefined' && campaigns.length) { %>
              <% campaigns.forEach((campaign) => { %>
                <option
                  value="<%= campaign._id %>"
                  data-url="<%= campaign.targetUrl %>"
                  data-ref="<%= campaign.refParam || '' %>">
                  <%= campaign.title %> <% if (campaign.brandName) { %>• <%= campaign.brandName %><% } %>
                </option>
              <% }) %>
            <% } %>
          </select>
          <div class="form-hint">Campaign select karoge to target URL auto-fill ho jayega.</div>
        </div>
        <div class="form-group">
          <label class="form-label">Original URL <span>*</span></label>
          <input class="form-input" type="url" id="originalUrl" placeholder="https://amazon.in/product/..." required />
        </div>
        <div class="form-group">
          <label class="form-label">Tracking Parameter</label>
          <input class="form-input" type="text" id="refParam" placeholder="tag=azmat123" />
          <div class="form-hint">URL mein add hoga: ?tag=azmat123</div>
        </div>

        <div class="form-error" id="form-error"></div>

        <button class="btn-submit" type="submit" id="submit-btn">
          Create Campaign
        </button>
      </form>
    </div>
  </div>

  <script>
    // ── THEME ──
    function toggleTheme() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      document.documentElement.setAttribute('data-theme', isDark ? 'light' : 'dark');
      document.getElementById('theme-btn').textContent = isDark ? '☾ Dark' : '☀ Light';
      localStorage.setItem('snaplink-theme', isDark ? 'light' : 'dark');
    }
    const saved = localStorage.getItem('snaplink-theme') || 'dark';
    document.documentElement.setAttribute('data-theme', saved);
    document.getElementById('theme-btn').textContent = saved === 'dark' ? '☀ Light' : '☾ Dark';

    // ── COPY ──
    function copyUrl(url, btn) {
      navigator.clipboard.writeText(url).then(() => {
        const orig = btn.textContent.trim();
        btn.textContent = 'Copied!';
        btn.classList.add('ok');
        setTimeout(() => { btn.textContent = orig; btn.classList.remove('ok'); }, 2000);
      });
    }

    // ── MODAL ──
    function openModal() {
      document.getElementById('modal').classList.add('open');
      document.getElementById('title').focus();
    }
    function closeModal() {
      document.getElementById('modal').classList.remove('open');
      document.getElementById('campaign-form').reset();
      document.getElementById('form-error').classList.remove('show');
      document.getElementById('originalUrl').disabled = false;
    }
    function handleOverlayClick(e) {
      if (e.target === document.getElementById('modal')) closeModal();
    }

    function onCampaignChange() {
      const campaignSelect = document.getElementById('campaignId');
      const originalUrlInput = document.getElementById('originalUrl');
      const refParamInput = document.getElementById('refParam');
      const selectedOption = campaignSelect.options[campaignSelect.selectedIndex];

      if (!campaignSelect.value) {
        originalUrlInput.disabled = false;
        return;
      }

      const campaignUrl = selectedOption.getAttribute('data-url') || '';
      const campaignRef = selectedOption.getAttribute('data-ref') || '';
      originalUrlInput.value = campaignUrl;
      originalUrlInput.disabled = true;

      if (!refParamInput.value.trim() && campaignRef) {
        refParamInput.value = campaignRef;
      }
    }

    // ── SUBMIT ──
    async function submitCampaign(e) {
      e.preventDefault();
      const btn = document.getElementById('submit-btn');
      const errEl = document.getElementById('form-error');

      btn.disabled = true;
      btn.textContent = 'Creating...';
      errEl.classList.remove('show');

      try {
        const res = await fetch('/affiliate/links', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: document.getElementById('title').value,
            originalUrl: document.getElementById('originalUrl').value,
            campaignId: document.getElementById('campaignId').value || null,
            refParam: document.getElementById('refParam').value || null,
          })
        });

        const data = await res.json();

        if (data.success) {
          window.location.reload(); // page reload — naya card dikhega
        } else {
          errEl.textContent = data.error || 'Kuch gadbad hui';
          errEl.classList.add('show');
          btn.disabled = false;
          btn.textContent = 'Create Campaign';
        }
      } catch (err) {
        errEl.textContent = 'Server se connect nahi ho pa raha';
        errEl.classList.add('show');
        btn.disabled = false;
        btn.textContent = 'Create Campaign';
      }
    }

    // ESC key se modal close
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeModal();
    });

    function filterCampaigns() {
      const search = document.getElementById('campaign-search').value.trim().toLowerCase();
      const status = document.getElementById('status-filter').value;
      const source = document.getElementById('source-filter').value;
      let visible = 0;

      document.querySelectorAll('.campaign-card').forEach((card) => {
        const haystack = [
          card.dataset.title || '',
          card.dataset.short || '',
          card.dataset.original || '',
        ].join(' ').toLowerCase();

        const matchesSearch = !search || haystack.includes(search);
        const matchesStatus = status === 'all' || card.dataset.status === status;
        const matchesSource = source === 'all' || card.dataset.source === source;
        const shouldShow = matchesSearch && matchesStatus && matchesSource;

        card.style.display = shouldShow ? '' : 'none';
        if (shouldShow) visible += 1;
      });

      const count = document.getElementById('visible-count');
      if (count) count.textContent = visible;
    }

    filterCampaigns();
  </script>

</body>

</html>


