<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Campaigns — SnapLink Affiliate</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link
    href="https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;500;600;700&family=Outfit:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet" />
  <style>
    :root {
      --bg: #07080f;
      --bg2: #0d0f1a;
      --bg3: #141728;
      --bg4: #1b2038;
      --border: rgba(139, 92, 246, 0.08);
      --border2: rgba(139, 92, 246, 0.18);
      --accent: #7c3aed;
      --accent2: #a78bfa;
      --accent-soft: rgba(124, 58, 237, 0.15);
      --accent-glow: rgba(124, 58, 237, 0.08);
      --green: #34d399;
      --green-bg: rgba(52, 211, 153, 0.08);
      --red: #f87171;
      --red-bg: rgba(248, 113, 113, 0.08);
      --amber: #fbbf24;
      --amber-bg: rgba(251, 191, 36, 0.08);
      --cyan: #22d3ee;
      --cyan-bg: rgba(34, 211, 238, 0.08);
      --text: #eeeaf8;
      --text2: #9d96c0;
      --text3: #4d4870;
      --mono: 'JetBrains Mono', monospace;
      --display: 'Clash Display', sans-serif;
      --body: 'Outfit', sans-serif;
      --radius: 16px;
      --radius-sm: 10px;
      --radius-xs: 6px;
    }

    [data-theme="light"] {
      --bg: #f5f3ff;
      --bg2: #ffffff;
      --bg3: #ede9fe;
      --bg4: #ddd6fe;
      --border: rgba(124, 58, 237, 0.1);
      --border2: rgba(124, 58, 237, 0.22);
      --accent: #6d28d9;
      --accent2: #7c3aed;
      --accent-soft: rgba(109, 40, 217, 0.1);
      --accent-glow: rgba(109, 40, 217, 0.06);
      --text: #1a1535;
      --text2: #5b5280;
      --text3: #a89fc8;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--body);
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Noise texture overlay */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
      opacity: 0.4;
    }

    /* Radial glow top left */
    body::after {
      content: '';
      position: fixed;
      top: -200px;
      left: -200px;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle, rgba(124, 58, 237, 0.12) 0%, transparent 65%);
      pointer-events: none;
      z-index: 0;
    }

    /* ── NAV ── */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2rem;
      height: 60px;
      background: rgba(7, 8, 15, 0.88);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
    }

    [data-theme="light"] nav {
      background: rgba(245, 243, 255, 0.92);
    }

    .nav-logo {
      font-family: var(--display);
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-mark {
      width: 28px;
      height: 28px;
      background: var(--accent);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      box-shadow: 0 0 20px rgba(124, 58, 237, 0.4);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .nav-link {
      padding: 6px 14px;
      border-radius: var(--radius-xs);
      font-size: 0.82rem;
      font-weight: 500;
      color: var(--text2);
      text-decoration: none;
      transition: all 0.15s;
    }

    .nav-link:hover {
      color: var(--text);
      background: var(--bg3);
    }

    .nav-link.active {
      color: var(--accent2);
      background: var(--accent-soft);
    }

    .nav-right {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .btn-nav {
      padding: 7px 16px;
      border-radius: var(--radius-sm);
      font-family: var(--body);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      border: 1px solid var(--border2);
      background: transparent;
      color: var(--text2);
      text-decoration: none;
    }

    .btn-nav:hover {
      color: var(--text);
      border-color: var(--accent2);
    }

    .btn-nav.ghost {
      color: var(--text3);
      border-color: var(--border);
    }

    .btn-nav.ghost:hover {
      color: var(--red);
      border-color: var(--red);
    }

    /* ── MAIN ── */
    main {
      position: relative;
      z-index: 1;
      max-width: 1160px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 6rem;
    }

    /* ── HERO HEADER ── */
    .hero {
      margin-bottom: 2.5rem;
      animation: fadeUp 0.5s ease both;
    }

    .hero-eyebrow {
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--accent2);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .hero-eyebrow::before {
      content: '';
      display: inline-block;
      width: 20px;
      height: 1px;
      background: var(--accent2);
    }

    .hero h1 {
      font-family: var(--display);
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 1;
      color: var(--text);
    }

    .hero h1 em {
      font-style: normal;
      color: var(--accent2);
    }

    .hero-sub {
      margin-top: 10px;
      color: var(--text2);
      font-size: 0.95rem;
      font-weight: 400;
    }

    /* ── STATS ── */
    .stats-bar {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 2rem;
    }

    @media(max-width:700px) {
      .stats-bar {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .stat-tile {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.2rem 1.4rem;
      display: flex;
      flex-direction: column;
      gap: 6px;
      animation: fadeUp 0.5s ease both;
      transition: border-color 0.2s, transform 0.2s;
      position: relative;
      overflow: hidden;
    }

    .stat-tile::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--accent);
      opacity: 0;
      transition: opacity 0.2s;
    }

    .stat-tile:hover {
      border-color: var(--border2);
      transform: translateY(-2px);
    }

    .stat-tile:hover::before {
      opacity: 1;
    }

    .stat-tile:nth-child(1) {
      animation-delay: .05s;
    }

    .stat-tile:nth-child(2) {
      animation-delay: .1s;
    }

    .stat-tile:nth-child(3) {
      animation-delay: .15s;
    }

    .stat-tile:nth-child(4) {
      animation-delay: .2s;
    }

    .stat-tile-label {
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text3);
    }

    .stat-tile-val {
      font-family: var(--mono);
      font-size: 1.8rem;
      font-weight: 500;
      color: var(--text);
      line-height: 1;
    }

    .stat-tile-val.accent {
      color: var(--accent2);
    }

    .stat-tile-val.green {
      color: var(--green);
    }

    /* ── TOOLBAR ── */
    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.2rem;
      gap: 1rem;
      flex-wrap: wrap;
      animation: fadeUp 0.5s 0.2s ease both;
    }

    .toolbar-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .section-title {
      font-family: var(--display);
      font-size: 1rem;
      font-weight: 600;
      color: var(--text);
    }

    .count-badge {
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--text3);
      background: var(--bg3);
      border: 1px solid var(--border);
      padding: 2px 10px;
      border-radius: 20px;
    }

    .filter-group {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .filter-input,
    .filter-select {
      background: var(--bg3);
      border: 1px solid var(--border2);
      color: var(--text);
      border-radius: var(--radius-xs);
      font-family: var(--body);
      font-size: 0.78rem;
      padding: 7px 10px;
      outline: none;
    }

    .filter-input {
      min-width: 180px;
    }

    .filter-input::placeholder {
      color: var(--text3);
    }

    /* ── NEW LINK BTN ── */
    .btn-new {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 20px;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: var(--radius-sm);
      font-family: var(--body);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 0 20px rgba(124, 58, 237, 0.3);
    }

    .btn-new:hover {
      background: var(--accent2);
      box-shadow: 0 0 30px rgba(124, 58, 237, 0.5);
      transform: translateY(-1px);
    }

    .btn-new-icon {
      width: 18px;
      height: 18px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
    }

    /* ── CAMPAIGN CARDS ── */
    .campaigns-grid {
      display: flex;
      flex-direction: column;
      gap: 10px;
      animation: fadeUp 0.5s 0.25s ease both;
    }

    .campaign-card {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.4rem 1.6rem;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 1rem;
      align-items: center;
      transition: border-color 0.2s, transform 0.15s, background 0.2s;
      position: relative;
      overflow: hidden;
    }

    .campaign-card::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 3px;
      background: var(--accent);
      opacity: 0;
      transition: opacity 0.2s;
    }

    .campaign-card:hover {
      border-color: var(--border2);
      background: var(--bg3);
      transform: translateX(3px);
    }

    .campaign-card:hover::before {
      opacity: 1;
    }

    .card-main {
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-width: 0;
    }

    .card-top {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .card-title {
      font-family: var(--display);
      font-size: 1rem;
      font-weight: 600;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    .card-status {
      font-size: 0.68rem;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 20px;
      letter-spacing: 0.06em;
    }

    .card-status.active {
      background: var(--green-bg);
      color: var(--green);
      border: 1px solid rgba(52, 211, 153, 0.2);
    }

    .card-status.inactive {
      background: var(--red-bg);
      color: var(--red);
      border: 1px solid rgba(248, 113, 113, 0.2);
    }

    .card-urls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .card-short {
      font-family: var(--mono);
      font-size: 0.8rem;
      color: var(--accent2);
      text-decoration: none;
      transition: color 0.15s;
    }

    .card-short:hover {
      color: var(--text);
    }

    .card-arrow {
      color: var(--text3);
      font-size: 0.75rem;
    }

    .card-original {
      font-family: var(--mono);
      font-size: 0.78rem;
      color: var(--text3);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 300px;
    }

    .card-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .meta-chip {
      font-family: var(--mono);
      font-size: 0.7rem;
      color: var(--text3);
      background: var(--bg3);
      border: 1px solid var(--border);
      padding: 2px 8px;
      border-radius: 4px;
    }

    .meta-chip.ref {
      color: var(--amber);
      background: var(--amber-bg);
      border-color: rgba(251, 191, 36, 0.2);
    }

    /* Card right actions */
    .card-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 10px;
    }

    .card-clicks {
      text-align: right;
    }

    .clicks-num {
      font-family: var(--mono);
      font-size: 1.6rem;
      font-weight: 500;
      color: var(--text);
      line-height: 1;
    }

    .clicks-label {
      font-size: 0.68rem;
      color: var(--text3);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .card-actions {
      display: flex;
      gap: 6px;
    }

    .btn-action {
      padding: 6px 14px;
      border-radius: var(--radius-xs);
      font-family: var(--body);
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
      border: 1px solid var(--border2);
      background: transparent;
      color: var(--text2);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .btn-action:hover {
      color: var(--text);
      border-color: var(--accent2);
      background: var(--accent-soft);
    }

    .btn-action.danger:hover {
      color: var(--red);
      border-color: var(--red);
      background: var(--red-bg);
    }

    .btn-action.copy.ok {
      color: var(--green);
      border-color: var(--green);
    }

    /* ── EMPTY STATE ── */
    .empty-state {
      text-align: center;
      padding: 5rem 2rem;
      animation: fadeUp 0.5s 0.25s ease both;
    }

    .empty-glyph {
      font-size: 3rem;
      margin-bottom: 1rem;
      opacity: 0.3;
      display: block;
    }

    .empty-state h3 {
      font-family: var(--display);
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--text2);
      margin-bottom: 8px;
    }

    .empty-state p {
      font-size: 0.88rem;
      color: var(--text3);
      margin-bottom: 1.5rem;
    }

    /* ── MODAL ── */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(7, 8, 15, 0.85);
      backdrop-filter: blur(8px);
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s;
    }

    .modal-overlay.open {
      opacity: 1;
      pointer-events: all;
    }

    .modal {
      background: var(--bg2);
      border: 1px solid var(--border2);
      border-radius: var(--radius);
      padding: 2rem;
      width: 100%;
      max-width: 500px;
      transform: translateY(20px);
      transition: transform 0.25s;
      position: relative;
    }

    .modal-overlay.open .modal {
      transform: translateY(0);
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }

    .modal-title {
      font-family: var(--display);
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--text);
    }

    .modal-close {
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text2);
      width: 30px;
      height: 30px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s;
    }

    .modal-close:hover {
      color: var(--red);
      border-color: var(--red);
    }

    .form-group {
      margin-bottom: 1.2rem;
    }

    .form-label {
      display: block;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text2);
      margin-bottom: 6px;
      letter-spacing: 0.04em;
    }

    .form-label span {
      color: var(--red);
      margin-left: 2px;
    }

    .form-input {
      width: 100%;
      padding: 10px 14px;
      background: var(--bg3);
      border: 1px solid var(--border2);
      border-radius: var(--radius-sm);
      color: var(--text);
      font-family: var(--body);
      font-size: 0.88rem;
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
    }

    .form-input::placeholder {
      color: var(--text3);
    }

    .form-input:focus {
      border-color: var(--accent2);
      box-shadow: 0 0 0 3px var(--accent-soft);
    }

    .form-hint {
      margin-top: 5px;
      font-size: 0.72rem;
      color: var(--text3);
      font-family: var(--mono);
    }

    .btn-submit {
      width: 100%;
      padding: 12px;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: var(--radius-sm);
      font-family: var(--body);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 4px 20px rgba(124, 58, 237, 0.3);
    }

    .btn-submit:hover {
      background: var(--accent2);
      box-shadow: 0 4px 30px rgba(124, 58, 237, 0.5);
    }

    .btn-submit:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .form-error {
      margin-top: 10px;
      padding: 8px 12px;
      background: var(--red-bg);
      border: 1px solid rgba(248, 113, 113, 0.2);
      border-radius: var(--radius-xs);
      font-size: 0.8rem;
      color: var(--red);
      display: none;
    }

    .form-error.show {
      display: block;
    }

    @media (max-width: 980px) {
      nav {
        height: auto;
        min-height: 60px;
        padding: 10px 14px;
        flex-wrap: wrap;
      }

      .nav-links {
        width: 100%;
        order: 3;
        overflow-x: auto;
        padding-bottom: 4px;
      }

      .nav-right {
        margin-left: auto;
      }
    }

    @media (max-width: 760px) {
      .stats-bar {
        grid-template-columns: 1fr;
      }

      .toolbar-left {
        width: 100%;
        flex-wrap: wrap;
      }

      .filter-group {
        width: 100%;
      }

      .filter-input,
      .filter-select {
        flex: 1;
        min-width: 140px;
      }

      .campaign-card {
        grid-template-columns: 1fr;
      }

      .card-right {
        align-items: flex-start;
        width: 100%;
      }

      .card-clicks {
        text-align: left;
      }

      .card-actions {
        flex-wrap: wrap;
      }
    }

    /* ── ANIMATIONS ── */
    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(16px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>

<body>

  <nav>
    <a class="nav-logo" href="/">
      <div class="logo-mark">⚡</div>
      SnapLink
    </a>
    <div class="nav-links">
      <a class="nav-link" href="/dashboard">URLs</a>
      <a class="nav-link active" href="/affiliate/dashboard">Affiliate</a>
      <a class="nav-link" href="/brand/campaigns">Brand</a>
      <a class="nav-link" href="/affiliate/wallet">💰 Wallet</a>

    </div>
    <div class="nav-right">
      <button class="btn-nav" onclick="toggleTheme()" id="theme-btn">☀ Light</button>
      <a class="btn-nav ghost" href="/logout">Logout</a>
    </div>
  </nav>

  <main>

    <!-- Hero -->
    <div class="hero">
      <div class="hero-eyebrow">Affiliate Tracker</div>
      <h1>Your <em>Campaigns</em></h1>
      <p class="hero-sub">Saare affiliate links aur unki real-time analytics ek jagah</p>
    </div>

    <!-- Stats Bar -->
    <div class="stats-bar">
      <div class="stat-tile">
        <span class="stat-tile-label">Total Campaigns</span>
        <span class="stat-tile-val accent">
          <%= stats.totalLinks %>
        </span>
      </div>
      <div class="stat-tile">
        <span class="stat-tile-label">Total Clicks</span>
        <span class="stat-tile-val">
          <%= stats.totalClicks %>
        </span>
      </div>
      <div class="stat-tile">
        <span class="stat-tile-label">Active Links</span>
        <span class="stat-tile-val green">
          <%= stats.activeLinks %>
        </span>
      </div>
      <div class="stat-tile">
        <span class="stat-tile-label">Pending Earn</span>
        <span class="stat-tile-val green">
          ₹<%= (stats.pendingEarnings || 0).toFixed(0) %>
        </span>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="toolbar">
      <div class="toolbar-left">
        <span class="section-title">All Campaigns</span>
        <span class="count-badge">
          <span id="visible-count"><%= links.length %></span> / <%= links.length %>
        </span>
        <div class="filter-group">
          <input
            class="filter-input"
            type="text"
            id="campaign-search"
            placeholder="Search title or URL"
            oninput="filterCampaigns()"
          />
          <select class="filter-select" id="status-filter" onchange="filterCampaigns()">
            <option value="all">All status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>
          <select class="filter-select" id="source-filter" onchange="filterCampaigns()">
            <option value="all">All sources</option>
            <option value="personal">Personal links</option>
            <option value="campaign">Brand campaigns</option>
          </select>
        </div>
      </div>
      <button class="btn-new" onclick="openModal()">
        <span class="btn-new-icon">+</span>
        New Campaign
      </button>
    </div>

    <!-- Campaigns List -->
    <div class="campaigns-grid">
      <% if (links.length===0) { %>
        <div class="empty-state">
          <span class="empty-glyph">🔗</span>
          <h3>Koi campaign nahi hai abhi</h3>
          <p>Pehla affiliate link banao aur track karna shuru karo</p>
          <button class="btn-new" onclick="openModal()" style="display:inline-flex">
            <span class="btn-new-icon">+</span>
            Pehla Campaign Banao
          </button>
        </div>
        <% } else { %>
          <% links.forEach((link, i)=> { %>
            <div
              class="campaign-card"
              data-title="<%= link.title %>"
              data-short="<%= link.shortCode %>"
              data-original="<%= link.originalUrl %>"
              data-status="<%= link.isActive ? 'active' : 'inactive' %>"
              data-source="<%= link.campaign ? 'campaign' : 'personal' %>"
              style="animation: fadeUp 0.4s <%= 0.1 + i * 0.05 %>s ease both; opacity:0"
            >
              <div class="card-main">
                <div class="card-top">
                  <span class="card-title">
                    <%= link.title %>
                  </span>
                  <span class="card-status <%= link.isActive ? 'active' : 'inactive' %>">
                    <%= link.isActive ? '● Active' : '○ Inactive' %>
                  </span>
                </div>
                <div class="card-urls">
                  <a class="card-short" href="/a/<%= link.shortCode %>" target="_blank">
                    /a/<%= link.shortCode %>
                  </a>
                  <span class="card-arrow">→</span>
                  <span class="card-original" title="<%= link.originalUrl %>">
                    <%= link.originalUrl %>
                  </span>
                </div>
                <div class="card-meta">
                  <span class="meta-chip">
                    <%= new Date(link.createdAt).toLocaleDateString('en-IN', {day:'numeric', month:'short',
                      year:'2-digit'}) %>
                  </span>
                  <% if (link.campaign) { %>
                    <span class="meta-chip">Campaign: <%= link.campaign.title %></span>
                  <% } %>
                  <% if (link.refParam) { %>
                    <span class="meta-chip ref">?<%= link.refParam %></span>
                    <% } %>
                </div>
              </div>

              <div class="card-right">
                <div class="card-clicks">
                  <div class="clicks-num">
                    <%= link.totalClicks %>
                  </div>
                  <div class="clicks-label">clicks</div>
                </div>
                <div class="card-actions">
                  <button class="btn-action copy" onclick="copyUrl('<%= link.shortUrl %>', this)">
                    Copy
                  </button>
                  <a class="btn-action" href="/affiliate/links/<%= link.shortCode %>/analytics">
                    Analytics →
                  </a>
                  <form action="/affiliate/links/<%= link.shortCode %>/delete" method="POST" style="margin:0">
                    <button class="btn-action danger" type="submit" onclick="return confirm('Delete karo?')">✕</button>
                  </form>
                </div>
              </div>
            </div>
            <% }) %>
              <% } %>
    </div>

  </main>

  <!-- New Campaign Modal -->
  <div class="modal-overlay" id="modal" onclick="handleOverlayClick(event)">
    <div class="modal">
      <div class="modal-header">
        <span class="modal-title">New Campaign</span>
        <button class="modal-close" onclick="closeModal()">✕</button>
      </div>

      <form id="campaign-form" onsubmit="submitCampaign(event)">
        <div class="form-group">
          <label class="form-label">Campaign Title <span>*</span></label>
          <input class="form-input" type="text" id="title" placeholder="e.g. Amazon Shoes Summer Sale" required />
        </div>
        <div class="form-group">
          <label class="form-label">Brand Campaign (optional)</label>
          <select class="form-input" id="campaignId" onchange="onCampaignChange()">
            <option value="">Personal affiliate link</option>
            <% if (typeof campaigns !== 'undefined' && campaigns.length) { %>
              <% campaigns.forEach((campaign) => { %>
                <option
                  value="<%= campaign._id %>"
                  data-url="<%= campaign.targetUrl %>"
                  data-ref="<%= campaign.refParam || '' %>">
                  <%= campaign.title %> <% if (campaign.brandName) { %>• <%= campaign.brandName %><% } %>
                </option>
              <% }) %>
            <% } %>
          </select>
          <div class="form-hint">Campaign select karoge to target URL auto-fill ho jayega.</div>
        </div>
        <div class="form-group">
          <label class="form-label">Original URL <span>*</span></label>
          <input class="form-input" type="url" id="originalUrl" placeholder="https://amazon.in/product/..." required />
        </div>
        <div class="form-group">
          <label class="form-label">Tracking Parameter</label>
          <input class="form-input" type="text" id="refParam" placeholder="tag=azmat123" />
          <div class="form-hint">URL mein add hoga: ?tag=azmat123</div>
        </div>

        <div class="form-error" id="form-error"></div>

        <button class="btn-submit" type="submit" id="submit-btn">
          Create Campaign
        </button>
      </form>
    </div>
  </div>

  <script>
    // ── THEME ──
    function toggleTheme() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      document.documentElement.setAttribute('data-theme', isDark ? 'light' : 'dark');
      document.getElementById('theme-btn').textContent = isDark ? '☾ Dark' : '☀ Light';
      localStorage.setItem('snaplink-theme', isDark ? 'light' : 'dark');
    }
    const saved = localStorage.getItem('snaplink-theme') || 'dark';
    document.documentElement.setAttribute('data-theme', saved);
    document.getElementById('theme-btn').textContent = saved === 'dark' ? '☀ Light' : '☾ Dark';

    // ── COPY ──
    function copyUrl(url, btn) {
      navigator.clipboard.writeText(url).then(() => {
        const orig = btn.textContent.trim();
        btn.textContent = 'Copied!';
        btn.classList.add('ok');
        setTimeout(() => { btn.textContent = orig; btn.classList.remove('ok'); }, 2000);
      });
    }

    // ── MODAL ──
    function openModal() {
      document.getElementById('modal').classList.add('open');
      document.getElementById('title').focus();
    }
    function closeModal() {
      document.getElementById('modal').classList.remove('open');
      document.getElementById('campaign-form').reset();
      document.getElementById('form-error').classList.remove('show');
      document.getElementById('originalUrl').disabled = false;
    }
    function handleOverlayClick(e) {
      if (e.target === document.getElementById('modal')) closeModal();
    }

    function onCampaignChange() {
      const campaignSelect = document.getElementById('campaignId');
      const originalUrlInput = document.getElementById('originalUrl');
      const refParamInput = document.getElementById('refParam');
      const selectedOption = campaignSelect.options[campaignSelect.selectedIndex];

      if (!campaignSelect.value) {
        originalUrlInput.disabled = false;
        return;
      }

      const campaignUrl = selectedOption.getAttribute('data-url') || '';
      const campaignRef = selectedOption.getAttribute('data-ref') || '';
      originalUrlInput.value = campaignUrl;
      originalUrlInput.disabled = true;

      if (!refParamInput.value.trim() && campaignRef) {
        refParamInput.value = campaignRef;
      }
    }

    // ── SUBMIT ──
    async function submitCampaign(e) {
      e.preventDefault();
      const btn = document.getElementById('submit-btn');
      const errEl = document.getElementById('form-error');

      btn.disabled = true;
      btn.textContent = 'Creating...';
      errEl.classList.remove('show');

      try {
        const res = await fetch('/affiliate/links', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: document.getElementById('title').value,
            originalUrl: document.getElementById('originalUrl').value,
            campaignId: document.getElementById('campaignId').value || null,
            refParam: document.getElementById('refParam').value || null,
          })
        });

        const data = await res.json();

        if (data.success) {
          window.location.reload(); // page reload — naya card dikhega
        } else {
          errEl.textContent = data.error || 'Kuch gadbad hui';
          errEl.classList.add('show');
          btn.disabled = false;
          btn.textContent = 'Create Campaign';
        }
      } catch (err) {
        errEl.textContent = 'Server se connect nahi ho pa raha';
        errEl.classList.add('show');
        btn.disabled = false;
        btn.textContent = 'Create Campaign';
      }
    }

    // ESC key se modal close
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closeModal();
    });

    function filterCampaigns() {
      const search = document.getElementById('campaign-search').value.trim().toLowerCase();
      const status = document.getElementById('status-filter').value;
      const source = document.getElementById('source-filter').value;
      let visible = 0;

      document.querySelectorAll('.campaign-card').forEach((card) => {
        const haystack = [
          card.dataset.title || '',
          card.dataset.short || '',
          card.dataset.original || '',
        ].join(' ').toLowerCase();

        const matchesSearch = !search || haystack.includes(search);
        const matchesStatus = status === 'all' || card.dataset.status === status;
        const matchesSource = source === 'all' || card.dataset.source === source;
        const shouldShow = matchesSearch && matchesStatus && matchesSource;

        card.style.display = shouldShow ? '' : 'none';
        if (shouldShow) visible += 1;
      });

      const count = document.getElementById('visible-count');
      if (count) count.textContent = visible;
    }

    filterCampaigns();
  </script>

</body>

</html>
